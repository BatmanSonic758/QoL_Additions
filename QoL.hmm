        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.weight.portalBitWeight, (uint)30);
    }

    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.weight.noneWeight, (uint)3920);
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.weight.ring10Weight, (uint)300);
