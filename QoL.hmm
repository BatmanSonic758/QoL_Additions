}

Code "Super Sonic Effect Fixes" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "BlackboardStatus"

static bool isSuperWarp = false;
static bool isSuperWarpEffect = false;
static bool isSuperStomp = false;

static float superWarpTimer = 0.0f;

{
    if (!BlackboardStatus.IsSuper())
    {
        // Detransforming mid-effect would otherwise leave it running until the next transformation
        if (isSuperWarpEffect)
        {
            for (int i = 0; i < 8; i++)
                Player.Effect.StopEffect("isSuperWarpEffect");

            isSuperWarpEffect = false;
        }

        if (isSuperStomp)
        {
            Player.Effect.StopEffect("isSuperStomp");
            isSuperStomp = false;
        }

        isSuperWarp = false;
        superWarpTimer = 0.0f;
        return;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    // Parry Warp
    if (currentState == Sonic.StateID.StateAvoidToTarget)
    {
        if (!isSuperWarp)
        {
            Player.Animation.SetAnimation("MOVE_UP_LOOP");
            superWarpTimer = 0.0f;
            isSuperWarp = true;
        }
        else
        {
            superWarpTimer += Time.GetDeltaTime();

            if (superWarpTimer >= 0.3f)
                Player.Animation.SetAnimation("MOVE_DOWN_LOOP");
        }
    }
    else
    {
        isSuperWarp = false;
        superWarpTimer = 0.0f;
    }

    if (previousState == Sonic.StateID.StateAvoidToTarget && currentState != Sonic.StateID.StateAvoidToTarget)
    {
        if (!isSuperWarpEffect)
        {
            Player.Effect.PlayEffect("isSuperWarpEffect", "ef_ss_parry_warp01");
            Player.Effect.PlayEffect("isSuperWarpEffect", "ec_ss_parry_warp01_spiral01");
            Player.Effect.PlayEffect("isSuperWarpEffect", "ec_ss_parry_warp01_spiral02");
            Player.Effect.PlayEffect("isSuperWarpEffect", "ec_ss_parry_warp01_Pointlight01");
            Player.Effect.PlayEffect("isSuperWarpEffect", "ec_ss_parry_warp01_impact01");
            Player.Effect.PlayEffect("isSuperWarpEffect", "ec_ss_parry_warp01_line_par01");
            Player.Effect.PlayEffect("isSuperWarpEffect", "ec_ss_parry_warp01_core01");
            Player.Effect.PlayEffect("isSuperWarpEffect", "ec_ss_parry_warp01_glow01");
            isSuperWarpEffect = true;
        }
    }
    else if (isSuperWarpEffect)
    {
        for (int i = 0; i < 8; i++)
            Player.Effect.StopEffect("isSuperWarpEffect");

        isSuperWarpEffect = false;
    }

    // Stomp
    if (currentState == Sonic.StateID.StateStompingDown)
    {
        if (!isSuperStomp)
        {
            Player.Effect.PlayEffect("isSuperStomp", "ef_ss_stomp_loop01");
            isSuperStomp = true;
        }
    }
    else if (isSuperStomp)
    {
        Player.Effect.StopEffect("isSuperStomp");
        isSuperStomp = false;
    }
}

Code "Card Stomp Effect" by "Batman Sonic"
