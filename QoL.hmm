Code "Disable Jump Stomp" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"
#lib "Time"
#lib "XInput"

#load "System.Numerics.dll"

using System.Numerics;

static bool isStompingLand = false;
static bool isStompingLandToStand = false;
static float stompingLandTimer = 0.0f;

static bool isConfigInitialized = false;
static bool conSonicNoJumpStomp = false;
static int conBounceAttackAbility = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            conSonicNoJumpStomp = INI.GetField<bool>(ini, "Main", "SonicNoJumpStomp", conSonicNoJumpStomp);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Sonic || !conSonicNoJumpStomp || conBounceAttackAbility != 2)
        return;

    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateStompingLand, Sonic.StateID.StateSquat);

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (currentState == Sonic.StateID.StateStompingLand || (previousState == Sonic.StateID.StateStompingLand && currentState == Sonic.StateID.StateStandRoot))
    {
        if (!isStompingLand)
        {
            Player.Animation.SetAnimation("STOMPING_END");
            Player.Sound.PlaySound("sn_stomping_land");
            Player.Effect.PlayEffect("isStompingLand", "ef_so_stomp_end01");
            isStompingLand = true;
        }
    }
    else if (isStompingLand)
    {
        Player.Effect.StopEffect("isStompingLand");
        isStompingLand = false;
    }

    if (previousState == Sonic.StateID.StateStompingDown && currentState == Sonic.StateID.StateStompingLand)
    {
        var xinputState = XInput.GetState();

        if (xinputState != null)
        {
            Vector2 stick = XInput.GetAnalog(0, true);

            if (stick.Y >= 0.25f)
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSliding);
                return;
            }
        }
    }

    if (previousState == Sonic.StateID.StateStompingLand && currentState == Sonic.StateID.StateStandRoot)
    {
        stompingLandTimer += Time.GetDeltaTime();

        if (stompingLandTimer >= 0.7f && !isStompingLandToStand)
        {
            Player.Animation.SetAnimation("SQUAT_END");
            isStompingLandToStand = true;
        }
    }
    else
    {
        stompingLandTimer = 0.0f;
        isStompingLandToStand = false;
    }
}

Code "Fix Jump Stomp Landing" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "GameManager"

static bool isJumpStompSequence = false;
static bool isJumpStompLand = false;
static bool isShockwaveEffect = false;
static bool isShockwaveDamage = false;
static bool isJumpStompEnd = false;
static bool isSquatEndPending = false;
static float jumpStompTimer = 0.0f;

{
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (currentState == Sonic.StateID.StateStompingDown &&
        previousState == Sonic.StateID.StateBounceJump)
    {
        isJumpStompSequence = true;
    }
    else if (currentState == Sonic.StateID.StateStompingLand &&
             previousState == Sonic.StateID.StateStompingDown &&
             isJumpStompSequence)
    {
        isJumpStompLand = true;
    }
    else if (currentState == Sonic.StateID.StateSquat &&
             previousState == Sonic.StateID.StateStompingLand &&
             isJumpStompLand)
    {
        Player.Animation.SetAnimation("STOMPING_END");

        Player.Effect.PlayEffect("isShockwaveEffect", "ec_so_stomp_end01_third_pointlight01");
        Player.Effect.PlayEffect("isShockwaveEffect", "ec_so_stomp_end01_third_lightning02");
        Player.Effect.PlayEffect("isShockwaveEffect", "ec_so_stomp_end01_third_lightning01");
        Player.Effect.PlayEffect("isShockwaveEffect", "ec_so_stomp_end01_third_glare02");
        Player.Effect.PlayEffect("isShockwaveEffect", "ec_so_stomp_end01_third_glare_02");
        Player.Effect.PlayEffect("isShockwaveEffect", "ef_so_stomp_end01_third");

        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 5.0f);
        Player.Collision.SetEntityCollision(false);

        isShockwaveEffect = true;
        isShockwaveDamage = true;
        isJumpStompEnd = true;
        isSquatEndPending = true;
        jumpStompTimer = 0.0f;
        isJumpStompSequence = false;
        isJumpStompLand = false;
    }

    if (isJumpStompEnd)
    {
        // Moving off the landing ends the hit right away, the effects still play out on their timer
        if (isShockwaveDamage && currentState != Sonic.StateID.StateSquat && currentState != Sonic.StateID.StateStandRoot)
        {
            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);
            isShockwaveDamage = false;
        }

        if (Player.Input.IsDown(Player.InputActionType.PlayerStomping))
        {
            jumpStompTimer = 0.0f;
        }
        else
        {
            bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                            GameManager.GetGameObject("MapMenu") != null ||
                            GameManager.GetGameObject("PhotoMode") != null;

            if (!isPaused)
                jumpStompTimer += Time.GetDeltaTime();

            if (jumpStompTimer >= 0.7f)
            {
                if (isSquatEndPending &&
                    currentState == Sonic.StateID.StateStandRoot &&
                    previousState == Sonic.StateID.StateSquat)
                {
                    Player.Animation.SetAnimation("SQUAT_END");
                    isSquatEndPending = false;
                }

                if (isShockwaveEffect)
                {
                    for (int i = 0; i < 6; i++)
                        Player.Effect.StopEffect("isShockwaveEffect");

                    isShockwaveEffect = false;
                }

                if (isShockwaveDamage)
                {
                    Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
                    Player.Collision.SetEntityCollision(true);
                    isShockwaveDamage = false;
                }

                isJumpStompEnd = false;
                jumpStompTimer = 0.0f;
            }
        }
    }
    else if (currentState != Sonic.StateID.StateStompingDown &&
             currentState != Sonic.StateID.StateStompingLand &&
             currentState != Sonic.StateID.StateSquat)
    {
        isJumpStompSequence = false;
        isJumpStompLand = false;
    }
}

