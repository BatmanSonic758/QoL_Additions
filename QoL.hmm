Code "Show Trail" by "Batman Sonic"
//

#lib "GameObject"
#lib "Player"
#lib "BlackboardStatus"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "GameManager"

#import "GOComponents"
#import "PlayerVisuals"

static bool isConfigInitialized = false;
static int conJumpDashTrail = 0;
static int conRollAbility = 0;
static int conHammerStomp = 0;
static int conJumpDashAbility = 0;
static int conJumpDashAnimation = 0;
static int conJumpDashStyle = 0;

static float jumpDashActiveTimer = 0.0f;
static bool jumpDashUncurled = false;

static bool specialTrailActive = false;
static float specialTrailTimer = 0.0f;
static bool isInFadeMode = false;
static string currentActiveEffect = "";

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conJumpDashTrail = INI.GetField<int>(ini, "Main", "JumpDashTrail", conJumpDashTrail);
            conRollAbility = INI.GetField<int>(ini, "Main", "RollAbility", conRollAbility);
            conHammerStomp = INI.GetField<int>(ini, "Main", "HammerStomp", conHammerStomp);
            conJumpDashAbility = INI.GetField<int>(ini, "Main", "JumpDashAbility", conJumpDashAbility);
            conJumpDashAnimation = INI.GetField<int>(ini, "Main", "JumpDashAnimation", conJumpDashAnimation);
            conJumpDashStyle = INI.GetField<int>(ini, "Main", "JumpDashStyle", conJumpDashStyle);
            isConfigInitialized = true;
        }
    }

    if (conJumpDashTrail == 0)
        return;

    var playerType = Player.GetPlayerType();

    float deltaTime = Time.GetDeltaTime();

    if (specialTrailActive && specialTrailTimer < 1.0f && conJumpDashTrail == 1)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;
        if (isPaused)
            deltaTime = 0.0f;
    }

    bool isInTrailState = false;
    bool forceStopTrail = false;

    switch (playerType)
    {
        case Player.PlayerType.Sonic:
        {
            var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
            var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

            if (previousState == Sonic.StateID.StateSliding && currentState == Sonic.StateID.StateQuickStepJump)
                forceStopTrail = true;

            if (currentState == Sonic.StateID.StateHomingAttack ||
                currentState == Sonic.StateID.StateHomingAttackInStorm ||
                currentState == Sonic.StateID.StateLoopKick ||
                currentState == Sonic.StateID.StateDriftDash ||
                currentState == Sonic.StateID.StateDropDash ||
                currentState == Sonic.StateID.StateSpinBoost ||
                currentState == Sonic.StateID.StateSpin ||
                currentState == Sonic.StateID.StateQuickStepDoubleJump ||
                currentState == Sonic.StateID.StateLightDash ||
                currentState == Sonic.StateID.StateStompingDown)
            {
                isInTrailState = true;
            }
            else if (currentState == Sonic.StateID.StateSliding && conRollAbility != 1)
            {
                isInTrailState = true;
            }
            // Jump Dash
            else if (currentState == Sonic.StateID.StateRunawayBee && conJumpDashAbility == 1 && conJumpDashAnimation != 4 && !jumpDashUncurled)
            {
                isInTrailState = true;
            }

            // Jump Dash uncurl
            if (currentState == Sonic.StateID.StateRunawayBee && conJumpDashAbility == 1)
            {
                jumpDashActiveTimer += deltaTime;
                float uncurlThreshold = (conJumpDashStyle == 3) ? 0.3f : 0.4f;
                if (!jumpDashUncurled && jumpDashActiveTimer >= uncurlThreshold)
                    jumpDashUncurled = true;
            }
            else
            {
                jumpDashActiveTimer = 0.0f;
                jumpDashUncurled = false;
            }

            break;
        }

        case Player.PlayerType.Tails:
        {
            var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
            var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

            if (previousState == Tails.StateID.StateSliding && currentState == Tails.StateID.StateQuickStepJump)
                forceStopTrail = true;

            if (currentState == Tails.StateID.StateHomingAttack ||
                currentState == Tails.StateID.StateHomingAttackInStorm ||
                currentState == Tails.StateID.StateDriftDash ||
                currentState == Tails.StateID.StateDropDash ||
                currentState == Tails.StateID.StateSpinBoost ||
                currentState == Tails.StateID.StateSpin ||
                currentState == Tails.StateID.StateQuickStepDoubleJump)
            {
                isInTrailState = true;
            }
            else if (currentState == Tails.StateID.StateSliding && conRollAbility != 1)
            {
                isInTrailState = true;
            }

            break;
        }

        case Player.PlayerType.Knuckles:
        {
            var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
            var previousState = Player.State.GetPreviousStateID<Knuckles.StateID>();

            if (previousState == Knuckles.StateID.StateSliding && currentState == Knuckles.StateID.StateQuickStepJump)
                forceStopTrail = true;

            if (currentState == Knuckles.StateID.StateHomingAttack ||
                currentState == Knuckles.StateID.StateHomingAttackInStorm ||
                currentState == Knuckles.StateID.StateDriftDash ||
                currentState == Knuckles.StateID.StateDropDash ||
                currentState == Knuckles.StateID.StateSpinBoost ||
                currentState == Knuckles.StateID.StateSpin ||
                currentState == Knuckles.StateID.StateQuickStepDoubleJump ||
                currentState == Knuckles.StateID.KnucklesStateStompingDown)
            {
                isInTrailState = true;
            }
            else if (currentState == Knuckles.StateID.StateSliding && conRollAbility != 1)
            {
                isInTrailState = true;
            }

            break;
        }

        case Player.PlayerType.Amy:
        {
            var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
            var previousState = Player.State.GetPreviousStateID<Amy.StateID>();

            if (previousState == Amy.StateID.StateSliding && currentState == Amy.StateID.StateQuickStepJump)
                forceStopTrail = true;

            if (currentState == Amy.StateID.StateHomingAttack ||
                currentState == Amy.StateID.StateHomingAttackInStorm ||
                currentState == Amy.StateID.StateDriftDash ||
                currentState == Amy.StateID.StateDropDash ||
                currentState == Amy.StateID.StateSpinBoost ||
                currentState == Amy.StateID.StateSpin ||
                currentState == Amy.StateID.StateQuickStepDoubleJump ||
                currentState == Amy.StateID.StateLightDash)
            {
                isInTrailState = true;
            }
            else if (currentState == Amy.StateID.StateSliding && conRollAbility != 1)
            {
                isInTrailState = true;
            }
            else if (currentState == Amy.StateID.AmyStateStompingDown && conHammerStomp != 1)
            {
                isInTrailState = true;
            }

            break;
        }

        default:
            break;
    }

    bool isSuper = BlackboardStatus.IsSuper();
    bool isSuperSonic2 = false;

    if (playerType == Player.PlayerType.Sonic)
    {
        var data = Player.GetPlayerData();
        if (data != null)
        {
            var gocVisual = GameObject.GetGOC<GOCPlayerVisual>(&data->GameObject);
            if (gocVisual != null)
            {
                var visual = gocVisual->GetVisual<VisualSuperSonic>();
                if (visual != null)
                    isSuperSonic2 = visual->IsSuperSonic2;
            }
        }
    }

    string prefix = "";
    if (playerType == Player.PlayerType.Sonic)
    {
        if (isSuperSonic2) prefix = "ec_ss2_";
        else if (isSuper) prefix = "ec_ss_";
        else prefix = "ec_so_";
    }
    else if (playerType == Player.PlayerType.Tails) prefix = "ec_ta_";
    else if (playerType == Player.PlayerType.Knuckles) prefix = "ec_kn_";
    else if (playerType == Player.PlayerType.Amy) prefix = "ec_am_";

    string singleEffectName = prefix + "dash_trail01";

    // Crawling out of a slide shouldn't keep the slide's trail
    if (forceStopTrail && specialTrailActive)
    {
        Player.Effect.StopEffect("Trail");
        specialTrailActive = false;
        specialTrailTimer = 0.0f;
        isInFadeMode = false;
        currentActiveEffect = "";
    }

    // Short Trail
    if (conJumpDashTrail == 2 && !forceStopTrail)
    {
        if (isInTrailState && !string.IsNullOrEmpty(singleEffectName))
        {
            if (!specialTrailActive)
            {
                Player.Effect.PlayEffect("Trail", singleEffectName);
                specialTrailActive = true;
                isInFadeMode = false;
                currentActiveEffect = singleEffectName;
            }
            else if (currentActiveEffect != singleEffectName)
            {
                // Super transform can change the effect prefix mid-trail
                Player.Effect.StopEffect("Trail");
                Player.Effect.PlayEffect("Trail", singleEffectName);
                currentActiveEffect = singleEffectName;
            }
        }
        else if (specialTrailActive)
        {
            Player.Effect.StopEffect("Trail");
            specialTrailActive = false;
            isInFadeMode = false;
            currentActiveEffect = "";
        }
    }

    // Long Trail
    if (conJumpDashTrail == 1 && !forceStopTrail)
    {
        if (isInTrailState && !string.IsNullOrEmpty(singleEffectName))
        {
            if (!specialTrailActive)
            {
                Player.Effect.PlayEffect("Trail", singleEffectName);
                specialTrailActive = true;
                specialTrailTimer = 0.0f;
                isInFadeMode = false;
                currentActiveEffect = singleEffectName;
            }
            else if (isInFadeMode || currentActiveEffect != singleEffectName)
            {
                Player.Effect.StopEffect("Trail");
                Player.Effect.PlayEffect("Trail", singleEffectName);
                isInFadeMode = false;
                currentActiveEffect = singleEffectName;
            }
            specialTrailTimer = 0.0f;
        }
        else if (specialTrailActive)
        {
            specialTrailTimer += deltaTime;

            if (!string.IsNullOrEmpty(singleEffectName) && currentActiveEffect != singleEffectName)
            {
                Player.Effect.StopEffect("Trail");
                Player.Effect.PlayEffect("Trail", singleEffectName);
                currentActiveEffect = singleEffectName;
            }
            isInFadeMode = true;

            if (specialTrailTimer >= 1.0f)
            {
                Player.Effect.StopEffect("Trail");
                specialTrailActive = false;
                isInFadeMode = false;
                currentActiveEffect = "";
            }
        }
    }
}

Code "Jump Dash" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "SonicParameters"
#lib "Lua"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "GameManager"
#lib "BlackboardStatus"

#load "System.Numerics.dll"

using System.Numerics;

static bool wasInHomingDash = false;

const float dashTimer = 0.4f;
const float dashCurveTimer = 0.3f;
static float dashTimeElapsed = 0.0f;
static bool hasStartedHomingDashAnimation = false;
static bool hasPlayedSound = false;
static bool homingBall = false;

static float stateTransitionCooldown = 0.0f;
const float transitionCooldownTime = 0.1f;

static float recoveryTimer = 0.0f;
const float recoveryDuration = 0.5f;
static bool isInRecoveryState = false;

static bool isJumpDashInProgress = false;
static bool isInExitAnimation = false;
static float jumpDashSpeed = 40.0f;

static float doubleJumpDelayTimer = 0.0f;
const float doubleJumpDelay = 0.2f;
static bool isDoubleJumpDelayed = false;

static bool isConfigInitialized = false;
static int conJumpDashAnimation = 0;
static int conJumpDashExitAnimation = 0;
static int conJumpDashStyle = 0;
static int conJumpDashAbility = 0;
static int conJumpDashHoming = 0;
static int conBounceAttackAbility = 0;

static bool jumpDashRequiresHomingDisabled = false;
static bool jumpDashRequiresJumpDisabled = false;

static bool canJumpDashFromBounce = false;
static Sonic.StateID lastNonBounceState = Sonic.StateID.StateFall;

static bool canJumpDashFromSpinCharge = false;

static bool hasUsedJumpDash = false;
static bool hasUsedChainJumpDash = false;
static bool isChainJumpDashReady = false;

static Vector3 sa2InitialVelocity = Vector3.Zero;
static bool sa2StyleInitialized = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conJumpDashAnimation = INI.GetField<int>(ini, "Main", "JumpDashAnimation", conJumpDashAnimation);
            conJumpDashExitAnimation = INI.GetField<int>(ini, "Main", "JumpDashExitAnimation", conJumpDashExitAnimation);
            conJumpDashStyle = INI.GetField<int>(ini, "Main", "JumpDashStyle", conJumpDashStyle);
            conJumpDashAbility = INI.GetField<int>(ini, "Main", "JumpDashAbility", conJumpDashAbility);
            conJumpDashHoming = INI.GetField<int>(ini, "Main", "JumpDashHoming", conJumpDashHoming);
            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            isConfigInitialized = true;
        }
    }

    if (conJumpDashAbility != 1)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Sonic || BlackboardStatus.IsSuper())
        return;

    Lua.Init();

    bool needsPauseCheck = stateTransitionCooldown > 0 ||
                           recoveryTimer > 0 ||
                           dashTimeElapsed > 0 ||
                           doubleJumpDelayTimer > 0;

    float deltaTime = Time.GetDeltaTime();

    if (needsPauseCheck)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (isPaused)
            deltaTime = 0.0f;
    }

    bool isOutOfControl = IS_WORLD_FLAG(IsOutOfControl);
    bool isGrind = IS_STATE_FLAG(IsGrind);
    bool isDamage = IS_WORLD_FLAG(IsDamagedOrRepelled);
    bool isDiving = IS_STATE_FLAG(IsDiving);
    bool isDivingBoost = IS_STATE_FLAG(IsDivingBoost);

    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateRunawayBee, Sonic.StateID.StateFall);

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var pGameObject = Player.Status.GetLockOnTarget();
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float speed = Player.Kinematics.GetHorizontalMagnitude();

    if (stateTransitionCooldown > 0)
        stateTransitionCooldown -= deltaTime;

    if (recoveryTimer > 0)
        recoveryTimer -= deltaTime;

    // Double Jump delay after uncurling
    if (isDoubleJumpDelayed)
    {
        doubleJumpDelayTimer -= deltaTime;

        if (doubleJumpDelayTimer <= 0.0f)
        {
            Lua.Call("SetPlayerAbilityEnabled", "DoubleJump", true);
            isDoubleJumpDelayed = false;
        }
    }

    // Recovery state
    if (currentState == Sonic.StateID.StateHomingFinished)
    {
        if (!isInRecoveryState)
        {
            recoveryTimer = recoveryDuration;
            isInRecoveryState = true;
        }
    }
    else
    {
        isInRecoveryState = false;
    }

    if (Player.Status.IsGrounded())
    {
        hasUsedJumpDash = false;
        hasUsedChainJumpDash = false;
        isChainJumpDashReady = false;
        isDoubleJumpDelayed = false;
        doubleJumpDelayTimer = 0.0f;
    }

    // A homing hit, spring or rail starts a fresh airtime, so both dashes come back with it
    if (currentState == Sonic.StateID.StateHomingFinished || currentState == Sonic.StateID.StateSpringJump || isGrind)
    {
        hasUsedJumpDash = false;
        hasUsedChainJumpDash = false;
        isChainJumpDashReady = false;
    }

    // Only a chain move done after the free dash earns another one, otherwise jump into double jump would get two
    bool isChainMove = !Player.Status.IsGrounded() &&
                       (currentState == Sonic.StateID.StateAirBoost ||
                        currentState == Sonic.StateID.StateSpinBoostCharge ||
                        currentState == Sonic.StateID.StateParry ||
                        (conBounceAttackAbility == 1 &&
                         (currentState == Sonic.StateID.StateStompingDown || currentState == Sonic.StateID.StateStompingLand)));

    if (isChainMove && hasUsedJumpDash && !hasUsedChainJumpDash)
        isChainJumpDashReady = true;

    bool canJumpDashAgain = !hasUsedJumpDash || isChainJumpDashReady;

    // Bounce-attack eligibility
    if (currentState == Sonic.StateID.StateStompingDown && conBounceAttackAbility == 1)
    {
        if (previousState != Sonic.StateID.StateStompingDown &&
            previousState != Sonic.StateID.StateRunawayBee)
        {
            canJumpDashFromBounce = true;
            lastNonBounceState = previousState;
        }
    }
    else if (currentState != Sonic.StateID.StateStompingDown &&
             currentState != Sonic.StateID.StateRunawayBee)
    {
        canJumpDashFromBounce = false;
        lastNonBounceState = currentState;
    }

    bool inSpinChargeFallWindow = currentState == Sonic.StateID.StateFall &&
                                  previousState == Sonic.StateID.StateSpinBoostCharge;

    if (currentState == Sonic.StateID.StateSpinBoostCharge)
    {
        if (!canJumpDashFromSpinCharge)
            canJumpDashFromSpinCharge = true;
    }
    else if (currentState != Sonic.StateID.StateRunawayBee && !inSpinChargeFallWindow)
    {
        canJumpDashFromSpinCharge = false;
    }

    bool pursuitKickActive = currentState == Sonic.StateID.StateHomingFinished;

    if (isJumpDashInProgress && currentState != Sonic.StateID.StateRunawayBee)
    {
        wasInHomingDash = false;
        hasStartedHomingDashAnimation = false;
        hasPlayedSound = false;
        isJumpDashInProgress = false;
        dashTimeElapsed = 0.0f;
        isInExitAnimation = false;
        sa2StyleInitialized = false;

        if (homingBall && (conJumpDashAnimation == 1 || conJumpDashAnimation == 5))
        {
            Player.Effect.StopAnimationEffects();
            homingBall = false;
        }

        homingBall = false;

        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
    }

    // Disable aerial AcceleCombo
    if (currentState == Sonic.StateID.StateRunawayBee)
    {
        if (SonicParametersInfo.pData != null)
        {
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboMoveSonic.moveType, SonicParameters.ComboMoveType.None);
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboTable.root.transitExistTarget[0], SonicParameters.Action.Root);
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboTable.root.transitInAir[0], SonicParameters.Action.Root);
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboTable.root.transitNotExistTarget[0], SonicParameters.Action.Root);
        }

        jumpDashRequiresHomingDisabled = true;

        if (!pursuitKickActive)
            Lua.Call("SetPlayerAbilityEnabled", "HomingAttack", false);

        if (!hasStartedHomingDashAnimation)
        {
            Lua.Call("SetPlayerAbilityEnabled", "Jump", false);
            Lua.Call("SetPlayerAbilityEnabled", "DoubleJump", false);
            jumpDashRequiresJumpDisabled = true;
        }
    }
    else
    {
        var notExistTargetAction = Player.Status.IsGrounded() || pGameObject != null ? SonicParameters.Action.AcceleCombo1 : SonicParameters.Action.Root;

        if (SonicParametersInfo.pData != null)
        {
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboMoveSonic.moveType, SonicParameters.ComboMoveType.Homing);
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboTable.root.transitExistTarget[0], SonicParameters.Action.HomingAttack);
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboTable.root.transitInAir[0], SonicParameters.Action.AerialHomingAttack);
            RFL_SET_PARAM(SonicParametersInfo, common.combo.comboTable.root.transitNotExistTarget[0], notExistTargetAction);
        }

        if (jumpDashRequiresHomingDisabled)
        {
            if (!pursuitKickActive)
                Lua.Call("SetPlayerAbilityEnabled", "HomingAttack", true);

            jumpDashRequiresHomingDisabled = false;
        }

        if (jumpDashRequiresJumpDisabled)
        {
            Lua.Call("SetPlayerAbilityEnabled", "Jump", true);

            if (!isDoubleJumpDelayed)
                Lua.Call("SetPlayerAbilityEnabled", "DoubleJump", true);

            jumpDashRequiresJumpDisabled = false;
        }
    }

    if (!Player.Status.IsGrounded() &&
        !isDamage &&
        !isGrind &&
        isInExitAnimation &&
        conJumpDashExitAnimation == 1 &&
        speed < 20.0f)
    {
        Player.Animation.SetAnimation("FALL");
        isInExitAnimation = false;
    }

    bool canStartJumpDash = canJumpDashAgain &&
                            !Player.Status.IsGrounded() &&
                            !Player.Status.IsGroundedSpecial() &&
                            Player.Input.IsPressed(Player.InputActionType.PlayerAttack) &&
                            !Player.Status.IsLockOnCursorVisible() &&
                            !isGrind &&
                            !isDamage &&
                            !isOutOfControl &&
                            !isDiving &&
                            !isDivingBoost &&
                            !(currentState == Sonic.StateID.StateFall &&
                              (previousState == Sonic.StateID.StateHomingFinish ||
                               previousState == Sonic.StateID.StateSpinBoostCharge)) &&
                            currentState != Sonic.StateID.StateJumpBoardLaunch &&
                            currentState != Sonic.StateID.StateHomingAttack &&
                            currentState != Sonic.StateID.StateHomingAttackInStorm &&
                            currentState != Sonic.StateID.StateStompingDown &&
                            currentState != Sonic.StateID.StateSpinBoostCharge &&
                            currentState != Sonic.StateID.StateBreathe &&
                            currentState != Sonic.StateID.StateStorm &&
                            currentState != Sonic.StateID.StateCaught &&
                            currentState != Sonic.StateID.StateHangPole &&
                            currentState != Sonic.StateID.StateAvoid &&
                            currentState != Sonic.StateID.StateParry &&
                            currentState != Sonic.StateID.StateParryStand &&
                            currentState != Sonic.StateID.StateAirBoost &&
                            currentState != Sonic.StateID.StateAcceleCombo1 &&
                            currentState != Sonic.StateID.StateAcceleCombo2 &&
                            currentState != Sonic.StateID.StateHomingFinish &&
                            !isJumpDashInProgress &&
                            stateTransitionCooldown <= 0 &&
                            recoveryTimer <= 0;

    bool canStartBounceJumpDash = currentState == Sonic.StateID.StateStompingDown &&
                                  conBounceAttackAbility == 1 &&
                                  canJumpDashFromBounce &&
                                  canJumpDashAgain &&
                                  Player.Input.IsPressed(Player.InputActionType.PlayerAttack) &&
                                  !Player.Status.IsLockOnCursorVisible();

    bool canStartSpinChargeJumpDash = (currentState == Sonic.StateID.StateSpinBoostCharge ||
                                       inSpinChargeFallWindow) &&
                                      !Player.Status.IsGrounded() &&
                                      canJumpDashFromSpinCharge &&
                                      canJumpDashAgain &&
                                      Player.Input.IsPressed(Player.InputActionType.PlayerAttack) &&
                                      !Player.Status.IsLockOnCursorVisible();

    // Initiate Jump Dash
    if (canStartJumpDash || canStartBounceJumpDash || canStartSpinChargeJumpDash)
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRunawayBee);
        SET_WORLD_FLAG(IsAirTrick, false);

        // Bounce Attack's dive and bounce effects would otherwise keep playing under the dash
        Player.Effect.StopAnimationEffects();

        if (!hasUsedJumpDash)
            hasUsedJumpDash = true;
        else
            hasUsedChainJumpDash = true;

        isChainJumpDashReady = false;

        wasInHomingDash = true;
        hasStartedHomingDashAnimation = false;
        hasPlayedSound = false;
        isJumpDashInProgress = true;
        stateTransitionCooldown = transitionCooldownTime;
        dashTimeElapsed = 0.0f;
        isInExitAnimation = false;
        sa2StyleInitialized = false;
    }
    // Active Jump Dash
    else if (wasInHomingDash && currentState == Sonic.StateID.StateRunawayBee)
    {
        if (!hasPlayedSound)
        {
            Player.Sound.PlaySound("sn_homing");
            Lua.Call("PlayVoice", "sa1022");
            hasPlayedSound = true;
        }

        if (!hasStartedHomingDashAnimation)
        {
            switch (conJumpDashAnimation)
            {
                case 1:
                    if (!homingBall)
                    {
                        Player.Effect.PlayAnimationEffect("SPINJUMP");
                        homingBall = true;
                        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 1.0f);
                        Player.Collision.SetEntityCollision(false);
                    }
                    break;

                case 2:
                    Player.Animation.SetAnimation("JUMP_BALL");
                    Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 1.0f);
                    Player.Collision.SetEntityCollision(false);
                    break;

                case 5:
                    if (!homingBall)
                    {
                        Player.Effect.PlayAnimationEffect("SPIN_CHARGE");
                        homingBall = true;
                        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 1.0f);
                        Player.Collision.SetEntityCollision(false);
                    }
                    break;
            }
        }

        if (conJumpDashStyle == 3)
        {
            if (!sa2StyleInitialized)
            {
                sa2InitialVelocity = kinematics->Velocity;

                float currentSpeed = new Vector3(
                    sa2InitialVelocity.X,
                    0,
                    sa2InitialVelocity.Z
                ).Length();

                jumpDashSpeed = Math.Max(
                    Player.Status.IsSideView() ? 30.0f : 50.0f,
                    currentSpeed
                );

                sa2StyleInitialized = true;
            }

            Vector3 fwd = Player.Kinematics.GetForward();
            Vector3 hFwd = new Vector3(fwd.X, 0, fwd.Z);

            if (hFwd.Length() > 0.001f)
                hFwd = Vector3.Normalize(hFwd) * jumpDashSpeed;

            kinematics->Velocity = new Vector3(
                hFwd.X,
                kinematics->Velocity.Y,
                hFwd.Z
            );
        }
        else
        {
            jumpDashSpeed = Player.Status.IsSideView()
                ? (conJumpDashStyle == 2 ? 18.0f : 40.0f)
                : (conJumpDashStyle == 2 ? 25.0f : 55.0f);

            kinematics->Velocity = Player.Kinematics.GetForward() * jumpDashSpeed;
        }

        dashTimeElapsed += deltaTime;

        // Timer expired, uncurl / end of dash
        if (dashTimeElapsed >= (conJumpDashStyle == 3 ? dashCurveTimer : dashTimer))
        {
            switch (conJumpDashExitAnimation)
            {
                case 1:
                    Player.Animation.SetAnimation("FALL");
                    isInExitAnimation = true;
                    break;

                case 2:
                    Player.Animation.SetAnimation("FALL");
                    break;

                case 3:
                    Player.Animation.SetAnimation("ATTACK_BOUNCE");
                    break;
            }

            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);

            if ((conJumpDashAnimation == 1 || conJumpDashAnimation == 5) && homingBall)
            {
                Player.Effect.StopAnimationEffects();
                homingBall = false;
            }

            if (conJumpDashStyle != 3)
            {
                jumpDashSpeed -= 10.0f * deltaTime;
                jumpDashSpeed = Math.Max(jumpDashSpeed, 0.0f);
                kinematics->Velocity = Player.Kinematics.GetForward() * jumpDashSpeed;
            }

            Lua.Call("SetPlayerAbilityEnabled", "Jump", true);

            Lua.Call("SetPlayerAbilityEnabled", "DoubleJump", false);
            doubleJumpDelayTimer = doubleJumpDelay;
            isDoubleJumpDelayed = true;

            hasStartedHomingDashAnimation = true;
            wasInHomingDash = false;
            dashTimeElapsed = 0.0f;
            hasPlayedSound = false;
            sa2StyleInitialized = false;
        }
    }

    // Toggle Homing mid-dash
    if (conJumpDashHoming == 2 &&
        currentState == Sonic.StateID.StateRunawayBee &&
        Player.Status.IsLockOnCursorVisible() &&
        !hasStartedHomingDashAnimation &&
        dashTimeElapsed < (conJumpDashStyle == 3 ? dashCurveTimer : dashTimer))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHomingAttack);
    }
}

Code "Retain Horizontal Velocity from Stomp" by "Batman Sonic, WasifBoomz"
//

#include "BlackboardStatus" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "Time"
#lib "INI"
#lib "HMM"

#load "System.Numerics.dll"

using System.Numerics;

const float stompStopForce = 20.0f;
const float stompReleaseStopForce = 80.0f;
static Vector3 prevVelocity;

static bool isJumpStomp = false;

static bool isConfigInitialized = false;
static int conBounceAttackAbility = 0;
static int conHammerStomp = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            conHammerStomp = INI.GetField<int>(ini, "Main", "HammerStomp", conHammerStomp);
            isConfigInitialized = true;
        }
    }

    var playerType = Player.GetPlayerType();

    if (IS_WORLD_FLAG(IsAutoRun) || IS_WORLD_FLAG(IsOutOfControl))
        return;

    if (playerType != Player.PlayerType.Sonic && playerType != Player.PlayerType.Amy)
        return;

    if (playerType == Player.PlayerType.Sonic && conBounceAttackAbility != 2)
        return;

    if (playerType == Player.PlayerType.Amy && conHammerStomp == 1)
        return;

    var kinematics = Player.Kinematics.Get();
    if (kinematics == null)
        return;

    float yVel = kinematics->Velocity.Y;
    bool isStompDown = Player.Input.IsDown(Player.InputActionType.PlayerStomping);

    bool isStompingLand = false;
    bool isStompingDown = false;

    if (playerType == Player.PlayerType.Sonic)
    {
        isStompingLand = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateStompingLand;
        isStompingDown = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateStompingDown;
    }
    else if (playerType == Player.PlayerType.Amy)
    {
        isStompingLand = Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.AmyStateStompingLand;
        isStompingDown = Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.AmyStateStompingDown;
    }

    if (isStompingLand)
    {
        kinematics->Velocity = new Vector3(0, yVel, 0);
    }

    if (isStompingDown)
    {
        Vector3 horizVel = new Vector3(prevVelocity.X, 0, prevVelocity.Z);
        float dt = Time.GetDeltaTime();

        if (horizVel.Length() < stompStopForce * dt)
            kinematics->Velocity = new Vector3(0, yVel, 0);
        else
            kinematics->Velocity = Vector3.Normalize(horizVel) * (horizVel.Length() - ((isStompDown ? stompStopForce : stompReleaseStopForce) * dt)) + new Vector3(0, yVel, 0);
    }

    // Jump Stomp
    if (playerType == Player.PlayerType.Sonic &&
        Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateBounceJump &&
        Player.State.GetPreviousStateID<Sonic.StateID>() == Sonic.StateID.StateStompingLand)
    {
        if (!isJumpStomp)
        {
            kinematics->Velocity.Y = 25.0f;
            isJumpStomp = true;
        }
    }
    else
    {
        isJumpStomp = false;
    }

    prevVelocity = kinematics->Velocity;
}

Code "Retain Horizontal Velocity from Bounce Attack" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Memory"
#lib "VectorHelpers"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

#import "GOComponents"

#load "System.Numerics.dll"
using System.Numerics;

const float diveFallSpeed = -55.0f;
const float airAccel = 12.5f;
const float airTopSpeed = 30.0f;
const float airDrag = 20.0f;
const float airBrake = 45.0f;
const float turnRate = 3.0f;
const float brakeAngle = 2.35f;

static Vector3 lastVelocity;
static Vector3 diveVelocity;
static bool wasDiving = false;

static bool isConfigInitialized = false;
static int conBounceAttackAbility = 0;
static int conBounceAttackStyle = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            conBounceAttackStyle = INI.GetField<int>(ini, "Main", "BounceAttackStyle", conBounceAttackStyle);
            isConfigInitialized = true;
        }
    }

    if (conBounceAttackAbility == 2 || conBounceAttackStyle == 2 || conBounceAttackStyle == 3)
        return;

    if (IS_WORLD_FLAG(IsAutoRun) || IS_WORLD_FLAG(IsOutOfControl) || Player.GetPlayerType() != Player.PlayerType.Sonic)
    {
        wasDiving = false;
        return;
    }

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null || !Memory.TryGetPointer<GOCPlayerKinematicParams>(kinematics, out var pKinematics))
        return;

    bool isBounceDive = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateStompingDown && Player.State.GetPreviousStateID<Sonic.StateID>() != Sonic.StateID.StateStomping;

    if (!isBounceDive)
    {
        wasDiving = false;
        lastVelocity = pKinematics->Velocity;
        return;
    }

    // The dive state wipes horizontal speed, so take it from the frame before the dive started
    if (!wasDiving)
        diveVelocity = new Vector3(lastVelocity.X, 0, lastVelocity.Z);

    wasDiving = true;

    float dt = Time.GetDeltaTime();
    float speed = diveVelocity.Length();
    float facing;

    if (speed > 0.01f)
    {
        facing = (float)Math.Atan2(diveVelocity.X, diveVelocity.Z);
    }
    else
    {
        var forward = VectorHelpers.GetForward(pKinematics->Rotation);
        facing = (float)Math.Atan2(forward.X, forward.Z);
    }

    var input = pKinematics->WorldInput;
    input.Y = 0;

    if (input.LengthSquared() > 0.001f)
    {
        float inputAngle = (float)Math.Atan2(input.X, input.Z);
        float angleDiff = (float)Math.IEEERemainder(inputAngle - facing, 2.0 * Math.PI);

        if (Math.Abs(angleDiff) > brakeAngle && speed > 1.0f)
        {
            speed = Math.Max(0.0f, speed - airBrake * dt);
        }
        else
        {
            float maxTurn = turnRate * dt;
            facing += speed > 1.0f ? Math.Max(-maxTurn, Math.Min(maxTurn, angleDiff)) : angleDiff;

            // Boost speed carried into the dive is kept, but input alone can't push past normal air speed
            if (speed < airTopSpeed)
                speed = Math.Min(airTopSpeed, speed + airAccel * dt);
        }
    }
    else
    {
        speed = Math.Max(0.0f, speed - airDrag * dt);
    }

    diveVelocity = new Vector3((float)Math.Sin(facing) * speed, 0, (float)Math.Cos(facing) * speed);

    // Yaw only, otherwise leftover pitch and roll from the jump tilts Sonic sideways
    pKinematics->Rotation = Quaternion.CreateFromAxisAngle(Vector3.UnitY, facing);
    pKinematics->Velocity = new Vector3(diveVelocity.X, diveFallSpeed, diveVelocity.Z);
    lastVelocity = pKinematics->Velocity;
}

Code "Bounce Attack" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "INI"
#lib "HMM"
#lib "Resources"
#lib "Time"
#lib "GameManager"

static bool stompingBounceAnimation = false;
static bool stompingAnimation = false;
static bool stompingPressAnimation = false;
static bool bounceJumpEffect = false;
static bool stompingDownEffect = false;
static bool stompingLandEffect = false;
static bool thirdBounce = false;
static bool wasBouncing = false;

static bool isBounceAttackSound = false;
static bool isStompingBounceSound = false;
static int bounceAttackSoundHandle = 0;

static int bounceIndex = 0;

const float minBounceHeight = 15.0f;
const float midBounceHeight = 20.0f;
const float maxBounceHeight = 25.0f;

static bool isConfigInitialized = false;
static int conBounceAttackAbility = 0;
static int conBounceAttackAnimation = 0;
static int conBounceAttackStyle = 0;

static bool particleRedirectInit = false;

static bool pendingBounceJump = false;
static float grindJumpTimer = 0.0f;

const float grindJumpDelay = 0.2f;

static List<string> stompEffects = new()
{
    "ef_so_stomp_loop01",
    "ef_so_stomp_start01"
};

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            conBounceAttackAnimation = INI.GetField<int>(ini, "Main", "BounceAttackAnimation", conBounceAttackAnimation);
            conBounceAttackStyle = INI.GetField<int>(ini, "Main", "BounceAttackStyle", conBounceAttackStyle);
            isConfigInitialized = true;
        }
    }

    if (conBounceAttackAbility != 1 || BlackboardStatus.IsSuper())
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    string NotifyRedirectEffects(string resourceName, string resourceType)
    {
        if (resourceType != "ResEffect")
            return resourceName;

        if (stompEffects.Contains(resourceName))
            return "";

        return resourceName;
    }

    if (!particleRedirectInit)
    {
        Resources.AddResourceNotifyAction(NotifyRedirectEffects);
        particleRedirectInit = true;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool isGrounded = Player.Status.IsGrounded();
    bool isBounceJumpState = currentState == Sonic.StateID.StateBounceJump;
    bool isStompingDownState = currentState == Sonic.StateID.StateStompingDown;
    bool isStompingLandState = currentState == Sonic.StateID.StateStompingLand;
    bool isStompingBounceState = currentState == Sonic.StateID.StateStompingBounce;
    bool isStompingState = currentState == Sonic.StateID.StateStomping;
    bool isStompingPressState = currentState == Sonic.StateID.StateStompingPress;
    bool isGrindDoubleJumpState = currentState == Sonic.StateID.StateGrindDoubleJump;
    bool isDiveFromStomping = isStompingDownState && previousState == Sonic.StateID.StateStomping;

    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateStompingLand, Sonic.StateID.StateDoubleJump);
    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateStompingBounce, isDiveFromStomping ? Sonic.StateID.StateGrindDoubleJump : Sonic.StateID.StateBounceJump);

    if (isGrindDoubleJumpState && previousState == Sonic.StateID.StateStompingDown && !pendingBounceJump)
    {
        pendingBounceJump = true;
        grindJumpTimer = 0.0f;
    }

    if (pendingBounceJump)
    {
        // Leaving the grind jump early (homing, landing) cancels the delayed bounce
        if (!isGrindDoubleJumpState)
        {
            pendingBounceJump = false;
        }
        else
        {
            bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                            GameManager.GetGameObject("MapMenu") != null ||
                            GameManager.GetGameObject("PhotoMode") != null;

            if (!isPaused)
                grindJumpTimer += Time.GetDeltaTime();

            if (grindJumpTimer >= grindJumpDelay)
            {
                pendingBounceJump = false;
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateBounceJump);
            }
        }
    }

    // Jump Dash runs earlier in the frame and has already started its ball, stopping here would wipe it
    bool isJumpDashing = currentState == Sonic.StateID.StateRunawayBee;

    if (stompingDownEffect && !isStompingDownState && !thirdBounce)
    {
        if (!isJumpDashing)
            Player.Effect.StopAnimationEffects();

        stompingDownEffect = false;
    }

    if (bounceJumpEffect && !isBounceJumpState && !thirdBounce)
    {
        if (!isJumpDashing)
            Player.Effect.StopAnimationEffects();

        bounceJumpEffect = false;
    }

    if (stompingLandEffect && !isStompingLandState && !isStompingBounceState && !thirdBounce)
    {
        if (!isJumpDashing)
            Player.Effect.StopAnimationEffects();

        stompingLandEffect = false;
    }

    // Third bounce: uncurl instead of starting another bounce
    if (conBounceAttackStyle == 3 && isStompingLandState && bounceIndex == 3 && !thirdBounce)
    {
        if (isBounceAttackSound && bounceAttackSoundHandle != 0)
        {
            int soundHandle = bounceAttackSoundHandle;
            Player.Sound.StopSound(&soundHandle);
            bounceAttackSoundHandle = 0;
            isBounceAttackSound = false;
        }

        Player.Animation.SetAnimation("BOUND_START");
        Player.Effect.StopAnimationEffects();

        thirdBounce = true;
        wasBouncing = true;
    }

    // Once the third bounce uncurls, don't allow another bounce dive
    if (thirdBounce)
    {
        if (isGrounded && !isStompingLandState)
        {
            thirdBounce = false;
            wasBouncing = false;
            bounceIndex = 0;

            stompingBounceAnimation = false;
            stompingAnimation = false;
            stompingPressAnimation = false;
            bounceJumpEffect = false;
            stompingDownEffect = false;
            stompingLandEffect = false;
        }

        return;
    }

    if (isStompingLandState &&
        Player.Input.IsPressed(Player.InputActionType.PlayerStomping))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStompingDown);
    }

    if (conBounceAttackAnimation == 1 &&
        previousState == Sonic.StateID.StateStompingDown &&
        (IS_STATE_FLAG(IsGrind) ||
         IS_STATE_FLAG(IsSpringJump) ||
         currentState == Sonic.StateID.StateRun))
    {
        Player.Effect.StopAnimationEffects();

        stompingDownEffect = false;
        bounceJumpEffect = false;
        stompingLandEffect = false;
        stompingBounceAnimation = false;
    }

    if ((isStompingDownState || isStompingLandState) &&
        Player.Status.IsLockOnCursorVisible() &&
        Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHomingAttack);
        return;
    }

    if (isStompingLandState)
    {
        var kinematics = Player.Kinematics.Get();

        if (!wasBouncing && kinematics != null)
        {
            if (bounceIndex == 0)
                kinematics->Velocity.Y = minBounceHeight;
            else if (bounceIndex == 1)
                kinematics->Velocity.Y = midBounceHeight;
            else
                kinematics->Velocity.Y = maxBounceHeight;

            bounceIndex++;
            wasBouncing = true;
        }
    }
    else
    {
        wasBouncing = false;

        if (isGrounded)
            bounceIndex = 0;
    }

    // Bounce Attack spin sound
    if (isStompingLandState && previousState != Sonic.StateID.StateStompingLand)
    {
        if (!isBounceAttackSound && conBounceAttackAnimation == 1)
        {
            bounceAttackSoundHandle = Player.Sound.PlaySound("sn_spin");
            isBounceAttackSound = true;
        }
    }
    else if (!isStompingLandState && previousState == Sonic.StateID.StateStompingLand)
    {
        if (isBounceAttackSound && bounceAttackSoundHandle != 0)
        {
            int soundHandle = bounceAttackSoundHandle;
            Player.Sound.StopSound(&soundHandle);
            bounceAttackSoundHandle = 0;
        }

        isBounceAttackSound = false;
    }

    // Stomping Bounce spin sound
    if (isStompingBounceState && previousState != Sonic.StateID.StateStompingBounce)
    {
        if (!isStompingBounceSound && conBounceAttackAnimation == 1)
        {
            Player.Sound.PlaySound("sn_spin");
            isStompingBounceSound = true;
        }
    }
    else if (!isStompingBounceState && isStompingBounceSound)
    {
        int soundHandle = Player.Sound.PlaySound("sn_spin");
        Player.Sound.StopSound(&soundHandle);
        isStompingBounceSound = false;
    }

    if (!isGrounded && isBounceJumpState)
    {
        if (!bounceJumpEffect)
        {
            Player.Effect.PlayAnimationEffect("BOUND_END");
            bounceJumpEffect = true;
        }
    }
    else if (!isBounceJumpState)
    {
        bounceJumpEffect = false;
    }

    if (!isGrounded && isStompingDownState)
    {
        if (!stompingDownEffect)
        {
            if (conBounceAttackAnimation == 1)
            {
                Player.Effect.PlayAnimationEffect("BOUND");
            }
            else if (conBounceAttackAnimation == 2)
            {
                Player.Animation.SetAnimation("JUMP_BALL");
                Player.Effect.StopAnimationEffects();
            }

            stompingDownEffect = true;
        }
    }
    else if (!isStompingDownState)
    {
        stompingDownEffect = false;
    }

    if (isStompingLandState)
    {
        if (!stompingLandEffect)
        {
            Player.Sound.PlaySound("sn_bound_attack");
            Player.Sound.PlaySound("sn_windmill_kick");

            if (conBounceAttackAnimation == 1)
            {
                Player.Effect.PlayAnimationEffect("SPINJUMP");
            }
            else if (conBounceAttackAnimation == 2)
            {
                Player.Animation.SetAnimation("JUMP_BALL");
                Player.Effect.StopAnimationEffects();
            }

            stompingLandEffect = true;
        }
    }
    else
    {
        stompingLandEffect = false;
    }

    if (isStompingBounceState)
    {
        if (!stompingBounceAnimation)
        {
            if (conBounceAttackAnimation == 1)
            {
                Player.Effect.PlayAnimationEffect("SPINJUMP");
            }
            else if (conBounceAttackAnimation == 2)
            {
                Player.Animation.SetAnimation("JUMP_BALL");
                Player.Effect.StopAnimationEffects();
            }

            stompingBounceAnimation = true;
        }
    }
    else
    {
        stompingBounceAnimation = false;
    }

    if (isStompingState && conBounceAttackAnimation == 1)
    {
        if (!stompingAnimation)
        {
            Player.Effect.PlayAnimationEffect("SPINJUMP");
            stompingAnimation = true;
        }
    }
    else
    {
        stompingAnimation = false;
    }

    if (isStompingPressState)
    {
        if (!stompingPressAnimation)
        {
            if (conBounceAttackAnimation == 1)
            {
                Player.Effect.PlayAnimationEffect("BOUND_PRESS");
            }
            else if (conBounceAttackAnimation == 2)
            {
                Player.Animation.SetAnimation("JUMP_BALL");
                Player.Effect.StopAnimationEffects();
            }

            stompingPressAnimation = true;
        }
    }
    else
    {
        stompingPressAnimation = false;
    }
}

Code "Stomp Animations" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardStatus"
#lib "HMM"
#lib "INI"

using System;

static long AdrSTOMPING = 0;
static long AdrSTOMPINGSTART = 0;

static string writtenStartName = "";
static string writtenLoopName = "";

static bool isConfigInitialized = false;
static int conHammerStomp = 0;
static int conBounceAttackAbility = 0;
static int conBounceAttackAnimation = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conHammerStomp = INI.GetField<int>(ini, "Main", "HammerStomp", conHammerStomp);
            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            conBounceAttackAnimation = INI.GetField<int>(ini, "Main", "BounceAttackAnimation", conBounceAttackAnimation);
            isConfigInitialized = true;
        }
    }

    if (AdrSTOMPING == 0)
    {
        // 0x14152F838, leading NUL keeps the scan from matching the tail of a longer name
        long found = ScanSignature("\0STOMPING\0", "xxxxxxxxxx");

        if (found != 0)
            AdrSTOMPING = found + 1;
    }

    // 0x14152F800
    if (AdrSTOMPINGSTART == 0)
        AdrSTOMPINGSTART = ScanSignature("STOMPING_START\0", "xxxxxxxxxxxxxxx");

    if (AdrSTOMPING == 0 || AdrSTOMPINGSTART == 0)
        return;

    var playerType = Player.GetPlayerType();

    bool isBoundingStart = playerType == Player.PlayerType.Sonic &&
                           conBounceAttackAbility == 1 &&
                           conBounceAttackAnimation == 2 &&
                           !BlackboardStatus.IsSuper();

    bool isHammerStart = playerType == Player.PlayerType.Amy && conHammerStomp == 2;

    string startName = "STOMPING_START";

    if (isBoundingStart)
        startName = "BOUNDING_START";
    else if (isHammerStart)
        startName = "STOMPHAM_START";

    string loopName = isHammerStart ? "STOMPHAM" : "STOMPING";

    // The names only change with the character, config or Super, so there's no need to rewrite them every frame
    if (startName == writtenStartName && loopName == writtenLoopName)
        return;

    WriteProtected<byte>(AdrSTOMPINGSTART, System.Text.Encoding.UTF8.GetBytes(startName));
    WriteProtected<byte>(AdrSTOMPING, System.Text.Encoding.UTF8.GetBytes(loopName));

    writtenStartName = startName;
    writtenLoopName = loopName;
}

Code "Increased Cyhammer and Cyknuckle Range" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "KnucklesParameters"
#lib "AmyParameters"

{
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");

    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    var playerType = Player.GetPlayerType();

    if (playerType != Player.PlayerType.Amy && playerType != Player.PlayerType.Knuckles)
        return;

    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckle.activeRadius, 10.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckle.activeRadius, 10.0f);
    }

    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammer.radius, 10.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.cyHammer.radius, 10.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.airCyHammer.groundRadius, 10.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.airCyHammer.groundRadius, 10.0f);
    }

    if (KnucklesParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckle.activeRadius, 10.0f);
    }

    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, cyHammer.radius, 10.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, airCyHammer.groundRadius, 10.0f);
    }
}

Code "Fix Amy Skill Traversal" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "AmyParameters"

{
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;

    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.airCyHammer.deceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.airCyHammer.deceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.airCyHammer.overSpeedDeceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.airCyHammer.overSpeedDeceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.airCyHammer.rotationForce, 360.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.airCyHammer.rotationForce, 360.0f);

        RFL_SET_PARAM(AmyParametersInfo, forwardView.tarotAttack.speed.initial, 20.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.tarotAttack.speed.initial, 20.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.tarotAttack.speed.min, 15.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.tarotAttack.speed.min, 15.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.tarotAttack.speed.max, 20.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.tarotAttack.speed.max, 20.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.tarotAttack.speed.minTurn, 20.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.tarotAttack.speed.minTurn, 20.0f);

        RFL_SET_PARAM(AmyParametersInfo, forwardView.charmAttack.followSpeed, 120.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.charmAttack.followSpeed, 120.0f);
    }

    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, airCyHammer.deceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, airCyHammer.overSpeedDeceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, airCyHammer.rotationForce, 360.0f);

        RFL_SET_PARAM(AmyParametersCyberInfo, tarotAttack.speed.initial, 20.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, tarotAttack.speed.min, 15.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, tarotAttack.speed.max, 20.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, tarotAttack.speed.minTurn, 20.0f);

        RFL_SET_PARAM(AmyParametersCyberInfo, charmAttack.followSpeed, 120.0f);
    }
}

