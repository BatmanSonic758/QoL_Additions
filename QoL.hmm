Code "Squat Slide" by "Batman Sonic"
//

#lib "Player"

#load "System.Numerics.dll"

using System.Numerics;

const float squatForwardSpeed = 2.5f;
static bool isSquatVelocityApplied = false;

{
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (currentState == Sonic.StateID.StateSquat)
    {
        if (!isSquatVelocityApplied &&
            previousState == Sonic.StateID.StateStandRoot)
        {
            Vector3 forward = Player.Kinematics.GetForward();
            kinematics->Velocity += forward * squatForwardSpeed;
            isSquatVelocityApplied = true;
        }
    }
    else
    {
        isSquatVelocityApplied = false;
    }
}

Code "Jump off Squat" by "Batman Sonic"
//

#lib "Player"

{
    if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSquat &&
        Player.Input.IsPressed(Player.InputActionType.PlayerJump))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStandRoot);
    }
}

Code "Glide off Stomp" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "GameManager"

static float glideTimer = 0.0f;

{
    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();

    if (currentState == Knuckles.StateID.KnucklesStateStompingDown)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            glideTimer += Time.GetDeltaTime();

            if (glideTimer >= 0.2f &&
                Player.Input.IsDown(Player.InputActionType.PlayerJump))
            {
                Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateGliding);
            }
        }
    }
    else
    {
        glideTimer = 0.0f;
    }
}

Code "Fix Friends' Movesets" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "BlackboardStatus"
#lib "Player"

{
    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);

    if (Player.GetPlayerType() == Player.PlayerType.Sonic)
        return;

    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

    if (previousState == Tails.StateID.StateGuardedFlipBack &&
        currentState == Tails.StateID.StateAvoid)
    {
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateTakeBehind);
    }

    if (!isAutoRun && currentState == Tails.StateID.StateRun &&
        Player.Input.IsDown(Player.InputActionType.PlayerStomping))
    {
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateSliding);
    }

    // Tails, Knuckles and Amy don't have skateboard animations yet (or ever?), so they fall back to rolling instead
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateBoarding, Tails.StateID.StateDropDash);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateBoarding, Knuckles.StateID.StateDropDash);
    Player.State.Redirect<Amy.StateID>(Amy.StateID.StateBoarding, Amy.StateID.StateDropDash);
}

Code "Super Sonic Damage Ring Loss" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardItem"
#lib "BlackboardStatus"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static bool conSuperSonicHitRing = true;
static bool wasInDamageState = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "config.ini");
            var ini = INI.Read(modConfigIniPath);

            conSuperSonicHitRing = INI.GetField<bool>(ini, "Main", "SuperSonicHitRing", conSuperSonicHitRing);

            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Sonic || !BlackboardStatus.IsSuper() || !conSuperSonicHitRing)
    {
        wasInDamageState = false;
        return;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool isDamageState =
        currentState == Sonic.StateID.StateDamageBlowOffHeavy;

    if (isDamageState && !wasInDamageState)
    {
        var pBlackboardItem = BlackboardItem.Get();

        if (pBlackboardItem != null && pBlackboardItem->RingCount > 0)
        {
            int ringsToLose = 20;

            if (pBlackboardItem->RingCount < ringsToLose)
                ringsToLose = pBlackboardItem->RingCount;

            pBlackboardItem->RingCount -= ringsToLose;
            Player.Sound.PlaySound("obj_ringspread");
        }
    }

    wasInDamageState = isDamageState;
}

Code "Head Slide" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardItem"
#lib "Time"
#lib "GameManager"

static float slideTimer = 0.0f;
static float ringLossTimer = 0.0f;

{
    if (Player.GetPlayerType() != Player.PlayerType.Amy)
    {
        slideTimer = 0.0f;
        ringLossTimer = 0.0f;
        return;
    }

    var currentState = Player.State.GetCurrentStateID<Amy.StateID>();

    if (currentState == Amy.StateID.StateSliding)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            slideTimer += Time.GetDeltaTime();

            if (slideTimer >= 5.0f)
            {
                ringLossTimer += Time.GetDeltaTime();

                if (ringLossTimer >= 1.0f)
                {
                    ringLossTimer -= 1.0f;

                    var pBlackboardItem = BlackboardItem.Get();

                    if (pBlackboardItem != null && pBlackboardItem->RingCount > 0)
                    {
                        pBlackboardItem->RingCount -= 1;
                        Player.Sound.PlaySound("obj_ring_appear");
                    }
                }
            }
        }
    }
    else
    {
        slideTimer = 0.0f;
        ringLossTimer = 0.0f;
    }
}

Code "Friends' Abilities over Double Jump" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static int conFriendsDoubleJump = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conFriendsDoubleJump = INI.GetField<int>(ini, "Main", "FriendsDoubleJump", conFriendsDoubleJump);
            isConfigInitialized = true;
        }
    }

    if (conFriendsDoubleJump != 1)
        return;

    if (Player.GetPlayerType() == Player.PlayerType.Tails &&
        Player.State.GetCurrentStateID<Tails.StateID>() == Tails.StateID.StateDoubleJump)
    {
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateTailsFly);
    }

    if (Player.GetPlayerType() == Player.PlayerType.Knuckles &&
        Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.StateDoubleJump)
    {
        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateGliding);
    }

    if (Player.GetPlayerType() == Player.PlayerType.Amy &&
        Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.StateDoubleJump)
    {
        Player.State.SetState<Amy.StateID>(Amy.StateID.StatePropellerJump);
    }
}

Code "Disable Damage Recovery" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"

static bool wasDamaged = false;

{
    bool isDamage = IS_WORLD_FLAG(IsDamagedOrRepelled);

    // Restore also clears any redirect on these states, so they're only touched when the damage state flips
    if (isDamage == wasDamaged)
        return;

    wasDamaged = isDamage;

    if (isDamage)
    {
        Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateAvoid);
        Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateParry);
        Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateAirBoost);
        Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateStompingDown);

        Player.State.Discard<Tails.StateID>(Tails.StateID.StateAvoid);
        Player.State.Discard<Tails.StateID>(Tails.StateID.StateParry);
        Player.State.Discard<Tails.StateID>(Tails.StateID.StateAirBoost);
        Player.State.Discard<Tails.StateID>(Tails.StateID.TailsStateStompingDown);

        Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateAvoid);
        Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateParry);
        Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateAirBoost);
        Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.KnucklesStateStompingDown);

        Player.State.Discard<Amy.StateID>(Amy.StateID.StateAvoid);
        Player.State.Discard<Amy.StateID>(Amy.StateID.StateParry);
        Player.State.Discard<Amy.StateID>(Amy.StateID.StateAirBoost);
        Player.State.Discard<Amy.StateID>(Amy.StateID.AmyStateStompingDown);
    }
    else
    {
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateAvoid);
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateParry);
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateAirBoost);
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateStompingDown);

        Player.State.Restore<Tails.StateID>(Tails.StateID.StateAvoid);
        Player.State.Restore<Tails.StateID>(Tails.StateID.StateParry);
        Player.State.Restore<Tails.StateID>(Tails.StateID.StateAirBoost);
        Player.State.Restore<Tails.StateID>(Tails.StateID.TailsStateStompingDown);

        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.StateAvoid);
        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.StateParry);
        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.StateAirBoost);
        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.KnucklesStateStompingDown);

        Player.State.Restore<Amy.StateID>(Amy.StateID.StateAvoid);
        Player.State.Restore<Amy.StateID>(Amy.StateID.StateParry);
        Player.State.Restore<Amy.StateID>(Amy.StateID.StateAirBoost);
        Player.State.Restore<Amy.StateID>(Amy.StateID.AmyStateStompingDown);
    }
}

Patch "Disable Spin Move State" by "Batman Sonic"
//

#lib "Player"

{
    Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateSpinMove);
    Player.State.Discard<Tails.StateID>(Tails.StateID.StateSpinMove);
    Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateSpinMove);
    Player.State.Discard<Amy.StateID>(Amy.StateID.StateSpinMove);
}

Patch "Base Jump to Bounce Jump" by "Batman Sonic"
//

#lib "Player"

{
    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateBaseJump, Sonic.StateID.StateBounceJump);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateBaseJump, Knuckles.StateID.StateBounceJump);
}

Code "HE1-Style Jump" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Time"
#lib "Reflection"
#lib "INI"
#lib "HMM"
#lib "MathHelpers"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"

static bool properGrindJump = false;
static bool properCloudJump = false;
static bool properAttackBounce = false;
static bool properSpinJump = false;
static bool bounceEffect = false;
static bool isJumping = false;
static bool isHoldingJump = false;
static bool isLongJump = false;
static bool isVulnerable = true;

static float jumpHoldTime = 0.0f;
const float holdDuration = 0.12f;
const float jumpBallDelay = 0.11f;

const float shortHopVelocity = 3.5f;
const float shortHopSpeedBonus = 1.5f;
const float hurdleHopVelocity = 9.0f;

const float longJumpVelocity = 12.0f;
const float longJumpSpeedBonus = 2.0f;
const float minLongJumpVelocity = 7.0f;
const float maxLongJumpHoldTime = 1.0f;
static float activeLongJumpVelocity = 12.0f;
const float speedThreshold = 7.0f;

static bool isPendingLongJumpVelocity = false;
static float longJumpPressTime = 0.0f;

static bool isBounceCarryPending = false;
static float bounceCarryVelocity = 0.0f;

static bool isPendingGrindJumpVelocity = false;
static bool grindJumpLaunched = false;
static float grindJumpActiveVelocity = 12.0f;
const float grindJumpMaxHoldTime = 0.2f;
const float grindBounceHoldTime = 0.2f;

static float animationCooldown = 0.0f;
const float cooldownDuration = 0.3f;

static bool useRightHurdle = false;

static bool isSpinSoundPlaying = false;
static int spinSoundInstance = -1;

static int conJumpPlayer = 0;
static int conJumpSpinSound = 0;
static bool conHurdleLongJump = false;

static bool isConfigInitialized = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conJumpPlayer = INI.GetField<int>(ini, "Main", "JumpPlayer", conJumpPlayer);
            conJumpSpinSound = INI.GetField<int>(ini, "Main", "JumpSpinSound", conJumpSpinSound);
            conHurdleLongJump = INI.GetField<bool>(ini, "Main", "HurdleLongJump", conHurdleLongJump);
            isConfigInitialized = true;
        }
    }

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();
    var playerType = Player.GetPlayerType();

    float speed = Player.Kinematics.GetHorizontalMagnitude();

    bool isHighSpeed = speed >= speedThreshold;

    void StopSpinSound()
    {
        if (spinSoundInstance != -1)
        {
            int soundHandle = spinSoundInstance;
            Player.Sound.StopSound(&soundHandle);
        }

        isSpinSoundPlaying = false;
        spinSoundInstance = -1;
    }

    void TriggerSpinJump()
    {
        if (playerType != Player.PlayerType.Amy || conJumpPlayer == 2)
        {
            Player.Effect.PlayAnimationEffect("SPINJUMP");
            Player.Sound.PlaySound("sn_windmill_kick");

            if (conJumpSpinSound != 3 && !isSpinSoundPlaying)
            {
                spinSoundInstance = Player.Sound.PlaySound("sn_spin");
                isSpinSoundPlaying = true;
            }

            properSpinJump = true;
        }
    }

    string GetNextHurdleAnimation()
    {
        if (useRightHurdle)
        {
            useRightHurdle = false;
            return "HURDLE_R";
        }

        useRightHurdle = true;
        return "HURDLE_L";
    }

    bool transitionFromBallToJump = currentState == Sonic.StateID.StateJump &&
                                    (previousState == Sonic.StateID.StateSpin ||
                                    previousState == Sonic.StateID.StateDropDash ||
                                    previousState == Sonic.StateID.StateDriftDash ||
                                    previousState == Sonic.StateID.StateSpinBoost ||
                                    previousState == Sonic.StateID.StateSpinBoostCharge);

    if (transitionFromBallToJump)
    {
        if (!bounceEffect)
        {
            Player.Effect.PlayAnimationEffect("SPINJUMP");
            Player.Sound.PlaySound("sn_windmill_kick");
            bounceEffect = true;
        }
        return;
    }
    else
    {
        bounceEffect = false;
    }

    // Remove jump pre-animation
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.jump.preActionTime, 99.99f);
        RFL_SET_PARAM(SonicParametersInfo, water.jump.preActionTime, 99.99f);
    }

    if (TailsParametersInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.jump.preActionTime, 99.99f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.jump.preActionTime, 99.99f);
        RFL_SET_PARAM(TailsParametersInfo, water.jump.preActionTime, 99.99f);
    }

    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.jump.preActionTime, 99.99f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.jump.preActionTime, 99.99f);
        RFL_SET_PARAM(KnucklesParametersInfo, water.jump.preActionTime, 99.99f);
    }

    if (TailsParametersCyberInfo.pData != null)
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.jump.preActionTime, 99.99f);

    if (KnucklesParametersCyberInfo.pData != null)
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.jump.preActionTime, 99.99f);

    if (animationCooldown > 0.0f)
        animationCooldown -= Time.GetDeltaTime();

    if (currentState != Sonic.StateID.StateJump &&
        currentState != Sonic.StateID.StateGrindJump &&
        isSpinSoundPlaying)
    {
        StopSpinSound();
    }

    if (currentState != Sonic.StateID.StateJump &&
        currentState != Sonic.StateID.StateGrindJump &&
        currentState != Sonic.StateID.StateFall)
    {
        properGrindJump = false;
        properCloudJump = false;
        properAttackBounce = false;
        properSpinJump = false;
        isJumping = false;
        isHoldingJump = false;
        isLongJump = false;
        jumpHoldTime = 0.0f;
        isPendingLongJumpVelocity = false;
        longJumpPressTime = 0.0f;
        activeLongJumpVelocity = longJumpVelocity;
    }

    if (currentState != previousState)
        animationCooldown = 0.0f;

    // Air states set their own sphere, so the spin jump's damage is only handed back once grounded
    if (properSpinJump)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 2.0f);
        Player.Collision.SetEntityCollision(false);
        isVulnerable = false;
    }
    else if (!isVulnerable && Player.Status.IsGrounded())
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        isVulnerable = true;
    }

    if (Player.Input.IsDown(Player.InputActionType.PlayerJump) || Player.Input.IsPressed(Player.InputActionType.PlayerJump))
    {
        if (currentState == Sonic.StateID.StateJump)
        {
            if (!isJumping && animationCooldown <= 0.0f)
            {
                string animationToPlay = "";

                if (playerType == Player.PlayerType.Sonic)
                {
                    if (!conHurdleLongJump)
                    {
                        if (!properCloudJump)
                        {
                            animationToPlay = "JUMP_START";
                            properCloudJump = true;
                        }
                    }
                    else
                    {
                        if (isHighSpeed && !properGrindJump)
                        {
                            animationToPlay = GetNextHurdleAnimation();
                            properGrindJump = true;
                        }
                        else if (!properCloudJump)
                        {
                            animationToPlay = "JUMP_START";
                            properCloudJump = true;
                        }
                    }
                }
                else if (playerType == Player.PlayerType.Tails ||
                         playerType == Player.PlayerType.Knuckles)
                {
                    if (!conHurdleLongJump)
                    {
                        if (!properAttackBounce)
                        {
                            animationToPlay = "JUMP_START";
                            properAttackBounce = true;
                        }
                    }
                    else
                    {
                        if (isHighSpeed && !properGrindJump)
                        {
                            animationToPlay = GetNextHurdleAnimation();
                            properGrindJump = true;
                        }
                        else if (!properAttackBounce)
                        {
                            animationToPlay = "JUMP_START";
                            properAttackBounce = true;
                        }
                    }
                }
                else if (playerType == Player.PlayerType.Amy)
                {
                    if (conJumpPlayer == 1)
                    {
                        if (isHighSpeed && !properGrindJump)
                        {
                            animationToPlay = "JUMP_START";
                            properGrindJump = true;
                        }
                        else if (!properCloudJump)
                        {
                            animationToPlay = "JUMP_START";
                            properCloudJump = true;
                        }
                    }
                    else if (conJumpPlayer == 2)
                    {
                        if (!conHurdleLongJump)
                        {
                            if (!properAttackBounce)
                            {
                                animationToPlay = "JUMP_START_VIR01";
                                properAttackBounce = true;
                            }
                        }
                        else
                        {
                            if (isHighSpeed && !properGrindJump)
                            {
                                animationToPlay = GetNextHurdleAnimation();
                                properGrindJump = true;
                            }
                            else if (!properAttackBounce)
                            {
                                animationToPlay = "JUMP_START_VIR01";
                                properAttackBounce = true;
                            }
                        }
                    }
                }

                if (animationToPlay != "")
                {
                    Player.Animation.SetAnimation(animationToPlay);
                    animationCooldown = cooldownDuration;

                    bool isLongJumpAnim = animationToPlay == "JUMP_START" || animationToPlay == "JUMP_START_VIR01" ||
                                          animationToPlay == "HURDLE_L" || animationToPlay == "HURDLE_R";

                    if (isLongJumpAnim)
                    {
                        isLongJump = true;

                        if (previousState != Sonic.StateID.StateGrindJump)
                        {
                            activeLongJumpVelocity = MathHelpers.Clamp(
                                longJumpVelocity + (speed / speedThreshold) * longJumpSpeedBonus,
                                longJumpVelocity,
                                longJumpVelocity + longJumpSpeedBonus);

                            if (kinematics->Velocity.Y < activeLongJumpVelocity)
                                kinematics->Velocity.Y = activeLongJumpVelocity;

                            isPendingLongJumpVelocity = true;
                            longJumpPressTime = 0.0f;
                        }
                    }
                }

                isJumping = true;
                isHoldingJump = true;
                jumpHoldTime = 0.0f;
            }

            if (isHoldingJump && !properSpinJump && !isLongJump)
            {
                jumpHoldTime += Time.GetDeltaTime();
                if (jumpHoldTime >= jumpBallDelay)
                {
                    TriggerSpinJump();
                    isHoldingJump = false;
                    jumpHoldTime = 0.0f;
                }
            }
        }
    }
    else
    {
        if (currentState == Sonic.StateID.StateJump && isHoldingJump)
        {
            if (jumpHoldTime < holdDuration && animationCooldown <= 0.0f)
            {
                string animationToPlay = "";
                bool isHurdleHop = false;

                if (playerType == Player.PlayerType.Sonic ||
                    playerType == Player.PlayerType.Tails ||
                    playerType == Player.PlayerType.Knuckles)
                {
                    if (!conHurdleLongJump && isHighSpeed)
                    {
                        animationToPlay = GetNextHurdleAnimation();
                        isHurdleHop = true;
                    }
                    else if (!isHighSpeed)
                    {
                        animationToPlay = "JUMP_UP";
                    }
                }
                else if (playerType == Player.PlayerType.Amy)
                {
                    if (conJumpPlayer == 1)
                    {
                        animationToPlay = isHighSpeed ? "JUMP_START" : "JUMP_TOP";
                    }
                    else if (conJumpPlayer == 2)
                    {
                        if (!conHurdleLongJump && isHighSpeed)
                        {
                            animationToPlay = GetNextHurdleAnimation();
                            isHurdleHop = true;
                        }
                        else if (!isHighSpeed)
                        {
                            animationToPlay = "JUMP_TOP";
                        }
                    }
                }

                // Hurdle hops launch near full-jump height, normal hops stay low
                float hopCap = isHurdleHop ? hurdleHopVelocity : MathHelpers.Clamp(shortHopVelocity + (speed / speedThreshold) * shortHopSpeedBonus, shortHopVelocity, shortHopVelocity + shortHopSpeedBonus);

                if (kinematics->Velocity.Y > hopCap)
                    kinematics->Velocity.Y = hopCap;

                if (animationToPlay != "")
                {
                    Player.Animation.SetAnimation(animationToPlay);
                    animationCooldown = cooldownDuration;
                }

                isLongJump = false;
                isPendingLongJumpVelocity = false;
            }

            isHoldingJump = false;
            jumpHoldTime = 0.0f;
        }
    }

    // Long jump curls into the ball
    if (currentState == Sonic.StateID.StateJump && isLongJump && !properSpinJump)
    {
        jumpHoldTime += Time.GetDeltaTime();

        if (jumpHoldTime >= jumpBallDelay)
        {
            TriggerSpinJump();
            isLongJump = false;
            isHoldingJump = false;
            jumpHoldTime = 0.0f;
        }
    }

    // Release scales the long jump down
    if (currentState == Sonic.StateID.StateJump && isPendingLongJumpVelocity)
    {
        if (Player.Input.IsDown(Player.InputActionType.PlayerJump))
        {
            longJumpPressTime += Time.GetDeltaTime();

            if (longJumpPressTime >= maxLongJumpHoldTime)
                isPendingLongJumpVelocity = false;
        }
        else
        {
            float t = MathHelpers.Clamp((longJumpPressTime - holdDuration) / (maxLongJumpHoldTime - holdDuration), 0.0f, 1.0f);
            t = t * t * (3.0f - 2.0f * t);

            float scaledVelocity = minLongJumpVelocity + t * (activeLongJumpVelocity - minLongJumpVelocity);

            if (kinematics->Velocity.Y > scaledVelocity)
                kinematics->Velocity.Y = scaledVelocity;

            isPendingLongJumpVelocity = false;
        }
    }

    bool inBounceState = ((playerType == Player.PlayerType.Sonic ||
                         playerType == Player.PlayerType.Tails || playerType == Player.PlayerType.Knuckles) &&
                         currentState == Sonic.StateID.StateBounceJump) ||
                         (playerType == Player.PlayerType.Amy && conJumpPlayer == 2 && Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.StateGrindDoubleJump);

    if (inBounceState)
    {
        // Re-apply the carried height a frame in, once the bounce state has set its own
        if (isBounceCarryPending)
        {
            kinematics->Velocity.Y = bounceCarryVelocity;
            isBounceCarryPending = false;
        }
    }
    else if (currentState != Sonic.StateID.StateGrindJump)
    {
        isBounceCarryPending = false;
    }

    // Grind jump
    if (currentState == Sonic.StateID.StateGrindJump)
    {
        if (!grindJumpLaunched)
        {
            grindJumpActiveVelocity = MathHelpers.Clamp(longJumpVelocity + (speed / speedThreshold) * longJumpSpeedBonus, longJumpVelocity, longJumpVelocity + longJumpSpeedBonus);

            if (kinematics->Velocity.Y < grindJumpActiveVelocity)
                kinematics->Velocity.Y = grindJumpActiveVelocity;

            isPendingGrindJumpVelocity = true;
            grindJumpLaunched = true;
            jumpHoldTime = 0.0f;
        }

        if (Player.Input.IsDown(Player.InputActionType.PlayerJump) && !properSpinJump)
        {
            jumpHoldTime += Time.GetDeltaTime();

            if (jumpHoldTime >= grindBounceHoldTime)
            {
                if (playerType == Player.PlayerType.Sonic ||
                    playerType == Player.PlayerType.Tails ||
                    playerType == Player.PlayerType.Knuckles)
                {
                    Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateBounceJump);
                    Player.Sound.PlaySound("sn_windmill_kick");
                    kinematics->Velocity.Y += 7.0f;
                }
                else if (playerType == Player.PlayerType.Amy && conJumpPlayer == 2)
                {
                    Player.State.SetState<Amy.StateID>(Amy.StateID.StateGrindDoubleJump);
                    Player.Sound.PlaySound("sn_windmill_kick");
                    kinematics->Velocity.Y += 7.0f;
                }

                bounceCarryVelocity = kinematics->Velocity.Y;
                isBounceCarryPending = true;

                isPendingGrindJumpVelocity = false;
                properSpinJump = true;
                jumpHoldTime = 0.0f;
            }
        }
        else if (!Player.Input.IsDown(Player.InputActionType.PlayerJump))
        {
            if (isPendingGrindJumpVelocity)
            {
                float t = MathHelpers.Clamp((jumpHoldTime - holdDuration) / (grindJumpMaxHoldTime - holdDuration), 0.0f, 1.0f);
                t = t * t * (3.0f - 2.0f * t);

                float scaledVelocity = minLongJumpVelocity + t * (grindJumpActiveVelocity - minLongJumpVelocity);

                if (kinematics->Velocity.Y > scaledVelocity)
                    kinematics->Velocity.Y = scaledVelocity;

                isPendingGrindJumpVelocity = false;
            }

            isHoldingJump = false;
            jumpHoldTime = 0.0f;
        }
    }
    else
    {
        grindJumpLaunched = false;
        isPendingGrindJumpVelocity = false;
    }
}

Code "Air Trick Finisher" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Converse"
#lib "BlackboardItem"
#lib "Time"
#lib "GameManager"
#lib "Lua"
#lib "XInput"
#lib "BlackboardStatus"

#import "Plugins"

#load "System.Numerics.dll"

using System.Numerics;

static bool isFinish = false;
static float timer = 0.0f;
static int trickRings = 0;
static bool isTextRedirected = false;

static bool isSuccessVoicePlaying = false;
static bool isPartialVoicePlaying = false;

const float boostRefillSuccess = 15.0f;
const float boostRefillPartial = 8.0f;
const float dirDeadzone = 0.35f;

const float ringInterval = 0.144f;

static string[] successVoiceLines = new string[]
{
    "si1000_020", "si1000_021", "si1000_022", "si1000_023", "si1000_024",
    "si2000_020", "si2000_021", "si2000_022", "si2000_023", "si2000_024"
};

static string[] partialVoiceLines = new string[]
{
    "sa1039", "sa1040", "sa1041", "sa1051"
};

static Random random = new Random();

static string GetTrickDirection()
{
    if (XInput.GetState() == null)
        return "F";

    Vector2 stick = XInput.GetAnalog(0, true);
    float ax = Math.Abs(stick.X);
    float ay = Math.Abs(stick.Y);

    if (ax < dirDeadzone && ay < dirDeadzone)
        return "F";

    if (ay >= ax)
        return stick.Y >= 0.0f ? "F" : "B";

    return stick.X >= 0.0f ? "R" : "L";
}

{
    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    int maxRings = pBlackboardItem->RingCapacity;
    bool isTricking = IS_WORLD_FLAG(IsAirTrick);

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (!isTextRedirected)
    {
        Converse.Redirect("skill_07_explain", "Air Tricks can be performed when sparks surround Sonic while he is in the air. Perform Air Tricks to earn Skill Pieces.\nPress <image name=\"s_button_cyloop\" /> to gain extra Rings, Boost Energy, and Skill Pieces.");
        isTextRedirected = true;
    }

    // The friends share the air trick flag, but the finisher and its rewards are Sonic's
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
    {
        timer = 0.0f;
        trickRings = 0;
        return;
    }

    if (isTricking)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
            timer += Time.GetDeltaTime();

        if (timer >= ringInterval)
        {
            trickRings++;
            timer = 0.0f;
        }
    }
    else
    {
        timer = 0.0f;
    }

    if (isTricking && Player.Input.IsPressed(Player.InputActionType.PlayerCyloop) && !isFinish)
    {
        isFinish = true;
        Player.Sound.PlaySound("_sn_airtrick");

        SET_WORLD_FLAG(IsAirTrick, false);

        string dir = GetTrickDirection();

        if (dir == "F")
        {
            Player.Animation.SetAnimation(Player.Status.IsSideView() ? "JUMP_TRICK_FINISH_F_SV" : "JUMP_TRICK_FINISH_F");

            int bonusRings = Math.Max(2, trickRings / 2);
            pBlackboardItem->RingCount += trickRings + bonusRings;

            if (boostPlugin != null)
            {
                boostPlugin->BoostAmount += boostRefillSuccess;

                if (boostPlugin->BoostAmount > boostPlugin->BoostCapacity)
                    boostPlugin->BoostAmount = boostPlugin->BoostCapacity;
            }

            if (!isSuccessVoicePlaying)
            {
                Lua.Call("PlayVoice", successVoiceLines[random.Next(successVoiceLines.Length)]);
                Player.Sound.PlaySound("obj_superring");
                isSuccessVoicePlaying = true;
            }
        }
        else
        {
            string anim = dir == "L" ? "JUMP_TRICK_FINISH_L" : dir == "R" ? "JUMP_TRICK_FINISH_R" : "JUMP_TRICK_FINISH_B";

            Player.Animation.SetAnimation(anim);

            int reducedRings = Math.Max(1, trickRings / 2);
            pBlackboardItem->RingCount += reducedRings;

            if (boostPlugin != null)
            {
                boostPlugin->BoostAmount += boostRefillPartial;

                if (boostPlugin->BoostAmount > boostPlugin->BoostCapacity)
                    boostPlugin->BoostAmount = boostPlugin->BoostCapacity;
            }

            if (!isPartialVoicePlaying)
            {
                Lua.Call("PlayVoice", partialVoiceLines[random.Next(partialVoiceLines.Length)]);
                Player.Sound.PlaySound("obj_ring");
                isPartialVoicePlaying = true;
            }
        }

        trickRings = 0;
    }
    else if (!isTricking)
    {
        // A trick that ends without the finisher shouldn't hand its rings to the next one
        trickRings = 0;
        isFinish = false;
        isSuccessVoicePlaying = false;
        isPartialVoicePlaying = false;
    }

    if (pBlackboardItem->RingCount > maxRings)
        pBlackboardItem->RingCount = maxRings;
}

Code "Brake" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "Lua"
#lib "INI"
#lib "HMM"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"

static bool isBrakeSoundPlayed = false;
static bool isDust = false;
static bool isConfigInitialized = false;
static bool wasBraking = false;
static int conBrakeAbility = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBrakeAbility = INI.GetField<int>(ini, "Main", "BrakeAbility", conBrakeAbility);
            isConfigInitialized = true;
        }
    }

    if (conBrakeAbility != 1)
        return;

    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateBrakeNeutral, Sonic.StateID.StateSliding);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateBrakeNeutral, Tails.StateID.StateSliding);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateBrakeNeutral, Knuckles.StateID.StateSliding);
    Player.State.Redirect<Amy.StateID>(Amy.StateID.StateBrakeNeutral, Amy.StateID.StateSliding);

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float speed = Player.Kinematics.GetHorizontalMagnitude();

    if (currentState == Sonic.StateID.StateBrakeNeutral)
    {
        Player.Animation.SetAnimation("RUN_SLIP_FRONT_LOOP");

        if (!isBrakeSoundPlayed)
        {
            Lua.Call("PlayVoice", "sa1003");
            isBrakeSoundPlayed = true;
        }

        if (!isDust)
        {
            Player.Effect.PlayEffect("isDust", "ef_ft_spinboost_charge01_sa01");
            isDust = true;
        }

        if (SonicParametersInfo.pData != null)
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 200.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.sliding.deceleForceMax, 400.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 400.0f);

            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 5.0f);

            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 200.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.sliding.deceleJerkContinue, 400.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 400.0f);
        }

        if (TailsParametersInfo.pData != null)
        {
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 200.0f);
            RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 400.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 200.0f);
            RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 400.0f);
        }

        if (TailsParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.sliding.deceleForceMax, 400.0f);
            RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 400.0f);
        }

        if (KnucklesParametersInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 200.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 400.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 200.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 400.0f);
        }

        if (KnucklesParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.deceleForceMax, 400.0f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 400.0f);
        }

        if (AmyParametersInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 200.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 400.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 200.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 400.0f);
        }

        if (AmyParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleForceMax, 400.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 400.0f);
        }
    }
    else
    {
        isBrakeSoundPlayed = false;

        if (isDust)
        {
            Player.Effect.StopEffect("isDust");
            isDust = false;
        }
    }

    if (speed >= 30.0f && Player.Status.IsGrounded() &&
        currentState == Sonic.StateID.StateTurn)
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateBrakeNeutral);
    }

    if (wasBraking && currentState != Sonic.StateID.StateBrakeNeutral)
    {
        if (SonicParametersInfo.pData != null)
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 30.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.sliding.deceleForceMax, 30.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 30.0f);

            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.sliding.baseRotateForceSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 15.0f);

            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.sliding.deceleJerkContinue, 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 5.0f);
        }

        if (TailsParametersInfo.pData != null)
        {
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 2.0f);
            RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 2.0f);
        }

        if (TailsParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 2.0f);
        }

        if (KnucklesParametersInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 2.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 2.0f);
        }

        if (KnucklesParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 2.0f);
        }

        if (AmyParametersInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 2.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 2.0f);
        }

        if (AmyParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleForceMax, 1.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 2.0f);
        }
    }

    wasBraking = currentState == Sonic.StateID.StateBrakeNeutral;

    if (speed < 25.0f && Player.Status.IsGrounded() &&
        currentState == Sonic.StateID.StateBrakeNeutral)
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateBrake);
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateBrakeNeutral);
        Player.State.Restore<Tails.StateID>(Tails.StateID.StateBrakeNeutral);
        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.StateBrakeNeutral);
        Player.State.Restore<Amy.StateID>(Amy.StateID.StateBrakeNeutral);
    }

    if (!Player.Status.IsGrounded() &&
        currentState == Sonic.StateID.StateBrakeNeutral)
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateFall);
    }
