Code "Dynamic Character Names" by "Batman Sonic"
//

#lib "Converse"
#lib "Player"

static Player.PlayerType lastPlayerType = (Player.PlayerType)(-1);

{
    var playerType = Player.GetPlayerType();

    if (playerType == lastPlayerType)
        return;

    string playerName = "Sonic";
    string he = "he";
    string He = "He";
    string him = "him";
    string Him = "Him";
    string his = "his";
    string His = "His";

    if (playerType == Player.PlayerType.Amy)
    {
        playerName = "Amy";
        he = "she";
        He = "She";
        him = "her";
        Him = "Her";
        his = "her";
        His = "Her";
    }
    else if (playerType == Player.PlayerType.Tails)
    {
        playerName = "Tails";
    }
    else if (playerType == Player.PlayerType.Knuckles)
    {
        playerName = "Knuckles";
    }

    Converse.Redirect("menu_field_sa2_load_mtips2", $"{playerName}'s stats will depend on which save data is loaded.");
    Converse.Redirect("menu_cmn_op1ke_ScamAT_mtips", $"Set whether the camera will automatically turn in the direction {playerName} travels to");
    Converse.Redirect("menu_cmn_op1ke_soli_mtips", $"Set whether {playerName} can move when commenting on {his} surroundings");
    Converse.Redirect("obj_ilf_02puzzle_01detail", $"The pond in front of {playerName} has some kind of plug.\nAbove it, a chain is connected to a huge stopper stone.\nMaybe it'll move if something hits it with enough force.");
    Converse.Redirect("obj_ilf_quest_02_detail", $"Take all the Koco back to Knuckles. {playerName} can speed things up by carrying the Koco, but the TOWERs will also speed up.\n(Boosting and dodging are not available in this quest)");
    Converse.Redirect("tip_063_Steam", $"Chase down SQUID to defeat it! {playerName} can avoid the bullets by moving to the left or right.");
    Converse.Redirect("tip_021_PC", $"When holding down <image name=\"button_right_trigger_Wh\" /> while moving, {playerName} will boost in the direction {he} is running towards. Boosting consumes the boost meter.");
    Converse.Redirect("tip_005", $"Parrying is not contingent on timing.\nHold <image name=\"button_left_shoulder_Wh\" />+<image name=\"button_right_shoulder_Wh\" /> to Parry, and {playerName} will automatically repel attacks.");
    Converse.Redirect("tip_017", $"If {playerName} is thrown back by an attack, press <image name=\"button_bottom_Wh\" /> before {he} hits the ground. {playerName} will immediately counterattack with a Recovery Smash attack.");
