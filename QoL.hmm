Code "Initial Boost Drain" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Reflection"
#lib "Player"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

static float boostTime = 0.0f;
const float boostConsume = 0.05f;

static bool isConfigInitialized = false;
static int conLegacySpinDash = 0;

static List<Amy.StateID> bikeStates = new()
{
    Amy.StateID.AmyStateTarotBoostAir,
    Amy.StateID.AmyStateTarotBikeRoot,
    Amy.StateID.AmyStateTarotBuildRoot,
    Amy.StateID.AmyStateTarotBuild,
    Amy.StateID.AmyStateTarotBuildAir,
    Amy.StateID.AmyStateTarotBuildFall,
    Amy.StateID.AmyStateTarotBoostRoot,
    Amy.StateID.AmyStateTarotBoost,
    Amy.StateID.AmyStateTarotBoostTurn,
    Amy.StateID.AmyStateTarotBoostStep,
    Amy.StateID.AmyStateTarotBoostJump,
    Amy.StateID.AmyStateTarotBoostFall,
    Amy.StateID.AmyStateTarotDrift
};

static List<Tails.StateID> cycloneStates = new()
{
    Tails.StateID.StateCycloneBoostRoot,
    Tails.StateID.StateAirBoostCyclone,
    Tails.StateID.StateCycloneAppear,
    Tails.StateID.StateCycloneBoost,
    Tails.StateID.StateLeftStepCyclone,
    Tails.StateID.StateRightStepCyclone
};

static List<Knuckles.StateID> drillStates = new()
{
    Knuckles.StateID.KnucklesStateDrillBoostRoot,
    Knuckles.StateID.KnucklesStateDrillBoost,
    Knuckles.StateID.KnucklesStateDrillBoostJump,
    Knuckles.StateID.KnucklesStateDrillBoostFall,
    Knuckles.StateID.KnucklesStateDrillBoostStep,
    Knuckles.StateID.KnucklesStateDrillBoostAir
};

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            isConfigInitialized = true;
        }
    }

    if (!IS_STATE_FLAG(IsBoost))
        boostTime = 0.0f;
    else if (boostTime < boostConsume)
        boostTime += Time.GetDeltaTime();

    bool isPowerBoost = IS_WORLD_FLAG(IsPowerBoost);
    bool isSpinDash = conLegacySpinDash == 3 && Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSpinBoost;

    bool isBike = bikeStates.Contains(Player.State.GetCurrentStateID<Amy.StateID>());
    bool isCyclone = cycloneStates.Contains(Player.State.GetCurrentStateID<Tails.StateID>());
    bool isDrill = drillStates.Contains(Player.State.GetCurrentStateID<Knuckles.StateID>());

    // The first moments of a boost burn the gauge hard so tapping it isn't free
    float GetRate(bool isCharacterBoost, float characterRate, float spinDashRate, float normalRate)
    {
        if (boostTime < boostConsume)
            return 90.0f;

        if (isSpinDash)
            return spinDashRate;

        return isCharacterBoost ? characterRate : normalRate;
    }

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    if (SonicParametersInfo.pData != null)
    {
        float rate = GetRate(isPowerBoost, 7.5f, 11.25f, 5.0f);
        float cyberRate = GetRate(isPowerBoost, 11.7f, 20.25f, 9.0f);

        RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.boost.consumptionRate, rate);
        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.boost.consumptionRate, cyberRate);
        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.boost.consumptionRate, cyberRate);
    }

    if (TailsParametersInfo.pData != null)
    {
        float rate = GetRate(isCyclone, 16.0f, 11.25f, 5.0f);
        float cyberRate = GetRate(isCyclone, 23.2f, 20.25f, 9.0f);

        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.boost.consumptionRate, rate);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.boost.consumptionRate, cyberRate);
    }

    if (TailsParametersCyberInfo.pData != null)
    {
        float cyberRate = GetRate(isCyclone, 23.2f, 20.25f, 9.0f);
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.boost.consumptionRate, cyberRate);
    }

    if (KnucklesParametersInfo.pData != null)
    {
        float rate = GetRate(isDrill, 7.5f, 11.25f, 5.0f);
        float cyberRate = GetRate(isDrill, 11.7f, 20.25f, 9.0f);

        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.boost.consumptionRate, rate);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.boost.consumptionRate, cyberRate);
    }

    if (KnucklesParametersCyberInfo.pData != null)
    {
        float cyberRate = GetRate(isDrill, 11.7f, 20.25f, 9.0f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.boost.consumptionRate, cyberRate);
    }

    if (AmyParametersInfo.pData != null)
    {
        float rate = GetRate(isBike, 7.5f, 11.25f, 5.0f);
        float cyberRate = GetRate(isBike, 11.7f, 20.25f, 9.0f);

        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.boost.consumptionRate, rate);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.boost.consumptionRate, cyberRate);
    }

    if (AmyParametersCyberInfo.pData != null)
    {
        float cyberRate = GetRate(isBike, 11.7f, 20.25f, 9.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.boost.consumptionRate, cyberRate);
    }
}

Code "Fix Auto-Run Boost Animation" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "HMM"
#lib "INI"

static bool isConfigInitialized = false;
static int conCyberSpaceRun = 3;

static string previousAnimation = "";

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conCyberSpaceRun = INI.GetField<int>(ini, "Main", "CyberSpaceRun", conCyberSpaceRun);
            isConfigInitialized = true;
        }
    }

    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);
    bool isBattle = IS_WORLD_FLAG(IsBattle);
    bool isBoost = IS_STATE_FLAG(IsBoost);

    if (isAutoRun)
    {
        var state = Player.State.GetCurrentStateID<Sonic.StateID>();
        string animation = "";

        string runAnimation = conCyberSpaceRun switch
        {
            1 => "RUNNING_CYBER",
            2 => "RUNNING_CYBER_VIR01",
            3 => isBattle ? "RUNNING_BATTLE" : "RUNNING",
            _ => "RUNNING",
        };

        if (state == Sonic.StateID.StateRun)
        {
            if (isBoost)
            {
                if (conCyberSpaceRun == 1)
                    animation = "BOOST_CYBER";
                else if (conCyberSpaceRun == 3)
                    animation = "BOOST";
            }
            else
            {
                animation = runAnimation;
            }
        }
        else if (state == Sonic.StateID.StateDamageRunning)
        {
            animation = Player.Status.IsGrounded() ? "STUMBLE_RUN" : "STUMBLE_RUN_AIR";
        }

        if (animation != "" && animation != previousAnimation)
        {
            Player.Animation.SetAnimation(animation);
            previousAnimation = animation;
        }
    }
    else
    {
        previousAnimation = "";
    }
}

Code "Horizontal Momentum Preservation" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Time"

#load "System.Numerics.dll"

using System.Numerics;

const float topSpeed = 90.0f;
const float maxSpeed = 120.0f;
const float momentumBleed = 25.0f;
const float minCarrySpeed = 40.0f;

static Vector3 prevVelocity;
static bool wasBoostRun = false;

{
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    // Keep tracking while skipped, otherwise a stale speed gets carried back in afterwards
    if (BlackboardStatus.IsSuper() || IS_WORLD_FLAG(IsCyberSpace))
    {
        prevVelocity = kinematics->Velocity;
        wasBoostRun = false;
        return;
    }

    bool isBoostRun = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateRun && IS_STATE_FLAG(IsBoost);

    // Preserve horizontal momentum when entering Boost Run
    if (isBoostRun && !wasBoostRun)
    {
        float carried = new Vector3(prevVelocity.X, 0, prevVelocity.Z).Length();
        float current = new Vector3(kinematics->Velocity.X, 0, kinematics->Velocity.Z).Length();

        if (carried > current)
        {
            kinematics->Velocity.X = prevVelocity.X;
            kinematics->Velocity.Z = prevVelocity.Z;
        }
    }

    float speed = new Vector3(kinematics->Velocity.X, 0, kinematics->Velocity.Z).Length();
    float prevSpeed = new Vector3(prevVelocity.X, 0, prevVelocity.Z).Length();

    // Above the stock top speed, prevent from snapping speed down
    if (speed > topSpeed || prevSpeed > topSpeed)
    {
        float floorSpeed = prevSpeed - momentumBleed * Time.GetDeltaTime();

        if (floorSpeed < topSpeed)
            floorSpeed = topSpeed;

        if (speed < floorSpeed && speed > minCarrySpeed)
        {
            float scale = floorSpeed / speed;

            kinematics->Velocity.X *= scale;
            kinematics->Velocity.Z *= scale;

            speed = floorSpeed;
        }
    }

    if (speed > maxSpeed)
    {
        float scale = maxSpeed / speed;

        kinematics->Velocity.X *= scale;
        kinematics->Velocity.Z *= scale;
    }

    prevVelocity = kinematics->Velocity;
    wasBoostRun = isBoostRun;
}

Code "Combo Momentum Preservation" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardStatus"

#load "System.Numerics.dll"

using System.Numerics;

static Vector3 previousVelocity;
static bool initialized = false;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var currentAmyState = Player.State.GetCurrentStateID<Amy.StateID>();

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    if (BlackboardStatus.IsSuper())
    {
        previousVelocity = kinematics->Velocity;
        return;
    }

    bool isSonicStates = currentState == Sonic.StateID.StateAcceleCombo1 ||
                         currentState == Sonic.StateID.StateAcceleCombo2 ||
                         currentState == Sonic.StateID.StateHomingFinish;

    bool isAmyStates = currentAmyState == Amy.StateID.StateTarotAttack ||
                       currentAmyState == Amy.StateID.StateTarotAttack2 ||
                       currentAmyState == Amy.StateID.AmyStateTarotRollingRoot ||
                       currentAmyState == Amy.StateID.AmyStateTarotRolling ||
                       currentAmyState == Amy.StateID.AmyStateTarotRollingJump ||
                       currentAmyState == Amy.StateID.AmyStateTarotRollingFall;

    if (!isSonicStates && !isAmyStates)
    {
        previousVelocity = kinematics->Velocity;
        initialized = true;
        return;
    }

    Vector3 currentVelocity = kinematics->Velocity;

    if (!initialized)
    {
        previousVelocity = currentVelocity;
        initialized = true;
        return;
    }

    Vector3 previousHorizontal = new Vector3(previousVelocity.X, 0.0f, previousVelocity.Z);
    Vector3 currentHorizontal = new Vector3(currentVelocity.X, 0.0f, currentVelocity.Z);

    float previousSpeed = previousHorizontal.Length();
    float currentSpeed = currentHorizontal.Length();

    if (previousSpeed > 0.0f && currentSpeed < previousSpeed)
    {
        float velocityLoss = previousSpeed - currentSpeed;

        if (velocityLoss > 5.0f)
        {
            Vector3 direction;

            if (currentSpeed > 0.001f)
                direction = Vector3.Normalize(currentHorizontal);
            else
                direction = Vector3.Normalize(previousHorizontal);

            kinematics->Velocity.X = direction.X * previousSpeed;
            kinematics->Velocity.Z = direction.Z * previousSpeed;
        }
    }

    previousVelocity = kinematics->Velocity;
}

Code "Consistent Physics - Animations" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Reflection"
#lib "BlackboardStatus"
#lib "SonicParameters"
#lib "Player"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static int conCyberSpaceRun = 3;

static bool wasSpecialMode = false;
static string currentAnim = "";

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conCyberSpaceRun = INI.GetField<int>(ini, "Main", "CyberSpaceRun", conCyberSpaceRun);
            isConfigInitialized = true;
        }
    }

    bool isBoost = IS_STATE_FLAG(IsBoost);
    bool isGrinding = IS_STATE_FLAG(IsGrind);
    bool isCyberSpace = IS_WORLD_FLAG(IsCyberSpace);

    float cyberBoostInitial = isGrinding ? 70.0f : conCyberSpaceRun == 3 ? 9999.0f : 22.0f;
    float islandBoostInitial = isGrinding ? 70.0f : conCyberSpaceRun == 3 ? 45.0f : 22.0f;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var currentPlayer = Player.GetPlayerType();

    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);
    bool isBattle = IS_WORLD_FLAG(IsBattle);
    bool isSpecialMode = isAutoRun || isBattle;

    void SetAnim(string animName)
    {
        if (animName != currentAnim)
        {
            Player.Animation.SetAnimation(animName);
            currentAnim = animName;
        }
    }

    if (currentPlayer == Player.PlayerType.Sonic)
    {
        // Auto-Run and Battle have their own animation codes, and leaving them needs a fresh pick.
        // Config 1 and 2 use Sonic's Cyber animations everywhere, config 3 only swaps to RUNNING / BOOST in Cyber Space.
        if (isSpecialMode || wasSpecialMode || currentState != Sonic.StateID.StateRun)
        {
            currentAnim = "";
        }
        else if (conCyberSpaceRun == 1)
        {
            SetAnim(isBoost ? "BOOST_CYBER" : "RUNNING_CYBER");
        }
        else if (conCyberSpaceRun == 2)
        {
            SetAnim("RUNNING_CYBER_VIR01");
        }
        else if (conCyberSpaceRun == 3 && isCyberSpace)
        {
            SetAnim(isBoost ? "BOOST" : "RUNNING");
        }
        else
        {
            currentAnim = "";
        }

        wasSpecialMode = isSpecialMode;
    }
    else
    {
        // The friends' run and boost only need replacing in Cyber Space
        if (isCyberSpace && currentState == Sonic.StateID.StateRun)
        {
            if (currentPlayer == Player.PlayerType.Tails)
                SetAnim(isBoost ? "TAILS_BOOST" : "TAILS_RUN");
            else
                SetAnim(isBoost ? "BOOST" : "RUNNING");
        }
        else
        {
            currentAnim = "";
        }

        wasSpecialMode = false;
    }

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");

    if (SonicParametersInfo.pData != null)
    {
        if (IS_WORLD_FLAG(IsAutoRun))
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boost.initial, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boost2.initial, 30.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boostLvMax.initial, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boostLvMax2.initial, 60.0f);
        }
        else
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boost.initial, islandBoostInitial);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boost2.initial, islandBoostInitial);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boostLvMax.initial, islandBoostInitial);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.speed.boostLvMax2.initial, islandBoostInitial);
        }

        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.speed.boost.initial, cyberBoostInitial);
        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.speed.boost2.initial, cyberBoostInitial);
        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.speed.boostLvMax.initial, cyberBoostInitial);
        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.speed.boostLvMax2.initial, cyberBoostInitial);

        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.speed.boost.initial, cyberBoostInitial);
        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.speed.boost2.initial, cyberBoostInitial);
        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.speed.boostLvMax.initial, cyberBoostInitial);
        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.speed.boostLvMax2.initial, cyberBoostInitial);
    }
}

Code "Consistent Physics - Running Start" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static int conCyberSpaceRun = 3;

static bool isRunCyberAnimation = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conCyberSpaceRun = INI.GetField<int>(ini, "Main", "CyberSpaceRun", conCyberSpaceRun);
            isConfigInitialized = true;
        }
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (Player.GetPlayerType() == Player.PlayerType.Sonic)
    {
        if (currentState == Sonic.StateID.StateRunningStart)
        {
            string runAnim = conCyberSpaceRun switch
            {
                1 => "RUNNING_CYBER",
                2 => "RUNNING_CYBER_VIR01",
                _ => "RUNNING",
            };

            if (!isRunCyberAnimation)
            {
                Player.Animation.SetAnimation(runAnim);
                isRunCyberAnimation = true;
            }
        }
        else
        {
            isRunCyberAnimation = false;
        }
    }
    else
    {
        isRunCyberAnimation = false;
    }
}

Code "Consistent Physics - Running Battle" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

static bool isConfigInitialized = false;
static int conCyberSpaceRun = 3;

static bool isRunCyberAnimation = false;
static bool isBoostAnimation = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conCyberSpaceRun = INI.GetField<int>(ini, "Main", "CyberSpaceRun", conCyberSpaceRun);
            isConfigInitialized = true;
        }
    }

    if (conCyberSpaceRun == 3)
    {
        isRunCyberAnimation = false;
        isBoostAnimation = false;
        return;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (Player.GetPlayerType() == Player.PlayerType.Sonic && IS_WORLD_FLAG(IsBattle))
    {
        if (currentState == Sonic.StateID.StateRun)
        {
            if (IS_STATE_FLAG(IsBoost) && conCyberSpaceRun == 1)
            {
                if (!isBoostAnimation)
                {
                    Player.Animation.SetAnimation("BOOST_CYBER");

                    isBoostAnimation = true;
                    isRunCyberAnimation = false;
                }
            }
            else
            {
                string runAnim = conCyberSpaceRun == 1 ? "RUNNING_CYBER" : "RUNNING_CYBER_VIR01";

                if (!isRunCyberAnimation || isBoostAnimation)
                {
                    Player.Animation.SetAnimation(runAnim);

                    isRunCyberAnimation = true;
                    isBoostAnimation = false;
                }
            }
        }
        else
        {
            isRunCyberAnimation = false;
            isBoostAnimation = false;
        }
    }
    else
    {
        isRunCyberAnimation = false;
        isBoostAnimation = false;
    }
}

