Code "Spin Dash Skill" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Player"
#lib "HMM"
#lib "INI"
#lib "Reflection"
#lib "GameSkillParameter"
#lib "BlackboardStatus"

static bool isConfigInitialized = false;
static int conLegacySpinDash = 0;
static int conDrift = 0;
static int conDriftInput = 0;

static bool hasCheckedCodes = false;
static bool isAlwaysUnlockedSpinDashEnabled = false;

static bool isSpinDashUnlocked = false;
static bool hasSetAutoCombo = false;
static bool lastAutoCombo = false;

static bool heldSpinDash = false;
static bool hasHeldSpinDash = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            conDrift = INI.GetField<int>(ini, "Main", "Drift", conDrift);
            conDriftInput = INI.GetField<int>(ini, "Main", "DriftInput", conDriftInput);
            isConfigInitialized = true;
        }
    }

    if (!hasCheckedCodes)
    {
        var codes = HMM.GetCodes();
        isAlwaysUnlockedSpinDashEnabled = codes.Contains("Cheats/Skills/Always Unlocked Spin Dash");
        hasCheckedCodes = true;
    }

    var GameSkillParameterInfo = Reflection.GetDataInfo<GameSkillParameter.Root>("skill");

    if (GameSkillParameterInfo.pData != null)
        RFL_SET_PARAM(GameSkillParameterInfo, skillParams[14].unlockPoint, 40);

    var playerType = Player.GetPlayerType();
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool isCyberSpace = IS_WORLD_FLAG(IsCyberSpace);
    bool isManualDrift = conDrift == 1 || (conDrift == 2 && isCyberSpace) || (conDrift == 3 && !isCyberSpace);
    bool isDriftOnLT = playerType == Player.PlayerType.Sonic && isManualDrift && conDriftInput == 4;

    if (conLegacySpinDash == 3)
    {
        // Loading a save brings its own Auto Combo back, so it gets read again once there's a player
        if (Player.GetPlayerData() == null)
        {
            hasSetAutoCombo = false;
            return;
        }

        bool isStomping = currentState == Sonic.StateID.StateStompingDown ||
                          Player.State.GetCurrentStateID<Tails.StateID>() == Tails.StateID.TailsStateStompingDown ||
                          Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.KnucklesStateStompingDown ||
                          Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.AmyStateStompingDown;

        // The friends don't have a Spin Dash skill to unlock
        if (playerType != Player.PlayerType.Sonic)
        {
            if (IS_COMBAT_FLAG(IsSpinDash) == isStomping)
                SET_COMBAT_FLAG(IsSpinDash, !isStomping);

            return;
        }

        bool isAutoCombo = IS_COMBAT_FLAG(IsAutoCombo);

        // Spin Dash sits on the Auto Combo node, and since Auto Combo gets written here too, only a change from the game counts as the unlock
        if (!hasSetAutoCombo || isAutoCombo != lastAutoCombo)
            isSpinDashUnlocked = isAutoCombo;

        bool isDrifting = isDriftOnLT && (currentState == Sonic.StateID.StateRun || currentState == Sonic.StateID.StateDrift);
        bool canSpinDash = (isAlwaysUnlockedSpinDashEnabled || isSpinDashUnlocked) && !isStomping && !isDrifting;

        if (isAutoCombo != canSpinDash)
            SET_COMBAT_FLAG(IsAutoCombo, canSpinDash);

        if (IS_COMBAT_FLAG(IsSpinDash) != canSpinDash)
            SET_COMBAT_FLAG(IsSpinDash, canSpinDash);

        hasSetAutoCombo = true;
        lastAutoCombo = canSpinDash;
        return;
    }

    if (conLegacySpinDash != 1 && conLegacySpinDash != 2 && !isDriftOnLT)
        return;

    // Running and stomping give LT to the squat charge or the drift, squatting or jumping gives it back, anything else keeps the last one
    if (currentState == Sonic.StateID.StateStompingDown ||
        currentState == Sonic.StateID.StateRun ||
        (isDriftOnLT && currentState == Sonic.StateID.StateDrift))
    {
        heldSpinDash = false;
        hasHeldSpinDash = true;
    }
    else if (currentState == Sonic.StateID.StateSquat || !Player.Status.IsGrounded())
    {
        heldSpinDash = true;
        hasHeldSpinDash = true;
    }

    if (!hasHeldSpinDash)
        return;

    if (IS_COMBAT_FLAG(IsSpinDash) != heldSpinDash)
        SET_COMBAT_FLAG(IsSpinDash, heldSpinDash);

    if (IS_COMBAT_FLAG(IsAutoCombo) != heldSpinDash)
        SET_COMBAT_FLAG(IsAutoCombo, heldSpinDash);
}

Patch "Spin Dash Skill Text" by "Batman Sonic"
//

#lib "Converse"
#lib "HMM"
#lib "INI"

{
    int conDriftInput = 0;

    var modsQuery = HMM.FindModsByName("Quality of Life Additions");

    if (modsQuery.Count == 1)
    {
        string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conDriftInput = INI.GetField<int>(ini, "Main", "DriftInput", conDriftInput);
    }

    Converse.Redirect("tu1000dlc_160", "Congratulations!");
    Converse.Redirect("tu1000dlc_165", "You achieved an S rank in every Action Chain Challenge.\nYour skill, speed, and precision are unmatched!");
    Converse.Redirect("tu1000dlc_166", "Congratulations!\nYou achieved an S rank in every Action Chain Challenge.\nYour skill, speed, and precision are unmatched!");

    Converse.Redirect("skill_15_name", "Spin Dash");
    Converse.Redirect("skill_15_command", "Hold <image name=\"button_right\" /> → <image name=\"button_left_trigger\" /> → Release <image name=\"button_right\" />");

    // Drift on LT, Sonic can't Spin Dash while running
    if (conDriftInput == 4)
        Converse.Redirect("skill_15_explain", "Press <image name=\"button_left_trigger\" /> while in midair to roll into a ball form and run over enemies to deal damage.");
    else
        Converse.Redirect("skill_15_explain", "Press <image name=\"button_left_trigger\" /> while running or in midair to roll into a ball form and run over enemies to deal damage.");
}

Code "Customizable Air Boost Physics" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"
#lib "INI"
#lib "HMM"
#lib "Reflection"

static bool isConfigInitialized = false;
static int conAirBoostPhysics = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conAirBoostPhysics = INI.GetField<int>(ini, "Main", "AirBoostPhysics", conAirBoostPhysics);
            isConfigInitialized = true;
        }
    }

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    // Sonic Forces
    if (conAirBoostPhysics == 2)
    {
        // Sonic
        if (SonicParametersInfo.pData != null)
        {
