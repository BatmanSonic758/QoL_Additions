Code "Consistent Physics - Amy" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Reflection"
#lib "BlackboardStatus"
#lib "AmyParameters"

{
    bool isGrinding = IS_STATE_FLAG(IsGrind);
    bool isNitroBoost = IS_WORLD_FLAG(IsNitroBoost);

    float forwardViewMaxSpeedOver = isGrinding ? 90.0f : 9999.0f;
    float cyberBoostInitialFriends = isGrinding ? 70.0f : 9999.0f;

    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    if (AmyParametersInfo.pData != null)
    {
        // Open Zone
        if (IS_WORLD_FLAG(IsAutoRun))
        {
            // Scripted auto-run sections are built around vanilla speeds
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.speed.normal.max, 15.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.speed.normal2.max, 15.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.speed.boost.initial, 20.0f);
