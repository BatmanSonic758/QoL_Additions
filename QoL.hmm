{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conSA2ShoesName = INI.GetField<int>(ini, "Main", "SA2ShoesName", conSA2ShoesName);
            isConfigInitialized = true;
        }
    }

    if (isInitialized)
        return;

    Converse.Redirect("tu1000dlc_170", "Elite Frontier");

    switch (conSA2ShoesName)
    {
        case 1:
            Converse.Redirect("extra_item_1_choice_8", "SOAP Shoes");
            break;

        case 2:
            Converse.Redirect("extra_item_1_choice_8", "2G Hi-Speed Shoes");
            break;

        case 3:
            Converse.Redirect("extra_item_1_choice_8", "Grind Shoes");
            break;

        case 4:
            Converse.Redirect("extra_item_1_choice_8", "Sonic Adventure 2 Shoes");
            break;

        default:
            Converse.Redirect("extra_item_1_choice_8", "Sonic Adventure 2 Shoes");
            break;
    }

    Converse.Redirect("extra_item_1_choice_10", "Sonic's Birthday Bash");
    Converse.Redirect("extra_item_3", "Sound Effects");
    Converse.Redirect("extra_item_9", "Friends Outfits");
    Converse.Redirect("extra_item_1_choice_11", "Elite Frontier");
    Converse.Redirect("extra_item_9_choice_1", "Birthday Party");
    Converse.Redirect("extra_item_8_choice_1", "Party Decorations");
    Converse.Redirect("extra_item_1_mtips", "Change Sonic's Outfits");

    if (HMM.GetModByID("mandm.sonicfrontiers.dlcoutfitfixes") != null)
        Converse.Redirect("extra_item_9_mtips", "Change Amy, Knuckles and Tails' Outfits.");
    else
        Converse.Redirect("extra_item_9_mtips", "Change Amy, Knuckles and Tails' Outfits. Please note that the Outfits will not apply for the playable Friends.");

    isInitialized = true;
}

