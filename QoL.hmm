        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateFall);
}

Code "Fix Homing Attack Transitions" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static int conHammerAttack = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conHammerAttack = INI.GetField<int>(ini, "Main", "HammerAttack", conHammerAttack);
            isConfigInitialized = true;
        }
    }

    if (!Player.Status.IsLockOnCursorVisible() || !Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
        return;

    var playerType = Player.GetPlayerType();

    // Knuckles' homing belongs to Knuckles Combat Rework and Amy's to Hammer Moves while her hammer attack is on
    if (playerType == Player.PlayerType.Knuckles || (playerType == Player.PlayerType.Amy && conHammerAttack == 1))
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool canHomingAttack = currentState == Sonic.StateID.StateBounceJump ||
                           currentState == Sonic.StateID.StateSquat ||
                           currentState == Sonic.StateID.StateStompingBounce ||
                           (currentState == Sonic.StateID.StateSpinBoostCharge && !Player.Status.IsGrounded());

    if (canHomingAttack)
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHomingAttack);
}

