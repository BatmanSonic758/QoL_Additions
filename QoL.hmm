Code "Disable Slope Slide from Homing Rebound" by "Batman Sonic"
//

#lib "Player"

static bool wasHomingRebound = false;

{
    bool isHomingRebound = Player.State.GetPreviousStateID<Sonic.StateID>() == Sonic.StateID.StateHomingFinished;

    if (isHomingRebound == wasHomingRebound)
        return;

    wasHomingRebound = isHomingRebound;

    if (isHomingRebound)
    {
        Player.State.Discard<Sonic.StateID>(Sonic.StateID.StateFallSlope);
        Player.State.Discard<Tails.StateID>(Tails.StateID.StateFallSlope);
        Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.StateFallSlope);
        Player.State.Discard<Amy.StateID>(Amy.StateID.StateFallSlope);
    }
    else
    {
        Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateFallSlope);
        Player.State.Restore<Tails.StateID>(Tails.StateID.StateFallSlope);
        Player.State.Restore<Knuckles.StateID>(Knuckles.StateID.StateFallSlope);
        Player.State.Restore<Amy.StateID>(Amy.StateID.StateFallSlope);
    }
}

Code "Enhanced Homing Rebound" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "Reflection"
#lib "Time"
#lib "GameManager"
#lib "HMM"
#lib "INI"
#lib "Memory"
#lib "VectorHelpers"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"

#import "GOComponents"

#load "System.Numerics.dll"
using System.Numerics;

const float reboundTurnSpeed = 3.14f;
const float reboundTurnDamping = 4.0f;
const float reboundAccel = 20.0f;
const float reboundAccel2D = 14.0f;
const float reboundDecel = 10.0f;
const float reboundMaxSpeed = 32.0f;

const float homingReboundImpulse = 3.5f;
const float stompBounceImpulse = 3.5f;
const float drillSpinReboundImpulse = 3.5f;

const float reboundImpulseBattle = 5.5f;
const float sideViewImpulse = 0.85f;
const float sideViewImpulseBattle = 1.0f;
const float cyberSpaceHomingReboundImpulse = 2.0f;

const float doubleJumpDelay = 0.5f;

const int reboundNone = 0;
const int reboundDrillSpin = 1;
const int reboundHoming = 2;
const int reboundStompBounce = 3;

static bool isDive = false;
static bool isConfigInitialized = false;

static int conBounceAttackAbility = 0;
static int activeReboundType = 0;

static float reboundSpeed = 0.0f;
static float homingReboundTime = 0.0f;

{
    var playerType = Player.GetPlayerType();
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    bool isSuper = BlackboardStatus.IsSuper();
    bool isBattle = IS_WORLD_FLAG(IsBattle);
    bool isSideView = Player.Status.IsSideView();
    bool isCyberSpace = IS_WORLD_FLAG(IsCyberSpace);

    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            isConfigInitialized = true;
        }
    }

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    if (IS_STATE_FLAG(IsDiving))
    {
        isDive = true;
    }
    else if (Player.Status.IsGroundedSpecial())
    {
        isDive = false;
    }

    // Sonic
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);

        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.homingAttack.supersonicBounce.bounceTime, 1.2f);
    }

    // Tails
    if (TailsParametersInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);

        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);
    }

    // Tails (3D Cyber Space)
    if (TailsParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);
    }

    // Knuckles
    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);

        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);
    }

    // Knuckles (3D Cyber Space)
    if (KnucklesParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);
    }

    // Amy
    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);

        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);
    }

    // Amy (3D Cyber Space)
    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.homingAttack.sonicBounce.bounceTime, isDive ? 1.0f : 999.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.homingAttack.sonicBounceWeak.bounceTime, isDive ? 1.0f : 999.0f);

        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.homingAttack.sonicBounceStorm.bounceTime, 1.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.homingAttack.sonicBounceStormSwirl.bounceTime, 1.0f);
    }

    bool inDrillSpinRebound = playerType == Player.PlayerType.Knuckles && Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.StateMaximumHeatKnuckleBounce;
    bool inHomingRebound = currentState == Sonic.StateID.StateHomingFinished && previousState != Sonic.StateID.StateHomingAttackInStorm && !isDive;
    bool inStompBounce = !isSuper && currentState == Sonic.StateID.StateStompingBounce;

    bool inStompBounceControl = inStompBounce && (playerType != Player.PlayerType.Sonic || conBounceAttackAbility == 2);

    int reboundType = reboundNone;
    float baseImpulse = 0.0f;

    if (inDrillSpinRebound)
    {
        reboundType = reboundDrillSpin;
        baseImpulse = drillSpinReboundImpulse;
    }
    else if (inHomingRebound)
    {
        reboundType = reboundHoming;
        baseImpulse = homingReboundImpulse;
    }
    else if (inStompBounceControl)
    {
        reboundType = reboundStompBounce;
        baseImpulse = stompBounceImpulse;
    }

    // Rebound air control
    if (reboundType != reboundNone)
    {
        if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(kinematics, out var out_pKinematics))
            return;

        float dt = Time.GetDeltaTime();

        Vector3 worldInput = out_pKinematics->WorldInput;

        bool isMoving = worldInput.LengthSquared() > 0.001f;

        Vector3 velocity = out_pKinematics->Velocity;

        if (activeReboundType != reboundType)
        {
            if (isSideView)
            {
                velocity.Y -= isBattle ? sideViewImpulseBattle : sideViewImpulse;
            }
            else
            {
                float reboundImpulse = baseImpulse;

                // Lower Homing Rebound in 3D Cyber Space
                if (isCyberSpace && reboundType == reboundHoming)
                {
                    reboundImpulse = cyberSpaceHomingReboundImpulse;
                }

                velocity.Y += isBattle ? reboundImpulseBattle : reboundImpulse;
            }

            reboundSpeed = 0.0f;
            activeReboundType = reboundType;
        }

        if (isMoving)
        {
            // 2D keeps the entry heading locked (no rotation) so you can't reverse mid-rebound
            if (!isSideView)
            {
                var forward = VectorHelpers.GetForward(out_pKinematics->Rotation);

                var inputDir = Vector3.Normalize(worldInput);

                var inputAngle = VectorHelpers.SignedAngle(forward, inputDir, Vector3.UnitY);

                var rotationStep = (float)Math.Sign(inputAngle) * (float)Math.Min(Math.Abs(inputAngle), reboundTurnSpeed * dt);

                var rotationDelta = Quaternion.CreateFromAxisAngle(Vector3.UnitY, rotationStep);

                out_pKinematics->Rotation = Quaternion.Normalize(Quaternion.Concatenate(out_pKinematics->Rotation, rotationDelta));

                float turnAmount = Math.Abs(inputAngle) / (float)Math.PI;

                reboundSpeed *= Math.Max(1.0f - turnAmount * reboundTurnDamping * dt, 0.85f);
            }
        }

        float accel = isSideView ? reboundAccel2D : reboundAccel;

        bool isAccelerating = isMoving;

        if (isSideView)
        {
            var heading2D = VectorHelpers.GetForward(out_pKinematics->Rotation);

            Vector3 flatForward = new Vector3(heading2D.X, 0.0f, heading2D.Z);
            Vector3 flatInput = new Vector3(worldInput.X, 0.0f, worldInput.Z);

            isAccelerating = flatForward.LengthSquared() > 0.001f && flatInput.LengthSquared() > 0.001f &&
                Vector3.Dot(Vector3.Normalize(flatForward), Vector3.Normalize(flatInput)) > 0.0f;
        }

        if (isAccelerating)
        {
            reboundSpeed = Math.Min(reboundSpeed + accel * dt, reboundMaxSpeed);
        }
        else
        {
            reboundSpeed = Math.Max(reboundSpeed - reboundDecel * dt, 0.0f);
        }

        var heading = VectorHelpers.GetForward(out_pKinematics->Rotation);

        Vector3 horizVel = new Vector3(heading.X, 0.0f, heading.Z);

        if (horizVel.LengthSquared() > 0.001f)
            horizVel = Vector3.Normalize(horizVel) * reboundSpeed;
        else
            horizVel = Vector3.Zero;

        out_pKinematics->Velocity = new Vector3(horizVel.X, velocity.Y, horizVel.Z);
    }
    else
    {
        activeReboundType = reboundNone;
        reboundSpeed = 0.0f;
    }

    if (inHomingRebound && playerType == Player.PlayerType.Sonic)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            homingReboundTime += Time.GetDeltaTime();

            if (homingReboundTime >= doubleJumpDelay && Player.Input.IsDown(Player.InputActionType.PlayerJump))
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateDoubleJump);
        }
    }
    else
    {
        homingReboundTime = 0.0f;
    }
}

Code "Spin Attack Fixes" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "Reflection"
#lib "Time"
#lib "GameManager"
#lib "INI"
#lib "HMM"
