Code "Jump Panel Boost Animation" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Lua"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

#import "Services"

static bool isJumpboardBoost = false;
static bool isJumpboardTrick = false;
static bool isConfigInitialized = false;
static bool conJumpboardBoostVoice = false;

static Random random = new Random();

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conJumpboardBoostVoice = INI.GetField<bool>(ini, "Main", "JumpboardBoostVoice", conJumpboardBoostVoice);
            isConfigInitialized = true;
        }
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    string stageID = LevelInfo.GetCurrentStageID();

    // Skips Portal 4-9 since as of writing this there is no way to determine when Sonic is interacting with blue ramps
    if (stageID == "w9d07")
        return;

    if (currentState == Sonic.StateID.StateJumpBoardLaunch)
    {
        bool isBoosting = IS_STATE_FLAG(IsBoost);
        bool isAirTrick = IS_WORLD_FLAG(IsAirTrick);
        bool isSideView = Player.Status.IsSideView();

        if (isAirTrick)
        {
            if (!isJumpboardTrick)
            {
                Player.Animation.SetAnimation("JUMPBOARD_TRICK");
                isJumpboardTrick = true;
            }
        }
        else if (isBoosting)
        {
            if (!isJumpboardBoost)
            {
                string animName = isSideView ? "JUMPBOARD_BOOST_SV" : "JUMPBOARD_BOOST";
                Player.Animation.SetAnimation(animName);

                Player.Effect.PlayEffect("BoostRamp", "ef_ob_superring_get01");
                Player.Effect.PlayEffect("BoostRamp", "ef_ob_superring_get01_bd");
                Player.Effect.PlayEffect("BoostRamp", "ec_ob_superring_glow01");

                if (conJumpboardBoostVoice)
                {
                    string[] voiceLines = Player.GetPlayerType() switch
                    {
                        Player.PlayerType.Tails => new[] { "sa1038", "sa1036" },
                        Player.PlayerType.Knuckles => new[] { "ka1100", "sa1010" },
                        Player.PlayerType.Amy => new[] { "aa1110", "sa1038" },
                        _ => new[] { "sa1020_2", "sa1021_2" }
                    };

                    Lua.Call("PlayVoice", voiceLines[random.Next(voiceLines.Length)]);
                }

                isJumpboardBoost = true;
            }
        }
    }
    else
    {
        isJumpboardBoost = false;
        isJumpboardTrick = false;
    }
}

Code "Generations-Style Skateboard Dismount" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "GameManager"

static bool isSkateboardDismount = false;
static bool isJumpBall = false;
static bool isFall = false;

static float dismountTimer = 0.0f;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (previousState == Sonic.StateID.StateBoarding && currentState == Sonic.StateID.StateJumpBoardLaunch && !isSkateboardDismount)
    {
        Player.Animation.SetAnimation("JUMPBOARD_BOOST");

        dismountTimer = 0.0f;
        isJumpBall = false;
        isFall = false;
        isSkateboardDismount = true;
    }

    if (!isSkateboardDismount)
        return;

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    if (!isPaused)
        dismountTimer += Time.GetDeltaTime();

    if (!isJumpBall && dismountTimer >= 0.8f)
    {
        Player.Animation.SetAnimation("JUMP_BALL");
        isJumpBall = true;
    }

    if (!isFall && dismountTimer >= 1.5f)
    {
        Player.Animation.SetAnimation("FALL");
        isFall = true;
    }

    if (currentState != Sonic.StateID.StateJumpBoardLaunch)
    {
        isSkateboardDismount = false;
        isJumpBall = false;
        isFall = false;
        dismountTimer = 0.0f;
    }
}

