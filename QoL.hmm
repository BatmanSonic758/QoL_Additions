                RFL_SET_PARAM(SonicParametersInfo, common.cyloop.locus.m_transparentLines[0].m_color1.G, 0.3f);
                RFL_SET_PARAM(SonicParametersInfo, common.cyloop.locus.m_transparentLines[0].m_color1.B, 0.5f);
                break;
        }
    }
}

Code "Additional Death Animations" by "Batman Sonic"
//

#lib "Player"

static bool isDeadFall = false;
static bool isCurrentDeadAnimation = false;
static bool isAerialDeadLand = false;
static bool wasGrounded = true;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (currentState != Sonic.StateID.StateDead && currentState != Sonic.StateID.StateFallingDead)
    {
        wasGrounded = Player.Status.IsGrounded();

        isCurrentDeadAnimation = false;
        isAerialDeadLand = false;
    }

    if (currentState == Sonic.StateID.StateDead)
    {
        if (!isCurrentDeadAnimation)
        {
            Player.Animation.SetAnimation(wasGrounded ? "DEAD_GROUND" : "DAMAGE_FRONT_AIR");

            isCurrentDeadAnimation = true;
        }

        if (!wasGrounded && !isAerialDeadLand && Player.Status.IsGrounded())
        {
            Player.Animation.SetAnimation("DEAD_AIR");
            isAerialDeadLand = true;
        }
    }

    if (currentState == Sonic.StateID.StateFallingDead)
    {
        if (!isDeadFall)
        {
            Player.Animation.SetAnimation("DEAD_FALL");
            isDeadFall = true;
        }
    }
    else
    {
        isDeadFall = false;
    }
}

Code "Fix Fall Animation" by "Batman Sonic"
//

#lib "Player"

static bool isFallFix = false;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool isFallStates = previousState == Sonic.StateID.StateGrind ||
                        previousState == Sonic.StateID.StateGrindStep ||
                        previousState == Sonic.StateID.StateRun ||
                        previousState == Sonic.StateID.StateQuickStepJump ||
                        previousState == Sonic.StateID.StateSliding;

    if (currentState == Sonic.StateID.StateFall && isFallStates)
    {
        if (!isFallFix)
        {
            Player.Animation.SetAnimation("FALL");
            isFallFix = true;
        }
    }
    else
    {
        isFallFix = false;
    }
}

Code "Fix Wall Jump Animation" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "HMM"
#lib "INI"
#lib "GameManager"

static bool wasInWallJump = false;
static bool isWallFlyLoop = false;
static bool isWallFlyEnd = false;
static float wallJumpTimer = 0.0f;
static float wallLoopTimer = 0.0f;

static bool isConfigInitialized = false;
static int conWallJumpAnimation = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conWallJumpAnimation = INI.GetField<int>(ini, "Main", "WallJumpAnimation", conWallJumpAnimation);
            isConfigInitialized = true;
        }
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (previousState == Sonic.StateID.StateWallJump &&
        currentState == Sonic.StateID.StateFall &&
        !wasInWallJump)
    {
        Player.Sound.PlaySound("sn_triangle_jump");
        Player.Animation.SetAnimation(conWallJumpAnimation == 1 ? "WALLJUMP" : "WALLFLY");

        wallJumpTimer = 0.0f;
        wallLoopTimer = 0.0f;
        isWallFlyLoop = false;
        isWallFlyEnd = false;
        wasInWallJump = true;
    }

    if (!wasInWallJump)
        return;

    if (conWallJumpAnimation == 1)
    {
        if (currentState != Sonic.StateID.StateFall)
            wasInWallJump = false;

        return;
    }

    if (currentState != Sonic.StateID.StateFall)
    {
        wasInWallJump = false;
        isWallFlyLoop = false;
        isWallFlyEnd = false;
        wallJumpTimer = 0.0f;
        wallLoopTimer = 0.0f;
        return;
    }

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    if (isPaused)
        return;

    if (!isWallFlyLoop)
    {
        wallLoopTimer += Time.GetDeltaTime();

        if (wallLoopTimer >= 0.21f)
        {
            Player.Animation.SetAnimation("WALLFLY_LOOP");
            isWallFlyLoop = true;
            wallJumpTimer = 0.0f;
        }
    }
    else if (!isWallFlyEnd)
    {
        wallJumpTimer += Time.GetDeltaTime();

        float endTimer = conWallJumpAnimation == 3 ? 0.2f : 0.8f;

        if (wallJumpTimer >= endTimer)
        {
            Player.Animation.SetAnimation("WALLFLY_END");
            isWallFlyEnd = true;
        }
    }
}

Code "Fix Wall Jump Cling Fall Rotation" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "VectorHelpers"

#load "System.Numerics.dll"

using System.Numerics;

static Quaternion clingRotation = Quaternion.Identity;
static Quaternion fallRotation = Quaternion.Identity;

static bool isFallFromCling = false;
static float rotationHoldTime = 0.0f;
const float rotationHoldDuration = 0.15f;

{
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (currentState == Sonic.StateID.StateWallJumpReady)
    {
        clingRotation = kinematics->Rotation;
        isFallFromCling = false;
        return;
    }

    if (currentState != Sonic.StateID.StateFall)
    {
        isFallFromCling = false;
        rotationHoldTime = 0.0f;
        return;
    }

    if (!isFallFromCling && Player.State.GetPreviousStateID<Sonic.StateID>() == Sonic.StateID.StateWallJumpReady)
    {
        var clingForward = VectorHelpers.GetForward(clingRotation);
        var flatForward = new Vector3(clingForward.X, 0.0f, clingForward.Z);

        fallRotation = flatForward.LengthSquared() > 0.0001f ? VectorHelpers.LookRotation(-Vector3.Normalize(flatForward)) : clingRotation;

        isFallFromCling = true;
        rotationHoldTime = rotationHoldDuration;
    }

    if (rotationHoldTime > 0.0f)
    {
        kinematics->Rotation = fallRotation;
        rotationHoldTime -= Time.GetDeltaTime();
    }
}

Code "Homing Tricks" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "HMM"
#lib "INI"
#lib "BlackboardStatus"

static bool isConfigInitialized = false;
static bool conHomingTrickRandom = false;

static bool hasCheckedCodes = false;
static bool isHomingTrickAnimationsEnabled = false;

static bool isDive = false;
static bool wasInHomingFinished = false;

static int trickIndex = 0;
static System.Random rng = new System.Random();

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conHomingTrickRandom = INI.GetField<bool>(ini, "Main", "HomingTrickRandom", conHomingTrickRandom);
            isConfigInitialized = true;
        }
    }

    if (!hasCheckedCodes)
    {
        var codes = HMM.GetCodes();
        isHomingTrickAnimationsEnabled = codes.Contains("Animation/Sonic/Homing Attack Trick Animations");
        hasCheckedCodes = true;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (IS_STATE_FLAG(IsDiving) || currentState == Sonic.StateID.StateStorm)
    {
        isDive = true;
    }
    else if (Player.Status.IsGroundedSpecial())
    {
        isDive = false;
    }

    if (currentState == Sonic.StateID.StateHomingFinished)
    {
        if (!wasInHomingFinished)
        {
            if (isDive)
            {
                Player.Animation.SetAnimation("DIVE_BOUNCE");
            }
            else if (!isHomingTrickAnimationsEnabled)
            {
                int selectedTrick;

                if (conHomingTrickRandom)
                {
                    selectedTrick = rng.Next(0, 6);
                }
                else
                {
                    selectedTrick = trickIndex;
                    trickIndex = (trickIndex + 1) % 6;
                }

                Player.Animation.SetAnimation("HOMING_ACT0" + (selectedTrick + 1));
            }

            wasInHomingFinished = true;
        }
    }
    else
    {
        wasInHomingFinished = false;
    }

    if (Player.Status.IsGrounded())
        trickIndex = 0;
}

Code "Miscellaneous Animations Fixes" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"

static bool isAutoRunQuickStepLeft = false;
static bool isAutoRunQuickStepRight = false;

static bool isLavaDead = false;
static bool isLavaDamage = false;
static bool wasInLavaDamage = false;
static bool magmaEffectsActive = false;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (currentState == Sonic.StateID.StateQuickStepLeft)
    {
        if (!isAutoRunQuickStepLeft)
        {
            Player.Animation.SetAnimation("QUICKSTEP_LEFT");
            isAutoRunQuickStepLeft = true;
        }
    }
    else
    {
        isAutoRunQuickStepLeft = false;
    }

    if (currentState == Sonic.StateID.StateQuickStepRight)
    {
        if (!isAutoRunQuickStepRight)
        {
            Player.Animation.SetAnimation("QUICKSTEP_RIGHT");
            isAutoRunQuickStepRight = true;
        }
    }
    else
    {
        isAutoRunQuickStepRight = false;
    }

    if (currentState == Sonic.StateID.StateLavaDead)
    {
        if (!isLavaDead)
        {
            Player.Animation.SetAnimation("LAVA_DEAD");
            isLavaDead = true;
        }
    }
    else
    {
        isLavaDead = false;
    }

    // Tails, Knuckles and Amy Lava Damage Animations
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
    {
        if (currentState == Sonic.StateID.StateDamageLava)
        {
            if (!isLavaDamage)
            {
                Player.Animation.SetAnimation("DAMAGE_LAVA");
                Player.Effect.PlayEffect("isMagmaEffect", "ef_pl_magma01");
                Player.Effect.PlayEffect("isMagmaEffect", "ec_pl_magma01_par01");
                Player.Effect.PlayEffect("isMagmaEffect", "ec_pl_magma01_smoke01");
                isLavaDamage = true;
                wasInLavaDamage = true;
                magmaEffectsActive = true;
            }
        }
        else
        {
            if (magmaEffectsActive)
            {
                for (int i = 0; i < 3; i++)
                    Player.Effect.StopEffect("isMagmaEffect");

                magmaEffectsActive = false;
            }

            isLavaDamage = false;
        }

        if (wasInLavaDamage && IS_STATE_FLAG(IsIdle) && previousState == Sonic.StateID.StateDamageLava)
        {
            Player.Animation.SetAnimation("DAMAGE_LAVA_END");
            wasInLavaDamage = false;
        }
    }
}

