Code "Grind Additions" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "Time"
#lib "XInput"
#lib "Memory"
#lib "GameManager"
#lib "HMM"
#lib "INI"
#lib "Lua"

#import "GOComponents"

#load "System.Numerics.dll"
using System.Numerics;

static bool isBoardingLowPosition = false;

static bool isCrouchPressed = false;
static bool hasReleasedCrouch = false;
static bool isSquatGrunt = false;

static bool isInSwitchAnimation = false;
static float switchAnimationTimer = 0.0f;
const float switchAnimationDuration = 0.7f;

static bool isGrindLanding = false;
static float grindLandTimer = 0.0f;
static float grindLandDuration = 0.35f;

static float railjumpTime = 0.0f;
const float idleTime = 0.45f;

static float shuffleSpeedBoost = 0.0f;

static bool wasStepInputActive = false;
// -1 left, 1 right, 0 none
static int lastStepDirection = 0;

static bool isJumpDisabled = false;

static bool isInitialized = false;
static int lastStateID = -1;

static bool isConfigInitialized = false;
static int conGrindBoostAnim = 1;

static long AdrGRINDSTEPL = 0;
static long AdrGRINDSTEPR = 0;
static int appliedStepMirror = -1;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conGrindBoostAnim = INI.GetField<int>(ini, "Main", "GrindBoostAnim", conGrindBoostAnim);
            isConfigInitialized = true;
        }
    }

    // Grind Step
    // Both addresses are resolved before any write, otherwise a later scan could land on an already swapped name
    if (AdrGRINDSTEPL == 0)
    {
        // 0x14153C358, leading NUL keeps the scan from matching the tail of a longer name
        long found = ScanSignature("\0GRIND_STEP_L\0", "xxxxxxxxxxxxxx");

        if (found != 0)
            AdrGRINDSTEPL = found + 1;
    }

    if (AdrGRINDSTEPR == 0)
    {
        // 0x14153C368
        long found = ScanSignature("\0GRIND_STEP_R\0", "xxxxxxxxxxxxxx");

        if (found != 0)
            AdrGRINDSTEPR = found + 1;
    }

    // Each slot is 16 bytes, so both names are padded to fill it exactly and never spill into the next string
    if (AdrGRINDSTEPL != 0 && AdrGRINDSTEPR != 0 && appliedStepMirror != (isBoardingLowPosition ? 1 : 0))
    {
        WriteProtected<byte>(AdrGRINDSTEPL, System.Text.Encoding.UTF8.GetBytes(isBoardingLowPosition ? "GRIND_STEP_R_L\0\0" : "GRIND_STEP_L_R\0\0"));
        WriteProtected<byte>(AdrGRINDSTEPR, System.Text.Encoding.UTF8.GetBytes(isBoardingLowPosition ? "GRIND_STEP_L_L\0\0" : "GRIND_STEP_R_R\0\0"));
        appliedStepMirror = isBoardingLowPosition ? 1 : 0;
    }

    var kinematics = Player.Kinematics.Get();
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    int currentStateID = (int)currentState;

    if (!isInitialized)
    {
        lastStateID = currentStateID;
        isInitialized = true;
    }

    if (kinematics == null)
    {
        lastStateID = currentStateID;
        return;
    }

    float deltaTime = Time.GetDeltaTime();
    bool isTails = Player.GetPlayerType() == Player.PlayerType.Tails;
    bool isSideView = Player.Status.IsSideView();

    const float shuffleBoostAmount = 8.0f;
    const float shuffleMaxSpeedMultiplier = 1.8f;
    const float shuffleSpeedDecayRate = 2.0f;

    // Stop Grinding
    if (currentState != Sonic.StateID.StateGrind &&
        currentState != Sonic.StateID.StateGrindJump &&
        currentState != Sonic.StateID.StateGrindStep &&
        currentState != Sonic.StateID.StateGrindDamage &&
        currentState != Sonic.StateID.StateGrindDamageAir)
    {
        if (previousState == Sonic.StateID.StateGrind ||
            previousState == Sonic.StateID.StateGrindJump ||
            previousState == Sonic.StateID.StateGrindStep ||
            previousState == Sonic.StateID.StateGrindDamage ||
            previousState == Sonic.StateID.StateGrindDamageAir)
        {
            // Retain in mirrored position mid-switch
            if (isInSwitchAnimation)
                isBoardingLowPosition = !isBoardingLowPosition;

            if (isJumpDisabled)
            {
                SET_WORLD_FLAG(IsOutOfControl, false);
                isJumpDisabled = false;
            }

            isCrouchPressed = false;
            hasReleasedCrouch = false;
            isSquatGrunt = false;
            isInSwitchAnimation = false;
            switchAnimationTimer = 0.0f;
            isGrindLanding = false;
            grindLandTimer = 0.0f;
            wasStepInputActive = false;
            lastStepDirection = 0;
            shuffleSpeedBoost = 0.0f;
        }

        railjumpTime = 0.0f;
        lastStateID = currentStateID;
        return;
    }

    bool isGrindJump = (currentState == Sonic.StateID.StateGrindJump);
    bool isGrindStep = (currentState == Sonic.StateID.StateGrindStep);
    bool isGrindDamage = (currentState == Sonic.StateID.StateGrindDamage);
    bool isGrindDamageAir = (currentState == Sonic.StateID.StateGrindDamageAir);

    // Grind Shuffle Speed
    if (shuffleSpeedBoost > 0.0f &&
        (currentState == Sonic.StateID.StateGrind || currentState == Sonic.StateID.StateGrindStep))
    {
        bool isBoostPaused = GameManager.GetGameObject("MainMenu") != null ||
                             GameManager.GetGameObject("MapMenu") != null ||
                             GameManager.GetGameObject("PhotoMode") != null;

        if (!isBoostPaused)
        {
            shuffleSpeedBoost = Math.Max(shuffleSpeedBoost - shuffleSpeedDecayRate * deltaTime, 0.0f);
            kinematics->Velocity += Player.Kinematics.GetForward() * shuffleSpeedBoost * deltaTime;
        }
    }

    if ((isGrindJump || isGrindStep) && isGrindLanding)
    {
        isGrindLanding = false;
        grindLandTimer = 0.0f;
        if (isGrindJump)
            railjumpTime = 0.0f;
    }

    if (currentState == Sonic.StateID.StateGrind && lastStateID != (int)Sonic.StateID.StateGrind)
    {
        isGrindLanding = true;
        grindLandTimer = 0.0f;
        grindLandDuration = (previousState == Sonic.StateID.StateGrindStep) ? 0.32f : 0.35f;
    }

    // Grind Landing
    if (isGrindLanding)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
            grindLandTimer += deltaTime;

        // Stepping off lands on the matching side, everything else uses the plain touchdown
        if (previousState == Sonic.StateID.StateGrindStep && lastStepDirection == 1)
            Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_STEP_L_LAND_L" : "GRIND_STEP_R_LAND_R");
        else if (previousState == Sonic.StateID.StateGrindStep && lastStepDirection == -1)
            Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_STEP_R_LAND_L" : "GRIND_STEP_L_LAND_R");
        else
            Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_LAND_L" : "GRIND_LAND_R");

        if (grindLandTimer < grindLandDuration)
        {
            lastStateID = currentStateID;
            return;
        }

        isGrindLanding = false;
        grindLandTimer = 0.0f;
        lastStepDirection = 0;
        Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_L" : "GRIND_R");
    }

    // Grind Damage
    if (isGrindDamage || isGrindDamageAir)
    {
        Player.Animation.SetAnimation(isBoardingLowPosition ? (isGrindDamageAir ? "GRIND_DAMAGE_AIR_L" : "GRIND_DAMAGE_L") : (isGrindDamageAir ? "GRIND_DAMAGE_AIR_R" : "GRIND_DAMAGE_R"));

        lastStateID = currentStateID;
        return;
    }

    // Grind Jump
    if (isGrindJump)
    {
        if (railjumpTime < idleTime)
        {
            bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                            GameManager.GetGameObject("MapMenu") != null ||
                            GameManager.GetGameObject("PhotoMode") != null;

            if (!isPaused)
                railjumpTime += deltaTime;
        }

        if (railjumpTime >= idleTime)
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateFall);
        else
            Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_JUMP_L" : "GRIND_JUMP_R");

        lastStateID = currentStateID;
        return;
    }
    else
    {
        railjumpTime = 0.0f;
    }

    // Grind Step
    if (isGrindStep)
    {
        // A switch past its halfway point commits the flip, an earlier one is cancelled
        if (isInSwitchAnimation)
        {
            if (switchAnimationTimer >= switchAnimationDuration * 0.5f)
                isBoardingLowPosition = !isBoardingLowPosition;

            isInSwitchAnimation = false;
            switchAnimationTimer = 0.0f;

            if (isJumpDisabled)
            {
                SET_WORLD_FLAG(IsOutOfControl, false);
                isJumpDisabled = false;
            }
        }

        Vector2 stick = XInput.GetAnalog(0, true);
        const float stickThreshold = 0.5f;

        bool stepRight = Player.Input.IsPressed(Player.InputActionType.PlayerRightStep) || stick.X > stickThreshold;
        bool stepLeft = Player.Input.IsPressed(Player.InputActionType.PlayerLeftStep) || stick.X < -stickThreshold;
        bool currentStepInput = stepRight || stepLeft;

        // The step animation itself comes from the swapped names, the direction is only kept for the landing
        if (currentStepInput && !wasStepInputActive)
            lastStepDirection = stepRight ? 1 : -1;

        wasStepInputActive = currentStepInput;
        lastStateID = currentStateID;
        return;
    }
    else
    {
        wasStepInputActive = false;
    }

    // Grind Shuffle
    if (currentState == Sonic.StateID.StateGrind)
    {
        // Finish an in-progress switch on its own timer, then flip and re-enable jump
        if (isInSwitchAnimation)
        {
            if (switchAnimationTimer < switchAnimationDuration)
            {
                bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                                GameManager.GetGameObject("MapMenu") != null ||
                                GameManager.GetGameObject("PhotoMode") != null;

                if (!isPaused)
                    switchAnimationTimer += deltaTime;
            }

            if (switchAnimationTimer >= switchAnimationDuration)
            {
                isInSwitchAnimation = false;
                switchAnimationTimer = 0.0f;
                isBoardingLowPosition = !isBoardingLowPosition;

                if (isJumpDisabled)
                {
                    SET_WORLD_FLAG(IsOutOfControl, false);
                    isJumpDisabled = false;
                }

                Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_L" : "GRIND_R");
            }

            lastStateID = currentStateID;
            return;
        }

        bool isBoost = IS_STATE_FLAG(IsBoost);

        // Grind Squat
        if (Player.Input.IsDown(Player.InputActionType.PlayerStomping))
        {
            if (!isCrouchPressed)
            {
                isCrouchPressed = true;
                hasReleasedCrouch = false;
            }

            if (!isSquatGrunt)
            {
                Player.Sound.PlaySound("sn_climb_jump");
                Lua.Call("PlayVoice", "sa1007");
                isSquatGrunt = true;
            }

            if (isTails && isBoost && conGrindBoostAnim == 1)
                Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_BOOST_SQUAT_L" : "GRIND_BOOST_SQUAT_R");
            else
                Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_SQUAT_L" : "GRIND_SQUAT_R");

            lastStateID = currentStateID;
            return;
        }
        else
        {
            isCrouchPressed = false;
            isSquatGrunt = false;
        }

        // Releasing the crouch launches the board switch
        if (Player.Input.IsReleased(Player.InputActionType.PlayerStomping) &&
            !isInSwitchAnimation && !hasReleasedCrouch)
        {
            hasReleasedCrouch = true;
            isInSwitchAnimation = true;
            switchAnimationTimer = 0.0f;

            SET_WORLD_FLAG(IsOutOfControl, true);
            isJumpDisabled = true;

            Player.Sound.PlaySound("sn_triangle_jump");
            Lua.Call("PlayVoice", "sa1003");

            float shuffleBaseSpeed = Player.Kinematics.GetHorizontalMagnitude();
            shuffleSpeedBoost = Math.Min(shuffleSpeedBoost + shuffleBoostAmount, shuffleBaseSpeed * (shuffleMaxSpeedMultiplier - 1.0f));
            kinematics->Velocity += Player.Kinematics.GetForward() * shuffleBoostAmount;

            Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_SWITCH_L" : "GRIND_SWITCH_R");

            lastStateID = currentStateID;
            return;
        }

        // Grind Lean
        Vector2 stick = XInput.GetAnalog(0, true);
        const float stickThreshold = 0.25f;
        int leanDir = 0;

        // No leaning in 2D, and none while boosting if boost animations are on
        if (!isSideView && (!isBoost || conGrindBoostAnim != 1) && Math.Abs(stick.X) > stickThreshold)
            leanDir = stick.X > 0.0f ? 1 : -1;

        if (leanDir == 1)
        {
            bool backward = GetFacingDirection(false);
            Player.Animation.SetAnimation(backward ? (isBoardingLowPosition ? "GRIND_LEAN_L_L" : "GRIND_LEAN_L_R") : (isBoardingLowPosition ? "GRIND_LEAN_R_L" : "GRIND_LEAN_R_R"));
        }
        else if (leanDir == -1)
        {
            bool backward = GetFacingDirection(true);
            Player.Animation.SetAnimation(backward ? (isBoardingLowPosition ? "GRIND_LEAN_L_L" : "GRIND_LEAN_L_R") : (isBoardingLowPosition ? "GRIND_LEAN_R_L" : "GRIND_LEAN_R_R"));
        }
        else
        {
            if (isBoost && conGrindBoostAnim == 1)
                Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_BOOST_L" : "GRIND_BOOST_R");
            else
                Player.Animation.SetAnimation(isBoardingLowPosition ? "GRIND_L" : "GRIND_R");
        }
    }

    lastStateID = currentStateID;
}

static bool GetFacingDirection(bool isLeftLean)
{
    if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(Player.Kinematics.Get(), out var out_pKinematics))
        return false;

    var forward = Vector3.Transform(new Vector3(1, 0, 0), out_pKinematics->Rotation);
    var worldInput = out_pKinematics->WorldInput;

    forward.Y = 0;
    worldInput.Y = 0;

    if (forward.Length() < 0.01f || worldInput.Length() < 0.01f)
        return false;

    forward = Vector3.Normalize(forward);
    var inputDir = Vector3.Normalize(worldInput);
    float dot = Vector3.Dot(forward, inputDir);

    return isLeftLean ? dot > 0.2f : dot > -0.2f;
}

Code "Grind Physics Tweaks" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "Reflection"
#lib "Time"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"

#load "System.Numerics.dll"

using System.Numerics;

static bool wasGrinding = false;
static float timeGrinding = 0.0f;

const float minGrindSpeed = 15.0f;
const float turnaroundDelay = 0.2f;

{
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    bool isGrinding = IS_STATE_FLAG(IsGrind);

    if (!isGrinding)
    {
        wasGrinding = false;
        timeGrinding = 0.0f;
        return;
    }

    if (timeGrinding < 1.0f)
        timeGrinding += Time.GetDeltaTime();

    bool isGrindingNow = !wasGrinding;
    bool isSideView = Player.Status.IsSideView();

    float grindMaxSpeed = isSideView ? 70.0f : 90.0f;

    // Keep previous speed before interacting with the rail
    if (isGrindingNow)
    {
        Vector3 horizontalVelocity = new Vector3(kinematics->Velocity.X, 0.0f, kinematics->Velocity.Z);

        float incomingSpeed = horizontalVelocity.Length();

        if (incomingSpeed > 0.001f)
        {
            float carriedSpeed = incomingSpeed;

            if (carriedSpeed < minGrindSpeed)
                carriedSpeed = minGrindSpeed;

            if (carriedSpeed > grindMaxSpeed)
                carriedSpeed = grindMaxSpeed;

            Vector3 direction = Vector3.Normalize(horizontalVelocity);

            kinematics->Velocity.X = direction.X * carriedSpeed;
            kinematics->Velocity.Z = direction.Z * carriedSpeed;
        }
        else
        {
            var forward = Vector3.Transform(new Vector3(0.0f, 0.0f, 1.0f), kinematics->Rotation);

            forward.Y = 0.0f;

            if (forward.LengthSquared() > 0.001f)
            {
                forward = Vector3.Normalize(forward);
                kinematics->Velocity.X = forward.X * minGrindSpeed;
                kinematics->Velocity.Z = forward.Z * minGrindSpeed;
            }
        }
    }

    // Sonic
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.grind.maxSpeed, grindMaxSpeed);
        RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.grind.maxBoostSpeed, isSideView ? 50.0f : 70.0f);
        RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.grind.maxSpeed, 70.0f);
        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.grind.maxBoostSpeed, 70.0f);
        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.grind.maxSpeed, 50.0f);
        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.grind.maxBoostSpeed, 50.0f);
        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.grind.deceleForce, 0.0f);

        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(SonicParametersInfo, cyberspace.modePackage.grind.deceleForce, 0.0f);

        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(SonicParametersInfo, cyberspaceSV.modePackage.grind.deceleForce, 0.0f);
    }

    // Tails
    if (TailsParametersInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.grind.maxSpeed, grindMaxSpeed);
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.grind.maxBoostSpeed, isSideView ? 50.0f : 70.0f);
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.grind.maxSpeed, 50.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.grind.maxBoostSpeed, 50.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.grind.deceleForce, 0.0f);

        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.grind.deceleForce, 0.0f);
    }

    // Tails (3D Cyber Space)
    if (TailsParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.grind.maxSpeed, 70.0f);
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.grind.maxBoostSpeed, 70.0f);
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.grind.deceleForce, 0.0f);
    }

    // Knuckles
    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.grind.maxSpeed, grindMaxSpeed);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.grind.maxBoostSpeed, isSideView ? 50.0f : 70.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.grind.maxSpeed, 50.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.grind.maxBoostSpeed, 50.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.grind.deceleForce, 0.0f);

        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.grind.deceleForce, 0.0f);
    }

    // Knuckles (3D Cyber Space)
    if (KnucklesParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.grind.maxSpeed, 70.0f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.grind.maxBoostSpeed, 70.0f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.grind.deceleForce, 0.0f);
    }

    // Amy
    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.grind.maxSpeed, grindMaxSpeed);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.grind.maxBoostSpeed, isSideView ? 50.0f : 70.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.grind.maxSpeed, 50.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.grind.maxBoostSpeed, 50.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.grind.deceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.grind.deceleForce, 0.0f);
    }

    // Amy (3D Cyber Space)
    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.grind.maxSpeed, 70.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.grind.maxBoostSpeed, 70.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.grind.limitSpeedMin, 0.0f);

        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.grind.acceleForce, 0.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.grind.deceleForce, 0.0f);
    }

    // Turn around when completely stopped on a rail
    float grindingSpeed = Player.Kinematics.GetMagnitude();

    if (grindingSpeed <= 0.01f && timeGrinding > turnaroundDelay)
    {
        kinematics->Rotation *= new Quaternion(-1.0f, 0.0f, 0.0f, 0.0f);
    }

    wasGrinding = true;
}

Code "Skateboard Additions" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Player"
#lib "Lua"
#lib "Time"
#lib "Reflection"
#lib "BlackboardStatus"
#lib "SonicParameters"

#import "Plugins"

static bool isBoostingDuringBoard = false;
static bool isSquatGrunt = false;
static bool wasInBoost = false;
static string currentBoardAnimation = "";

const float boostDrainPerSecond = 12.0f;

static bool isAirborne = false;
static float airPeakHeight = 0.0f;
static float airTime = 0.0f;
static float landingTimer = 0.0f;

// Terrain bumps briefly unground the board, so short hops don't count as a landing
const float minAirTimeForLanding = 0.15f;
const float bigLandingHeight = 12.0f;
const float landingDuration = 0.35f;
const float bigLandingDuration = 0.8f;

static Sonic.StateID previousState;
static bool isJumpboardLandingPending = false;

{
    if (BlackboardStatus.IsSuper())
        return;

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");

    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (currentState == Sonic.StateID.StateBoarding && previousState == Sonic.StateID.StateJumpBoardLaunch)
        isJumpboardLandingPending = true;

    previousState = currentState;

    if (currentState != Sonic.StateID.StateBoarding)
    {
        if (isBoostingDuringBoard)
        {
            SET_STATE_FLAG(IsBoost, false);
            isBoostingDuringBoard = false;
        }

        if (wasInBoost)
        {
            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);
            wasInBoost = false;
        }

        isSquatGrunt = false;
        currentBoardAnimation = "";
        isAirborne = false;
        airTime = 0.0f;
        landingTimer = 0.0f;
        isJumpboardLandingPending = false;
        return;
    }

    bool isBoostHeld = Player.Input.IsDown(Player.InputActionType.PlayerBoost);
    bool isSquatHeld = Player.Input.IsDown(Player.InputActionType.PlayerStomping);

    float dt = Time.GetDeltaTime();
    float speed = Player.Kinematics.GetHorizontalMagnitude();

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    bool hasBoostEnergy = boostPlugin != null &&
                          (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0 &&
                          boostPlugin->BoostAmount > 0.01f;

    bool isBoostBoarding = isBoostHeld &&
                           hasBoostEnergy &&
                           !IS_WORLD_FLAG(IsDamagedOrRepelled);

    if (isBoostBoarding)
    {
        SET_STATE_FLAG(IsBoost, true);
        isBoostingDuringBoard = true;

        boostPlugin->BoostAmount = Math.Max(
            boostPlugin->BoostAmount - boostDrainPerSecond * dt,
            0.0f
        );

        if (boostPlugin->BoostAmount <= 0.01f)
        {
            // A leftover sliver sits below the energy check and never drains, so snap it to zero
            boostPlugin->BoostAmount = 0.0f;
            SET_STATE_FLAG(IsBoost, false);
            isBoostingDuringBoard = false;
            isBoostBoarding = false;
        }
    }
    else
    {
        SET_STATE_FLAG(IsBoost, false);
        isBoostingDuringBoard = false;
    }

    if (isBoostingDuringBoard)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 1.0f);
        Player.Collision.SetEntityCollision(false);
        wasInBoost = true;
    }
    else if (wasInBoost)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        wasInBoost = false;
    }

    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.maxSpeed, isBoostingDuringBoard ? 70.0f : 45.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.minSpeed, 20.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.damageSpeed, 15.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.accel, isBoostingDuringBoard ? 40.0f : 20.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.damageBrake, 30.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.gravity, 30.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.airJumpSpeed, 5.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.groundJumpSpeed, 5.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.airAccel, 30.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.maxAirAddSpeed, 20.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.downForceRate, 5.5f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.steeringSpeed1, 140.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.steeringSpeed2, 110.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.steeringSpeed3, 35.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.startSteeringSpeed, 10.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, boarding.endSteeringSpeed, 55.0f);
    }

    var kinematics = Player.Kinematics.Get();
    bool isGrounded = Player.Status.IsGrounded();

    if (!isGrounded)
    {
        if (kinematics != null)
        {
            float height = kinematics->Position.Y;

            // Measure from the apex, not the takeoff point, so jumping off a ramp counts the full drop
            if (!isAirborne || height > airPeakHeight)
                airPeakHeight = height;
        }

        if (!isAirborne)
            airTime = 0.0f;

        isAirborne = true;
        airTime += dt;
        landingTimer = 0.0f;
    }
    else
    {
        bool isLanding = false;
        bool isBigLanding = false;

        if (isAirborne)
        {
            isAirborne = false;

            if (airTime >= minAirTimeForLanding)
            {
                float fallHeight = kinematics != null ? airPeakHeight - kinematics->Position.Y : 0.0f;
                isLanding = true;
                isBigLanding = fallHeight >= bigLandingHeight;
            }

            airTime = 0.0f;
        }

        if (isJumpboardLandingPending)
        {
            isLanding = true;
            isBigLanding = true;
            isJumpboardLandingPending = false;
        }

        if (isLanding && !IS_WORLD_FLAG(IsDamagedOrRepelled))
        {
            string landingAnimation = isBigLanding ? "BOARDING_LAND_BIG" : "BOARDING_LAND";

            Player.Animation.SetAnimation(landingAnimation);
            currentBoardAnimation = landingAnimation;
            landingTimer = isBigLanding ? bigLandingDuration : landingDuration;
        }
    }

    if (IS_WORLD_FLAG(IsDamagedOrRepelled) || !isGrounded)
    {
        isSquatGrunt = false;
        currentBoardAnimation = "";
        landingTimer = 0.0f;
        return;
    }

    if (landingTimer > 0.0f)
    {
        landingTimer -= dt;

        if (landingTimer > 0.0f)
            return;

        landingTimer = 0.0f;
    }

    string desiredAnimation;

    if (isSquatHeld)
        desiredAnimation = "BOARDING_SQUAT";
    else if (isBoostBoarding)
        desiredAnimation = "BOARDING_BOOST";
    else if (speed < 14.0f)
        desiredAnimation = "BOARDING_LOW";
    else
        desiredAnimation = "BOARDING";

    if (desiredAnimation != currentBoardAnimation)
    {
        Player.Animation.SetAnimation(desiredAnimation);
        currentBoardAnimation = desiredAnimation;
    }

    if (isSquatHeld)
    {
        if (!isSquatGrunt)
        {
            Player.Sound.PlaySound("sn_climb_jump");
            Lua.Call("PlayVoice", "sa1007");
            isSquatGrunt = true;
        }
    }
    else
    {
        isSquatGrunt = false;
    }
}

Code "Flight Tweaks" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "BlackboardStatus"
#lib "TailsParameters"
#lib "Player"
#lib "Reflection"
#lib "Time"
#lib "Tails"
#lib "Converse"
#lib "HMM"
#lib "INI"
#lib "Lua"
#lib "Memory"
#lib "VectorHelpers"
#lib "GameManager"

#import "Plugins"
#import "States"
#import "GOComponents"

#load "System.Numerics.dll"
using System.Numerics;

static bool isConfigInitialized = false;
static int conFlightMeter = 0;

static float flyTimer = 0.0f;
static float initialFlightSpeed = 0.0f;
static float dynamicSpeedCap = 50.0f;
static float upwardVelocity = 0.0f;

static bool isFlightUsed = false;
static bool playedOverheatSFX = false;
static bool playedFullSFX = false;
static bool isTired = false;

static bool hasSetStartAnim = false;
static bool hasSetRiseAnim = false;
static bool hasSetCruiseAnim = false;
static bool hasSetTiredAnim = false;
static bool playedTiredSFX = false;
static bool wasUnderwater = false;
static string currentFlightAnim = "";

static bool boostAbilityDisabled = false;
static bool playedBoostSFX = false;
static bool wasFlightBoosting = false;

static float currentFlightLeanAngle = 0.0f;
static Quaternion previousRotation = Quaternion.Identity;

const float maxFlightTime = 10.0f;
const float maxRiseSpeed = 8.0f;
const float riseAcceleration = 28.0f;
const float idleDescendSpeed = 4.2f;
const float tiredDescendSpeed = 12.0f;
const float normalSteerFactor = 0.18f;
const float cruiseSteerFactor = 0.04f;
const float momentumThreshold = 14.0f;
const float maxNormalFlightSpeed = 50.0f;
const float maxHighMomentumSpeed = 75.0f;
const float highMomentumThreshold = 50.0f;

const float boostSpeed = 90.0f;
const float boostTimerDrain = 3.0f;
const float boostGaugeDrain = 2.5f;
const float boostDecelRate = 40.0f;

const float normalTurnSpeed = 35.0f;
const float turnDamping = 8.0f;
const float tiredTurnSpeed = 15.0f;

const float leanBuildRate = 320.0f;
const float maxLeanAngle = 55.0f;
const float leanDecaySpeed = 60.0f;
const float riseLeanThreshold = 12.0f; // Rise reuses the cruise lean anims for now
const float cruiseLeanThreshold = 12.0f;

{
    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conFlightMeter = INI.Parse<int>(ini["Main"]["FlightMeter"], conFlightMeter);
            isConfigInitialized = true;
        }
    }

    Lua.Init();

    float deltaTime = Time.GetDeltaTime();

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();
    var pStateTailsFly = Player.State.GetState<StateTailsFly>();
    var kinematics = Player.Kinematics.Get();
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");

    if (TailsParametersInfo.pData == null || kinematics == null)
        return;

    if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(kinematics, out var out_pKinematics))
        return;

    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();

    bool isUnderwater = Player.Status.IsUnderwater();
    bool isGrounded = Player.Status.IsGrounded();
    bool jumpHeld = Player.Input.IsDown(Player.InputActionType.PlayerJump);
    bool boostHeld = Player.Input.IsDown(Player.InputActionType.PlayerBoost);
    bool isBoost = IS_STATE_FLAG(IsBoost);

    Vector3 worldInput = out_pKinematics->WorldInput;
    bool isMoving = worldInput.LengthSquared() > 0.001f;
    Vector3 velocity = out_pKinematics->Velocity;

    bool isFlightState = (currentState == Tails.StateID.StateTailsFly ||
                          currentState == Tails.StateID.StateRunawayBee);
    bool isFlightBoosting = !isUnderwater && isFlightState && boostHeld;

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    if (isTired && (currentState == Tails.StateID.StateTailsFly || currentState == Tails.StateID.StateRunawayBee))
    {
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateSleep);
        return;
    }

    bool gaugeEmpty = conFlightMeter == 1 && boostPlugin != null && boostPlugin->BoostAmount <= 0.01f;
    bool timerEmpty = conFlightMeter != 1 && flyTimer >= maxFlightTime;

    if (currentState == Tails.StateID.StateTailsFly && (gaugeEmpty || timerEmpty))
    {
        isTired = true;
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateSleep);
        return;
    }

    if (isUnderwater != wasUnderwater)
    {
        hasSetRiseAnim = false;
        hasSetCruiseAnim = false;
        hasSetTiredAnim = false;
        currentFlightLeanAngle = 0.0f;
        currentFlightAnim = "";
        wasUnderwater = isUnderwater;
    }

    void SetFlightAnim(string animName)
    {
        if (animName != currentFlightAnim)
        {
            Player.Animation.SetAnimation(animName);
            currentFlightAnim = animName;
        }
    }

    // Leaning
    void UpdateLean()
    {
        var currentRotation = out_pKinematics->Rotation;
        var deltaRot = Quaternion.Concatenate(Quaternion.Inverse(previousRotation), currentRotation);

        float yawDelta = 2.0f * (float)Math.Atan2(deltaRot.Y, deltaRot.W);

        float yawSpeed = yawDelta / Math.Max(deltaTime, 0.0001f);
        float rawLean = yawSpeed * (180.0f / (float)Math.PI) * (leanBuildRate / 360.0f);
        float targetLean = Math.Max(-maxLeanAngle, Math.Min(rawLean, maxLeanAngle));

        if (Math.Abs(targetLean) > Math.Abs(currentFlightLeanAngle) ||
            Math.Sign(targetLean) == Math.Sign(currentFlightLeanAngle))
        {
            float diff = targetLean - currentFlightLeanAngle;
            currentFlightLeanAngle += diff * Math.Min(leanBuildRate * deltaTime / maxLeanAngle, 1.0f);
        }
        else
        {
            float decayStep = Math.Sign(-currentFlightLeanAngle) * Math.Min(Math.Abs(currentFlightLeanAngle), leanDecaySpeed * deltaTime);
            currentFlightLeanAngle += decayStep;
        }

        previousRotation = currentRotation;
    }

    string GetRiseAnim()
    {
        if (isUnderwater)
        {
            if (Math.Abs(currentFlightLeanAngle) > riseLeanThreshold)
                return currentFlightLeanAngle > 0 ? "TAILS_BOOST_SWIM_L" : "TAILS_BOOST_SWIM_R";
            return "TAILS_BOOST_SWIM";
        }
        if (isFlightBoosting)
            return "BOOST_AIR";
        if (Math.Abs(currentFlightLeanAngle) > riseLeanThreshold)
            return currentFlightLeanAngle > 0 ? "FLY_RISE_L_LOOP" : "FLY_RISE_R_LOOP";
        return "FLY_RISE_LOOP";
    }

    string GetCruiseAnim()
    {
        if (isUnderwater)
        {
            if (Math.Abs(currentFlightLeanAngle) > cruiseLeanThreshold)
                return currentFlightLeanAngle > 0 ? "TAILS_BOOST_SWIM_L" : "TAILS_BOOST_SWIM_R";
            return "TAILS_BOOST_SWIM";
        }
        if (isFlightBoosting)
            return "BOOST_AIR";
        if (Math.Abs(currentFlightLeanAngle) > cruiseLeanThreshold)
            return currentFlightLeanAngle > 0 ? "FLY_CRUISE_L_LOOP" : "FLY_CRUISE_R_LOOP";
        return "FLY_CRUISE_LOOP";
    }

    Vector3 ApplyTurn(Vector3 horizVel, float turnSpeed, bool applyDamping)
    {
        if (!isMoving)
            return horizVel;

        var forward = VectorHelpers.GetForward(out_pKinematics->Rotation);
        var inputDir = Vector3.Normalize(worldInput);
        var inputAngle = VectorHelpers.SignedAngle(forward, inputDir, Vector3.UnitY);
        var rotationStep = (float)Math.Sign(inputAngle) *
            (float)Math.Min(Math.Abs(inputAngle), turnSpeed * deltaTime);
        var rotationDelta = Quaternion.CreateFromAxisAngle(Vector3.UnitY, rotationStep);

        out_pKinematics->Rotation = Quaternion.Normalize(
            Quaternion.Concatenate(out_pKinematics->Rotation, rotationDelta));

        if (horizVel.LengthSquared() > 0.001f)
        {
            horizVel = Vector3.Transform(horizVel, rotationDelta);
            if (applyDamping)
            {
                float turnAmount = Math.Abs(inputAngle) / (float)Math.PI;
                horizVel *= Math.Max(1.0f - turnAmount * turnDamping * deltaTime, 0.85f);
            }
        }

        return horizVel;
    }

    Vector3 GetBoostHorizVel()
    {
        var forward = VectorHelpers.GetForward(out_pKinematics->Rotation);
        var horizVel = new Vector3(forward.X, 0, forward.Z);
        if (horizVel.LengthSquared() > 0.001f)
            horizVel = Vector3.Normalize(horizVel) * boostSpeed;
        return horizVel;
    }

    Vector3 ApplyBoostDecel(Vector3 horizVel)
    {
        if (wasFlightBoosting)
        {
            float currentSpeed = horizVel.Length();
            if (currentSpeed > dynamicSpeedCap)
            {
                float newSpeed = Math.Max(currentSpeed - boostDecelRate * deltaTime, dynamicSpeedCap);
                if (horizVel.LengthSquared() > 0.001f)
                    horizVel = Vector3.Normalize(horizVel) * newSpeed;
            }
            else
            {
                wasFlightBoosting = false;
            }
        }
        return horizVel;
    }

    void DrainFlightGauge(float multiplier)
    {
        boostPlugin->BoostAmount -= boostPlugin->BoostCapacity / 10.0f * deltaTime * multiplier;
        boostPlugin->BoostAmount = Math.Max(boostPlugin->BoostAmount, 0.0f);

        if (!isFlightUsed)
        {
            isFlightUsed = true;
            playedFullSFX = false;
        }

        if (boostPlugin->BoostAmount <= 0.01f)
        {
            if (!playedOverheatSFX)
            {
                Player.Sound.PlaySound("sys_boostgage_overheat");
                playedOverheatSFX = true;
            }

            isTired = true;
            Player.State.SetState<Tails.StateID>(Tails.StateID.StateSleep);
        }
    }

    if (pStateTailsFly != null && pStateTailsFly->Phase == StateTailsFly.PhaseType.Intro)
        pStateTailsFly->Phase = StateTailsFly.PhaseType.Rise;

    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateTailsFly, Tails.StateID.StateFall);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateRunawayBee, Tails.StateID.StateFall);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateSleep, Tails.StateID.StateFall);

    if (isFlightState || currentState == Tails.StateID.StateSleep)
    {
        if (!boostAbilityDisabled)
        {
            Lua.Call("SetPlayerAbilityEnabled", "Boost", false);
            boostAbilityDisabled = true;
        }
    }
    else if (boostAbilityDisabled)
    {
        Lua.Call("SetPlayerAbilityEnabled", "Boost", true);
        boostAbilityDisabled = false;
    }

    if (isFlightState || currentState == Tails.StateID.StateSleep)
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);

    // Flight Meter
    if (conFlightMeter == 1 && boostPlugin != null && !isBoost)
    {
        if (isFlightUsed)
            Converse.Redirect("hud_sonic_boost", "FLIGHT");

        if (!isPaused)
        {
            // Rising always burns the gauge, cruising only burns it while boosting
            bool riseDraining = pStateTailsFly != null &&
                (pStateTailsFly->Phase == StateTailsFly.PhaseType.Flying ||
                 pStateTailsFly->Phase == StateTailsFly.PhaseType.Rise ||
                 currentState == Tails.StateID.StateTailsFly);

            if (riseDraining)
                DrainFlightGauge(isFlightBoosting ? boostGaugeDrain : 1.0f);

            if (currentState == Tails.StateID.StateRunawayBee && isFlightBoosting)
                DrainFlightGauge(boostGaugeDrain);

            // Refill on the ground once flight has been used
            if (isGrounded && isFlightUsed &&
                currentState != Tails.StateID.StateTailsFly &&
                currentState != Tails.StateID.StateRunawayBee &&
                currentState != Tails.StateID.StateSleep)
            {
                boostPlugin->BoostAmount += boostPlugin->BoostCapacity / 3.0f * deltaTime;
                boostPlugin->BoostAmount = Math.Min(boostPlugin->BoostAmount, boostPlugin->BoostCapacity);

                if (boostPlugin->BoostAmount >= boostPlugin->BoostCapacity && !playedFullSFX)
                {
                    Player.Sound.PlaySound("sys_boostgage_max");
                    playedFullSFX = true;
                    playedOverheatSFX = false;
                    isFlightUsed = false;
                }
            }
        }
    }

    if (currentState == Tails.StateID.StateTailsFly && flyTimer == 0.0f)
    {
        float speed = Player.Kinematics.GetHorizontalMagnitude();
        initialFlightSpeed = speed;
        dynamicSpeedCap = speed > highMomentumThreshold ? maxHighMomentumSpeed : maxNormalFlightSpeed;
    }

    // Flight Start animation
    if (currentState == Tails.StateID.StateRecoveryJump && jumpHeld)
    {
        if (!hasSetStartAnim)
        {
            Player.Effect.StopAnimationEffects();
            SetFlightAnim("FLY_START");
            hasSetStartAnim = true;
        }
    }
    else
    {
        hasSetStartAnim = false;
    }

    // Flight Rise
    if (currentState == Tails.StateID.StateTailsFly)
    {
        if (!hasSetRiseAnim)
        {
            Player.Effect.StopAnimationEffects();
            currentFlightAnim = "";
            previousRotation = out_pKinematics->Rotation;
            hasSetRiseAnim = true;
        }

        UpdateLean();
        SetFlightAnim(GetRiseAnim());

        if (isFlightBoosting)
        {
            if (!playedBoostSFX)
            {
                Lua.Call("PlayVoice", "ta1112");
                Player.Sound.PlaySound("sn_just_avoid_accel");
                playedBoostSFX = true;
            }
        }
        else
        {
            playedBoostSFX = false;
        }

        if (jumpHeld)
        {
            if (!isPaused && conFlightMeter != 1)
            {
                flyTimer += deltaTime * (isFlightBoosting ? boostTimerDrain : 1.0f);
                if (flyTimer >= maxFlightTime)
                {
                    isTired = true;
                    Player.State.SetState<Tails.StateID>(Tails.StateID.StateSleep);
                    return;
                }
            }

            upwardVelocity += riseAcceleration * deltaTime;
            upwardVelocity = Math.Min(upwardVelocity, maxRiseSpeed);
            velocity.Y = upwardVelocity;

            Vector3 horizVel = new Vector3(velocity.X, 0, velocity.Z);
            horizVel = ApplyTurn(horizVel, normalTurnSpeed, true);

            if (isFlightBoosting)
            {
                horizVel = GetBoostHorizVel();
                wasFlightBoosting = true;
            }
            else
            {
                horizVel = ApplyBoostDecel(horizVel);

                bool preserveMomentum = initialFlightSpeed >= momentumThreshold &&
                                        horizVel.Length() >= initialFlightSpeed;
                if (!preserveMomentum && isMoving)
                    horizVel += Vector3.Normalize(worldInput) * normalSteerFactor;

                if (!wasFlightBoosting && horizVel.Length() > dynamicSpeedCap)
                    horizVel = Vector3.Normalize(horizVel) * dynamicSpeedCap;
            }

            velocity = new Vector3(horizVel.X, velocity.Y, horizVel.Z);
            out_pKinematics->Velocity = velocity;
        }
        else
        {
            Player.State.SetState<Tails.StateID>(Tails.StateID.StateRunawayBee);
        }
    }
    else
    {
        hasSetRiseAnim = false;
    }

    // Flight Cruise
    if (currentState == Tails.StateID.StateRunawayBee)
    {
        if (!hasSetCruiseAnim)
        {
            Player.Effect.StopAnimationEffects();
            currentFlightAnim = "";
            previousRotation = out_pKinematics->Rotation;
            hasSetCruiseAnim = true;
        }

        UpdateLean();
        SetFlightAnim(GetCruiseAnim());

        if (isFlightBoosting)
        {
            if (!playedBoostSFX)
            {
                Lua.Call("PlayVoice", "ta1112");
                Player.Sound.PlaySound("sn_just_avoid_accel");
                playedBoostSFX = true;
            }

            if (!isPaused && conFlightMeter != 1)
            {
                flyTimer += deltaTime * boostTimerDrain;
                if (flyTimer >= maxFlightTime)
                {
                    isTired = true;
                    Player.State.SetState<Tails.StateID>(Tails.StateID.StateSleep);
                    return;
                }
            }
        }
        else
        {
            playedBoostSFX = false;
        }

        velocity.Y = -idleDescendSpeed;

        Vector3 horizVel = new Vector3(velocity.X, 0, velocity.Z);
        horizVel = ApplyTurn(horizVel, normalTurnSpeed, true);

        if (isFlightBoosting)
        {
            horizVel = GetBoostHorizVel();
            wasFlightBoosting = true;
        }
        else
        {
            horizVel = ApplyBoostDecel(horizVel);

            if (horizVel.Length() < initialFlightSpeed && isMoving)
                horizVel += Vector3.Normalize(worldInput) * cruiseSteerFactor;

            if (!wasFlightBoosting && horizVel.Length() > dynamicSpeedCap)
                horizVel = Vector3.Normalize(horizVel) * dynamicSpeedCap;
        }

        velocity = new Vector3(horizVel.X, velocity.Y, horizVel.Z);
        out_pKinematics->Velocity = velocity;

        // Holding jump lifts back into a rise, unless we're spent
        if (jumpHeld && !isTired)
        {
            Player.State.SetState<Tails.StateID>(Tails.StateID.StateTailsFly);
            upwardVelocity = 0.01f;
        }
    }
    else
    {
        hasSetCruiseAnim = false;
    }

    // Tired
    if (currentState == Tails.StateID.StateSleep)
    {
        if (!hasSetTiredAnim)
        {
            Player.Effect.StopAnimationEffects();
            currentFlightAnim = "";
            SetFlightAnim(isUnderwater ? "TAILS_BOOST_SWIM_DESCEND" : "FLY_DESCEND_LOOP");
            hasSetTiredAnim = true;
        }

        velocity.Y = -tiredDescendSpeed;

        Vector3 horizVel = new Vector3(velocity.X, 0, velocity.Z);
        horizVel = ApplyTurn(horizVel, tiredTurnSpeed, false);

        velocity = new Vector3(horizVel.X, velocity.Y, horizVel.Z);
        out_pKinematics->Velocity = velocity;

        if (!playedTiredSFX)
        {
            Player.Sound.PlaySound("sn_homingshot");
            playedTiredSFX = true;
        }
    }
    else
    {
        hasSetTiredAnim = false;
        playedTiredSFX = false;
    }

    if (isGrounded ||
        (currentState != Tails.StateID.StateTailsFly &&
         currentState != Tails.StateID.StateRunawayBee &&
         currentState != Tails.StateID.StateSleep &&
         currentState != Tails.StateID.StateBounceJump))
    {
        flyTimer = 0.0f;
        initialFlightSpeed = 0.0f;
        dynamicSpeedCap = maxNormalFlightSpeed;
        upwardVelocity = 0.0f;
        isTired = false;
        hasSetStartAnim = false;
        hasSetRiseAnim = false;
        hasSetCruiseAnim = false;
        hasSetTiredAnim = false;
        playedTiredSFX = false;
        playedBoostSFX = false;
        wasFlightBoosting = false;
        currentFlightLeanAngle = 0.0f;
        currentFlightAnim = "";
    }
}

Code "Glide Tweaks" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "KnucklesParameters"
#lib "Memory"
#lib "VectorHelpers"
#lib "Time"
#lib "BlackboardItem"
#lib "HMM"
#lib "GameManager"
#lib "INI"

#import "GOComponents"

#load "System.Numerics.dll"
using System.Numerics;

static bool isDust = false;

static bool hasSetGlideAnim = false;
static string currentGlideAnim = "";
static float currentGlideLeanAngle = 0.0f;
static Quaternion previousGlideRotation = Quaternion.Identity;

// Side View turn-around
static float glideTurnSign = 0.0f;
static Vector3 glideTurnTarget = Vector3.Zero;
static float glideTurnSpeed = 0.0f;

// Glide Start Animation
static bool isDisableGlideTransitionEnabled = false;
static bool hasCheckedDisableGlideTransition = false;
static bool isPlayingGlideStartAnim = false;
static float glideStartTimer = 0.0f;

const float glideLeanBuildRate = 320.0f;
const float glideMaxLeanAngle = 55.0f;
const float glideLeanDecaySpeed = 60.0f;
const float glideLeanThreshold = 12.0f;

const float glideTurnRate = 12.0f;
const float glidePushPerSecond = 3.0f;
const float glideStartDelay = 1.16f;
const float glideStartVir01Delay = 1.52f;

static bool isConfigInitialized = false;
static bool conKnuxLegacyGlide = false;
static bool conKnuxLegacyInfiniteGlide = false;

{
    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    float deltaTime = Time.GetDeltaTime();

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(kinematics, out var out_pKinematics))
        return;

    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");

    var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
    var previousState = Player.State.GetPreviousStateID<Knuckles.StateID>();

    Vector3 worldInput = out_pKinematics->WorldInput;
    Vector3 velocity = out_pKinematics->Velocity;

    bool isMoving = worldInput.LengthSquared() > 0.001f;
    bool isSideView = Player.Status.IsSideView();

    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateSpinDash, Knuckles.StateID.StateSliding);

    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conKnuxLegacyGlide = INI.GetField<bool>(ini, "Main", "KnuxLegacyGlide", conKnuxLegacyGlide);
            conKnuxLegacyInfiniteGlide = INI.GetField<bool>(ini, "Main", "KnuxLegacyInfiniteGlide", conKnuxLegacyInfiniteGlide);
            isConfigInitialized = true;
        }
    }

    if (!hasCheckedDisableGlideTransition)
    {
        var codes = HMM.GetCodes();
        isDisableGlideTransitionEnabled = codes.Contains("Animation/Knuckles/Disable Gliding Transition");
        hasCheckedDisableGlideTransition = true;
    }

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    bool isInfiniteGlideStart = pBlackboardItem->RingCount == pBlackboardItem->RingCapacity;

    bool legacyGlideActive = isInfiniteGlideStart ? conKnuxLegacyInfiniteGlide : conKnuxLegacyGlide;
    bool startAnimEligible = legacyGlideActive && !isDisableGlideTransitionEnabled;

    // Lean
    void UpdateGlideLean()
    {
        var currentRotation = out_pKinematics->Rotation;
        var deltaRot = Quaternion.Concatenate(Quaternion.Inverse(previousGlideRotation), currentRotation);

        float yawDelta = 2.0f * (float)Math.Atan2(deltaRot.Y, deltaRot.W);
        float yawSpeed = yawDelta / Math.Max(deltaTime, 0.0001f);

        float rawLean = yawSpeed * (180.0f / (float)Math.PI) * (glideLeanBuildRate / 360.0f);
        float targetLean = Math.Max(-glideMaxLeanAngle, Math.Min(rawLean, glideMaxLeanAngle));

        if (Math.Abs(targetLean) > Math.Abs(currentGlideLeanAngle) || Math.Sign(targetLean) == Math.Sign(currentGlideLeanAngle))
        {
            float diff = targetLean - currentGlideLeanAngle;
            currentGlideLeanAngle += diff * Math.Min(glideLeanBuildRate * deltaTime / glideMaxLeanAngle, 1.0f);
        }
        else
        {
            float decayStep = Math.Sign(-currentGlideLeanAngle) * Math.Min(Math.Abs(currentGlideLeanAngle), glideLeanDecaySpeed * deltaTime);
            currentGlideLeanAngle += decayStep;
        }

        previousGlideRotation = currentRotation;
    }

    // Glide Leaning Animations
    string GetGlideAnim()
    {
        bool isRingMax = pBlackboardItem->RingCount == pBlackboardItem->RingCapacity;

        if (!isSideView && Math.Abs(currentGlideLeanAngle) > glideLeanThreshold)
        {
            if (isRingMax)
                return currentGlideLeanAngle > 0 ? "GLIDING_RING_MAX_L" : "GLIDING_RING_MAX_R";

            return currentGlideLeanAngle > 0 ? "GLIDING_L" : "GLIDING_R";
        }

        return isRingMax ? "GLIDING_RING_MAX" : "GLIDING";
    }

    void SetGlideAnim(string animName)
    {
        if (animName != currentGlideAnim)
        {
            Player.Animation.SetAnimation(animName);
            currentGlideAnim = animName;
        }
    }

    if (currentState == Knuckles.StateID.StateGliding)
    {
        if (!hasSetGlideAnim)
        {
            Player.Effect.StopAnimationEffects();
            currentGlideAnim = "";
            currentGlideLeanAngle = 0.0f;
            glideTurnSign = 0.0f;
            previousGlideRotation = out_pKinematics->Rotation;
            hasSetGlideAnim = true;

            // Glide Start
            if (startAnimEligible)
            {
                Player.Animation.SetAnimation(isInfiniteGlideStart ? "GLIDE_RING_MAX_START_VIR01" : "GLIDE_START_VIR01");
                currentGlideAnim = isInfiniteGlideStart ? "GLIDE_RING_MAX_START_VIR01" : "GLIDE_START_VIR01";
                isPlayingGlideStartAnim = true;
                glideStartTimer = 0.0f;
            }
            else
            {
                isPlayingGlideStartAnim = false;
            }
        }

        if (isPlayingGlideStartAnim)
        {
            if (!isPaused)
                glideStartTimer += deltaTime;

            UpdateGlideLean();

            float requiredDelay = isInfiniteGlideStart ? glideStartVir01Delay : glideStartDelay;

            if (glideStartTimer >= requiredDelay)
            {
                isPlayingGlideStartAnim = false;
                SetGlideAnim(GetGlideAnim());
            }
        }
        else
        {
            UpdateGlideLean();
            SetGlideAnim(GetGlideAnim());
        }

        if (!isPaused)
            kinematics->Velocity += Player.Kinematics.GetForward() * glidePushPerSecond * deltaTime;

        if (isMoving)
        {
            Vector3 inputDir = Vector3.Normalize(worldInput);
            Vector3 forward = VectorHelpers.GetForward(out_pKinematics->Rotation);

            float inputAngle = VectorHelpers.SignedAngle(forward, inputDir, Vector3.UnitY);
            float rotationStep;

            // 2D Glide Turn
            if (isSideView)
            {
                Vector3 flatForward = new Vector3(forward.X, 0.0f, forward.Z);
                Vector3 flatInput = new Vector3(inputDir.X, 0.0f, inputDir.Z);

                bool flatValid = flatForward.LengthSquared() > 0.001f && flatInput.LengthSquared() > 0.001f;

                if (flatValid)
                {
                    flatForward = Vector3.Normalize(flatForward);
                    flatInput = Vector3.Normalize(flatInput);
                }

                float alignment = flatValid ? Vector3.Dot(flatForward, flatInput) : 1.0f;

                if (glideTurnSign == 0.0f && flatValid && alignment < 0.0f)
                {
                    glideTurnSign = -1.0f;
                    glideTurnTarget = flatInput;
                    glideTurnSpeed = new Vector3(velocity.X, 0.0f, velocity.Z).Length();
                }

                if (glideTurnSign != 0.0f)
                {
                    float targetAlign = Math.Max(-1.0f, Math.Min(1.0f, Vector3.Dot(flatForward, glideTurnTarget)));
                    float remaining = (float)Math.Acos(targetAlign);

                    rotationStep = glideTurnSign * (float)Math.Min(glideTurnRate * deltaTime, remaining);

                    if (remaining <= glideTurnRate * deltaTime)
                        glideTurnSign = 0.0f;
                }
                else
                {
                    rotationStep = (float)Math.Sign(inputAngle) * (float)Math.Min(Math.Abs(inputAngle), glideTurnRate * deltaTime);
                }
            }
            else
            {
                rotationStep = (float)Math.Min(Math.Abs(inputAngle), glideTurnRate * deltaTime);
                rotationStep *= (float)Math.Sign(inputAngle);
            }

            var rotationDelta = Quaternion.CreateFromAxisAngle(Vector3.UnitY, rotationStep);

            out_pKinematics->Rotation = Quaternion.Normalize(Quaternion.Concatenate(out_pKinematics->Rotation, rotationDelta));

            Vector3 horizontalVelocity = new Vector3(velocity.X, 0.0f, velocity.Z);

            if (horizontalVelocity.LengthSquared() > 0.001f)
            {
                if (isSideView && glideTurnSign != 0.0f)
                {
                    Vector3 turnForward = VectorHelpers.GetForward(out_pKinematics->Rotation);
                    Vector3 flatForward = new Vector3(turnForward.X, 0.0f, turnForward.Z);

                    if (flatForward.LengthSquared() > 0.001f)
                        horizontalVelocity = Vector3.Normalize(flatForward) * glideTurnSpeed;
                }
                else
                {
                    horizontalVelocity = Vector3.Transform(horizontalVelocity, rotationDelta);
                }

                kinematics->Velocity = new Vector3(horizontalVelocity.X, velocity.Y, horizontalVelocity.Z);
            }
        }
    }
    else
    {
        hasSetGlideAnim = false;
        isPlayingGlideStartAnim = false;
        glideStartTimer = 0.0f;
    }

    // Glide Landing
    if (Player.Status.IsGrounded() && previousState == Knuckles.StateID.StateGliding)
        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateSpinDash);

    if (currentState == Knuckles.StateID.StateSpinDash)
    {
        Player.Animation.SetAnimation("SLIDING_GLIDING");
        Player.Effect.StopAnimationEffects();

        if (!isDust)
        {
            Player.Effect.PlayEffect("isDust", "ef_ft_spinboost_charge01_sa01");
            isDust = true;
        }
    }
    else
    {
        Player.Effect.StopEffect("isDust");
        isDust = false;
    }

    if (!Player.Status.IsGrounded() && currentState == Knuckles.StateID.StateSpinDash)
        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateFall);

    if (currentState == Knuckles.StateID.StateSpinDash && Player.Kinematics.GetHorizontalMagnitude() < 10.0f)
        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateSpringJumpHeadLand);

    // Gliding (Open Zone)
    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.minSpeed, 20.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.minSpeedRingMax, 40.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.moveWaitTime, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.minActionTime, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.fallSpeed, 1.8f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.fallAccel, 2.5f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.maxSteerSpeed, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.rollSpeed, 200.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.neutralRollSpeed, 150.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.rollSpeedRingMax, 220.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.neutralRollSpeedRingMax, 170.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.yawSpeed, 350.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.yawSpeedRingMax, 380.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.maxRollAngle, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.rollAngleRatioMin, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.rollAngleRatioMax, 120.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.rollAngleRatioMinRingMax, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.rollAngleRatioMaxRingMax, 130.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.height, 0.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.gliding.startHeight, 0.0f);
    }

    // Gliding (2D Cyber Space)
    if (KnucklesParametersInfo.pData != null)
    {
