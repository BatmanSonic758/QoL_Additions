Code "Dynamic Damage Animations" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Memory"
#lib "Player"
#lib "BlackboardStatus"
#lib "CyberCorruption"

#import "GOComponents"

#load "System.Numerics.dll"
using System.Numerics;

static bool isDamageAir = false;
static bool isDamageGround = false;

// Tracks a single damage instance and the direction captured when it began
static bool isDamageActive = false;
static bool damageHitFromFront = false;

{
    CyberCorruption.Update();

    bool isBattle = IS_WORLD_FLAG(IsBattle);

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    string frontDamageAnim;

    if (CyberCorruption.Level == 2)
        frontDamageAnim = "DAMAGE_FRONT_CORRUPTION_STRONG";
    else if (CyberCorruption.Level == 1)
        frontDamageAnim = "DAMAGE_FRONT_CORRUPTION_WEAK";
    else
        frontDamageAnim = isBattle ? "DAMAGE_FRONT_BATTLE" : "DAMAGE_FRONT";

    bool isGrounded = Player.Status.IsGrounded();

    if (currentState == Sonic.StateID.StateDamageBlowOff)
    {
        if (previousState != Sonic.StateID.StateDamageBlowOff && !isDamageActive)
        {
            damageHitFromFront = GetHitDirection(isGrounded);
            isDamageActive = true;
        }

        if (!isGrounded)
        {
            if (!isDamageAir)
            {
                Player.Animation.SetAnimation(damageHitFromFront ? "DAMAGE_FRONT_AIR" : "BATTLE_DAMAGE_BLOW_BACK");
                isDamageAir = true;
            }
            isDamageGround = false;
        }
        else
        {
            if (!isDamageGround)
            {
                Player.Animation.SetAnimation(damageHitFromFront ? frontDamageAnim : "dummy");
                Player.Sound.PlaySound("sn_collision");
                isDamageGround = true;
            }
            isDamageAir = false;
        }
    }
    else
    {
        isDamageActive = false;
        isDamageAir = false;
        isDamageGround = false;
    }
}

static bool GetHitDirection(bool isGroundHit)
{
    if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(Player.Kinematics.Get(), out var out_pKinematics))
        return false;

    var forward = Vector3.Transform(new Vector3(1, 0, 0), out_pKinematics->Rotation);
    var worldInput = out_pKinematics->WorldInput;

    forward.Y = 0;
    worldInput.Y = 0;

    if (forward.Length() < 0.01f || worldInput.Length() < 0.01f)
        return false;

    forward = Vector3.Normalize(forward);
    var inputDir = Vector3.Normalize(worldInput);
    var dot = Vector3.Dot(forward, inputDir);

    return isGroundHit ? dot > 0.2f : dot > -0.2f;
}

Code "Dynamic Super Sonic Damage Animations" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardItem"
#lib "Postures"
#lib "BlackboardStatus"

#import "Postures"

static bool isSuperWait = false;
static bool isSuperDamage = false;

{
    if (Player.GetPlayerType() != Player.PlayerType.Sonic || !BlackboardStatus.IsSuper())
        return;

    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    var pPostureDamageBlowOffHeavy = Player.Posture.GetPosture<PostureDamageBlowOffHeavy>();

    if (pPostureDamageBlowOffHeavy == null)
        return;

    int rings = pBlackboardItem->RingCount;

    bool isCritical = rings <= 150;

    if (pPostureDamageBlowOffHeavy->Phase == PostureDamageBlowOffHeavy.PhaseType.Damage)
    {
        if (!isSuperDamage)
        {
            Player.Animation.SetAnimation(isCritical ? "DAMAGE02" : "DAMAGE_FRONT_START");

            isSuperDamage = true;
        }
    }
    else
    {
        isSuperDamage = false;
    }

    if (pPostureDamageBlowOffHeavy->Phase == PostureDamageBlowOffHeavy.PhaseType.Wait)
    {
        if (!isSuperWait)
        {
            Player.Animation.SetAnimation(isCritical ? "DAMAGE02_FRONT_END" : "DAMAGE_FRONT_END");

            isSuperWait = true;
        }
    }
    else
    {
        isSuperWait = false;
    }
}

Code "Super Sonic Boss Damage Animations" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardItem"
#lib "BlackboardStatus"

#import "Services"

static bool isSuperDamage = false;

{
    if (Player.GetPlayerType() != Player.PlayerType.Sonic || !BlackboardStatus.IsSuper())
        return;

    bool isBoss = Player.State.GetStatePlugin("StatePluginBossBattle") != null;

    bool isSupreme = isBoss && (GameManager.GetGameObject("Rifle0") != null);
    bool isTheEnd = isBoss && (GameManager.GetGameObject("RifleBeast0") != null);

    bool isSpringJump = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSpringJump;

    if (!((isSupreme || isTheEnd) && isSpringJump))
    {
        isSuperDamage = false;
        return;
    }

    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    bool isCritical = pBlackboardItem->RingCount <= 150;

    if (!isSuperDamage)
    {
        Player.Animation.SetAnimation(isCritical ? "DAMAGE02" : "DAMAGE_FRONT_LOOP");
        isSuperDamage = true;
    }
}

Code "Restore Sky Dive Idle Animation" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Time"
#lib "Player"
#lib "XInput"
#lib "GameManager"
#lib "BlackboardStatus"

#load "System.Numerics.dll"

using System.Numerics;

const float diveTimer = 5.0f;
static float diveTimeElapsed = 0.0f;
static bool hasStartedDiveIdleAnimation = false;

static bool lastMovementState = false;
static int movementCheckCounter = 0;

static bool IsMovementDetected()
{
    movementCheckCounter++;
    if (movementCheckCounter >= 3)
    {
        var xinputState = XInput.GetState();
        if (xinputState == null)
        {
            lastMovementState = true;
        }
        else
        {
            Vector2 stick = XInput.GetAnalog(0, true);
            lastMovementState = Math.Abs(stick.X) >= 0.25f || Math.Abs(stick.Y) >= 0.25f;
        }
        movementCheckCounter = 0;
    }

    return lastMovementState;
}

{
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    bool isDiving = IS_STATE_FLAG(IsDiving);
    bool isMoving = IsMovementDetected();

    if (isDiving)
    {
        if (!isMoving)
        {
            if (diveTimeElapsed < diveTimer)
            {
                bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                                GameManager.GetGameObject("MapMenu") != null ||
                                GameManager.GetGameObject("PhotoMode") != null;

                if (!isPaused)
                {
                    diveTimeElapsed += Time.GetDeltaTime();

                    if (diveTimeElapsed >= diveTimer && !hasStartedDiveIdleAnimation)
                    {
                        Player.Animation.SetAnimation("DIVE_IDLE_START");
                        hasStartedDiveIdleAnimation = true;
                    }
                }
            }
        }
        else
        {
            if (hasStartedDiveIdleAnimation)
            {
                Player.Animation.SetAnimation("DIVE_START");
            }

            diveTimeElapsed = 0.0f;
            hasStartedDiveIdleAnimation = false;
        }
    }
    else
    {
        diveTimeElapsed = 0.0f;
        hasStartedDiveIdleAnimation = false;
    }
}

Code "Play All Idle Animations [EXPERIMENTAL]" by "Batman Sonic"
//

#lib "Player"
#lib "Time"

using System;

static long AdrIDLEACT00 = 0;
static long AdrIDLEACT01 = 0;
static long AdrIDLEACT06 = 0;
static long AdrIDLEACT07 = 0;
static long AdrIDLEACT08 = 0;
static long AdrIDLEACT09 = 0;

static Random rng = new Random();

static bool hasWrittenNames = false;
static bool wasUnderwater = false;
static float rerollTimer = 0.0f;

const float rerollInterval = 0.25f;

// Padded to 14 bytes so a short name fully covers a longer _SV name and still ends in NUL
static string[] idlePool = new string[]
{
    "IDLE_ACT00\0\0\0\0",
    "IDLE_ACT01\0\0\0\0",
    "IDLE_ACT06\0\0\0\0",
    "IDLE_ACT07\0\0\0\0",
    "IDLE_ACT08_SV\0",
    "IDLE_ACT09_SV\0"
};

static string waterIdle = "WATER_IDLE\0\0\0\0";

static void WriteIdleName(long address, bool isUnderwater)
{
    string name = isUnderwater ? waterIdle : idlePool[rng.Next(idlePool.Length)];

    WriteProtected<byte>(address, System.Text.Encoding.UTF8.GetBytes(name));
}

{
    // Every address is resolved before any write, otherwise a later scan could land on an already swapped slot
    // 0x14153F958
    if (AdrIDLEACT00 == 0)
        AdrIDLEACT00 = ScanSignature("IDLE_ACT00\0", "xxxxxxxxxxx");

    // 0x14153F968
    if (AdrIDLEACT01 == 0)
        AdrIDLEACT01 = ScanSignature("IDLE_ACT01\0", "xxxxxxxxxxx");

    // 0x14153F938
    if (AdrIDLEACT06 == 0)
        AdrIDLEACT06 = ScanSignature("IDLE_ACT06\0", "xxxxxxxxxxx");

    // 0x14153F948
    if (AdrIDLEACT07 == 0)
        AdrIDLEACT07 = ScanSignature("IDLE_ACT07\0", "xxxxxxxxxxx");

    // 0x14153F918
    if (AdrIDLEACT08 == 0)
        AdrIDLEACT08 = ScanSignature("IDLE_ACT08_SV\0", "xxxxxxxxxxxxxx");

    // 0x14153F928
    if (AdrIDLEACT09 == 0)
        AdrIDLEACT09 = ScanSignature("IDLE_ACT09_SV\0", "xxxxxxxxxxxxxx");

    if (AdrIDLEACT00 == 0 || AdrIDLEACT01 == 0 || AdrIDLEACT06 == 0 || AdrIDLEACT07 == 0 || AdrIDLEACT08 == 0 || AdrIDLEACT09 == 0)
        return;

    bool isUnderwater = Player.Status.IsUnderwater();

    rerollTimer -= Time.GetDeltaTime();

    // The names only have to be fresh when an idle act starts, so a few rolls a second is plenty and spares the page protection calls
    if (hasWrittenNames && isUnderwater == wasUnderwater && (isUnderwater || rerollTimer > 0.0f))
        return;

    WriteIdleName(AdrIDLEACT00, isUnderwater);
    WriteIdleName(AdrIDLEACT01, isUnderwater);
    WriteIdleName(AdrIDLEACT06, isUnderwater);
    WriteIdleName(AdrIDLEACT07, isUnderwater);
    WriteIdleName(AdrIDLEACT08, isUnderwater);
    WriteIdleName(AdrIDLEACT09, isUnderwater);

    hasWrittenNames = true;
    wasUnderwater = isUnderwater;
    rerollTimer = rerollInterval;
}

Code "Drowning Idle Animation" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "GameManager"
#lib "BlackboardStatus"

static bool isDrownIdle = false;
static float underwaterTime = 0.0f;
const float idleTime = 8.0f;

{
    if (Player.Status.IsUnderwater() && IS_STATE_FLAG(IsIdle))
    {
        if (underwaterTime < idleTime)
        {
            bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                            GameManager.GetGameObject("MapMenu") != null ||
                            GameManager.GetGameObject("PhotoMode") != null;

            if (!isPaused)
            {
                underwaterTime += Time.GetDeltaTime();

                if (underwaterTime >= idleTime && !isDrownIdle)
                {
                    Player.Animation.SetAnimation("WATER_IDLE_START");
                    isDrownIdle = true;
                }
            }
        }
    }
    else
    {
        isDrownIdle = false;
        underwaterTime = 0.0f;
    }
}

Code "Restore Sky Dive Start Animation" by "Batman Sonic"
//

#lib "Player"

static bool isDiveAnimation = false;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool isDiveStart = (currentState == Sonic.StateID.StateDiving &&
                        previousState != Sonic.StateID.StateDivingFall &&
                        previousState != Sonic.StateID.StateDivingSpecialDamage) ||
                       (currentState == Sonic.StateID.StateDivingRoot &&
                        (previousState == Sonic.StateID.StateSpringJump ||
                         previousState == Sonic.StateID.StateAuraTrain)) ||
                       (previousState == Sonic.StateID.StateDiving &&
                        currentState == Sonic.StateID.StateFall);

    if (isDiveStart)
    {
        if (!isDiveAnimation)
        {
            Player.Animation.SetAnimation("DIVE_START");
            isDiveAnimation = true;
        }
    }
    else
    {
        isDiveAnimation = false;
    }
}

Code "Fix Slide Animations" by "Batman Sonic"
//

#lib "Player"

static bool isSlideStart = false;
static bool isSlideEnd = false;
static bool isStompLandToSlide = false;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (previousState == Sonic.StateID.StateStompingDown &&
        currentState == Sonic.StateID.StateStompingLand)
    {
        isStompLandToSlide = true;
    }

    if (currentState == Sonic.StateID.StateSliding)
    {
        if (isStompLandToSlide ||
            previousState == Sonic.StateID.StateRun ||
            previousState == Sonic.StateID.StateLeftStepRun ||
            previousState == Sonic.StateID.StateRightStepRun)
        {
            if (!isSlideStart)
            {
                Player.Animation.SetAnimation("SLIDING_START");
                isSlideStart = true;
            }

            isStompLandToSlide = false;
        }
    }
    else if (currentState != Sonic.StateID.StateStompingLand)
    {
        isStompLandToSlide = false;
        isSlideStart = false;
    }

    if (currentState == Sonic.StateID.StateSquat &&
        previousState == Sonic.StateID.StateSliding)
    {
        if (!isSlideEnd)
        {
            if (Player.GetPlayerType() == Player.PlayerType.Amy)
                Player.Animation.SetAnimation("SLIDING_IDLE");
            else
                Player.Animation.SetAnimation("SLIDING_END");

            isSlideEnd = true;
        }
    }

    else if (currentState == Sonic.StateID.StateStandRoot &&
             previousState == Sonic.StateID.StateSliding)
    {
        if (!isSlideEnd)
        {
            Player.Animation.SetAnimation("SLIDING_IDLE");
            Player.Sound.PlaySound("sn_stand_1");
            isSlideEnd = true;
        }
    }
    else if (currentState != Sonic.StateID.StateSliding)
    {
        isSlideEnd = false;
    }
}

Code "Restore Landing Big" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardStatus"

using System;

static long AdrLANDING = 0;
static long AdrINJURY = 0;
static long AdrBATTLE = 0;
static long AdrWEAK = 0;
static long AdrSTRONG = 0;

static bool isAirborne = false;
static bool isBigWritten = false;
static float airPeakHeight = 0.0f;
const float bigLandingHeight = 5.0f;

{
    // Every address is resolved before any write, otherwise a later scan could land on an already swapped name
    if (AdrLANDING == 0)
    {
        // 0x1414C5378, leading NUL keeps the scan from matching the tail of a longer name
        long found = ScanSignature("\0LANDING\0", "xxxxxxxxx");

        if (found != 0)
            AdrLANDING = found + 1;
    }

    if (AdrINJURY == 0)
    {
        // 0x14153F888, leading NUL keeps the scan from matching the tail of a longer name
        long found = ScanSignature("\0LANDING_INJURY\0", "xxxxxxxxxxxxxxxx");

        if (found != 0)
            AdrINJURY = found + 1;
    }

    if (AdrBATTLE == 0)
    {
        // 0x14153F898, leading NUL keeps the scan from matching the tail of a longer name
        long found = ScanSignature("\0LANDING_BATTLE\0", "xxxxxxxxxxxxxxxx");

        if (found != 0)
            AdrBATTLE = found + 1;
    }

    if (AdrWEAK == 0)
    {
        // 0x14153F8A8, leading NUL keeps the scan from matching the tail of a longer name
        long found = ScanSignature("\0LANDING_CORRUPTION_WEAK\0", "xxxxxxxxxxxxxxxxxxxxxxxxx");

        if (found != 0)
            AdrWEAK = found + 1;
    }

    if (AdrSTRONG == 0)
    {
        // 0x14153F8C0, leading NUL keeps the scan from matching the tail of a longer name
        long found = ScanSignature("\0LANDING_CORRUPTION_STRONG\0", "xxxxxxxxxxxxxxxxxxxxxxxxxxx");

        if (found != 0)
            AdrSTRONG = found + 1;
    }

    if (AdrLANDING == 0 || AdrINJURY == 0 || AdrBATTLE == 0 || AdrWEAK == 0 || AdrSTRONG == 0)
        return;

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float height = kinematics->Position.Y;

    // The names stay as the fall left them so the landing reads them, the next airtime resets them
    if (Player.Status.IsGrounded())
    {
        isAirborne = false;
        return;
    }

    if (!isAirborne || height > airPeakHeight)
        airPeakHeight = height;

    isAirborne = true;

    bool isBigFall = !BlackboardStatus.IsSuper() && airPeakHeight - height >= bigLandingHeight;

    if (isBigFall == isBigWritten)
        return;

    WriteProtected<byte>(AdrLANDING, System.Text.Encoding.UTF8.GetBytes(isBigFall ? "LANDBIG" : "LANDING"));
    WriteProtected<byte>(AdrINJURY, System.Text.Encoding.UTF8.GetBytes(isBigFall ? "LANDBIG_INJURY" : "LANDING_INJURY"));
    WriteProtected<byte>(AdrBATTLE, System.Text.Encoding.UTF8.GetBytes(isBigFall ? "LANDBIG_BATTLE" : "LANDING_BATTLE"));
    WriteProtected<byte>(AdrWEAK, System.Text.Encoding.UTF8.GetBytes(isBigFall ? "LANDBIG_CORRUPTION_WEAK" : "LANDING_CORRUPTION_WEAK"));
    WriteProtected<byte>(AdrSTRONG, System.Text.Encoding.UTF8.GetBytes(isBigFall ? "LANDBIG_CORRUPTION_STRONG" : "LANDING_CORRUPTION_STRONG"));
    isBigWritten = isBigFall;
}

Code "Camera Tweaks" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Player"
#lib "GameObject"
#lib "Reflection"
#lib "StandardCameraConfig"
#lib "MathHelpers"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

#import "Cameras"
#import "GOComponents"

static float currentFOV = 52.0f;
static float currentDist = 5.0f;

static bool isBattle = false;
static int battleCheckCounter = 0;

static bool isConfigInitialized = false;
static int conCameraFOV = 1;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conCameraFOV = INI.GetField<int>(ini, "Main", "CameraFOV", conCameraFOV);
            isConfigInitialized = true;
        }
    }

    var StandardCameraConfigInfo = Reflection.GetDataInfo<StandardCameraConfig.Root>("standard_camera");

    if (StandardCameraConfigInfo.pData != null)
    {
        RFL_SET_PARAM(StandardCameraConfigInfo, common.targetUpOffset, 0.4f);
        RFL_SET_PARAM(StandardCameraConfigInfo, dash.targetUpOffset, 0.25f);
        RFL_SET_PARAM(StandardCameraConfigInfo, battle.distance, 10.0f);
        RFL_SET_PARAM(StandardCameraConfigInfo, dash.minDistance, 4.0f);
        RFL_SET_PARAM(StandardCameraConfigInfo, dash.maxDistance, 4.0f);
    }

    var pPlayer = Player.GetPlayerData();

    if (pPlayer == null)
        return;

    var pGOCCamera = GameObject.GetGOC<GOCCamera>(&pPlayer->GameObject);

    if (pGOCCamera == null)
        return;

    var pStandardCamera = pGOCCamera->GetCameraController<StandardCamera>();

    if (pStandardCamera == null)
        return;

    var pStandardCameraContext = pStandardCamera->pContext;

    if (pStandardCameraContext == null)
        return;

    battleCheckCounter++;
    if (battleCheckCounter >= 10)
    {
        isBattle = IS_WORLD_FLAG(IsBattle);
        battleCheckCounter = 0;
    }

    float speed = Player.Kinematics.GetHorizontalMagnitude();

    float baseFOV = isBattle ? 58.0f : 52.0f;
    float maxFOV = isBattle ? 70.0f : 75.0f;
    float boostFOV = 44.0f;
    float minDist = isBattle ? 7.0f : 5.0f;
    float maxDist = isBattle ? 13.0f : 11.0f;

    float targetFOV = baseFOV;
    float targetDist = minDist;

    // Battle always keeps the speed-based framing so every mode fights the same
    bool useSpeedScaling = isBattle || conCameraFOV != 3;

    if (useSpeedScaling)
    {
        if (speed >= 70.0f)
        {
            float fovFactor = MathHelpers.Clamp((speed - 70.0f) / 50.0f, 0.0f, 1.0f);
            targetFOV = MathHelpers.Lerp(baseFOV, maxFOV, fovFactor);
        }

        if (speed >= 20.0f)
        {
            float distFactor = MathHelpers.Clamp((speed - 20.0f) / 70.0f, 0.0f, 1.0f);
            targetDist = MathHelpers.Lerp(minDist, maxDist, distFactor);
        }
    }

    if (!isBattle && conCameraFOV == 2 && IS_STATE_FLAG(IsBoost))
        targetFOV = boostFOV;

    // Blend rates were tuned at 60 FPS, scaled so higher frame rates don't settle the camera faster
    float transitionSpeed = isBattle ? 0.12f : 0.08f;
    float blend = 1.0f - (float)Math.Pow(1.0f - transitionSpeed, Time.GetDeltaTime() * 60.0f);

    currentFOV = MathHelpers.Lerp(currentFOV, targetFOV, blend);
    currentDist = MathHelpers.Lerp(currentDist, targetDist, blend);

    pStandardCameraContext->SetFieldOfView(currentFOV);
    pStandardCameraContext->Distance = currentDist;
    pStandardCameraContext->DistanceSuspension = currentDist * 0.15f;
}

Code "Quick Step Slide" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "GameManager"

static bool wasSliding = false;
static bool cancelReady = false;

static float stepTimer = 0.0f;
static float slideTimer = 0.0f;
static float slideCarry = 0.0f;

const float cancelWindow = 0.08f;
const float minSlide = 0.15f;
const float slideEntryGain = 1.35f;
const float slideDecay = 2.6f;

{
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    if (isPaused)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool holdSlide = Player.Input.IsDown(Player.InputActionType.PlayerStomping);
    bool holdLeft = Player.Input.IsDown(Player.InputActionType.PlayerLeftStep);
    bool holdRight = Player.Input.IsDown(Player.InputActionType.PlayerRightStep);

    bool isQuickStepState = currentState == Sonic.StateID.StateLeftStepRun || currentState == Sonic.StateID.StateRightStepRun;

    if (isQuickStepState)
    {
        stepTimer += Time.GetDeltaTime();

        if (stepTimer > cancelWindow)
            cancelReady = true;

        // Cancelling the quickstep back into a slide keeps the chain going
        if (holdSlide && cancelReady)
        {
            slideCarry = kinematics->Velocity.Length() * slideEntryGain;
            kinematics->Velocity = Player.Kinematics.GetForward() * slideCarry;

            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSliding);
            wasSliding = true;
            stepTimer = 0.0f;
            slideTimer = 0.0f;
            cancelReady = false;
        }
    }
    else
    {
        stepTimer = 0.0f;
        cancelReady = false;
    }

    if (currentState == Sonic.StateID.StateSliding)
    {
        slideTimer += Time.GetDeltaTime();

        if (slideTimer >= minSlide)
        {
            if (holdLeft)
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateLeftStepRun);
                slideTimer = 0.0f;
            }
            else if (holdRight)
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRightStepRun);
                slideTimer = 0.0f;
            }
        }

        if (wasSliding)
        {
            if (slideCarry <= 0.0f)
                slideCarry = kinematics->Velocity.Length();

            slideCarry = Math.Max(0.0f, slideCarry - slideDecay * Time.GetDeltaTime());
            kinematics->Velocity = Player.Kinematics.GetForward() * slideCarry;
        }
    }
    else if (!isQuickStepState)
    {
        wasSliding = false;
        slideTimer = 0.0f;
        slideCarry = 0.0f;
    }
}

Code "Fix Side View Damage Frames" by "Batman Sonic"
