Code "Crawl" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "MathHelpers"
#lib "XInput"
#lib "Lua"

#load "System.Numerics.dll"

using System.Numerics;

static bool isCrawling = false;
static bool isCrawlAnimation = false;

const float crawlSpeedMultiplier = 0.25f;
static float movementHoldTime = 0.0f;
const float minHoldTime = 0.1f;

static bool IsMovementDetected()
{
    // If no controller is connected, assume keyboard movement
    if (XInput.GetState() == null)
        return true;

    Vector2 stick = XInput.GetAnalog(0, true);

    return Math.Abs(stick.X) >= 0.25f || Math.Abs(stick.Y) >= 0.25f;
}

{
    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateQuickStepJump, Sonic.StateID.StateRun);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateQuickStepJump, Tails.StateID.StateRun);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateQuickStepJump, Knuckles.StateID.StateRun);
    Player.State.Redirect<Amy.StateID>(Amy.StateID.StateQuickStepJump, Amy.StateID.StateRun);

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();
    var kinematics = Player.Kinematics.Get();
    var deltaTime = Time.GetDeltaTime();

    if (kinematics == null)
        return;

    var playerType = Player.GetPlayerType();

    bool isMoving = IsMovementDetected();
    bool stompHeld = Player.Input.IsDown(Player.InputActionType.PlayerStomping);
    bool stompReleased = Player.Input.IsReleased(Player.InputActionType.PlayerStomping);

    // A short hold before crawling keeps squat and crawl from fighting over the state
    if (currentState == Sonic.StateID.StateSquat && stompHeld && isMoving)
    {
        movementHoldTime += deltaTime;
    }
    else if (currentState != Sonic.StateID.StateQuickStepJump)
    {
        movementHoldTime = 0.0f;
    }

    bool isSonicCrawl = !isCrawling &&
                        playerType == Player.PlayerType.Sonic &&
                        (previousState == Sonic.StateID.StateSquat && currentState == Sonic.StateID.StateSliding) && stompHeld;

    bool isFriendsCrawl = !isCrawling &&
                          (playerType == Player.PlayerType.Tails ||
                           playerType == Player.PlayerType.Knuckles ||
                           playerType == Player.PlayerType.Amy) && isMoving &&
                           movementHoldTime >= minHoldTime;

    if (isSonicCrawl || isFriendsCrawl)
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateQuickStepJump);
        isCrawling = true;
        isCrawlAnimation = false;
        movementHoldTime = 0.0f;
    }

    if (currentState == Sonic.StateID.StateQuickStepJump)
    {
        if (!isCrawlAnimation)
        {
            Player.Animation.SetAnimation("CRAWL");

            Lua.Call("SetPlayerAbilityEnabled", "Boost", false);
            Lua.Call("SetPlayerAbilityEnabled", "Cyloop", false);

            isCrawlAnimation = true;
        }

        var vel = kinematics->Velocity;
        float targetSpeed = vel.Length() * crawlSpeedMultiplier;

        vel.X = MathHelpers.Clamp(vel.X, -targetSpeed, targetSpeed);
        vel.Z = MathHelpers.Clamp(vel.Z, -targetSpeed, targetSpeed);
        kinematics->Velocity = vel;

        if (stompReleased)
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSquat);
            Lua.Call("SetPlayerAbilityEnabled", "Boost", true);
            Lua.Call("SetPlayerAbilityEnabled", "Cyloop", true);

            isCrawling = false;
            isCrawlAnimation = false;
            movementHoldTime = 0.0f;
        }
    }
    else if (isCrawling || isCrawlAnimation)
    {
        Lua.Call("SetPlayerAbilityEnabled", "Boost", true);
        Lua.Call("SetPlayerAbilityEnabled", "Cyloop", true);

        isCrawling = false;
        isCrawlAnimation = false;
        movementHoldTime = 0.0f;
    }
}

Code "Fix Slide Transitions" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "GameManager"
#lib "BlackboardStatus"

#import "Plugins"

static bool initializedSliding = false;
static bool wasStompHeldOnEntry = false;

static float stompReleaseDelay = 0.0f;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (currentState != Sonic.StateID.StateSliding)
    {
        wasStompHeldOnEntry = false;
        stompReleaseDelay = 0.0f;
        initializedSliding = false;
        return;
    }

    if (!initializedSliding)
    {
        wasStompHeldOnEntry = Player.Input.IsDown(Player.InputActionType.PlayerStomping);
        stompReleaseDelay = 0.0f;
        initializedSliding = true;
    }

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    if (!isPaused && stompReleaseDelay < 0.2f)
    {
        stompReleaseDelay += Time.GetDeltaTime();

        if (stompReleaseDelay > 0.2f)
            stompReleaseDelay = 0.2f;
    }

    bool stompReleased = Player.Input.IsReleased(Player.InputActionType.PlayerCyloop);

    if (stompReleased && wasStompHeldOnEntry && stompReleaseDelay < 0.2f)
    {
        stompReleased = false;
    }

    if (stompReleased)
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpringJumpHeadLand);
        return;
    }

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    bool hasBoostEnergy = boostPlugin != null && (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0;

    if (hasBoostEnergy && Player.Input.IsDown(Player.InputActionType.PlayerBoost))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRun);
        SET_STATE_FLAG(IsBoost, true);
        return;
    }

    if (!Player.Status.IsGrounded())
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateFall);
    }
}

Code "Fix Squat Transitions" by "Batman Sonic"
