Code "Fix Wall Leave Control" by "Batman Sonic"
//

#lib "Player"

static bool isWallLeave = false;

{
    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateWallLeave, Sonic.StateID.StateFall);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateWallLeave, Knuckles.StateID.StateFall);

    if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateWallLeave)
    {
        if (!isWallLeave)
        {
            Player.Animation.SetAnimation("ATTACK_BOUNCE");
            isWallLeave = true;
        }
    }
    else
    {
        isWallLeave = false;
    }
}

Code "Stomp during Stomp Bounce" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "GameManager"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static int conBounceAttackAbility = 0;

static bool isStompAttackRecovery = false;

static float stompBounceTime = 0.0f;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            isConfigInitialized = true;
        }
    }

    if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateStompingBounce)
    {
        // Bounce Attack chains need a quicker recovery, checked per frame since the character can change
        float recoveryTime = Player.GetPlayerType() == Player.PlayerType.Sonic && conBounceAttackAbility == 1 ? 0.2f : 0.5f;

        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            if (!isStompAttackRecovery)
            {
                stompBounceTime += Time.GetDeltaTime();

                if (stompBounceTime >= recoveryTime)
                    isStompAttackRecovery = true;
            }

            if (isStompAttackRecovery && Player.Input.IsDown(Player.InputActionType.PlayerStomping))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStompingDown);
            }
        }
    }
    else
    {
        isStompAttackRecovery = false;
        stompBounceTime = 0.0f;
    }
}

Code "Disable Unintended Jumps" by "Batman Sonic"
//

#lib "Player"
#lib "Lua"

static bool isJumpDisabled = false;

{
    var sonicState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var tailsState = Player.State.GetCurrentStateID<Tails.StateID>();
    var knucklesState = Player.State.GetCurrentStateID<Knuckles.StateID>();
    var amyState = Player.State.GetCurrentStateID<Amy.StateID>();

    bool isStomping = sonicState == Sonic.StateID.StateStompingDown ||
                      tailsState == Tails.StateID.TailsStateStompingDown ||
                      knucklesState == Knuckles.StateID.KnucklesStateStompingDown ||
                      amyState == Amy.StateID.AmyStateStompingDown;

    bool isMiscStates = isStomping ||
                        sonicState == Sonic.StateID.StateParry ||
                        sonicState == Sonic.StateID.StateHomingFinished ||
                        sonicState == Sonic.StateID.StateStompingBounce ||
                        knucklesState == Knuckles.StateID.StateMaximumHeatKnuckleBounce;

    // Jump is only handed back on the way out, so other codes and stage scripts own it the rest of the time
    if (isMiscStates)
        Lua.Call("SetPlayerAbilityEnabled", "Jump", false);
    else if (isJumpDisabled)
        Lua.Call("SetPlayerAbilityEnabled", "Jump", true);

    isJumpDisabled = isMiscStates;
}

