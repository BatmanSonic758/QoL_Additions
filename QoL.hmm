Code "Fix Glide Sound" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "BlackboardItem"
#lib "HMM"
#lib "GameManager"
#lib "INI"

static bool isGliding = false;
static bool hasPlayedGrideStart = false;
static bool hasPlayedGrideLoop = false;

static float glideStartTimer = 0.0f;
static float grideLoopTimer = 0.0f;

static int grideLoopSoundHandle = 0;

const float legacyGlideStartDelay = 0.5f;
const float legacyGlideLoopDelay = 0.67f;
const float glideLoopDelay = 0.5f;

static bool isConfigInitialized = false;
static bool conKnuxLegacyGlide = false;
static bool conKnuxLegacyInfiniteGlide = false;

static bool isDisableGlideTransitionEnabled = false;
static bool hasCheckedDisableGlideTransition = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conKnuxLegacyGlide = INI.GetField<bool>(ini, "Main", "KnuxLegacyGlide", conKnuxLegacyGlide);
            conKnuxLegacyInfiniteGlide = INI.GetField<bool>(ini, "Main", "KnuxLegacyInfiniteGlide", conKnuxLegacyInfiniteGlide);
            isConfigInitialized = true;
        }
    }

    if (!hasCheckedDisableGlideTransition)
    {
        var codes = HMM.GetCodes();
        isDisableGlideTransitionEnabled = codes.Contains("Animation/Knuckles/Disable Gliding Transition");
        hasCheckedDisableGlideTransition = true;
    }

    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    bool isInfiniteGlide = pBlackboardItem->RingCount == pBlackboardItem->RingCapacity;

    string grideStartSound = isInfiniteGlide ? "kn_ringmax_start" : "kn_gride_start";
    string grideLoopSound = isInfiniteGlide ? "kn_ringmax_loop" : "kn_gride_loop";

    if (Player.State.GetCurrentStateID<Knuckles.StateID>() != Knuckles.StateID.StateGliding)
    {
        if (grideLoopSoundHandle != 0)
        {
            int soundHandle = grideLoopSoundHandle;
            Player.Sound.StopSound(&soundHandle);

            grideLoopSoundHandle = 0;
        }

        isGliding = false;
        hasPlayedGrideStart = false;
        hasPlayedGrideLoop = false;

        glideStartTimer = 0.0f;
        grideLoopTimer = 0.0f;

        return;
    }

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    if (isPaused)
        return;

    // The legacy glide opens with a dive, so its glide sounds wait for the dive to finish
    bool isLegacyGlide = !isDisableGlideTransitionEnabled && (isInfiniteGlide ? conKnuxLegacyInfiniteGlide : conKnuxLegacyGlide);

    if (!isGliding)
    {
        Player.Sound.PlaySound(isLegacyGlide ? "kn_dive_start" : grideStartSound);

        isGliding = true;
        hasPlayedGrideStart = !isLegacyGlide;
        hasPlayedGrideLoop = false;

        glideStartTimer = 0.0f;
        grideLoopTimer = 0.0f;
    }

    if (!hasPlayedGrideStart)
    {
        glideStartTimer += Time.GetDeltaTime();

        if (glideStartTimer >= legacyGlideStartDelay)
        {
            Player.Sound.PlaySound(grideStartSound);

            hasPlayedGrideStart = true;
            grideLoopTimer = 0.0f;
        }
    }

    if (hasPlayedGrideStart && !hasPlayedGrideLoop)
    {
        grideLoopTimer += Time.GetDeltaTime();

        if (grideLoopTimer >= (isLegacyGlide ? legacyGlideLoopDelay : glideLoopDelay))
        {
            grideLoopSoundHandle = Player.Sound.PlaySound(grideLoopSound);
            hasPlayedGrideLoop = true;
        }
    }
}

