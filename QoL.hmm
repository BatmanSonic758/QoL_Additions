        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.weight.skillPieceWeight, (uint)0);
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.weight.skillPieceKnucklesWeight, (uint)150);
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.weight.sequenceItemWeight, (uint)100);
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.weight.portalBitWeight, (uint)30);
    }

    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, common.cyloop.dropItem.weight.noneWeight, (uint)3920);
