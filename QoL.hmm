Code "Lost World-Style Double Jump" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static int conAltDoubleJump = 0;
static int conJumpPlayer = 0;
static int conHammerJumpAttack = 0;

static bool isDoubleJumpSpin = false;
static bool isDoubleJumpNormal = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conAltDoubleJump = INI.GetField<int>(ini, "Main", "AltDoubleJump", conAltDoubleJump);
            conJumpPlayer = INI.GetField<int>(ini, "Main", "JumpPlayer", conJumpPlayer);
            conHammerJumpAttack = INI.GetField<int>(ini, "Main", "HammerJumpAttack", conHammerJumpAttack);
            isConfigInitialized = true;
        }
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var playerType = Player.GetPlayerType();

    bool useAltDoubleJump = playerType == Player.PlayerType.Amy ? conHammerJumpAttack != 1 && (conAltDoubleJump == 1 || conJumpPlayer != 2) : conAltDoubleJump == 1;

    if (useAltDoubleJump && currentState == Sonic.StateID.StateDoubleJump)
    {
        Player.Effect.StopAnimationEffects();
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);

        float speed = Player.Kinematics.GetHorizontalMagnitude();

        if (speed >= 16.0f)
        {
            if (!isDoubleJumpSpin)
            {
                Player.Animation.SetAnimation("JUMP_BUNK_SPIN");

                isDoubleJumpSpin = true;
                isDoubleJumpNormal = false;
            }
        }
        else
        {
            if (!isDoubleJumpNormal)
            {
                Player.Animation.SetAnimation("JUMP_BUNK");

                isDoubleJumpNormal = true;
                isDoubleJumpSpin = false;
            }
        }
    }
    else
    {
        isDoubleJumpSpin = false;
        isDoubleJumpNormal = false;
    }
}

Code "Manual Ball Tunnel" by "Batman Sonic"
//

#lib "Player"

#import "Services"

{
    string stageID = LevelInfo.GetCurrentStageID();
    bool isBallStage = stageID == "w7d03" || stageID == "w7d07";

    if (!isBallStage)
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateBallMove, Sonic.StateID.StateDropDash);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateBallMove, Tails.StateID.StateDropDash);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateBallMove, Knuckles.StateID.StateDropDash);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateBallMove, Amy.StateID.StateDropDash);
    }
    else
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateBallMove, Sonic.StateID.StateBallMove);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateBallMove, Tails.StateID.StateBallMove);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateBallMove, Knuckles.StateID.StateBallMove);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateBallMove, Amy.StateID.StateBallMove);

        if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateBallMove)
        {
            Player.Animation.SetAnimation("JUMP_BALL");
            Player.Effect.StopAnimationEffects();
        }
    }
}

Code "Bouncy Spin Dash Charge" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isBouncySpinDashCharge = false;

static bool isConfigInitialized = false;
static int conHammerRush = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conHammerRush = INI.GetField<int>(ini, "Main", "HammerRush", conHammerRush);
            isConfigInitialized = true;
        }
    }

    var playerType = Player.GetPlayerType();

    bool isAmyAerialHammerRush = playerType == Player.PlayerType.Amy && conHammerRush == 1 && !Player.Status.IsGrounded();
    bool isSpinDashCharge = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSpinBoostCharge;
    bool isCharging = Player.Input.IsDown(Player.InputActionType.PlayerSonicboom);

    if (isSpinDashCharge && isCharging && !isAmyAerialHammerRush)
    {
        if (!isBouncySpinDashCharge)
        {
            Player.Effect.PlayAnimationEffect("SPIN_CHARGE");
            isBouncySpinDashCharge = true;
        }
    }
    else
    {
        isBouncySpinDashCharge = false;
    }
}

Code "Bouncy Spin Dash" by "Batman Sonic"
//

#lib "Player"
#lib "HMM"
#lib "INI"

static bool isBouncySpinDash = false;

static bool isConfigInitialized = false;
static int conLegacySpinDash = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            isConfigInitialized = true;
        }
    }

    if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSpinBoost)
    {
        if (!isBouncySpinDash)
        {
            Player.Effect.PlayAnimationEffect(conLegacySpinDash == 3 ? "SPIN_CHARGE" : "SPINJUMP");
            isBouncySpinDash = true;
        }
    }
    else
    {
        isBouncySpinDash = false;
    }
}

Code "Bouncy Jumpball Animation" by "Batman Sonic"
//

#lib "Player"
#lib "HMM"
#lib "INI"

#load "System.Collections.dll"

using System.Collections.Generic;

static bool isConfigInitialized = false;
static int conHammerJumpAttack = 0;
static int conAltDoubleJump = 0;

static Sonic.StateID lastNonAmyState;
static Amy.StateID lastAmyState;

static bool hasLastNonAmyState = false;
static bool hasLastAmyState = false;

static HashSet<Sonic.StateID> sonicBallStates = new HashSet<Sonic.StateID>
{
    Sonic.StateID.StateQuickStepDoubleJump,
    Sonic.StateID.StateSpinAttack,
    Sonic.StateID.StateBaseJump,
    Sonic.StateID.StateDropDash,
    Sonic.StateID.StateDriftDash,
    Sonic.StateID.StateDoubleJump,
    Sonic.StateID.StateBounceJump
};

static HashSet<Amy.StateID> amyBallStates = new HashSet<Amy.StateID>
{
    Amy.StateID.StateQuickStepDoubleJump,
    Amy.StateID.StateBaseJump,
    Amy.StateID.StateDropDash,
    Amy.StateID.StateDriftDash,
    Amy.StateID.StateDoubleJump,
    Amy.StateID.StateGrindDoubleJump
};

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conHammerJumpAttack = INI.GetField<int>(ini, "Main", "HammerJumpAttack", conHammerJumpAttack);
            conAltDoubleJump = INI.GetField<int>(ini, "Main", "AltDoubleJump", conAltDoubleJump);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() == Player.PlayerType.Amy)
    {
        var currentAmyState = Player.State.GetCurrentStateID<Amy.StateID>();

        bool skipAmyDoubleJump = currentAmyState == Amy.StateID.StateDoubleJump && (conAltDoubleJump == 1 || conHammerJumpAttack == 1);

        bool skipAmyGrindDoubleJump = currentAmyState == Amy.StateID.StateGrindDoubleJump && conHammerJumpAttack == 1 && hasLastAmyState && lastAmyState == Amy.StateID.StateSpinAttack;

        if (!skipAmyDoubleJump && !skipAmyGrindDoubleJump && amyBallStates.Contains(currentAmyState) && (!hasLastAmyState || currentAmyState != lastAmyState))
        {
            Player.Effect.PlayAnimationEffect("SPINJUMP");
        }

        lastAmyState = currentAmyState;
        hasLastAmyState = true;
        return;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool skipSonicDoubleJump = currentState == Sonic.StateID.StateDoubleJump && conAltDoubleJump == 1;

    if (!skipSonicDoubleJump && sonicBallStates.Contains(currentState) && (!hasLastNonAmyState || currentState != lastNonAmyState))
    {
        Player.Effect.PlayAnimationEffect("SPINJUMP");
    }

    lastNonAmyState = currentState;
    hasLastNonAmyState = true;
}

Code "Customizable Homing Attack Animations" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isHomingAttackAnimation = false;

static bool isConfigInitialized = false;
static int conJumpDashAnimation = 0;
static int conScrewdriverAbility = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conJumpDashAnimation = INI.GetField<int>(ini, "Main", "JumpDashAnimation", conJumpDashAnimation);
            conScrewdriverAbility = INI.GetField<int>(ini, "Main", "ScrewdriverAbility", conScrewdriverAbility);
            isConfigInitialized = true;
        }
    }

    // Screwdriver drives Knuckles' homing animation itself
    if (Player.GetPlayerType() == Player.PlayerType.Knuckles && conScrewdriverAbility == 1)
        return;

    if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateHomingAttack || Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateHomingAttackInStorm)
    {
        if (!isHomingAttackAnimation)
        {
            switch (conJumpDashAnimation)
            {
                case 1:
                    Player.Effect.StopAnimationEffects();
                    Player.Effect.PlayAnimationEffect("SPINJUMP");
                    break;

                case 2:
                case 3:
                case 4:
                    Player.Effect.StopAnimationEffects();
                    Player.Animation.SetAnimation("JUMP_BALL");
                    break;

                case 5:
                    Player.Effect.StopAnimationEffects();
                    Player.Effect.PlayAnimationEffect("SPIN_CHARGE");
                    break;
            }

            isHomingAttackAnimation = true;
        }
    }
    else
    {
        isHomingAttackAnimation = false;
    }
}

Code "Alternate Spin Slash Animation" by "Batman Sonic"
//

#lib "Player"

static bool isBouncySpinSlash = false;

{
    if (Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateSpinSlash)
    {
        if (!isBouncySpinSlash)
        {
            Player.Effect.PlayAnimationEffect("SPIN_CHARGE");
            isBouncySpinSlash = true;
        }
    }
    else
    {
        isBouncySpinSlash = false;
    }
}

Code "Light Speed Dash Rename" by "Batman Sonic"
