        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.damage.common.invincibleTime, forwardViewInvincibleTime);
    }
}

Code "Fix State Damage Collision" by "Batman Sonic"
//

#lib "Player"

static bool wasInDamageState = false;

static List<Sonic.StateID> damageStates = new()
{
    Sonic.StateID.StateBounceJump,
    Sonic.StateID.StateSpinAttack,
    Sonic.StateID.StateDoubleJump
};

static List<Sonic.StateID> spinStates = new()
{
    Sonic.StateID.StateQuickStepDoubleJump,
    Sonic.StateID.StateSpinBoostCharge,
    Sonic.StateID.StateDriftDash,
    Sonic.StateID.StateDropDash,
    Sonic.StateID.StateSpin
};

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool isDamageState = damageStates.Contains(currentState) || (previousState == Sonic.StateID.StateQuickStepDoubleJump &&
         currentState == Sonic.StateID.StateDoubleJump) || (spinStates.Contains(previousState) && currentState == Sonic.StateID.StateJump);

    if (isDamageState)
    {
        if (!wasInDamageState)
        {
            Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 2.0f);
            Player.Collision.SetEntityCollision(false);
            wasInDamageState = true;
        }
    }
    else if (wasInDamageState)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        wasInDamageState = false;
    }
}

Code "Fix Homing Attack Damage Collision" by "Batman Sonic"
//

#lib "Player"
#lib "BlackboardStatus"

static List<Sonic.StateID> damageStates = new()
{
    Sonic.StateID.StateHomingAttack,
    Sonic.StateID.StateHomingAttackInStorm
};

static bool wasInHoming = false;

{
    bool isHoming = !BlackboardStatus.IsSuper() && damageStates.Contains(Player.State.GetCurrentStateID<Sonic.StateID>());

    if (isHoming)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.DamageHoming, 1.0f);
        Player.Collision.SetEntityCollision(false);
        wasInHoming = true;
    }
    else if (wasInHoming)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        wasInHoming = false;
    }
}

Code "Balanced Infinite Boost and Cyloop" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Reflection"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"

static Random random = new Random();

static uint GetRingAmount()
{
    int roll = random.Next(100);

    if (roll < 40)
        return 1;
    if (roll < 70)
        return 2;
    if (roll < 90)
        return 3;
    if (roll < 98)
        return 4;

    return 5;
}

static uint Get10RingAmount()
{
    int roll = random.Next(100);

    if (roll < 60)
        return 1;
    if (roll < 90)
        return 2;

    return 3;
}
{
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    // Infinite Boost
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.boost.infinityBoostTime, 60.0f);
    }

    if (TailsParametersInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.boost.infinityBoostTime, 60.0f);
    }

    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.boost.infinityBoostTime, 60.0f);
    }

    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.boost.infinityBoostTime, 60.0f);
    }

    // 30% chance of 1-5 rings, mostly 1-3
    uint randomRings = 0;

    if (random.Next(100) < 30)
        randomRings = GetRingAmount();

    // 1, 2 or 3 ten-ring packs at 60/30/10%
    uint random10Rings = Get10RingAmount();

    // Cyloop Items
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.numRings, randomRings);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.num10Rings, random10Rings);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.numSkillPieces, (uint)10);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.skillPieceExp, (uint)20);
    }

    if (TailsParametersInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.numRings, randomRings);
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.num10Rings, random10Rings);
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.numSkillPieces, (uint)10);
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.skillPieceExp, (uint)20);
    }

    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.numRings, randomRings);
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.num10Rings, random10Rings);
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.numSkillPieces, (uint)10);
        RFL_SET_PARAM(KnucklesParametersInfo, common.cyloop.dropItem.skillPieceExp, (uint)20);
    }

    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, common.cyloop.dropItem.numRings, randomRings);
        RFL_SET_PARAM(AmyParametersInfo, common.cyloop.dropItem.num10Rings, random10Rings);
        RFL_SET_PARAM(AmyParametersInfo, common.cyloop.dropItem.numSkillPieces, (uint)10);
        RFL_SET_PARAM(AmyParametersInfo, common.cyloop.dropItem.skillPieceExp, (uint)20);
    }

    // Cyloop Item Drop Chance
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.weight.noneWeight, (uint)3920);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.weight.ring10Weight, (uint)300);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.weight.powerSeedWeight, (uint)250);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.weight.guardSeedWeight, (uint)250);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.weight.skillPieceWeight, (uint)150);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.weight.sequenceItemWeight, (uint)100);
        RFL_SET_PARAM(SonicParametersInfo, common.cyloop.dropItem.weight.portalBitWeight, (uint)30);
    }

    if (TailsParametersInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.weight.noneWeight, (uint)3920);
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.weight.ring10Weight, (uint)300);
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.weight.powerSeedWeight, (uint)250);
        RFL_SET_PARAM(TailsParametersInfo, common.cyloop.dropItem.weight.guardSeedWeight, (uint)250);
