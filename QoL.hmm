Code "Fix Friends in Cyber Space" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Time"
#lib "GameManager"
#lib "INI"
#lib "HMM"

#import "Plugins"

static bool isConfigInitialized = false;

static int conTailsHoming = 0;
static int conLegacySpinDash = 0;
static bool conHomingSpam = false;

// Tails Homing Recovery
static float homingCooldown = 0.0f;
static bool wasInHomingRecovery = false;

// Amy High Card Jump
static bool isCyberHighCardJump = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conTailsHoming = INI.GetField<int>(ini, "Main", "TailsHoming", conTailsHoming);
            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            conHomingSpam = INI.GetField<bool>(ini, "Main", "HomingSpam", conHomingSpam);
            isConfigInitialized = true;
        }
    }

    if (!IS_WORLD_FLAG(IsCyberSpace))
        return;

    if (IS_WORLD_FLAG(IsOutOfControl))
        return;

    if (Player.GetPlayerType() == Player.PlayerType.Sonic)
        return;

    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

    if (homingCooldown > 0.0f)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            homingCooldown -= Time.GetDeltaTime();

            if (homingCooldown < 0.0f)
                homingCooldown = 0.0f;
        }
    }

    float recoveryTime = conHomingSpam ? 0.15f : 0.3f;

    // Tails Homing Recovery
    bool isHomingRecovery =
        (currentState == Tails.StateID.StateSpringJump &&
         previousState == Tails.StateID.StateHomingAttack) ||
        currentState == Tails.StateID.StateHomingFinished;

    if (Player.GetPlayerType() == Player.PlayerType.Tails && isHomingRecovery)
    {
        if (!wasInHomingRecovery)
        {
            homingCooldown = recoveryTime;
            wasInHomingRecovery = true;
        }
    }
    else
    {
        wasInHomingRecovery = false;
    }

    // Amy High Card Jump and Stomp
    if (Player.GetPlayerType() == Player.PlayerType.Amy)
    {
        var currentAmyState = Player.State.GetCurrentStateID<Amy.StateID>();

        if (currentAmyState == Amy.StateID.AmyStateStompingLand &&
            Player.Input.IsDown(Player.InputActionType.PlayerStomping))
        {
            Player.State.SetState<Amy.StateID>(Amy.StateID.StateHighJump);
            isCyberHighCardJump = true;
        }

        if (isCyberHighCardJump &&
            !Player.Input.IsDown(Player.InputActionType.PlayerStomping))
        {
            isCyberHighCardJump = false;
        }

        if (!Player.Status.IsGrounded() && !IS_STATE_FLAG(IsGrind) && currentAmyState != Amy.StateID.StateSpinBoostCharge && !isCyberHighCardJump && Player.Input.IsPressed(Player.InputActionType.PlayerStomping))
        {
            Player.State.SetState<Amy.StateID>(Amy.StateID.AmyStateStompingDown);
        }
    }
    else
    {
        // Allow Stomp (Tails / Knuckles)
        if (!Player.Status.IsGrounded() && !IS_STATE_FLAG(IsGrind) && currentState != Tails.StateID.StateSpinBoostCharge && Player.Input.IsPressed(Player.InputActionType.PlayerStomping))
        {
            Player.State.SetState<Tails.StateID>(Tails.StateID.TailsStateStompingDown);
        }

        // Allow Homing Attack for Tails
        if (Player.GetPlayerType() == Player.PlayerType.Tails &&
            conTailsHoming == 1 &&
            homingCooldown <= 0.0f &&
            Player.Status.IsLockOnCursorVisible() &&
            Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
        {
            Player.State.SetState<Tails.StateID>(Tails.StateID.StateHomingAttack);
        }
    }

    // Spin Boost
    if (conLegacySpinDash == 3 && Player.Input.IsDown(Player.InputActionType.PlayerSonicboom) && currentState != Tails.StateID.TailsStateStompingDown)
    {
        var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

        bool boostEmpty = boostPlugin != null && (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) != 0;

        if (!boostEmpty)
        {
            if ((currentState == Tails.StateID.StateSquat || !Player.Status.IsGrounded()) && currentState != Tails.StateID.StateSpinBoost)
            {
                Player.State.SetState<Tails.StateID>(Tails.StateID.StateSpinBoostCharge);
            }

            if (currentState == Tails.StateID.StateRun)
            {
                Player.State.SetState<Tails.StateID>(Tails.StateID.StateSpinBoost);
            }
        }
    }

    // Classic Spin Dash
    else if (conLegacySpinDash != 3 && Player.Input.IsDown(Player.InputActionType.PlayerSonicboom) && currentState != Tails.StateID.TailsStateStompingDown)
    {
        if ((currentState == Tails.StateID.StateSquat || !Player.Status.IsGrounded()) && currentState != Tails.StateID.StateSpinBoost)
        {
            Player.State.SetState<Tails.StateID>(Tails.StateID.StateSpinBoostCharge);
        }
    }
}

Code "Enable Light Dash for Amy" by "Batman Sonic"
//

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static bool conAmyLightDash = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conAmyLightDash = INI.GetField<bool>(ini, "Main", "AmyLightDash", conAmyLightDash);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Amy || !conAmyLightDash)
        return;

    if (Player.Input.IsPressed(Player.InputActionType.PlayerLightDash))
    {
        Player.State.SetState<Amy.StateID>(Amy.StateID.StateLightDash);
    }
}

Code "Disable Amy's Boost" by "Batman Sonic"
//

#lib "Player"
#lib "Lua"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static bool conAmyBoostStop = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conAmyBoostStop = INI.GetField<bool>(ini, "Main", "AmyBoostStop", conAmyBoostStop);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Amy || !conAmyBoostStop)
        return;

    Lua.Call("SetPlayerAbilityEnabled", "Boost", false);
}

Code "Common Card Spin Animation" by "Batman Sonic"
//

#lib "Player"

static bool isTarotSpinAnimation = false;

static List<Amy.StateID> tarotRollStates = new()
{
    Amy.StateID.AmyStateTarotRolling,
    Amy.StateID.AmyStateTarotRollingJump,
    Amy.StateID.AmyStateTarotRollingFall
};

{
    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;

    if (tarotRollStates.Contains(Player.State.GetCurrentStateID<Amy.StateID>()))
    {
        if (!isTarotSpinAnimation)
        {
            Player.Animation.SetAnimation("ATK_TAROT_ROLL_START");
            isTarotSpinAnimation = true;
        }
    }
    else
    {
        isTarotSpinAnimation = false;
    }
}

Code "Hammer Moves" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "Reflection"
#lib "AmyParameters"
#lib "Time"
#lib "BlackboardItem"
#lib "GameManager"
#lib "HMM"
#lib "INI"
#lib "Lua"

static bool isGroundHammerAnimation = false;
static bool isAirHammerAnimation = false;
static bool isHammerSpinAnimation = false;
static bool isStompDownAnimation = false;
static bool isGroundAnimation = false;
static bool isGroundBounceAnimation = false;
static bool isAerialOutroAnimation = false;
static bool isAerialAttack = false;
static bool isGroundAttack = false;
static bool isHammerSwingAttack = false;

const float spinDuration = 7.0f;
static float spinTimer = 0.0f;
static bool spinTimerActive = false;
static bool isConfigInitialized = false;
static bool wasInStunState = false;
static float stunTimer = 0.0f;
const float stunDuration = 3.0f;
static bool isSpinStunned = false;
static bool playedStunEndAnimation = false;
static bool playedSpinVoice = false;

static float aerialHammerTimer = 0.0f;
const float hammerJumpVelocity = 60.0f;
static bool timerActive = false;
static bool aerialAttackHeldThrough = false;

static float groundAttackTimer = 0.0f;
const float groundAttackDuration = 1.0f;
const float hammerAttackSpeed = 12.0f;
const float hammerAttackMomentum = 5.0f;

static int conHammerStomp = 0;
static int conHammerAttack = 0;
static int conHammerJump = 0;
static int conHammerJumpAttack = 0;
static int conHammerRush = 0;

static bool appliedJumpVelocity = false;

static bool isBounceAttack = false;
static bool bounceInputHeld = false;
static float bounceHoldTime = 0.0f;
const float bounceHoldThreshold = 0.5f;
static bool playedBounceVoice = false;
static bool bounceAttackInitiated = false;
const float bounceVelocity = 25.0f;
static bool isHammerBounceSound = false;
static int hammerBounceLoopSound = 0;
static Amy.StateID originalBounceState = Amy.StateID.StateAcceleCombo1;
static bool wasBouncing = false;
static bool aerialBounceEntry = false;
static float aerialBounceCeiling = 0.0f;

static bool isDoubleJumpHammerAnimation = false;
static bool isGrindDoubleJumpHammerAnimation = false;
static bool hasDamageSphere = false;

static bool isHammerRushAnimation = false;
static bool isHammerRushChargeAnimation = false;
static float hammerRushChargeCount = 0.0f;
const float maxHammerRushCharge = 6.0f;
const float hammerRushSpeedMultiplier = 10.0f;
static float hammerRushGraceTimer = 0.0f;
const float hammerRushGraceDuration = 0.0f;

static float hammerRushSoundTimer = 0.0f;
const float soundLoopDuration = 0.4f;
static bool hasPlayedLineGravity = false;

static bool isDive = false;

static float reboundHammerTimer = 0.0f;
const float reboundHammerDelay = 0.5f;

static Random random = new Random();

static List<Amy.StateID> bikeStates = new()
{
    Amy.StateID.AmyStateTarotBoostAir,
    Amy.StateID.AmyStateTarotBikeRoot,
    Amy.StateID.AmyStateTarotBuildRoot,
    Amy.StateID.AmyStateTarotBuild,
    Amy.StateID.AmyStateTarotBuildAir,
    Amy.StateID.AmyStateTarotBuildFall,
    Amy.StateID.AmyStateTarotBoostRoot,
    Amy.StateID.AmyStateTarotBoost,
    Amy.StateID.AmyStateTarotBoostTurn,
    Amy.StateID.AmyStateTarotBoostStep,
    Amy.StateID.AmyStateTarotBoostJump,
    Amy.StateID.AmyStateTarotBoostFall,
    Amy.StateID.AmyStateTarotDrift
};

static List<string> boostVoices = new() { "sa1024", "sa1038", "aa1112", "aa1110" };
static List<string> hammerspinVoices = new() { "aa1110", "sa1024", "sa1029" };

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conHammerStomp = INI.GetField<int>(ini, "Main", "HammerStomp", conHammerStomp);
            conHammerAttack = INI.GetField<int>(ini, "Main", "HammerAttack", conHammerAttack);
            conHammerJump = INI.GetField<int>(ini, "Main", "HammerJump", conHammerJump);
            conHammerJumpAttack = INI.GetField<int>(ini, "Main", "HammerJumpAttack", conHammerJumpAttack);
            conHammerRush = INI.GetField<int>(ini, "Main", "HammerRush", conHammerRush);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;

    var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
    var previousState = Player.State.GetPreviousStateID<Amy.StateID>();

    bool isBike = bikeStates.Contains(currentState);

    bool isSpringJump = IS_STATE_FLAG(IsSpringJump);
    bool isGrind = IS_STATE_FLAG(IsGrind);
    bool isDiving = IS_STATE_FLAG(IsDiving);
    bool isDivingBoost = IS_STATE_FLAG(IsDivingBoost);
    bool isDamaged = IS_WORLD_FLAG(IsDamagedOrRepelled);
    bool isDead = IS_WORLD_FLAG(IsDead);
    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);
    bool isOutOfControl = IS_WORLD_FLAG(IsOutOfControl);

    if (IS_STATE_FLAG(IsDiving))
    {
        isDive = true;
    }
    else if (Player.Status.IsGroundedSpecial())
    {
        isDive = false;
    }

    // Delay Aerial Hammer Attack when at rebound
    bool isHomingRebound = currentState == Amy.StateID.StateHomingFinished && previousState != Amy.StateID.StateHomingAttackInStorm && !isDive;
    bool isStompBounce = currentState == Amy.StateID.AmyStateStompingBounce;

    bool isRebound = isHomingRebound || isStompBounce;

    if (isRebound)
    {
        if (previousState != currentState)
            reboundHammerTimer = 0.0f;

        reboundHammerTimer += Time.GetDeltaTime();
    }
    else
    {
        reboundHammerTimer = 0.0f;
    }

    bool reboundHammerDelayActive = isRebound && reboundHammerTimer < reboundHammerDelay;
    // Block during a Homing Rebound from a storm or dive
    bool inHomingRebound = currentState == Amy.StateID.StateHomingFinished && (previousState == Amy.StateID.StateHomingAttackInStorm || isDive);

    bool isHammerMovesBlocked = currentState == Amy.StateID.StateJumpBoardLaunch ||
                                currentState == Amy.StateID.StateHomingAttack ||
                                currentState == Amy.StateID.StateHomingAttackInStorm ||
                                currentState == Amy.StateID.StateSpinBoostCharge ||
                                currentState == Amy.StateID.StateStorm ||
                                currentState == Amy.StateID.StateCaught ||
                                currentState == Amy.StateID.StateHangPole ||
                                currentState == Amy.StateID.StateAvoid ||
                                currentState == Amy.StateID.StateParry ||
                                currentState == Amy.StateID.StateParryStand ||
                                currentState == Amy.StateID.StateAirBoost ||
                                currentState == Amy.StateID.StateSlingshot ||
                                currentState == Amy.StateID.StateSandSki ||
                                currentState == Amy.StateID.StateSandSkiBlow ||
                                currentState == Amy.StateID.AmyStateCharmAttack ||
                                currentState == Amy.StateID.AmyStateCharmAttackFollow ||
                                isBike ||
                                isSpringJump ||
                                isGrind ||
                                isDamaged ||
                                isDiving ||
                                isDivingBoost ||
                                isDead ||
                                isAutoRun ||
                                isOutOfControl ||
                                inHomingRebound ||
                                reboundHammerDelayActive;

    if (isHammerBounceSound && (isHammerMovesBlocked || currentState != Amy.StateID.StateAcceleCombo1))
    {
        int bounceLoopHandle = hammerBounceLoopSound;
        Player.Sound.StopSound(&bounceLoopHandle);
        isHammerBounceSound = false;
    }

    // Disable Damage Recovery's restore clears this redirect, so it's reapplied even while the moves are blocked
    if (conHammerStomp == 1)
        Player.State.Redirect<Amy.StateID>(Amy.StateID.AmyStateStompingDown, Amy.StateID.StateAirCyHammer);

    if (isHammerMovesBlocked)
    {
        // Restore the Homing Attack while the hammer moves are inactive
        Lua.Call("SetPlayerAbilityEnabled", "HomingAttack", true);

        if (hasDamageSphere)
        {
            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);
            hasDamageSphere = false;
        }

        isGroundHammerAnimation = false;
        isAirHammerAnimation = false;
        isHammerSpinAnimation = false;
        isStompDownAnimation = false;
        isGroundAnimation = false;
        isGroundBounceAnimation = false;
        isAerialOutroAnimation = false;
        isAerialAttack = false;
        isGroundAttack = false;
        isHammerSwingAttack = false;

        spinTimer = 0.0f;
        spinTimerActive = false;
        wasInStunState = false;
        stunTimer = 0.0f;
        isSpinStunned = false;
        playedStunEndAnimation = false;
        playedSpinVoice = false;

        aerialHammerTimer = 0.0f;
        timerActive = false;
        aerialAttackHeldThrough = false;

        groundAttackTimer = 0.0f;
        appliedJumpVelocity = false;

        isBounceAttack = false;
        bounceInputHeld = false;
        bounceHoldTime = 0.0f;
        playedBounceVoice = false;
        bounceAttackInitiated = false;
        wasBouncing = false;
        aerialBounceEntry = false;

        isDoubleJumpHammerAnimation = false;
        isGrindDoubleJumpHammerAnimation = false;

        isHammerRushAnimation = false;
        isHammerRushChargeAnimation = false;
        hammerRushChargeCount = 0.0f;
        hammerRushGraceTimer = 0.0f;
        hammerRushSoundTimer = 0.0f;
        hasPlayedLineGravity = false;

        return;
    }

    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    var pBlackboardItem = BlackboardItem.Get();

    bool hasMaxRings = false;
    if (pBlackboardItem != null)
    {
        int maxrings = pBlackboardItem->RingCapacity;
        int rings = pBlackboardItem->RingCount;
        hasMaxRings = (rings == maxrings);
    }

    if (conHammerAttack == 1)
    {
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateRunawayBee, Amy.StateID.StateAirCyHammer);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateAwakening, Amy.StateID.StateRecoveryJump);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateTarotAttack2, Amy.StateID.StateRun);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateAcceleCombo1, Amy.StateID.StateDoubleJump);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateAcceleCombo2, Amy.StateID.StateSliding);

        Lua.Call("SetPlayerAbilityEnabled", "HomingAttack", false);
        Player.State.Discard<Amy.StateID>(Amy.StateID.StateTarotAttack);

        if (AmyParametersInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.root.transitExistTarget[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.root.transitInAir[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.root.transitNotExistTarget[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.homingAttack.transitExistTarget[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.homingAttack.transitInAir[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.homingAttack.transitNotExistTarget[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.amyTarotAttack.transitExistTarget[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.amyTarotAttack.transitInAir[0], AmyParameters.Action.Root);
            RFL_SET_PARAM(AmyParametersInfo, common.combo.comboTable.amyTarotAttack.transitNotExistTarget[0], AmyParameters.Action.Root);
        }
    }

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    var speed = kinematics->Velocity.Length();

    float horizontalSpeed = Player.Kinematics.GetHorizontalMagnitude();
    float deltaTime = Time.GetDeltaTime();

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;
    if (isPaused)
        deltaTime = 0.0f;

    // Jumping Hammer Attack. When disabled (0 or 2), Bouncy Jumpball Animation handles these states
    if (conHammerJumpAttack == 1)
    {
        if (currentState == Amy.StateID.StateDoubleJump)
        {
            if (!isDoubleJumpHammerAnimation)
            {
                Player.Animation.SetAnimation("CYHAMMER_AIR_LOOP");
                Player.Effect.StopAnimationEffects();
                isDoubleJumpHammerAnimation = true;
            }
        }
        else
        {
            isDoubleJumpHammerAnimation = false;
        }

        if (currentState == Amy.StateID.StateGrindDoubleJump && previousState == Amy.StateID.StateSpinAttack)
        {
            if (!isGrindDoubleJumpHammerAnimation)
            {
                Player.Animation.SetAnimation("CYHAMMER_AIR_LOOP");
                Player.Effect.StopAnimationEffects();
                isGrindDoubleJumpHammerAnimation = true;
            }
        }
        else if (currentState != Amy.StateID.StateGrindDoubleJump)
        {
            isGrindDoubleJumpHammerAnimation = false;
        }
    }
    else
    {
        isDoubleJumpHammerAnimation = false;
        isGrindDoubleJumpHammerAnimation = false;
    }

    // Hammer Rush
    if (conHammerRush == 2)
    {
        bool isBoost = IS_STATE_FLAG(IsBoost);

        if (currentState == Amy.StateID.StateRun && isBoost)
        {
            if (!isHammerRushAnimation)
            {
                Player.Animation.SetAnimation("ATK_CYHAMMER_DASH_LOOP");
                isHammerRushAnimation = true;

                if (deltaTime > 0)
                {
                    Player.Sound.PlaySound("sn_line_gravity");
                    Player.Sound.PlaySound("sn_homingshot");
                    hasPlayedLineGravity = true;
                }

                hammerRushSoundTimer = 0.0f;
            }

            hammerRushSoundTimer += deltaTime;

            if (hammerRushSoundTimer >= soundLoopDuration)
            {
                Player.Sound.PlaySound("sn_homingshot");
                hammerRushSoundTimer = 0.0f;
            }
        }
        else if (currentState == Amy.StateID.StateRun && !isBoost)
        {
            if (isHammerRushAnimation)
            {
                Player.Animation.SetAnimation("RUNNING");
                isHammerRushAnimation = false;
                hasPlayedLineGravity = false;
                hammerRushSoundTimer = 0.0f;
            }
        }
        else if (currentState != Amy.StateID.StateRun && isHammerRushAnimation)
        {
            isHammerRushAnimation = false;
            hasPlayedLineGravity = false;
            hammerRushSoundTimer = 0.0f;
        }
    }
    else if (conHammerRush == 1)
    {
        bool is2D = Player.Status.IsSideView();

        if (is2D)
            Player.State.Redirect<Amy.StateID>(Amy.StateID.StateSpinDash, Amy.StateID.StateDropDash);
        else
            Player.State.Redirect<Amy.StateID>(Amy.StateID.StateSpinDash, Amy.StateID.StateDriftDash);

        if (!Player.Status.IsGrounded() && currentState == Amy.StateID.StateSpinBoostCharge)
        {
            if (!isHammerRushChargeAnimation)
            {
                Player.Animation.SetAnimation("CYHAMMER_AIR_LOOP");
                Player.Effect.StopAnimationEffects();
                isHammerRushChargeAnimation = true;
            }

            if (!Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
            {
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateFall);
                hammerRushChargeCount = 0.0f;
                isHammerRushChargeAnimation = false;
            }
            else
            {
                hammerRushChargeCount = maxHammerRushCharge * 0.7f;
            }
        }
        else if (currentState != Amy.StateID.StateSpinBoostCharge)
        {
            isHammerRushChargeAnimation = false;
        }

        if (previousState == Amy.StateID.StateSpinBoostCharge &&
            Player.Status.IsGrounded() &&
            hammerRushChargeCount > 0.0f)
        {
            if (Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateSpinDash);
            else
                hammerRushChargeCount = 0.0f;
        }

        if (currentState == Amy.StateID.StateSpinDash && previousState != Amy.StateID.StateSpinDash)
        {
            float speedMultiplier = is2D ? 0.45f : 0.6f;
            kinematics->Velocity += Player.Kinematics.GetForward() *
                                   (hammerRushChargeCount * hammerRushSpeedMultiplier * speedMultiplier);
            hammerRushChargeCount = 0.0f;
            hammerRushGraceTimer = 0.0f;

            if (!hasPlayedLineGravity && deltaTime > 0)
            {
                Player.Sound.PlaySound("sn_line_gravity");
                Player.Sound.PlaySound("sn_homingshot");
                hasPlayedLineGravity = true;
            }
        }

        if (currentState == Amy.StateID.StateSpinDash && Player.Status.IsGrounded())
            hammerRushGraceTimer += deltaTime;
        else if (currentState != Amy.StateID.StateSpinDash)
        {
            hammerRushGraceTimer = 0.0f;
            hasPlayedLineGravity = false;
        }

        if (currentState == Amy.StateID.StateSpinDash && Player.Status.IsGrounded())
        {
            if (!isHammerRushAnimation)
            {
                Player.Animation.SetAnimation("ATK_CYHAMMER_DASH_LOOP");
                Lua.Call("PlayVoice", boostVoices[random.Next(boostVoices.Count)]);
                Player.Effect.StopAnimationEffects();
                isHammerRushAnimation = true;
            }

            hammerRushSoundTimer += deltaTime;

            if (hammerRushSoundTimer >= soundLoopDuration)
            {
                Player.Sound.PlaySound("sn_homingshot");
                hammerRushSoundTimer = 0.0f;
            }

            float currentSpeed = Player.Kinematics.GetMagnitude();
            bool shouldUncurlFromSpeed = (hammerRushGraceTimer >= hammerRushGraceDuration && currentSpeed < 10.0f);
            bool buttonReleased = !Player.Input.IsDown(Player.InputActionType.PlayerSonicboom);

            if (buttonReleased || shouldUncurlFromSpeed)
            {
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateSpringJumpHeadLand);
                isHammerRushAnimation = false;
                hammerRushGraceTimer = 0.0f;
                hammerRushSoundTimer = 0.0f;
                hasPlayedLineGravity = false;
            }
        }
        else if (currentState == Amy.StateID.StateSpinDash && !Player.Status.IsGrounded())
        {
            Player.State.SetState<Amy.StateID>(Amy.StateID.StateFall);
            isHammerRushAnimation = false;
            hammerRushGraceTimer = 0.0f;
            hammerRushSoundTimer = 0.0f;
            hasPlayedLineGravity = false;
        }
        else if (currentState != Amy.StateID.StateSpinDash)
        {
            isHammerRushAnimation = false;
            hammerRushSoundTimer = 0.0f;
            hasPlayedLineGravity = false;
        }
    }
    else
    {
        isHammerRushAnimation = false;
        isHammerRushChargeAnimation = false;
        hammerRushChargeCount = 0.0f;
        hammerRushGraceTimer = 0.0f;
        hammerRushSoundTimer = 0.0f;
        hasPlayedLineGravity = false;
    }

    // Hammer Jump
    if (conHammerJump == 1 || conHammerJump == 2)
    {
        if (currentState == Amy.StateID.StateAcceleCombo2 && Player.Input.IsDown(Player.InputActionType.PlayerStomping) || currentState == Amy.StateID.StateHighJump && conHammerStomp == 2)
        {
            Player.State.SetState<Amy.StateID>(Amy.StateID.StateAwakening);
        }

        if (currentState == Amy.StateID.StateAwakening)
        {
            if (!appliedJumpVelocity)
            {
                kinematics->Velocity.Y = hammerJumpVelocity;
                appliedJumpVelocity = true;
            }

            if (Player.Status.IsGrounded())
            {
                if (!isGroundHammerAnimation)
                {
                    Player.Effect.StopAnimationEffects();
                    Player.Animation.SetAnimation("CYHAMMER_AIR_END");
                    isGroundHammerAnimation = true;
                    isAirHammerAnimation = false;
                }
            }
            else
            {
                if (!isAirHammerAnimation)
                {
                    Player.Effect.StopAnimationEffects();
                    Player.Animation.SetAnimation("CYHAMMER_JUMP");
                    isAirHammerAnimation = true;
                    isGroundHammerAnimation = false;
                }
            }
        }
        else
        {
            isGroundHammerAnimation = false;
            isAirHammerAnimation = false;
            appliedJumpVelocity = false;
        }
    }

    // Hammer Stomp (CyHammer)
    if (conHammerStomp == 1)
    {
        if (currentState == Amy.StateID.AmyStateStomping)
        {
            if (!isStompDownAnimation)
            {
                Player.Animation.SetAnimation("CYHAMMER_AIR_LOOP");
                isStompDownAnimation = true;
            }
        }
        else
        {
            isStompDownAnimation = false;
        }
    }

    // Hammer Attack
    if (conHammerAttack == 1)
    {
        // Ground Hammer Attack via PlayerAttack
        if (Player.Status.IsGrounded() && Player.Input.IsPressed(Player.InputActionType.PlayerAttack) && !IS_STATE_FLAG(IsGrind))
        {
            if (!isGroundAttack && !isHammerSwingAttack && !isBounceAttack)
            {
                if (horizontalSpeed < hammerAttackMomentum)
                {
                    kinematics->Velocity = Player.Kinematics.GetForward() * hammerAttackMomentum;
                }

                Player.State.SetState<Amy.StateID>(Amy.StateID.StateAcceleCombo2);
                isGroundAttack = true;
                groundAttackTimer = 0.0f;
            }
        }

        if (currentState == Amy.StateID.StateAcceleCombo2)
        {
            if (horizontalSpeed < 14.0f)
            {
                kinematics->Velocity = Player.Kinematics.GetForward() * hammerAttackSpeed;
            }

            groundAttackTimer += deltaTime;
            if (groundAttackTimer >= groundAttackDuration)
            {
                if (Player.Status.IsGrounded())
                    Player.State.SetState<Amy.StateID>(Amy.StateID.StateRun);
                else
                    Player.State.SetState<Amy.StateID>(Amy.StateID.StateFall);
                groundAttackTimer = 0.0f;
            }
        }
        else
        {
            groundAttackTimer = 0.0f;
        }

        // Bounce Attack: hold attack during the ground combo to launch upward
        if (currentState == Amy.StateID.StateAcceleCombo2 && speed > 7.0f)
        {
            if (Player.Input.IsDown(Player.InputActionType.PlayerAttack))
            {
                if (!bounceInputHeld)
                {
                    bounceInputHeld = true;
                    bounceHoldTime = 0.0f;
                }

                bounceHoldTime += deltaTime;

                if (bounceHoldTime >= bounceHoldThreshold && !bounceAttackInitiated)
                {
                    // Only the ground combo hold is swapped, the aerial hold still reaches the bounce
                    if (conHammerJump == 2)
                    {
                        Player.State.SetState<Amy.StateID>(Amy.StateID.StateAwakening);
                        bounceAttackInitiated = true;
                    }
                    else
                    {
                        Player.State.SetState<Amy.StateID>(Amy.StateID.StateAcceleCombo1);
                        isBounceAttack = true;
                        bounceAttackInitiated = true;
                        playedBounceVoice = false;
                    }
                }
            }
            else
            {
                bounceInputHeld = false;
                bounceHoldTime = 0.0f;
            }
        }

        if (currentState == Amy.StateID.StateAcceleCombo1)
        {
            if (!playedBounceVoice)
            {
                Player.Sound.PlaySound("am_cyhammer_air_start");
                Lua.Call("PlayVoice", "sa1038");
                playedBounceVoice = true;
            }

            wasBouncing = true;

            // AcceleCombo1 is redirected to the double jump, which kicks her upward when entered mid-air
            if (aerialBounceEntry)
            {
                if (Player.Status.IsGrounded())
                {
                    aerialBounceEntry = false;
                }
                else
                {
                    if (kinematics->Velocity.Y > aerialBounceCeiling)
                        kinematics->Velocity.Y = aerialBounceCeiling;
                    aerialBounceCeiling = kinematics->Velocity.Y;
                }
            }

            if (Player.Input.IsDown(Player.InputActionType.PlayerAttack))
            {
                if (Player.Status.IsGrounded())
                {
                    kinematics->Velocity.Y = bounceVelocity;
                    originalBounceState = Amy.StateID.StateAcceleCombo1;
                }
            }
            else
            {
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateFall);
                isBounceAttack = false;
                bounceAttackInitiated = false;
                bounceInputHeld = false;
                bounceHoldTime = 0.0f;
                playedBounceVoice = false;
                wasBouncing = false;
            }
        }

        if (!Player.Status.IsGrounded() && wasBouncing && currentState != Amy.StateID.StateAcceleCombo1)
        {
            if (previousState == Amy.StateID.StateAcceleCombo1)
                originalBounceState = Amy.StateID.StateAcceleCombo1;
        }

        // Land while still holding attack -> resume the bounce
        if (Player.Status.IsGrounded() && wasBouncing && currentState != Amy.StateID.StateAcceleCombo1 && previousState == Amy.StateID.StateAcceleCombo1)
        {
            if (Player.Input.IsDown(Player.InputActionType.PlayerAttack))
                Player.State.SetState<Amy.StateID>(originalBounceState);
            else
                wasBouncing = false;
        }

        if (currentState != Amy.StateID.StateAcceleCombo2 &&
            currentState != Amy.StateID.StateAcceleCombo1 &&
            currentState != Amy.StateID.StateSpinAttack)
        {
            if (!Player.Input.IsDown(Player.InputActionType.PlayerAttack) ||
                (currentState != Amy.StateID.StateFall && currentState != Amy.StateID.StateJump))
            {
                isBounceAttack = false;
                bounceAttackInitiated = false;
                bounceInputHeld = false;
                bounceHoldTime = 0.0f;
                playedBounceVoice = false;
                wasBouncing = false;
                aerialBounceEntry = false;
            }
        }

        if (currentState != Amy.StateID.StateAcceleCombo2)
            isGroundAttack = false;

        // Hammer Spin Attack
        bool spinStomping = Player.Input.IsDown(Player.InputActionType.PlayerStomping);

        if (!isHammerSwingAttack && !wasInStunState && !isBounceAttack &&
            Player.Status.IsGrounded() &&
            currentState == Amy.StateID.StateRun && speed >= 7.0f &&
            spinStomping)
        {
            Player.State.SetState<Amy.StateID>(Amy.StateID.StateTarotAttack2);
            isHammerSwingAttack = true;
            spinTimerActive = true;
            spinTimer = 0.0f;
            playedSpinVoice = false;
        }

        if (isHammerSwingAttack && !wasInStunState)
        {
            if (!spinStomping)
            {
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateSlidingToStand);
                isHammerSwingAttack = false;
                spinTimerActive = false;
                spinTimer = 0.0f;
            }
            else if (!Player.Status.IsGrounded())
            {
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateFall);
                isHammerSwingAttack = false;
                spinTimerActive = false;
                spinTimer = 0.0f;
            }
            else
            {
                if (currentState != Amy.StateID.StateTarotAttack2)
                    Player.State.SetState<Amy.StateID>(Amy.StateID.StateTarotAttack2);

                if (!playedSpinVoice)
                {
                    Lua.Call("PlayVoice", hammerspinVoices[random.Next(hammerspinVoices.Count)]);
                    playedSpinVoice = true;
                }

                // With max rings the spin runs indefinitely
                if (spinTimerActive && !hasMaxRings)
                {
                    spinTimer += deltaTime;

                    if (spinTimer >= spinDuration)
                    {
                        Player.State.SetState<Amy.StateID>(Amy.StateID.StateSleep);
                        wasInStunState = true;
                        stunTimer = 0.0f;
                        spinTimerActive = false;
                        playedStunEndAnimation = false;
                    }
                }
                else if (hasMaxRings)
                {
                    spinTimer = 0.0f;
                }
            }
        }

        if (currentState == Amy.StateID.StateSleep && wasInStunState)
        {
            stunTimer += deltaTime;

            if (stunTimer >= (stunDuration - 0.5f) && !playedStunEndAnimation)
            {
                Player.Animation.SetAnimation("PIYORI_END");
                playedStunEndAnimation = true;
            }

            if (stunTimer >= stunDuration)
            {
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateSlidingToStand);
                wasInStunState = false;
                isHammerSwingAttack = false;
                stunTimer = 0.0f;
                playedStunEndAnimation = false;
            }
        }

        if (!isHammerSwingAttack && !wasInStunState &&
            currentState != Amy.StateID.StateTarotAttack2 &&
            currentState != Amy.StateID.StateSleep &&
            currentState != Amy.StateID.StateSliding)
        {
            stunTimer = 0.0f;
            playedStunEndAnimation = false;
            playedSpinVoice = false;
            spinTimerActive = false;
            spinTimer = 0.0f;
        }

        // Landing mid-swing with X still held goes straight into the bounce
        if (timerActive && aerialAttackHeldThrough && Player.Status.IsGrounded() && Player.Input.IsDown(Player.InputActionType.PlayerAttack))
        {
            Player.State.SetState<Amy.StateID>(Amy.StateID.StateAcceleCombo1);
            isBounceAttack = true;
            bounceAttackInitiated = true;
            playedBounceVoice = false;
            wasBouncing = true;
            aerialHammerTimer = 0.0f;
            timerActive = false;
            aerialAttackHeldThrough = false;
        }

        // Aerial Attack
        if (!Player.Status.IsGrounded() && Player.Input.IsPressed(Player.InputActionType.PlayerAttack) && !IS_STATE_FLAG(IsGrind))
        {
            if (!isAerialAttack)
            {
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateRunawayBee);
                isAerialAttack = true;
                aerialAttackHeldThrough = true;
                if (!timerActive)
                {
                    aerialHammerTimer = 0.0f;
                    timerActive = true;
                }
            }
        }
        else if (currentState != Amy.StateID.StateRunawayBee && currentState != Amy.StateID.StateAirCyHammer)
        {
            isAerialAttack = false;
            timerActive = false;
            aerialAttackHeldThrough = false;
        }

        if (currentState == Amy.StateID.StateRunawayBee && !Player.Input.IsDown(Player.InputActionType.PlayerAttack))
            aerialAttackHeldThrough = false;

        if (currentState == Amy.StateID.StateRunawayBee && !Player.Status.IsGrounded() && timerActive)
        {
            aerialHammerTimer += deltaTime;
            if (aerialHammerTimer >= 0.5f)
            {
                // No bounceVelocity here: she keeps spinning in the air and the bounce block launches her on landing
                if (aerialAttackHeldThrough)
                {
                    aerialBounceCeiling = kinematics->Velocity.Y;
                    aerialBounceEntry = true;
                    Player.State.SetState<Amy.StateID>(Amy.StateID.StateAcceleCombo1);
                    isBounceAttack = true;
                    bounceAttackInitiated = true;
                    playedBounceVoice = false;
                    wasBouncing = true;
                }
                else
                {
                    Player.State.SetState<Amy.StateID>(Amy.StateID.StateFall);
                }
                timerActive = false;
                aerialAttackHeldThrough = false;
            }
        }
        else if (Player.Status.IsGrounded() && timerActive)
        {
            aerialHammerTimer = 0.0f;
            timerActive = false;
            aerialAttackHeldThrough = false;
        }

        // Ground Hammer Attack animation
        if (currentState == Amy.StateID.StateAcceleCombo2)
        {
            if (!isGroundAnimation)
            {
                Player.Animation.SetAnimation("CYHAMMER_AIR_END");
                isGroundAnimation = true;
            }
        }
        else
        {
            isGroundAnimation = false;
        }

        // Hammer Bounce animation
        if (currentState == Amy.StateID.StateAcceleCombo1)
        {
            if (!isGroundBounceAnimation)
            {
                Player.Animation.SetAnimation("CYHAMMER_AIR_LOOP");
                Player.Effect.StopAnimationEffects();
                isGroundBounceAnimation = true;
            }
        }
        else
        {
            isGroundBounceAnimation = false;
        }

        // Hammer Bounce sound
        if (currentState == Amy.StateID.StateAcceleCombo1 && !isHammerBounceSound)
        {
            hammerBounceLoopSound = Player.Sound.PlaySound("am_cyhammer_air_loop");
            isHammerBounceSound = true;
        }

        // Hammer Spin animation
        if (currentState == Amy.StateID.StateTarotAttack2)
        {
            if (!isHammerSpinAnimation)
            {
                Player.Animation.SetAnimation("RING_MAX_LOOP");
                isHammerSpinAnimation = true;
            }
        }
        else
        {
            isHammerSpinAnimation = false;
        }

        if ((previousState == Amy.StateID.StateRunawayBee || previousState == Amy.StateID.StateAcceleCombo1) && currentState == Amy.StateID.StateFall)
        {
            if (!isAerialOutroAnimation)
            {
                Player.Animation.SetAnimation("ATTACK_BOUNCE");
                isAerialOutroAnimation = true;
            }
        }
        else
        {
            isAerialOutroAnimation = false;
        }

        // Spin stun animation and voice
        if (currentState == Amy.StateID.StateSleep && wasInStunState)
        {
            if (!isSpinStunned)
            {
                Player.Animation.SetAnimation("PIYORI_START");
                Lua.Call("PlayVoice", "sa1048");
                isSpinStunned = true;
            }
        }
        else
        {
            isSpinStunned = false;
        }
    }

    // One owner for the sphere, so every hammer move hands it back the moment it ends
    float hammerRadius = 0.0f;

    if (isDoubleJumpHammerAnimation || isGrindDoubleJumpHammerAnimation || isHammerRushChargeAnimation)
        hammerRadius = 5.0f;
    else if (isHammerRushAnimation)
        hammerRadius = 1.0f;

    if (conHammerAttack == 1 &&
        (currentState == Amy.StateID.StateAcceleCombo2 ||
         currentState == Amy.StateID.StateTarotAttack2 ||
         currentState == Amy.StateID.StateRunawayBee ||
         currentState == Amy.StateID.StateAcceleCombo1 ||
         currentState == Amy.StateID.StateSpinAttack))
    {
        hammerRadius = Math.Max(hammerRadius, 1.0f);
    }

    if (conHammerStomp == 1 && currentState == Amy.StateID.StateAirCyHammer && previousState == Amy.StateID.AmyStateStomping)
        hammerRadius = Math.Max(hammerRadius, 1.0f);

    if (hammerRadius > 0.0f)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, hammerRadius);
        Player.Collision.SetEntityCollision(false);
        hasDamageSphere = true;
    }
    else if (hasDamageSphere)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        hasDamageSphere = false;
    }

    // Hammer Item Drop Management
    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.cyHammerAppearGimmick.dropItem.numRings, (uint)0);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.cyHammerAppearGimmick.dropItem.numRings2, (uint)0);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.cyHammerAppearGimmick.dropItem.num10Rings, (uint)0);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.cyHammerAppearGimmick.dropItem.numSkillPieces, (uint)0);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.cyHammerAppearGimmick.dropItem.skillPieceExp, (uint)0);
    }

    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, cyHammerAppearGimmick.dropItem.numRings, (uint)0);
        RFL_SET_PARAM(AmyParametersCyberInfo, cyHammerAppearGimmick.dropItem.numRings2, (uint)0);
        RFL_SET_PARAM(AmyParametersCyberInfo, cyHammerAppearGimmick.dropItem.num10Rings, (uint)0);
        RFL_SET_PARAM(AmyParametersCyberInfo, cyHammerAppearGimmick.dropItem.numSkillPieces, (uint)0);
        RFL_SET_PARAM(AmyParametersCyberInfo, cyHammerAppearGimmick.dropItem.skillPieceExp, (uint)0);
    }

    if (AmyParametersInfo.pData != null)
    {
        if (currentState != Amy.StateID.StateAirCyHammer)
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.numRings, (uint)0);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.numRings2, (uint)0);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.num10Rings, (uint)0);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.numSkillPieces, (uint)0);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.skillPieceExp, (uint)0);
        }
        else
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.numRings, (uint)15);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.numRings2, (uint)3);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.num10Rings, (uint)3);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.numSkillPieces, (uint)10);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.cyHammerAppearGimmick.dropItem.skillPieceExp, (uint)20);
        }
    }

    // Sliding tuning for the Ground Hammer Attack
    if (conHammerAttack == 1 && currentState == Amy.StateID.StateAcceleCombo2)
    {
        if (AmyParametersInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.minSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.endSpeed, 0.5f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.minContinueTime, 0.75f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.baseRotateForce, 1000.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 1000.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.gravitySize, 0.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleJerk, 120.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 10.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 75.0f);

            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.minSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.endSpeed, 0.5f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.minContinueTime, 0.75f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForce, 1000.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 1000.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.gravitySize, 0.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerk, 120.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 10.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 75.0f);
        }

        if (AmyParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.minSpeed, 5.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.endSpeed, 0.5f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.minContinueTime, 0.75f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.baseRotateForce, 1000.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 1000.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.gravitySize, 0.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleJerk, 120.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 10.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleForceMax, 75.0f);
        }
    }

    // Sliding tuning for the Hammer Spin
    if (conHammerAttack == 1 && currentState == Amy.StateID.StateTarotAttack2)
    {
        if (AmyParametersInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.minSpeed, 25.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.endSpeed, 18.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleJerk, 45.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleJerkContinue, 3.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.deceleForceMax, 35.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.baseRotateForce, 450.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 15.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.sliding.maxRotateForce, 2000.0f);

            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.minSpeed, 25.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.endSpeed, 18.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerk, 45.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleJerkContinue, 3.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.deceleForceMax, 35.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForce, 450.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 15.0f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.sliding.maxRotateForce, 2000.0f);
        }

        if (AmyParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.minSpeed, 25.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.endSpeed, 18.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleJerk, 45.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleJerkContinue, 3.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.deceleForceMax, 35.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.baseRotateForce, 450.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 15.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.sliding.maxRotateForce, 2000.0f);
        }
    }
}

Code "Faster Aerial Cyknuckle Descent" by "Batman Sonic"
//

#lib "Player"

static bool isDescending = false;
const float cyknuckleFallSpeed = -120.0f;

{
    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    if (Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.StateCyKnucklePreFall)
    {
        if (!isDescending)
        {
            kinematics->Velocity.Y = cyknuckleFallSpeed;
            isDescending = true;
        }
    }
    else
    {
        isDescending = false;
    }
}

Code "Unlock Heat Stomp and Aerial Cyknuckle" by "Batman Sonic"
//

#lib "Player"
#lib "Memory"
#lib "VectorHelpers"
#lib "Time"

#import "GOComponents"

#load "System.Numerics.dll"
using System.Numerics;

const float stompStopForce = 20.0f;
const float stompReleaseStopForce = 80.0f;
const float stompFallSpeed = -75.0f;
const float momentumGain = 12.5f;
const float turnSpeed = 20.0f;

static Vector3 prevVelocity;

{
    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(kinematics, out var out_pKinematics))
        return;

    var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();

    if (currentState == Knuckles.StateID.KnucklesStateStompingDown || currentState == Knuckles.StateID.StateCyKnucklePreFall)
    {
        float dt = Time.GetDeltaTime();

        Vector3 worldInput = out_pKinematics->WorldInput;
        Vector3 horizVel = new Vector3(prevVelocity.X, 0.0f, prevVelocity.Z);

        if (worldInput.LengthSquared() > 0.001f)
        {
            var inputDir = Vector3.Normalize(worldInput);
            var forward = VectorHelpers.GetForward(out_pKinematics->Rotation);
            var inputAngle = VectorHelpers.SignedAngle(forward, inputDir, Vector3.UnitY);
            var rotationStep = (float)Math.Sign(inputAngle) * (float)Math.Min(Math.Abs(inputAngle), turnSpeed * dt);
            var rotationDelta = Quaternion.CreateFromAxisAngle(Vector3.UnitY, rotationStep);

            out_pKinematics->Rotation = Quaternion.Normalize(Quaternion.Concatenate(out_pKinematics->Rotation, rotationDelta));

            // Turn the momentum along with the new facing
            if (horizVel.LengthSquared() > 0.001f)
                horizVel = Vector3.Transform(horizVel, rotationDelta);

            horizVel += inputDir * momentumGain * dt;
        }
        else
        {
            float decel = (Player.Input.IsDown(Player.InputActionType.PlayerStomping) ? stompStopForce : stompReleaseStopForce) * dt;
            float speed = horizVel.Length();

            horizVel = speed > decel ? Vector3.Normalize(horizVel) * (speed - decel) : Vector3.Zero;
        }

        out_pKinematics->Velocity = new Vector3(horizVel.X, stompFallSpeed, horizVel.Z);
    }

    prevVelocity = out_pKinematics->Velocity;
}

Code "Knuckles Combat Rework" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "GameObject"
#lib "Reflection"
#lib "KnucklesParameters"
#lib "Time"
#lib "GameManager"
#lib "HMM"
#lib "INI"
#lib "Lua"

static bool isCombo1Animation = false;
static bool isCombo2Animation = false;
static bool isUppercutAnimation = false;
static bool isHomingFinishAnimation = false;
static bool isGroundSlamAnimation = false;
static bool isUppercutGroundAnimation = false;
static bool isChargeAttackAirAnimation = false;
static bool wasInSpinAttack = false;

static float spinAttackDelayTimer = 0.0f;
static bool spinAttackDelayActive = false;
static Knuckles.StateID spinAttackReturnState = Knuckles.StateID.StateAcceleCombo1;

static bool isInCombo = false;
static bool canTransitionToFinisher = false;
static float comboTimer = 0.0f;
const float comboWindow = 0.8f;
static float comboCooldown = 0.0f;
static bool cooldownActive = false;

static float combo1Timer = 0.0f;
static float combo2Timer = 0.0f;
static float homingFinishTimer = 0.0f;

const float dashSpeed = 45.0f;
static bool hasPlayedDashSound = false;
static bool hasPlayedDashEffects = false;

const float combo1Speed = 12.0f;
const float combo2Speed = 12.0f;

const float uppercutJumpVelocity = 26.0f;
static bool appliedUppercutVelocity = false;

const float chargeAttackJumpVelocity = 17.0f;
static bool appliedChargeVelocity = false;
static bool isDescending = false;
static float groundSlamTimer = 0.0f;
static bool hasPlayedChargeSound = false;
static bool hasPlayedSlamEffects = false;

static bool canPerformAerialAttack = true;
static float aerialAttackCooldown = 0.0f;
const float aerialAttackCooldownDuration = 0.5f;

static bool hitboxActive = false;

const int dashAuraEffectCount = 36;
const int stompLandingEffectCount = 19;

static bool isDive = false;

static bool isConfigInitialized = false;
static int conScrewdriverAbility = 0;

const float lightPunchMomentum = 5.0f;

static List<Knuckles.StateID> drillStates = new()
{
    Knuckles.StateID.KnucklesStateDrillBoostRoot,
    Knuckles.StateID.KnucklesStateDrillBoost,
    Knuckles.StateID.KnucklesStateDrillBoostJump,
    Knuckles.StateID.KnucklesStateDrillBoostFall,
    Knuckles.StateID.KnucklesStateDrillBoostStep,
    Knuckles.StateID.KnucklesStateDrillBoostAir
};

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conScrewdriverAbility = INI.GetField<int>(ini, "Main", "ScrewdriverAbility", conScrewdriverAbility);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
    var previousState = Player.State.GetPreviousStateID<Knuckles.StateID>();

    bool isDrill = drillStates.Contains(currentState);
    bool isSpringJump = IS_STATE_FLAG(IsSpringJump);
    bool isGrind = IS_STATE_FLAG(IsGrind);
    bool isDiving = IS_STATE_FLAG(IsDiving);
    bool isDivingBoost = IS_STATE_FLAG(IsDivingBoost);
    bool isDamaged = IS_WORLD_FLAG(IsDamagedOrRepelled);
    bool isDead = IS_WORLD_FLAG(IsDead);
    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);
    bool isOutOfControl = IS_WORLD_FLAG(IsOutOfControl);

    if (IS_STATE_FLAG(IsDiving))
    {
        isDive = true;
    }
    else if (Player.Status.IsGroundedSpecial())
    {
        isDive = false;
    }

    bool inHomingRebound = currentState == Knuckles.StateID.StateHomingFinished && (previousState == Knuckles.StateID.StateHomingAttackInStorm || isDive);

    bool isCombatBlocked = currentState == Knuckles.StateID.StateJumpBoardLaunch ||
                           currentState == Knuckles.StateID.StateHomingAttack ||
                           currentState == Knuckles.StateID.StateHomingAttackInStorm ||
                           currentState == Knuckles.StateID.StateSpinBoostCharge ||
                           currentState == Knuckles.StateID.StateStorm ||
                           currentState == Knuckles.StateID.StateCaught ||
                           currentState == Knuckles.StateID.StateHangPole ||
                           currentState == Knuckles.StateID.StateAvoid ||
                           currentState == Knuckles.StateID.StateParry ||
                           currentState == Knuckles.StateID.StateParryStand ||
                           currentState == Knuckles.StateID.StateAirBoost ||
                           currentState == Knuckles.StateID.StateSlingshot ||
                           currentState == Knuckles.StateID.StateSandSki ||
                           currentState == Knuckles.StateID.StateSandSkiBlow ||
                           isDrill ||
                           isSpringJump ||
                           isGrind ||
                           isDamaged ||
                           isDiving ||
                           isDivingBoost ||
                           isDead ||
                           isAutoRun ||
                           isOutOfControl ||
                           inHomingRebound;

    if (isCombatBlocked)
    {
        // Restore Homing Attack while combat is inactive, since some battles rely on it
        Lua.Call("SetPlayerAbilityEnabled", "HomingAttack", true);

        if (hasPlayedDashEffects)
            StopEffects("DashAura", dashAuraEffectCount);

        if (hasPlayedSlamEffects)
            StopEffects("StompLanding", stompLandingEffectCount);

        isCombo1Animation = false;
        isCombo2Animation = false;
        isUppercutAnimation = false;
        isHomingFinishAnimation = false;
        isGroundSlamAnimation = false;
        isUppercutGroundAnimation = false;
        isChargeAttackAirAnimation = false;
        wasInSpinAttack = false;

        isInCombo = false;
        canTransitionToFinisher = false;
        cooldownActive = false;
        comboTimer = 0.0f;
        comboCooldown = 0.0f;
        combo1Timer = 0.0f;
        combo2Timer = 0.0f;
        homingFinishTimer = 0.0f;
        groundSlamTimer = 0.0f;

        appliedUppercutVelocity = false;
        appliedChargeVelocity = false;
        isDescending = false;

        hasPlayedDashSound = false;
        hasPlayedDashEffects = false;
        hasPlayedChargeSound = false;
        hasPlayedSlamEffects = false;

        canPerformAerialAttack = true;
        aerialAttackCooldown = 0.0f;

        spinAttackDelayActive = false;
        spinAttackDelayTimer = 0.0f;

        if (hitboxActive)
        {
            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);
            hitboxActive = false;
        }

        return;
    }

    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");

    var kinematics = Player.Kinematics.Get();
    if (kinematics == null)
        return;

    float speed = Player.Kinematics.GetHorizontalMagnitude();
    float deltaTime = Time.GetDeltaTime();

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;
    if (isPaused)
        deltaTime = 0.0f;

    var pGameObject = Player.Status.GetLockOnTarget();

    // Disable the light-attack homing route when locked onto an enemy with a healthbar, else keep it
    if (KnucklesParametersInfo.pData != null)
    {
        bool hasHealthTarget = pGameObject != null && GameObject.GetGOC(pGameObject, "GOCHealth") != null;

        var lightAttackMove = hasHealthTarget ? KnucklesParameters.ComboMoveType.None : KnucklesParameters.ComboMoveType.Homing;
        var lightAttackAction = hasHealthTarget ? KnucklesParameters.Action.Root : KnucklesParameters.Action.HomingAttack;

        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboMoveSonic.moveType, lightAttackMove);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitExistTarget[0], lightAttackAction);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitInAir[0], lightAttackAction);
    }

    if (Player.Status.IsGrounded())
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateAcceleCombo1, Knuckles.StateID.StateSliding);
    else
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateAcceleCombo1, Knuckles.StateID.StateBounceJump);

    // Suspend CyKnuckle mid-uppercut so it can't cancel the finisher
    if (KnucklesParametersInfo.pData != null)
    {
        var cyKnuckleAction = currentState == Knuckles.StateID.KnucklesStateUppercut ? KnucklesParameters.Action.Root : KnucklesParameters.Action.KnucklesCyKnuckle;

        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitExistTarget[2], cyKnuckleAction);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitInAir[2], cyKnuckleAction);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitNotExistTarget[2], cyKnuckleAction);
    }

    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateAcceleCombo2, Knuckles.StateID.StateSliding);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.KnucklesStateUppercut, Knuckles.StateID.StateRecoveryJump);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateChargeAttack, Knuckles.StateID.StateRecoveryJump);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateHomingFinish, Knuckles.StateID.StateSliding);

    Player.State.Discard<Knuckles.StateID>(Knuckles.StateID.KnucklesStatePunch1);

    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitNotExistTarget[0], KnucklesParameters.Action.Root);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.homingAttack.transitExistTarget[0], KnucklesParameters.Action.Root);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.homingAttack.transitInAir[0], KnucklesParameters.Action.Root);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.homingAttack.transitNotExistTarget[0], KnucklesParameters.Action.Root);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.knucklesPunch1.transitExistTarget[0], KnucklesParameters.Action.Root);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.knucklesPunch1.transitInAir[0], KnucklesParameters.Action.Root);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.knucklesPunch1.transitNotExistTarget[0], KnucklesParameters.Action.Root);
    }

    bool attackPressed = Player.Input.IsPressed(Player.InputActionType.PlayerAttack);
    bool stompPressed = Player.Input.IsPressed(Player.InputActionType.PlayerStomping);
    bool cyloopPressed = Player.Input.IsPressed(Player.InputActionType.PlayerCyloop);

    if (!canPerformAerialAttack)
    {
        aerialAttackCooldown += deltaTime;
        if (aerialAttackCooldown >= aerialAttackCooldownDuration)
        {
            canPerformAerialAttack = true;
            aerialAttackCooldown = 0.0f;
        }
    }

    if (isInCombo)
    {
        comboTimer += deltaTime;
        if (comboTimer >= comboWindow)
        {
            isInCombo = false;
            canTransitionToFinisher = false;
            comboTimer = 0.0f;
        }
    }

    if (cooldownActive)
    {
        comboCooldown += deltaTime;
        if (comboCooldown >= 0.5f)
        {
            comboCooldown = 0.0f;
            cooldownActive = false;
        }
    }

    // Screwdriver compatibility: only let a grounded combo start from a plain run
    bool canStartCombat = true;
    if (conScrewdriverAbility == 1 && Player.Status.IsGrounded())
        canStartCombat = (currentState == Knuckles.StateID.StateRun);

    // Combo starter / aerial attack
    if (!isInCombo && !cooldownActive && attackPressed && canStartCombat)
    {
        if (Player.Status.IsGrounded() && speed < lightPunchMomentum)
            kinematics->Velocity = Player.Kinematics.GetForward() * lightPunchMomentum;

        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateAcceleCombo1);

        if (Player.Status.IsGrounded())
        {
            isInCombo = true;
            comboTimer = 0.0f;
        }
        else
        {
            canPerformAerialAttack = false;
            aerialAttackCooldown = 0.0f;
        }

        combo1Timer = 0.0f;
    }

    if (currentState == Knuckles.StateID.StateAcceleCombo1)
    {
        if (!Player.Status.IsGrounded() && pGameObject != null && GameObject.GetGOC(pGameObject, "GOCHealth") == null)
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateHomingAttack);

        if (Player.Status.IsGrounded() && speed < 14.0f)
            kinematics->Velocity = Player.Kinematics.GetForward() * combo1Speed;

        combo1Timer += deltaTime;
        if (combo1Timer >= 0.5f)
        {
            if (Player.Status.IsGrounded())
                Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateRun);
            else
                Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateFall);

            combo1Timer = 0.0f;

            // A chain press on this frame still needs the combo alive, otherwise the leftover window swallows the next starter
            if (!attackPressed)
            {
                isInCombo = false;
                canTransitionToFinisher = false;
                comboTimer = 0.0f;
            }
        }
    }
    else
    {
        combo1Timer = 0.0f;
    }

    if (currentState == Knuckles.StateID.StateAcceleCombo1 && isInCombo && Player.Status.IsGrounded() && attackPressed)
    {
        if (speed < lightPunchMomentum)
            kinematics->Velocity = Player.Kinematics.GetForward() * lightPunchMomentum;

        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateAcceleCombo2);
        comboTimer = 0.0f;
        combo2Timer = 0.0f;
        canTransitionToFinisher = true;
    }

    if (currentState == Knuckles.StateID.StateAcceleCombo2)
    {
        if (speed < 14.0f)
            kinematics->Velocity = Player.Kinematics.GetForward() * combo2Speed;

        combo2Timer += deltaTime;
    }
    else
    {
        combo2Timer = 0.0f;
    }

    bool finisherStarted = false;

    // Finisher branches: cyloop -> uppercut, stomp -> dash, attack -> charge slam
    if (currentState == Knuckles.StateID.StateAcceleCombo2)
    {
        if (cyloopPressed && canTransitionToFinisher)
        {
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.KnucklesStateUppercut);
            finisherStarted = true;
            isInCombo = false;
            canTransitionToFinisher = false;
            cooldownActive = true;
            comboCooldown = 0.0f;
            appliedUppercutVelocity = false;
        }
        else if (stompPressed && canTransitionToFinisher)
        {
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateHomingFinish);
            finisherStarted = true;
            isInCombo = false;
            canTransitionToFinisher = false;
            cooldownActive = true;
            comboCooldown = 0.0f;
            homingFinishTimer = 0.0f;
            hasPlayedDashEffects = false;
        }
        else if (attackPressed && canTransitionToFinisher)
        {
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateChargeAttack);
            finisherStarted = true;
            isInCombo = false;
            canTransitionToFinisher = false;
            cooldownActive = true;
            comboCooldown = 0.0f;
            appliedChargeVelocity = false;
            isDescending = false;
            groundSlamTimer = 0.0f;
            hasPlayedChargeSound = false;
            hasPlayedSlamEffects = false;
        }
    }

    // Punch 2 ends on its own timer so the pose never outlasts COMBO_PUNCH02
    if (currentState == Knuckles.StateID.StateAcceleCombo2 && !finisherStarted && combo2Timer >= 0.5f)
    {
        if (Player.Status.IsGrounded())
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateRun);
        else
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateFall);

        combo2Timer = 0.0f;
        isInCombo = false;
        canTransitionToFinisher = false;
        comboTimer = 0.0f;
    }

    // Uppercut
    if (currentState == Knuckles.StateID.KnucklesStateUppercut)
    {
        if (!appliedUppercutVelocity)
        {
            kinematics->Velocity.Y = uppercutJumpVelocity;
            appliedUppercutVelocity = true;
        }

        if (Player.Status.IsGrounded())
        {
            if (!isUppercutGroundAnimation)
            {
                Player.Effect.StopAnimationEffects();
                Player.Animation.SetAnimation("COMBO_UPPERCUT_AIR");
                isUppercutGroundAnimation = true;
                isUppercutAnimation = false;
            }
        }
        else
        {
            if (!isUppercutAnimation)
            {
                Player.Effect.StopAnimationEffects();
                Player.Animation.SetAnimation("COMBO_UPPERCUT_AIR");
                isUppercutAnimation = true;
                isUppercutGroundAnimation = false;
            }
        }
    }
    else
    {
        isUppercutGroundAnimation = false;
        isUppercutAnimation = false;
        appliedUppercutVelocity = false;
    }

    // Charge Attack ground slam
    if (currentState == Knuckles.StateID.StateChargeAttack)
    {
        if (!hasPlayedChargeSound)
        {
            Player.Sound.PlaySound("sn_lightdash");
            hasPlayedChargeSound = true;
        }

        if (!appliedChargeVelocity)
        {
            kinematics->Velocity.Y = chargeAttackJumpVelocity;
            appliedChargeVelocity = true;
        }

        if (kinematics->Velocity.Y < -5.0f)
            isDescending = true;
    }
    else
    {
        appliedChargeVelocity = false;
        hasPlayedChargeSound = false;
    }

    if (Player.Status.IsGrounded() && currentState != Knuckles.StateID.StateChargeAttack &&
        previousState == Knuckles.StateID.StateChargeAttack && isDescending)
    {
        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateSleep);
        isDescending = false;
    }

    if (currentState == Knuckles.StateID.StateSleep)
    {
        if (!isGroundSlamAnimation)
        {
            Player.Effect.StopAnimationEffects();
            Player.Animation.SetAnimation("COMBO_PUNCH03_END");
            Player.Sound.PlaySound("sn_stomping_land");
            Lua.Call("PlayVoice", "ka1100");
            isGroundSlamAnimation = true;
            groundSlamTimer = 0.0f;
            hasPlayedSlamEffects = false;
        }

        if (!hasPlayedSlamEffects)
        {
            Player.Effect.PlayEffect("StompLanding", "ef_knp_stomp_endshake01");
            Player.Effect.PlayEffect("StompLanding", "ef_knp_stomp_end01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_radialblur01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_shake01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_shock01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_spiral01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_spiral02");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_spiral03");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_gpu01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_gpu02");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_ground01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_plight01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_flame01_blk");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_flame02");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_flame02_blk");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_flamering01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_flamering01_blk");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_cybernoise01");
            Player.Effect.PlayEffect("StompLanding", "ec_knp_stomp_end01_flame01");
            hasPlayedSlamEffects = true;
        }

        groundSlamTimer += deltaTime;
        if (groundSlamTimer >= 1.0f)
        {
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateSlidingToStand);
            isGroundSlamAnimation = false;
            groundSlamTimer = 0.0f;
            isDescending = false;
            StopEffects("StompLanding", stompLandingEffectCount);
            hasPlayedSlamEffects = false;
        }
    }
    else
    {
        isGroundSlamAnimation = false;
        if (hasPlayedSlamEffects)
        {
            StopEffects("StompLanding", stompLandingEffectCount);
            hasPlayedSlamEffects = false;
        }
    }

    // Dash Attack
    if (currentState == Knuckles.StateID.StateHomingFinish)
    {
        if (!hasPlayedDashSound)
        {
            Player.Sound.PlaySound("sn_cont_attack2");
            hasPlayedDashSound = true;
        }

        if (!hasPlayedDashEffects)
        {
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_aura01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_core01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_glow01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_light01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_par01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_smoke01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_smoke02");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_wind01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact01_wind02");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_aura01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_core01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_glow01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_light01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_par01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_smoke01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_smoke02");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_wind01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_boost_impact02_wind02");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_dash01_ge01_air01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_dash01_ge01_gpu01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_dash01_ge01_light01");
            Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_dash01_ge01_line01");
            for (int i = 0; i < 7; i++)
            {
                Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_dash01_ge01_smoke01");
                Player.Effect.PlayEffect("DashAura", "ec_kn_nitro_dash01_ge01_wind01");
            }
            hasPlayedDashEffects = true;
        }

        kinematics->Velocity = Player.Kinematics.GetForward() * dashSpeed;

        homingFinishTimer += deltaTime;
        if (homingFinishTimer >= 0.5f)
        {
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateSlidingToStand);
            homingFinishTimer = 0.0f;
        }
    }
    else
    {
        if (hasPlayedDashEffects)
            StopEffects("DashAura", dashAuraEffectCount);

        hasPlayedDashSound = false;
        hasPlayedDashEffects = false;
        homingFinishTimer = 0.0f;
    }

    if (currentState == Knuckles.StateID.StateAcceleCombo1)
    {
        if (!isCombo1Animation)
        {
            Player.Effect.StopAnimationEffects();
            if (Player.Status.IsGrounded())
                Player.Animation.SetAnimation("COMBO_PUNCH01");
            else
                Player.Animation.SetAnimation("COMBO_PUNCH01_AIR");
            isCombo1Animation = true;
        }
    }
    else
    {
        isCombo1Animation = false;
    }

    if (currentState == Knuckles.StateID.StateAcceleCombo2)
    {
        if (!isCombo2Animation)
        {
            Player.Effect.StopAnimationEffects();
            Player.Animation.SetAnimation("COMBO_PUNCH02");
            isCombo2Animation = true;
        }
    }
    else
    {
        isCombo2Animation = false;
    }

    if (currentState == Knuckles.StateID.StateChargeAttack && !Player.Status.IsGrounded())
    {
        if (!isChargeAttackAirAnimation)
        {
            Player.Effect.StopAnimationEffects();
            Player.Animation.SetAnimation("COMBO_PUNCH03_START");
            Lua.Call("PlayVoice", "ka1202");
            isChargeAttackAirAnimation = true;
        }
    }
    else
    {
        isChargeAttackAirAnimation = false;
    }

    if (currentState == Knuckles.StateID.StateHomingFinish)
    {
        if (!isHomingFinishAnimation)
        {
            Player.Effect.StopAnimationEffects();
            Player.Animation.SetAnimation("COMBO_DASH");
            Lua.Call("PlayVoice", "sa1010");
            isHomingFinishAnimation = true;
        }
    }
    else
    {
        isHomingFinishAnimation = false;
    }

    if (currentState == Knuckles.StateID.KnucklesStateUppercut && !Player.Status.IsGrounded() && !isUppercutGroundAnimation)
    {
        if (!isUppercutAnimation)
        {
            Player.Effect.StopAnimationEffects();
            Player.Animation.SetAnimation("COMBO_UPPERCUT");
            isUppercutAnimation = true;
        }
    }
    else if (currentState != Knuckles.StateID.KnucklesStateUppercut)
    {
        isUppercutAnimation = false;
    }

    // deltaTime is already 0 while paused
    if (spinAttackDelayActive)
    {
        spinAttackDelayTimer -= deltaTime;
        if (spinAttackDelayTimer <= 0.0f)
        {
            Player.State.SetState<Knuckles.StateID>(spinAttackReturnState);
            spinAttackDelayActive = false;
            spinAttackDelayTimer = 0.0f;
        }
    }

    // Let the spin attack play briefly before returning to the combo bounce
    if (currentState == Knuckles.StateID.StateSpinAttack &&
        previousState == Knuckles.StateID.StateAcceleCombo1)
    {
        if (!wasInSpinAttack)
        {
            wasInSpinAttack = true;
            spinAttackReturnState = Knuckles.StateID.StateAcceleCombo1;
            spinAttackDelayTimer = 0.1f;
            spinAttackDelayActive = true;
        }
    }
    else
    {
        wasInSpinAttack = false;
    }

    if (currentState != Knuckles.StateID.StateAcceleCombo1 &&
        currentState != Knuckles.StateID.StateAcceleCombo2 &&
        currentState != Knuckles.StateID.StateChargeAttack &&
        currentState != Knuckles.StateID.StateHomingFinish &&
        currentState != Knuckles.StateID.KnucklesStateUppercut)
    {
        if (isInCombo && comboTimer >= comboWindow)
        {
            isInCombo = false;
            canTransitionToFinisher = false;
            comboTimer = 0.0f;
        }
    }

    bool isDamageState = currentState == Knuckles.StateID.StateAcceleCombo1 ||
                         currentState == Knuckles.StateID.StateAcceleCombo2 ||
                         currentState == Knuckles.StateID.StateChargeAttack ||
                         currentState == Knuckles.StateID.StateHomingFinish ||
                         currentState == Knuckles.StateID.KnucklesStateUppercut ||
                         currentState == Knuckles.StateID.StateBounceJump ||
                         currentState == Knuckles.StateID.StateSleep;

    if (isDamageState)
    {
        // The ground slam gets a bigger sphere to match its shockwave
        float damageRadius = (currentState == Knuckles.StateID.StateSleep) ? 10.0f : 2.5f;
        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, damageRadius);
        Player.Collision.SetEntityCollision(false);
        hitboxActive = true;
    }
    else if (hitboxActive)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        hitboxActive = false;
    }

    if (currentState == Knuckles.StateID.StateAcceleCombo1 ||
        currentState == Knuckles.StateID.StateAcceleCombo2 ||
        currentState == Knuckles.StateID.StateHomingFinish)
    {
        if (KnucklesParametersInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.minSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.minSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.endSpeed, 0.5f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.endSpeed, 0.5f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.minContinueTime, 0.75f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.minContinueTime, 0.75f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.baseRotateForce, 1000.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForce, 1000.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.baseRotateForceSpeed, 1000.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.baseRotateForceSpeed, 1000.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.sliding.gravitySize, 0.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.sliding.gravitySize, 0.0f);
        }

        if (KnucklesParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.minSpeed, 5.0f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.endSpeed, 0.5f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.minContinueTime, 0.75f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.baseRotateForce, 1000.0f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.baseRotateForceSpeed, 1000.0f);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.sliding.gravitySize, 0.0f);
        }
    }
}

static void StopEffects(string name, int count)
{
    for (int i = 0; i < count; i++)
        Player.Effect.StopEffect(name);
}

Code "Screwdriver" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "KnucklesParameters"
#lib "Converse"
#lib "Lua"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "GameManager"
#lib "BlackboardStatus"

#load "System.Numerics.dll"

using System.Numerics;

static bool isCharging = false;
static bool isScrewdriving = false;
static float chargeTime = 0.0f;
static float screwdriveTimer = 0.0f;
static float screwdriveTimeElapsed = 0.0f;
static bool hasStartedScrewdriveAnimation = false;
static bool hasPlayedSound = false;
static bool hasPlayedChargeVoice = false;
static bool trail = false;
static bool screwdriverAura = false;
static bool screwdriverAuraMax = false;
static bool hasPlayedChargeSound = false;
static bool hasPlayedMaxChargeSound = false;
static bool isMaxChargeAuraPlaying = false;

static bool isScrewdriveHoming = false;
static bool isTextRedirected = false;

static float stateTransitionCooldown = 0.0f;
const float transitionCooldownTime = 0.2f;

const float maxChargeTime = 2.0f;
const float minScrewdriveSpeed = 45.0f;
const float maxScrewdriveSpeed = 120.0f;
const float screwdriveDuration = 1.2f;
const float momentumPreservation = 0.8f;
const float gravityResistance = 0.6f;

static bool isConfigInitialized = false;
static int conScrewdriverAbility = 0;

static string[] basicChargeEffects = {
    "ec_knp_heatknuckle_charge01_aura01",
    "ef_knp_heatknuckle_charge01",
    "ec_knp_heatknuckle_charge01_flame01",
    "ec_knp_heatknuckle_charge01_flame02",
    "ec_knp_heatknuckle_charge01_glow01",
    "ec_knp_heatknuckle_charge01_plight01",
    "ec_knp_heatknuckle_charge01_dist01"
};

static string[] maxChargeEffects = {
    "ef_knp_heatknuckle_aura01",
    "ef_knp_heatknuckle_charge01"
};

void StartBasicChargeEffects()
{
    if (!screwdriverAura)
    {
        foreach (string effect in basicChargeEffects)
        {
            Player.Effect.PlayEffect("ScrewdriverAura", effect);
        }
        screwdriverAura = true;
    }
}

void StartMaxChargeEffects()
{
    if (!screwdriverAuraMax)
    {
        foreach (string effect in maxChargeEffects)
        {
            Player.Effect.PlayEffect("ScrewdriverAuraMax", effect);
        }
        screwdriverAuraMax = true;
    }
}

void StopAllChargeEffects()
{
    if (screwdriverAura)
    {
        // StopEffect kills one instance per call, so stop it once for every effect that was started
        foreach (string effect in basicChargeEffects)
            Player.Effect.StopEffect("ScrewdriverAura");
        screwdriverAura = false;
    }

    if (screwdriverAuraMax)
    {
        foreach (string effect in maxChargeEffects)
            Player.Effect.StopEffect("ScrewdriverAuraMax");
        screwdriverAuraMax = false;
    }
}

void StopMaxChargeAura()
{
    if (!isMaxChargeAuraPlaying)
        return;

    // Restart then stop to cut the looping aura sound
    int soundHandle = Player.Sound.PlaySound("kn_heat_knuckle_aura");
    Player.Sound.StopSound(&soundHandle);
    isMaxChargeAuraPlaying = false;
}

void StartTrailEffect()
{
    if (!trail)
    {
        Player.Effect.PlayEffect("Trail", "ec_knp_ringmax_glide01_red_line01");
        trail = true;
    }
}

void StopTrailEffect()
{
    if (trail)
    {
        Player.Effect.StopEffect("Trail");
        trail = false;
    }
}

void StartScrewdriverHomingAttack()
{
    if (!isScrewdriveHoming)
    {
        Player.Effect.PlayEffect(
            "isScrewdriveHoming",
            "ec_knp_ringmax_glide01_red_line01"
        );

        isScrewdriveHoming = true;
    }
}

void StopScrewdriverHomingAttack()
{
    if (isScrewdriveHoming)
    {
        Player.Effect.StopEffect("isScrewdriveHoming");
        isScrewdriveHoming = false;
    }
}

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conScrewdriverAbility = INI.GetField<int>(ini, "Main", "ScrewdriverAbility", conScrewdriverAbility);
            isConfigInitialized = true;
        }
    }

    if (conScrewdriverAbility != 1)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    Lua.Init();
    float deltaTime = Time.GetDeltaTime();

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;
    if (isPaused)
        deltaTime = 0.0f;

    bool isTricking = IS_WORLD_FLAG(IsAirTrick);
    bool isOutOfControl = IS_WORLD_FLAG(IsOutOfControl);
    bool isGrind = IS_STATE_FLAG(IsGrind);
    bool isDamage = IS_WORLD_FLAG(IsDamagedOrRepelled);

    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateRunawayBee, Knuckles.StateID.StateFall);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateWakeUp, Knuckles.StateID.StateStandRoot);

    var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
    var previousState = Player.State.GetPreviousStateID<Knuckles.StateID>();

    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    if (stateTransitionCooldown > 0)
        stateTransitionCooldown -= deltaTime;

    // Turn off the light-attack homing route so holding attack charges instead of firing a homing hit
    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboMoveSonic.moveType, KnucklesParameters.ComboMoveType.None);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitExistTarget[0], KnucklesParameters.Action.Root);
        RFL_SET_PARAM(KnucklesParametersInfo, common.combo.comboTable.root.transitInAir[0], KnucklesParameters.Action.Root);
    }

    if (currentState == Knuckles.StateID.StateHomingAttack || currentState == Knuckles.StateID.StateHomingAttackInStorm)
    {
        StartScrewdriverHomingAttack();
    }
    else
    {
        StopScrewdriverHomingAttack();
    }

    // Clear leftover screwdrive state/effects once grounded or coming out of the dash
    if (!isCharging &&
        currentState != Knuckles.StateID.StateRunawayBee &&
        (previousState == Knuckles.StateID.StateRunawayBee || Player.Status.IsGrounded()))
    {
        isScrewdriving = false;
        hasStartedScrewdriveAnimation = false;
        hasPlayedSound = false;
        hasPlayedChargeVoice = false;
        hasPlayedChargeSound = false;
        hasPlayedMaxChargeSound = false;
        screwdriveTimeElapsed = 0.0f;

        StopTrailEffect();
        StopAllChargeEffects();

        StopMaxChargeAura();
    }

    if (!isCharging && (screwdriverAura || screwdriverAuraMax))
    {
        StopAllChargeEffects();
        hasPlayedChargeSound = false;
        hasPlayedMaxChargeSound = false;

        StopMaxChargeAura();
    }

    bool canStartCharging = currentState == Knuckles.StateID.StateStandRoot &&
                           Player.Input.IsDown(Player.InputActionType.PlayerAttack) &&
                           !isGrind &&
                           !isTricking &&
                           !isDamage &&
                           !isOutOfControl &&
                           !BlackboardStatus.IsSuper() &&
                           !isCharging &&
                           !isScrewdriving &&
                           stateTransitionCooldown <= 0;

    if (canStartCharging)
    {
        isCharging = true;
        chargeTime = 0.0f;
        stateTransitionCooldown = transitionCooldownTime;
        Player.Animation.SetAnimation("SCREW_READY_LOOP");

        kinematics->Velocity = Vector3.Zero;

        if (!hasPlayedChargeVoice)
        {
            Lua.Call("PlayVoice", "ka1202");
            hasPlayedChargeVoice = true;
        }

        StartBasicChargeEffects();

        if (!hasPlayedChargeSound)
        {
            Player.Sound.PlaySound("kn_heat_knuckle_charge");
            hasPlayedChargeSound = true;
        }
    }
    else if (isCharging && currentState == Knuckles.StateID.StateStandRoot)
    {
        Player.Animation.SetAnimation("SCREW_READY_LOOP");
        kinematics->Velocity = Vector3.Zero;

        if (Player.Input.IsDown(Player.InputActionType.PlayerAttack))
        {
            chargeTime += deltaTime;
            chargeTime = Math.Min(chargeTime, maxChargeTime);

            float chargeRatio = chargeTime / maxChargeTime;

            if (chargeRatio >= 1.0f)
            {
                StartMaxChargeEffects();

                if (!hasPlayedMaxChargeSound)
                {
                    Player.Sound.PlaySound("sn_ringmax");
                    hasPlayedMaxChargeSound = true;
                }

                if (!isMaxChargeAuraPlaying)
                {
                    Player.Sound.PlaySound("kn_heat_knuckle_aura");
                    isMaxChargeAuraPlaying = true;
                }
            }
        }
        else
        {
            float chargeRatio = chargeTime / maxChargeTime;
            bool isMaxCharge = chargeRatio >= 1.0f;
            screwdriveTimer = screwdriveDuration * (0.6f + chargeRatio * 0.4f);

            StopMaxChargeAura();

            if (Player.Status.IsLockOnCursorVisible())
            {
                if (isMaxCharge)
                    Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateMaximumHeatKnuckle);
                else
                    Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateHomingAttack);

                isCharging = false;
                chargeTime = 0.0f;
                hasPlayedChargeVoice = false;

                StopAllChargeEffects();
            }
            else
            {
                Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateRunawayBee);
                isCharging = false;
                isScrewdriving = true;
                screwdriveTimeElapsed = 0.0f;
                hasStartedScrewdriveAnimation = false;
                hasPlayedSound = false;
                hasPlayedChargeVoice = false;
            }
        }
    }
    else if (isScrewdriving && currentState == Knuckles.StateID.StateRunawayBee)
    {
        if (!hasPlayedSound)
        {
            Player.Sound.PlaySound("sn_homing");
            Lua.Call("PlayVoice", "sa1010");
            hasPlayedSound = true;
        }

        if (!hasStartedScrewdriveAnimation)
        {
            Player.Animation.SetAnimation("BOOST_POWER_LOOP");
            hasStartedScrewdriveAnimation = true;
        }

        StartTrailEffect();

        Vector3 currentVelocity = kinematics->Velocity;
        Vector3 moveDirection = Player.Kinematics.GetForward();

        float chargeRatio = Math.Min(chargeTime / maxChargeTime, 1.0f);
        float normalizedTime = screwdriveTimeElapsed / screwdriveTimer;

        float screwdriveSpeed = minScrewdriveSpeed + (maxScrewdriveSpeed - minScrewdriveSpeed) * chargeRatio;

        float momentumFactor = 1.0f;
        if (normalizedTime < 0.3f)
        {
            momentumFactor = 1.0f;
        }
        else if (normalizedTime < 0.7f)
        {
            float fadeProgress = (normalizedTime - 0.3f) / 0.4f;
            momentumFactor = 1.0f - (fadeProgress * 0.3f);
        }
        else
        {
            float fadeProgress = (normalizedTime - 0.7f) / 0.3f;
            momentumFactor = 0.7f - (fadeProgress * 0.4f);
        }

        Vector3 targetVelocity = moveDirection * screwdriveSpeed * momentumFactor;

        if (normalizedTime < 0.4f)
        {
            float upwardProgress = normalizedTime / 0.4f;
            float upwardForce = screwdriveSpeed * 0.4f * (1.0f - upwardProgress);
            targetVelocity.Y = Math.Max(currentVelocity.Y, upwardForce);
        }
        else
        {
            float gravityProgress = (normalizedTime - 0.4f) / 0.6f;
            float gravityForce = -20.0f * gravityProgress * (1.0f - gravityResistance);
            targetVelocity.Y = currentVelocity.Y + gravityForce * deltaTime;
        }

        float lerpFactor = Math.Min(deltaTime * 8.0f, 1.0f);
        Vector3 newVelocity = Vector3.Lerp(currentVelocity, targetVelocity, lerpFactor);

        Vector3 horizontalCurrent = new Vector3(currentVelocity.X, 0, currentVelocity.Z);
        Vector3 horizontalTarget = new Vector3(targetVelocity.X, 0, targetVelocity.Z);
        Vector3 horizontalBlend = Vector3.Lerp(horizontalCurrent, horizontalTarget, lerpFactor * momentumPreservation);

        kinematics->Velocity = new Vector3(horizontalBlend.X, newVelocity.Y, horizontalBlend.Z);

        screwdriveTimeElapsed += deltaTime;

        if (screwdriveTimeElapsed >= screwdriveTimer)
        {
            Vector3 finalVelocity = kinematics->Velocity;
            finalVelocity *= 0.9f;
            kinematics->Velocity = finalVelocity;

            StopTrailEffect();
            StopAllChargeEffects();

            isScrewdriving = false;
            screwdriveTimeElapsed = 0.0f;
            hasPlayedSound = false;
            hasPlayedChargeVoice = false;
            chargeTime = 0.0f;
        }
    }

    if (currentState == Knuckles.StateID.StateHomingAttack || currentState == Knuckles.StateID.StateHomingAttackInStorm)
    {
        Player.Animation.SetAnimation("BOOST_POWER_LOOP");
        Player.Effect.StopAnimationEffects();
    }

    if (isCharging && currentState != Knuckles.StateID.StateStandRoot)
    {
        isCharging = false;
        chargeTime = 0.0f;
        StopAllChargeEffects();

        StopMaxChargeAura();
    }

    if (!isTextRedirected)
    {
        Converse.Redirect("skill_48_name", "Screwdriver");
        Converse.Redirect("ps_mission_126", "Screwdriver");
        Converse.Redirect("skill_48_command_Steam", "Hold <image name=\"s_button_attack\" /> while standing");
        Converse.Redirect("skill_48_explain_Steam", "Hold <image name=\"s_button_attack\" /> to charge.\nRelease to blast upward and spin through nearby enemies automatically when targets appear.");
        isTextRedirected = true;
    }
}

Code "Restore Dig" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "KnucklesParameters"
#lib "GameManager"
#lib "Time"
#lib "Lua"
#lib "INI"
#lib "HMM"

static bool isDigging = false;
static bool isDigDeep = false;
static bool isExitingHole = false;
static bool isGroundDig = false;
static bool isStompDig = false;
static bool isStompingLand = false;
static float digTimer = 0.0f;
static float riseTimer = 0.0f;
static float stompLandTimer = 0.0f;
const float riseTarget = 9.0f;
const float riseSpeed = 14.0f;
const float stompDigWindow = 0.7f;
static Random random = new Random();

static bool isConfigInitialized = false;
static int conDigAbility = 1;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conDigAbility = INI.GetField<int>(ini, "Main", "DigAbility", conDigAbility);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Knuckles)
        return;

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    bool canWallDig = conDigAbility == 1 || conDigAbility == 3;
    bool canGroundDig = conDigAbility == 1 || conDigAbility == 2;

    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");

    var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
    var previousState = Player.State.GetPreviousStateID<Knuckles.StateID>();

    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateCyKnuckleInHole, Knuckles.StateID.StateSleep);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateCyKnuckleOutHole, Knuckles.StateID.StateCyKnuckleWall);

    // Stomp dig burrows and surfaces faster than a wall or ground dig
    float deepThreshold = isStompDig ? 1.5f : 2.5f;
    float exitThreshold = isStompDig ? 2.2f : 3.2f;

    bool isRiseTimerRunning = currentState == Knuckles.StateID.StateCyKnuckleOutHole && isExitingHole && (isGroundDig || isStompDig) && riseTimer < riseTarget;

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    if (currentState == Knuckles.StateID.StateCyKnuckleInHole)
    {
        if (!isDigging)
        {
            if (isStompDig)
            {
                Player.Animation.SetAnimation("HOLEDIVE_START_STOMPING");
            }
            else if (isGroundDig)
            {
                Player.Animation.SetAnimation("HOLEDIVE_START");
                Player.Sound.PlaySound("sn_stomping_roll");
                Lua.Call("PlayVoice", "ka1202");
            }
            else
            {
                Player.Animation.SetAnimation("HOLEDIVE_START_CLIMB");
                Player.Sound.PlaySound("sn_stomping_roll");
                Lua.Call("PlayVoice", "ka1202");
            }

            isDigging = true;
            isDigDeep = false;
            digTimer = 0.0f;
        }

        if (!isPaused)
        {
            digTimer += Time.GetDeltaTime();

            if (digTimer >= deepThreshold && !isDigDeep)
            {
                // Only the wall dig plays a mid-dig surfacing flourish
                if (!isGroundDig && !isStompDig)
                {
                    Player.Animation.SetAnimation("HOLEDIVE_END_CLIMB");
                    Player.Sound.PlaySound("kn_cyknuckle");
                    Lua.Call("PlayVoice", "ka1100");
                }

                isDigDeep = true;
            }

            if (digTimer >= exitThreshold)
            {
                isDigging = false;
                isDigDeep = false;
                digTimer = 0.0f;
                Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateCyKnuckleOutHole);
            }
        }
    }
    else
    {
        isDigging = false;
        isDigDeep = false;
    }

    if (currentState == Knuckles.StateID.StateCyKnuckleOutHole)
    {
        if (!isExitingHole)
        {
            isExitingHole = true;
            riseTimer = 0.0f;

            if (isGroundDig || isStompDig)
            {
                Player.Animation.SetAnimation("HOLEDIVE_END");
                Player.Sound.PlaySound("kn_cyknuckle");
                Lua.Call("PlayVoice", "ka1100");
            }
            else
            {
                Player.Animation.SetAnimation("FLOAT_LOOP");
            }

            uint randomRings = (uint)(random.Next(2) == 0 ? 5 : 0);

            // Drop chances belong to Balanced Infinite Boost and Cyloop, only the amounts are set here
            if (KnucklesParametersInfo.pData != null)
            {
                RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.numRings, randomRings);
                RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.numRings2, (uint)3);
                RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.num10Rings, (uint)1);
                RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.numSkillPieces, (uint)5);
                RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.skillPieceExp, (uint)10);

                RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.numRings, randomRings);
                RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.numRings2, (uint)3);
                RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.num10Rings, (uint)1);
                RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.numSkillPieces, (uint)5);
                RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.skillPieceExp, (uint)10);
            }

            if (KnucklesParametersCyberInfo.pData != null)
            {
                RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.numRings, randomRings);
                RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.numRings2, (uint)3);
                RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.num10Rings, (uint)1);
                RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.numSkillPieces, (uint)5);
                RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.skillPieceExp, (uint)10);
            }
        }

        if (!isPaused && isRiseTimerRunning)
        {
            float step = riseSpeed * Time.GetDeltaTime();
            float remaining = riseTarget - riseTimer;
            float move = Math.Min(step, remaining);

            kinematics->Position.Y += move;
            riseTimer += move;
        }
    }
    else
    {
        isExitingHole = false;
        riseTimer = 0.0f;

        // Suppress CyKnuckle drops outside the dig so the gimmick only rewards a dig exit
        if (KnucklesParametersInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.numRings, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.numRings2, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.num10Rings, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.numSkillPieces, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.cyknuckleAppearGimmick.dropItem.skillPieceExp, (uint)0);

            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.numRings, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.numRings2, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.num10Rings, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.numSkillPieces, (uint)0);
            RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.cyknuckleAppearGimmick.dropItem.skillPieceExp, (uint)0);
        }

        if (KnucklesParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.numRings, (uint)0);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.numRings2, (uint)0);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.num10Rings, (uint)0);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.numSkillPieces, (uint)0);
            RFL_SET_PARAM(KnucklesParametersCyberInfo, cyknuckleAppearGimmick.dropItem.skillPieceExp, (uint)0);
        }
    }

    if (canWallDig
    && currentState == Knuckles.StateID.KnucklesStateWallMove
    && Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
    {
        isGroundDig = false;
        isStompDig = false;
        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateCyKnuckleInHole);
    }

    if (canGroundDig
    && currentState == Knuckles.StateID.StateSquat
    && Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
    {
        isGroundDig = true;
        isStompDig = false;
        Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateCyKnuckleInHole);
    }

    if (currentState == Knuckles.StateID.KnucklesStateStompingLand
    && previousState == Knuckles.StateID.KnucklesStateStompingDown)
    {
        if (!isStompingLand)
        {
            isStompingLand = true;
            stompLandTimer = 0.0f;
        }

        // Input is read before the timer advances so a stomp held through the landing still counts
        if (canGroundDig
        && stompLandTimer <= stompDigWindow
        && Player.Input.IsDown(Player.InputActionType.PlayerStomping))
        {
            isGroundDig = false;
            isStompDig = true;
            stompLandTimer = stompDigWindow + 1.0f;
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateCyKnuckleInHole);
        }

        if (!isPaused)
            stompLandTimer += Time.GetDeltaTime();
    }
    else
    {
        isStompingLand = false;
        stompLandTimer = 0.0f;
    }
}

Code "Boost Camera Shake" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"

static bool isBoostCamera = false;

{
    if (IS_STATE_FLAG(IsBoost))
    {
        if (!isBoostCamera)
        {
            Player.Effect.PlayEffect("BoostCamera", "ec_ft_landing_sand_sa01_shake01");
            Player.Effect.PlayEffect("BoostCamera", "ec_ft_landing_sand_sa02_shake01");
            Player.Effect.PlayEffect("BoostCamera", "ec_ft_landing_sand_sa03_shake01");
            Player.Effect.PlayEffect("BoostCamera", "ec_knp_stomp_end01_shake01");
            Player.Effect.PlayEffect("BoostCamera", "ec_knp_stomp_end01_shake01");
            isBoostCamera = true;
        }
    }
    else
    {
        if (isBoostCamera)
        {
            for (int i = 0; i < 5; i++)
                Player.Effect.StopEffect("BoostCamera");

            isBoostCamera = false;
        }
    }
}

Code "Always Show Power Boost Trail" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "HMM"

#import "Plugins"

static bool isPowerBoosting = false;
static bool isPowerBoostSound = false;

static bool hasCheckedCodes = false;
static bool isDisablePowerBoostEnabled = false;
static bool isDisablePowerBoostAudioEnabled = false;
static bool isHidePowerBoostEffectsEnabled = false;

{
    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
        return;

    if (!hasCheckedCodes)
    {
        var codes = HMM.GetCodes();

        isDisablePowerBoostEnabled = codes.Contains("Gameplay/Skills/Sonic/Disable Power Boost");
        isDisablePowerBoostAudioEnabled = codes.Contains("Audio/Disable Power Boost Audio");
        isHidePowerBoostEffectsEnabled = codes.Contains("Graphics/Effects/Hide Power Boost Effects");
        hasCheckedCodes = true;
    }

    void StopPowerBoost()
    {
        if (isPowerBoosting)
        {
            Player.Effect.StopEffect("PowerBoostTrail");
            Player.Effect.StopEffect("PowerBoostLightning");

            for (int i = 0; i < 3; i++)
                Player.Effect.StopEffect("PowerBoostMisc");

            isPowerBoosting = false;
        }

        if (isPowerBoostSound)
        {
            // Restart then stop to cut the looping line sound
            int soundHandle = Player.Sound.PlaySound("sn_powerboost_line");
            Player.Sound.StopSound(&soundHandle);
            isPowerBoostSound = false;
        }
    }

    bool hasBoostEnergy = (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0;

    bool isBoost = IS_STATE_FLAG(IsBoost);

    bool isBoostDrift = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift && Player.Input.IsDown(Player.InputActionType.PlayerBoost) && hasBoostEnergy;
    bool isBoostBoarding = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateBoarding && Player.Input.IsDown(Player.InputActionType.PlayerBoost) && hasBoostEnergy && !IS_WORLD_FLAG(IsDamagedOrRepelled);

    bool isPowerBoostActive = !isDisablePowerBoostEnabled && (isBoost || isBoostDrift || isBoostBoarding) && (IS_WORLD_FLAG(IsPowerBoost) || IS_WORLD_FLAG(IsCyberSpacePowerBoost));

    if (Player.GetPlayerType() != Player.PlayerType.Sonic || BlackboardStatus.IsSuper() || IS_WORLD_FLAG(IsNitroBoost))
    {
        StopPowerBoost();

        return;
    }

    if (isPowerBoostActive)
    {
        if (!isHidePowerBoostEffectsEnabled && !isPowerBoosting)
        {
            Player.Effect.PlayEffect("PowerBoostTrail", "ec_ft_pow_dash_ge01_blue_line01_update");
            Player.Effect.PlayEffect("PowerBoostLightning", "ec_ft_pow_dash_ge01_lightning_line01_update");

            Player.Effect.PlayEffect("PowerBoostMisc", "ec_ft_pow_dash_ge01_lightning01");
            Player.Effect.PlayEffect("PowerBoostMisc", "ec_ft_pow_dash_ge01_round_blue01");
            Player.Effect.PlayEffect("PowerBoostMisc", "ec_ft_pow_dash_ge01_lightning03");

            isPowerBoosting = true;
        }

        if (!isDisablePowerBoostAudioEnabled && !isPowerBoostSound)
        {
            Player.Sound.PlaySound("sn_powerboost_line");
            isPowerBoostSound = true;
        }
    }
    else
    {
        StopPowerBoost();
    }
}

Code "Fix Rocket Boost Aura" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

static bool isRocketBoostActive = false;

static bool isConfigInitialized = false;
static int conBoostAura = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBoostAura = INI.GetField<int>(ini, "Main", "BoostAura", conBoostAura);
            isConfigInitialized = true;
        }
    }

    if (conBoostAura != 3)
        return;

    bool showAura = IS_WORLD_FLAG(IsNitroBoost) && Player.State.GetCurrentStateID<Sonic.StateID>() != Sonic.StateID.StateRun;

    if (showAura && !isRocketBoostActive)
    {
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_aura01");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_core01");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_glow01");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_light01");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_par01");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_smoke01");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_smoke02");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_wind01");
        Player.Effect.PlayEffect("RocketBoostImpact01", "ec_cycom_nitro_boost_impact01_wind02");

        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_aura01");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_core01");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_glow01");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_light01");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_par01");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_smoke01");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_smoke02");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_wind01");
        Player.Effect.PlayEffect("RocketBoostImpact02", "ec_cycom_nitro_boost_impact02_wind02");

        Player.Effect.PlayEffect("RocketBoostDash", "ec_cycom_nitro_dash01_ge01_air01");
        Player.Effect.PlayEffect("RocketBoostDash", "ec_cycom_nitro_dash01_ge01_gpu01");
        Player.Effect.PlayEffect("RocketBoostDash", "ec_cycom_nitro_dash01_ge01_light01");
        Player.Effect.PlayEffect("RocketBoostDash", "ec_cycom_nitro_dash01_ge01_line01");
        Player.Effect.PlayEffect("RocketBoostDash", "ec_cycom_nitro_dash01_ge01_smoke01");
        Player.Effect.PlayEffect("RocketBoostDash", "ec_cycom_nitro_dash01_ge01_wind01");

        isRocketBoostActive = true;
    }
    else if (!showAura && isRocketBoostActive)
    {
        // StopEffect ends one instance per call
        for (int i = 0; i < 9; i++)
            Player.Effect.StopEffect("RocketBoostImpact01");

        for (int i = 0; i < 9; i++)
            Player.Effect.StopEffect("RocketBoostImpact02");

        for (int i = 0; i < 6; i++)
            Player.Effect.StopEffect("RocketBoostDash");

        isRocketBoostActive = false;
    }
}

Code "Cyloop Aura while Boosting" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"

#import "Plugins"

{
    if (Player.GetPlayerType() != Player.PlayerType.Sonic || BlackboardStatus.IsSuper())
        return;

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool hasBoostEnergy = (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0;
    bool isBoostHeld = Player.Input.IsDown(Player.InputActionType.PlayerBoost) && hasBoostEnergy;

    bool isBoost = IS_STATE_FLAG(IsBoost);
    bool isBoostDrift = currentState == Sonic.StateID.StateDrift && isBoostHeld;
    bool isBoostBoarding = currentState == Sonic.StateID.StateBoarding && isBoostHeld && !IS_WORLD_FLAG(IsDamagedOrRepelled);
    bool isLightDash = currentState == Sonic.StateID.StateLightDash;
    bool isQuickCyloop = currentState == Sonic.StateID.StateQuickCyloop;

    Sonic.Effect.SetCyloopAuraVisibility(isBoost || isBoostDrift || isBoostBoarding || isLightDash || isQuickCyloop);
}

Code "Boost Aura" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "GameObject"
#lib "HMM"
#lib "INI"

#import "GOComponents"
#import "PlayerVisuals"
#import "Plugins"

static bool boostAura = false;
static bool wasSuperSonic2 = false;
static bool wasPowerBoost = false;
static bool wasNitroBoost = false;

const int smokeWindMultiplier = 2;

static bool isConfigInitialized = false;
static bool hasCheckedDisablePowerBoost = false;
static bool isDisablePowerBoostEnabled = false;
static int conBoostAura = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBoostAura = INI.GetField<int>(ini, "Main", "BoostAura", conBoostAura);
            isConfigInitialized = true;
        }
    }

    if (conBoostAura != 1 && conBoostAura != 2)
        return;

    if (!hasCheckedDisablePowerBoost)
    {
        var codes = HMM.GetCodes();
        isDisablePowerBoostEnabled = codes.Contains("Gameplay/Skills/Sonic/Disable Power Boost");
        hasCheckedDisablePowerBoost = true;
    }

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
        return;

    var playerType = Player.GetPlayerType();

    bool hasBoostEnergy = (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0;
    bool isSpinDash = IS_STATE_FLAG(IsSpinDash);
    bool isBoost = IS_STATE_FLAG(IsBoost);
    bool isNitroBoost = IS_WORLD_FLAG(IsNitroBoost);
    bool isSuper = BlackboardStatus.IsSuper();

    bool isBoostDrift = false;
    bool isBoostBoarding = false;
    bool isSuperSonic2 = false;

    if (playerType == Player.PlayerType.Sonic)
    {
        var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

        isBoostDrift = currentState == Sonic.StateID.StateDrift && Player.Input.IsDown(Player.InputActionType.PlayerBoost) && hasBoostEnergy;
        isBoostBoarding = currentState == Sonic.StateID.StateBoarding && Player.Input.IsDown(Player.InputActionType.PlayerBoost) && hasBoostEnergy && !IS_WORLD_FLAG(IsDamagedOrRepelled);

        var data = Player.GetPlayerData();

        if (data != null)
        {
            var gocVisual = GameObject.GetGOC<GOCPlayerVisual>(&data->GameObject);

            if (gocVisual != null)
            {
                var visual = gocVisual->GetVisual<VisualSuperSonic>();

                if (visual != null)
                    isSuperSonic2 = visual->IsSuperSonic2;
            }
        }
    }

    bool isPowerBoostActive = !isDisablePowerBoostEnabled && (isBoost || isBoostDrift || isBoostBoarding) && (IS_WORLD_FLAG(IsPowerBoost) || IS_WORLD_FLAG(IsCyberSpacePowerBoost));

    bool boostActive = !isSpinDash && (isBoost || isBoostDrift || isBoostBoarding || isNitroBoost);

    if (!boostActive)
    {
        if (boostAura)
        {
            int totalEffects = 4 + (smokeWindMultiplier * 2);

            for (int i = 0; i < totalEffects; i++)
                Player.Effect.StopEffect("BoostAura");

            boostAura = false;
            wasSuperSonic2 = false;
            wasPowerBoost = false;
            wasNitroBoost = false;
        }

        return;
    }

    bool superStateChanged = playerType == Player.PlayerType.Sonic && wasSuperSonic2 != isSuperSonic2;
    bool powerBoostChanged = playerType == Player.PlayerType.Sonic && wasPowerBoost != isPowerBoostActive;
    bool nitroBoostChanged = playerType == Player.PlayerType.Sonic && wasNitroBoost != isNitroBoost;

    if (boostAura && !superStateChanged && !powerBoostChanged && !nitroBoostChanged)
        return;

    if (boostAura)
    {
        int totalEffects = 4 + (smokeWindMultiplier * 2);

        for (int i = 0; i < totalEffects; i++)
            Player.Effect.StopEffect("BoostAura");
    }

    string pfx;

    if (playerType == Player.PlayerType.Sonic)
    {
        if (isNitroBoost)
            pfx = "cycom_nitro";
        else if (isSuperSonic2)
            pfx = "ss2_nitro";
        else if (isSuper)
            pfx = "ss_nitro";
        else if (isPowerBoostActive)
            pfx = "so_pow_nitro";
        else
            pfx = "so_nitro";
    }
    else if (playerType == Player.PlayerType.Tails)
    {
        pfx = "ta_nitro";
    }
    else if (playerType == Player.PlayerType.Knuckles)
    {
        pfx = "kn_nitro";
    }
    else if (playerType == Player.PlayerType.Amy)
    {
        pfx = "am_nitro";
    }
    else
    {
        pfx = "so_nitro";
    }

    // Trail effects are disabled when BoostAura = 2
    if (conBoostAura == 1)
    {
        Player.Effect.PlayEffect("BoostAura", $"ec_{pfx}_dash01_ge01_air01");
        Player.Effect.PlayEffect("BoostAura", $"ec_{pfx}_dash01_ge01_gpu01");
        Player.Effect.PlayEffect("BoostAura", $"ec_{pfx}_dash01_ge01_light01");
        Player.Effect.PlayEffect("BoostAura", $"ec_{pfx}_dash01_ge01_line01");
    }

    // Smoke and wind remain enabled in both modes
    for (int i = 0; i < smokeWindMultiplier; i++)
    {
        Player.Effect.PlayEffect("BoostAura", $"ec_{pfx}_dash01_ge01_smoke01");
        Player.Effect.PlayEffect("BoostAura", $"ec_{pfx}_dash01_ge01_wind01");
    }

    wasSuperSonic2 = isSuperSonic2;
    wasPowerBoost = isPowerBoostActive;
    wasNitroBoost = isNitroBoost;
    boostAura = true;
}

Code "Slide Effects" by "Batman Sonic"
//

#lib "Player"
#lib "HMM"
#lib "INI"

static bool isSlide = false;
static bool isStompLandToSlide = false;
static bool isConfigInitialized = false;
static int conRollAbility = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conRollAbility = INI.GetField<int>(ini, "Main", "RollAbility", conRollAbility);
            isConfigInitialized = true;
        }
    }

    if (conRollAbility != 2)
        return;

    var playerType = Player.GetPlayerType();

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    if (previousState == Sonic.StateID.StateStompingDown &&
        currentState == Sonic.StateID.StateStompingLand)
    {
        isStompLandToSlide = true;
    }

    bool slidingFromRun = isStompLandToSlide ||
                          previousState == Sonic.StateID.StateRun ||
                          previousState == Sonic.StateID.StateLeftStepRun ||
                          previousState == Sonic.StateID.StateRightStepRun;

    bool isSliding = currentState == Sonic.StateID.StateSliding;

    if (slidingFromRun && isSliding)
    {
        if (!isSlide)
        {
            string effectName = "";

            if (playerType == Player.PlayerType.Sonic)
                effectName = "ec_so_skill_sonicboom01_slashaura01";
            else if (playerType == Player.PlayerType.Tails)
                effectName = "ec_ta_skill_sonicboom01_slashaura01";
            else if (playerType == Player.PlayerType.Knuckles)
                effectName = "ec_kn_skill_sonicboom01_slashaura01";
            else if (playerType == Player.PlayerType.Amy)
                effectName = "ec_am_skill_sonicboom01_slashaura01";
            else
                return;

            Player.Effect.PlayEffect("isSlide", effectName);
            isSlide = true;
        }

        isStompLandToSlide = false;
    }

    if (!isSliding)
    {
        if (isSlide)
        {
            Player.Effect.StopEffect("isSlide");
            isSlide = false;
        }

        if (currentState != Sonic.StateID.StateStompingLand)
            isStompLandToSlide = false;
    }
}

