            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.airboost.minKeepTime, 0.1f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.airboost.maxKeepTime, 0.11f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.airboost.maxTime, 0.12f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.airboost.gravityRate, 0.5f);
            RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.airboost.steeringSpeed, 10.0f);
        }

        if (AmyParametersCyberInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.startHSpeed, 55.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.startHSpeedMax, 55.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.startVSpeed, 10.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.minHSpeed, 50.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.minHSpeedMax, 50.0f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.brakeTime, 0.2f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.minKeepTime, 0.1f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.maxKeepTime, 0.11f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.maxTime, 0.12f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.gravityRate, 0.5f);
            RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.airboost.steeringSpeed, 10.0f);
        }
    }
}

Code "Boost Jump" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "HMM"
#lib "INI"
#lib "BlackboardStatus"

static bool isConfigInitialized = false;
static bool conForcesBoostJump = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conForcesBoostJump = INI.GetField<bool>(ini, "Main", "ForcesBoostJump", conForcesBoostJump);
            isConfigInitialized = true;
        }
    }

    if (!conForcesBoostJump)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (IS_STATE_FLAG(IsBoost) && (currentState == Sonic.StateID.StateJump || currentState == Sonic.StateID.StateGrindJump))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateAirBoost);
    }
}

Code "Restore Alternate Power Boost Cutscene" by "Batman Sonic"
//

#lib "BlackboardItem"
#lib "Player"
#lib "INI"
#lib "HMM"

static bool hasAwakened = false;

static bool isConfigInitialized = false;
static bool conStateAwakening = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conStateAwakening = INI.GetField<bool>(ini, "Main", "StateAwakening", conStateAwakening);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Sonic || !conStateAwakening)
        return;

    var pBlackboardItem = BlackboardItem.Get();

    if (pBlackboardItem == null)
        return;

    int maxRings = pBlackboardItem->RingCapacity;
    int rings = pBlackboardItem->RingCount;

    if (rings == maxRings && Player.Status.IsGrounded() && !hasAwakened)
    {
        hasAwakened = true;
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateAwakening);
    }
    else if (rings < maxRings)
    {
        hasAwakened = false;
    }
}

Code "Restore Tails' Homing Attack Skill" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "GameSkillParameter"
#lib "GameManager"
#lib "Player"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "Reflection"

static bool isConfigInitialized = false;
static int conTailsHoming = 0;

static bool conHomingSpam = false;
static bool conTailsSpannerStop = false;

static float homingCooldown = 0.0f;
static bool startedRecovery = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conTailsHoming = INI.GetField<int>(ini, "Main", "TailsHoming", conTailsHoming);
            conTailsSpannerStop = INI.GetField<bool>(ini, "Main", "TailsSpannerStop", conTailsSpannerStop);
            conHomingSpam = INI.GetField<bool>(ini, "Main", "HomingSpam", conHomingSpam);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    var GameSkillParameterInfo = Reflection.GetDataInfo<GameSkillParameter.Root>("skill");

    if (homingCooldown > 0.0f)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            homingCooldown -= Time.GetDeltaTime();

            if (homingCooldown < 0.0f)
                homingCooldown = 0.0f;
        }
    }

    // Skill Tree
    if (conTailsHoming == 1)
    {
        if (GameSkillParameterInfo.pData != null)
        {
            RFL_SET_PARAM(GameSkillParameterInfo, skillParams[65].unlockPoint, 0);
            RFL_SET_PARAM(GameSkillParameterInfo, treeParamsTails.nodeParams[6].skill, GameSkillParameter.Value.TailsHomingAtatck);
            RFL_SET_PARAM(GameSkillParameterInfo, treeParamsTails.nodeParams[11].skill, GameSkillParameter.Value.TailsFly);
        }
    }

    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

    float recoveryTime = conHomingSpam ? 0.15f : 0.3f;

    bool inRecovery = (currentState == Tails.StateID.StateHomingFinished) ||

        (currentState == Tails.StateID.StateSpringJump &&
         previousState == Tails.StateID.StateHomingAttack) ||

        (currentState == Tails.StateID.StateStorm &&
         previousState == Tails.StateID.StateHomingAttackInStorm);

    if (inRecovery)
    {
        if (!startedRecovery)
        {
            homingCooldown = recoveryTime;
            startedRecovery = true;
        }
    }
    else
    {
        startedRecovery = false;
    }

    // Normal Homing Attack
    if (conTailsHoming == 1 &&
        homingCooldown <= 0.0f &&
        Player.Status.IsLockOnCursorVisible() &&
        (conTailsSpannerStop || !Player.Status.IsGrounded()) &&
        Player.Input.IsPressed(Player.InputActionType.PlayerAttack) &&
        currentState != Tails.StateID.StateStorm &&
        currentState != Tails.StateID.StateHomingAttackInStorm)
    {
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateHomingAttack);
    }

    // Storm Homing Attack
    if (homingCooldown <= 0.0f &&
        currentState == Tails.StateID.StateStorm &&
        Player.Status.IsLockOnCursorVisible() &&
        Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
    {
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateHomingAttackInStorm);
    }
}

Code "Manual Drift" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "XInput"
#lib "Converse"
#lib "HMM"
#lib "INI"
#lib "Time"
#lib "Lua"

#import "Plugins"

static bool isDrift = false;
static float lastDriftDir = 0.0f;
static float airTime = 0.0f;
static float turnDelay = 0.0f;

const float minDriftSpeed = 7.0f;
const float minExitSpeed = 4.0f;
const float maxAirTime = 0.07f;
const float turnDelayTime = 0.2f;
const float boostDrainPerSecond = 12.0f;
const float boostGainPerSecond = 9.0f;
const float boostExitBonus = 0.1f;
const float jumpVelocity = 30.0f;

static List<string> driftVoices = new List<string> { "sa1010", "sa1024", "sa1038", "sa1013_1" };
static Random random = new Random();

static bool isConfigInitialized = false;
static bool tutorialConfigured = false;

static long driftPanelAddress = 0;
static bool hasScannedDriftPanel = false;
static bool isDriftPanelDisabled = false;

static int conDrift = 0;
static int conDriftInput = 0;
static int conDriftGauge = 0;
static int conDriftAnimation = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conDrift = INI.GetField<int>(ini, "Main", "Drift", conDrift);
            conDriftInput = INI.GetField<int>(ini, "Main", "DriftInput", conDriftInput);
            conDriftGauge = INI.GetField<int>(ini, "Main", "DriftGauge", conDriftGauge);
            conDriftAnimation = INI.GetField<int>(ini, "Main", "DriftAnimation", conDriftAnimation);
            isConfigInitialized = true;
        }
    }

    if (conDrift < 1 || conDrift > 4)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float deltaTime = Time.GetDeltaTime();

    if (deltaTime <= 0.0f)
        return;

    if (turnDelay > 0.0f)
        turnDelay -= deltaTime;

    bool isCyberSpace = IS_WORLD_FLAG(IsCyberSpace);
    bool manualDrift = conDrift == 1 || (conDrift == 2 && isCyberSpace) || (conDrift == 3 && !isCyberSpace);

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();
    float speed = Player.Kinematics.GetHorizontalMagnitude();
    bool isGrounded = Player.Status.IsGrounded();

    float analogX = XInput.GetState() == null ? 0.0f : XInput.GetAnalog(0).X;
    float driftDir = analogX > 0.3f ? 1.0f : (analogX < -0.3f ? -1.0f : 0.0f);
    bool stickTilted = driftDir != 0.0f;

    bool driftInputHeld;
    switch (conDriftInput)
    {
        case 2:
            driftInputHeld = Player.Input.IsDown(Player.InputActionType.PlayerLightDash);
            break;
        case 3:
            driftInputHeld = Player.Input.IsDown(Player.InputActionType.PlayerStomping) && Player.Input.IsDown(Player.InputActionType.PlayerBoost);
            break;
        case 4:
            driftInputHeld = Player.Input.IsDown(Player.InputActionType.PlayerSonicboom);
            break;
        default:
            driftInputHeld = Player.Input.IsDown(Player.InputActionType.PlayerStomping);
            break;
    }

    // Scanned once, since the signature no longer matches after the jump is written
    if (!hasScannedDriftPanel)
    {
        /* 0x140482A6E */
        driftPanelAddress = ScanSignature
        (
            "\x48\x8B\xC2\x48\x8B\xF9\x48\x8B\xC8\x48\x8D\x15\xCC\xCC\xCC\xCC\xE8\xCC\xCC\xCC\xCC\x4C\x8B\xF8\xE8\xCC\xCC\xCC\xCC\x48\x8B\xD0\x48\x8B\xCF\xE8\xCC\xCC\xCC\xCC\x4C\x8B\xE8",
            "xxxxxxxxxxxx????x????xxxx????xxxxxxx????xxx"
        );

        hasScannedDriftPanel = true;
    }

    // Drift Dash Panels are only skipped while drifting is manual, so they work again outside of it
    if (driftPanelAddress != 0 && manualDrift != isDriftPanelDisabled)
    {
        if (manualDrift)
            WriteProtected<byte>(driftPanelAddress, 0xE9, 0x24, 0x03, 0x00, 0x00);
        else
            WriteProtected<byte>(driftPanelAddress, 0x48, 0x8B, 0xC2, 0x48, 0x8B);

        isDriftPanelDisabled = manualDrift;
    }

    if (manualDrift)
    {
        if (!tutorialConfigured)
        {
            Converse.Redirect("tu5000_050", "Drift");
            switch (conDriftInput)
            {
                case 1:
                    Converse.Redirect("tu5000_055", "Press <image name=\"button_right_Wh\" /> to drift while running.\nTilt <image name=\"button_left_stick\" /> left or right to turn sharply.");
                    break;
                case 2:
                    Converse.Redirect("tu5000_055", "Press <image name=\"button_left_stick\" /> to drift while running.\nTilt it left or right to turn sharply.");
                    break;
                case 3:
                    Converse.Redirect("tu5000_055", "Press <image name=\"button_right_trigger\" />+<image name=\"button_right_Wh\" /> to drift while running.\nTilt <image name=\"button_left_stick\" /> left or right to turn sharply.");
                    break;
                case 4:
                    Converse.Redirect("tu5000_055", "Press <image name=\"button_left_trigger\" /> to drift while running.\nTilt <image name=\"button_left_stick\" /> left or right to turn sharply.");
                    break;
                default:
                    Converse.Redirect("tu5000_055", "Press the drift button while running.\nTilt <image name=\"button_left_stick\" /> left or right to turn sharply.");
                    break;
            }
            Converse.Redirect("tu5000_temp003", "Drifting during a boost <image name=\"button_right_trigger\" /> lets you maintain speed while turning more tightly.");
            tutorialConfigured = true;
        }

        if (Player.Status.IsSideView())
        {
            Player.State.Restore<Sonic.StateID>(Sonic.StateID.StateSliding);
            if (currentState == Sonic.StateID.StateDrift)
                Player.State.SetState(Player.Input.IsDown(Player.InputActionType.PlayerBoost) ? Sonic.StateID.StateDropDash : Sonic.StateID.StateRun);
            return;
        }
    }

    if (currentState == Sonic.StateID.StateDrift)
    {
        if (!isGrounded) airTime += deltaTime;
        else airTime = 0.0f;

        var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

        if (!isDrift)
        {
            Player.Sound.PlaySound("sn_quick_turn");
            Lua.Call("PlayVoice", driftVoices[random.Next(driftVoices.Count)]);

            lastDriftDir = driftDir;

            Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 3.0f);
            Player.Collision.SetEntityCollision(false);
            XInput.SetVibration(0, 0.15f);
            Player.Effect.PlayEffect("DriftDust", "ef_ft_spinboost_charge01_sa01");

            switch (conDriftAnimation)
            {
                case 2:
                    Player.Effect.PlayAnimationEffect("COMBO_SMASH_LOOP");
                    kinematics->Velocity.Y = 2.5f;
                    break;
                case 3:
                    Player.Effect.PlayAnimationEffect("SPIN_CHARGE");
                    break;
                default:
                    Player.Animation.SetAnimation(!manualDrift ? "DRIFTING" : (driftDir < 0.0f ? "DRIFT_L" : "DRIFT_R"));
                    break;
            }

            isDrift = true;
        }
        else if (stickTilted && lastDriftDir == 0.0f)
        {
            lastDriftDir = driftDir;
            if (manualDrift && conDriftAnimation != 2 && conDriftAnimation != 3)
                Player.Animation.SetAnimation(driftDir < 0.0f ? "DRIFT_L" : "DRIFT_R");
        }
        else if (manualDrift && stickTilted && driftDir != lastDriftDir && lastDriftDir != 0.0f && turnDelay <= 0.0f)
        {
            turnDelay = turnDelayTime;
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRun);
            return;
        }

        if (boostPlugin != null)
        {
            if (Player.Input.IsDown(Player.InputActionType.PlayerBoost) && stickTilted)
                boostPlugin->BoostAmount = Math.Max(boostPlugin->BoostAmount - boostDrainPerSecond * deltaTime, 0.0f);
            else if (manualDrift && conDriftGauge == 1)
                boostPlugin->BoostAmount = Math.Min(boostPlugin->BoostAmount + boostGainPerSecond * deltaTime, boostPlugin->BoostCapacity);
        }

        if (manualDrift && Player.Status.IsLockOnCursorVisible() && Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHomingAttack);
            return;
        }

        if (Player.Input.IsPressed(Player.InputActionType.PlayerJump))
        {
            kinematics->Velocity.Y = jumpVelocity;
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateBumpJump);
            return;
        }

        if (airTime > maxAirTime || (manualDrift && (!driftInputHeld || speed < minExitSpeed)))
        {
            if (manualDrift && conDriftGauge == 1 && boostPlugin != null)
            {
                boostPlugin->BoostAmount = Math.Min(boostPlugin->BoostAmount + boostExitBonus, boostPlugin->BoostCapacity);
                Player.Effect.PlayEffect("DriftExitBoost", "ef_ft_spinboost_charge01_spark01");
            }
            Player.State.SetState(isGrounded ? Sonic.StateID.StateRun : Sonic.StateID.StateFall);
        }
        return;
    }

    if (isDrift)
    {
        XInput.SetVibration(0.0f);
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        Player.Effect.StopEffect("DriftDust");
        lastDriftDir = 0.0f;
        airTime = 0.0f;
        isDrift = false;
    }

    if (!manualDrift)
        return;

    bool blockedByPreviousState = currentState == Sonic.StateID.StateRun && (previousState == Sonic.StateID.StateSpinBoostCharge || previousState == Sonic.StateID.StateQuickStepDoubleJump);
    float entryThreshold = turnDelay > 0.0f ? minExitSpeed : minDriftSpeed;
    bool canEnter = currentState == Sonic.StateID.StateRun || currentState == Sonic.StateID.StateSliding;

    if (isGrounded && !IS_WORLD_FLAG(IsAutoRun) && !blockedByPreviousState && canEnter && driftInputHeld && stickTilted && speed >= entryThreshold)
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateDrift);
}

Code "Drift Physics Tweaks" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "SonicParameters"
#lib "HMM"
#lib "INI"

#import "Plugins"

static bool isConfigInitialized = false;
static int conDrift = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conDrift = INI.GetField<int>(ini, "Main", "Drift", conDrift);
            isConfigInitialized = true;
        }
    }

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    bool manualOpenZone = conDrift == 1 || conDrift == 3;
    bool manualCyberSpace = conDrift == 1 || conDrift == 2;

    bool hasBoostEnergy = (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0;
    bool isBoostDrift = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateDrift && Player.Input.IsDown(Player.InputActionType.PlayerBoost) && hasBoostEnergy;

    // Open Zone
    if (SonicParametersInfo.pData != null)
    {
        if (manualOpenZone)
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.startAngle, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.endSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minSpeed, isBoostDrift ? 60.0f : 30.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minSpeedMax, isBoostDrift ? 120.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxSpeed, isBoostDrift ? 80.0f : 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxSpeedMax, isBoostDrift ? 120.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minBoostSpeed, isBoostDrift ? 60.0f : 30.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minBoostSpeedMax, isBoostDrift ? 90.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxBoostSpeed, isBoostDrift ? 80.0f : 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxBoostSpeedMax, isBoostDrift ? 90.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.accel, isBoostDrift ? 20.0f : 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.brake, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxSteerAngle, 35.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.steerAccel, 800.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxSteerSpeed, 90.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.neutralSteerAccel, 710.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxNeutralSteerSpeed, 200.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxRotateSpeed, 200.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.recoverTime, 0.5f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minDashSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxDashSpeed, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minDashJumpSpeed, 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxDashJumpSpeed, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.jumpSpeed, 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.checkFallTime, 2.0f);
        }
        else
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.endSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minSpeed, 40.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minSpeedMax, 80.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxSpeed, 40.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxSpeedMax, 80.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minBoostSpeed, 60.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.minBoostSpeedMax, 120.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxBoostSpeed, 80.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxBoostSpeedMax, 120.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxSteerAngle, 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.maxRotateSpeed, 140.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.drift.checkFallTime, 0.2f);
        }
    }

    // Cyber Space
    if (SonicParametersInfo.pData != null)
    {
        if (manualCyberSpace)
        {
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.startAngle, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.endSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minSpeed, isBoostDrift ? 60.0f : 30.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minSpeedMax, isBoostDrift ? 120.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxSpeed, isBoostDrift ? 80.0f : 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxSpeedMax, isBoostDrift ? 120.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minBoostSpeed, isBoostDrift ? 60.0f : 30.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minBoostSpeedMax, isBoostDrift ? 90.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxBoostSpeed, isBoostDrift ? 80.0f : 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxBoostSpeedMax, isBoostDrift ? 90.0f : 50.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.accel, isBoostDrift ? 20.0f : 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.brake, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxSteerAngle, 35.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.steerAccel, 800.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxSteerSpeed, 90.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.neutralSteerAccel, 710.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxNeutralSteerSpeed, 200.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxRotateSpeed, 200.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.recoverTime, 0.5f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minDashSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxDashSpeed, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minDashJumpSpeed, 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxDashJumpSpeed, 20.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.jumpSpeed, 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.checkFallTime, 2.0f);
        }
        else
        {
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.endSpeed, 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minSpeed, 40.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minSpeedMax, 80.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxSpeed, 40.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxSpeedMax, 80.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minBoostSpeed, 60.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.minBoostSpeedMax, 120.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxBoostSpeed, 80.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxBoostSpeedMax, 120.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxSteerAngle, 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.maxRotateSpeed, 140.0f);
            RFL_SET_PARAM(SonicParametersInfo, cyberspace.drift.checkFallTime, 0.2f);
        }
    }
}

