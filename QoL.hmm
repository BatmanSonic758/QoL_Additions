Code "Fix Air Boost at Empty Gauge" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"

#import "Plugins"

static bool isBoostEmpty = false;

{
    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
        return;

    if (IS_STATE_FLAG(IsAirBoost) && (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) != 0 && Player.Input.IsDown(Player.InputActionType.PlayerBoost))
    {
        if (!isBoostEmpty)
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateFall);
            isBoostEmpty = true;
        }
    }
    else
    {
        isBoostEmpty = false;
    }
}

Code "Boost Preservation from Objects" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "GameManager"
#lib "BlackboardStatus"

#import "Plugins"

static bool wasBoosting = false;
static bool keepBoost = false;
static bool wasInObject = false;

const float boostDrainPerSecond = 6.0f;
static float fallTimer = 0.0f;
const float fallDuration = 1.81f;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool boostHeld = Player.Input.IsDown(Player.InputActionType.PlayerBoost);
    bool boostReleased = Player.Input.IsReleased(Player.InputActionType.PlayerBoost);

    bool inObject = currentState == Sonic.StateID.StateJumpBoardLaunch ||
                    currentState == Sonic.StateID.StateSpringJump ||
                    currentState == Sonic.StateID.StateSpringJumpHeadLand ||
                    currentState == Sonic.StateID.StateSliding ||
                    currentState == Sonic.StateID.StateCaught ||
                    currentState == Sonic.StateID.StateBaseJump ||
                    currentState == Sonic.StateID.StateGrindDoubleJump ||
                    currentState == Sonic.StateID.StateSpinAttack ||
                    currentState == Sonic.StateID.StateBounceJump ||
                    (currentState == Sonic.StateID.StateFall &&
                    previousState != Sonic.StateID.StateAirBoost);

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    bool isFall = currentState == Sonic.StateID.StateFall;

    if (currentState == Sonic.StateID.StateAirBoost)
    {
        wasBoosting = false;
        keepBoost = false;
        wasInObject = false;
        fallTimer = 0.0f;
        return;
    }

    StatePluginBoost* boostPlugin = null;

    if (inObject && wasBoosting && keepBoost)
        boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (isFall && !wasInObject)
        fallTimer = fallDuration;

    if (inObject)
    {
        if (!wasInObject)
        {
            wasBoosting = IS_STATE_FLAG(IsBoost);
            keepBoost = boostHeld;
        }

        if (isFall && fallTimer > 0.0f)
        {
            if (!isPaused)
            {
                fallTimer -= Time.GetDeltaTime();

                if (fallTimer <= 0.0f)
                {
                    SET_STATE_FLAG(IsBoost, false);
                    keepBoost = false;
                }
            }
        }

        if (wasBoosting && keepBoost)
        {
            SET_STATE_FLAG(IsBoost, true);

            if (boostPlugin != null)
            {
                if (!isPaused)
                {
                    boostPlugin->BoostAmount -= boostDrainPerSecond * Time.GetDeltaTime();
                    boostPlugin->BoostAmount = Math.Max(boostPlugin->BoostAmount, 0.0f);

                    if (boostPlugin->BoostAmount <= 0.01f)
                    {
                        // A leftover sliver never reads as empty, so the boost lock would never kick in
                        boostPlugin->BoostAmount = 0.0f;
                        SET_STATE_FLAG(IsBoost, false);
                        keepBoost = false;
                    }
                }
            }
        }

        if (boostReleased)
        {
            SET_STATE_FLAG(IsBoost, false);
            keepBoost = false;
        }

        wasInObject = true;
    }
    else if (!isFall || fallTimer <= 0.0f)
    {
        if (wasInObject)
        {
            if (wasBoosting && keepBoost && boostHeld)
                SET_STATE_FLAG(IsBoost, true);
            else
                SET_STATE_FLAG(IsBoost, false);
        }

        if (!isFall)
            wasInObject = false;
    }
}

Code "Start with Empty Boost Gauge" by "Batman Sonic"
//

#lib "BlackboardItem"
#lib "BlackboardStatus"
#lib "GameMode"
#lib "Player"
#lib "INI"
#lib "HMM"

#import "Plugins"
#import "Services"

static bool isConfigInitialized = false;
static bool conStartEmptyGauge = false;

static long lastBoostPtr = 0;
static bool drainedForDeath = false;
static float carriedBoost = 0.0f;

static float[] ringLossDivisors = new float[]
{
    1.05f,
    1.25f,
    1.5f,
    2.0f,
};

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conStartEmptyGauge = INI.GetField<bool>(ini, "Main", "StartEmptyGauge", conStartEmptyGauge);
            isConfigInitialized = true;
        }
    }

    if (BlackboardStatus.IsSuper())
        return;

    string stageID = LevelInfo.GetCurrentStageID();

    // Skips Portals 4-F, 4-G and 4-I to prevent the levels from being unfair or unbeatable
    if (stageID == "w7d23" || stageID == "w9d21" || stageID == "w9d23")
        return;

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
    {
        lastBoostPtr = 0;
        drainedForDeath = false;
        return;
    }

    string gameMode = GameMode.GetName();
    bool isCyberSpace = gameMode == "GameModeCyberStage";
    bool isChallenge = gameMode == "GameModeCyberStageChallenge";
    bool isIsland = gameMode == "GameModeStage";

    bool startEmptyApplies = isCyberSpace || stageID == "w1r02_1";

    long boostPtr = (long)boostPlugin;
    bool isNewInstance = boostPtr != lastBoostPtr;
    lastBoostPtr = boostPtr;

    var previousStateID = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool cameFromDeath = previousStateID == Sonic.StateID.StateDead ||
                         previousStateID == Sonic.StateID.StateFallingDead ||
                         previousStateID == Sonic.StateID.StateLavaDead ||
                         previousStateID == Sonic.StateID.StatePressDead ||
                         previousStateID == Sonic.StateID.StateSuffocatingDead ||
                         previousStateID == Sonic.StateID.StateTimeUpDead ||
                         previousStateID == Sonic.StateID.StateUpDead;

    bool deathRespawn = false;

    if (cameFromDeath)
    {
        if (!drainedForDeath)
        {
            drainedForDeath = true;
            deathRespawn = true;
        }
    }
    else
    {
        drainedForDeath = false;
    }

    if (isChallenge)
    {
        if (isNewInstance && carriedBoost >= 0.0f)
        {
            boostPlugin->BoostAmount = carriedBoost;

            if (carriedBoost <= 0.0f)
                boostPlugin->Flags |= StatePluginBoost.BoostFlags.IsGaugeEmpty;
            else
                boostPlugin->Flags &= ~StatePluginBoost.BoostFlags.IsGaugeEmpty;
        }

        if (deathRespawn)
        {
            boostPlugin->BoostAmount = 0.0f;
            boostPlugin->Flags |= StatePluginBoost.BoostFlags.IsGaugeEmpty;
            carriedBoost = 0.0f;
        }

        carriedBoost =
            Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateNoisyGoal
                ? boostPlugin->BoostAmount
                : 0.0f;
    }
    else
    {
        carriedBoost = conStartEmptyGauge ? 0.0f : -1.0f;

        if ((isNewInstance && startEmptyApplies && conStartEmptyGauge) || deathRespawn)
        {
            boostPlugin->BoostAmount = 0.0f;
            boostPlugin->Flags |= StatePluginBoost.BoostFlags.IsGaugeEmpty;
        }

        if (deathRespawn && isIsland)
        {
            var pBlackboardItem = BlackboardItem.Get();
            var pStatus = BlackboardStatus.Get();

            if (pBlackboardItem != null && pStatus != null)
            {
                int difficulty = (int)pStatus->Difficulty;

                if (difficulty < 0)
                    difficulty = 0;
                else if (difficulty > 3)
                    difficulty = 3;

                pBlackboardItem->RingCount =
                    (int)(pBlackboardItem->RingCount / ringLossDivisors[difficulty]);
            }
        }
    }
}

Code "Fix Low Capacity Boost Restriction" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Lua"
#lib "BlackboardStatus"

#import "Plugins"
#import "Services"

static bool isBoostLocked = false;

{
    bool isNitroBoost = IS_WORLD_FLAG(IsNitroBoost);

    string stageID = LevelInfo.GetCurrentStageID();

    // Skip Portals 4-G
    if (stageID == "w9d21")
        return;

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
        return;

    // Flight Tweaks and Crawl turn Boost off themselves and hand it back when they're done
    var tailsState = Player.State.GetCurrentStateID<Tails.StateID>();

    bool isTailsFlying = Player.GetPlayerType() == Player.PlayerType.Tails &&
                         (tailsState == Tails.StateID.StateTailsFly ||
                          tailsState == Tails.StateID.StateRunawayBee ||
                          tailsState == Tails.StateID.StateSleep);

    bool isCrawling = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateQuickStepJump;
    bool isBoostHeldOff = isTailsFlying || isCrawling;

    // Rocket Boost always starts with a full Boost Gauge
    if (isNitroBoost || BlackboardStatus.IsSuper())
    {
        boostPlugin->BoostAmount = 100.0f;
        boostPlugin->Flags &= ~StatePluginBoost.BoostFlags.IsGaugeEmpty;

        if (!isBoostHeldOff)
        {
            Lua.Call("SetPlayerAbilityEnabled", "Boost", true);
            isBoostLocked = false;
        }

        return;
    }

    // Hotfix for Portals 4-A and 4-C
    if (stageID == "w6d21" || stageID == "w6d23")
    {
        boostPlugin->Flags &= ~StatePluginBoost.BoostFlags.IsGaugeEmpty;

        if (!isBoostHeldOff)
        {
            Lua.Call("SetPlayerAbilityEnabled", "Boost", true);
            isBoostLocked = false;
        }

        return;
    }

    if (boostPlugin->BoostAmount <= 0.0f)
    {
        boostPlugin->Flags |= StatePluginBoost.BoostFlags.IsGaugeEmpty;
        Lua.Call("SetPlayerAbilityEnabled", "Boost", false);
        isBoostLocked = true;
        return;
    }

    if (boostPlugin->BoostAmount > 0.1f)
    {
        boostPlugin->Flags &= ~StatePluginBoost.BoostFlags.IsGaugeEmpty;

        // Rings can refill the gauge and the game clears the empty flag on its own, so the unlock can't wait on that flag
        if (isBoostLocked && !isBoostHeldOff)
        {
            Lua.Call("SetPlayerAbilityEnabled", "Boost", true);
            isBoostLocked = false;
        }
    }
}

Code "Idle Sleep" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "XInput"
#lib "GameManager"
#lib "BlackboardStatus"
#lib "Lua"
#lib "CyberCorruption"

#load "System.Numerics.dll"

using System.Numerics;

static float idleSleepTimer = 0.0f;
static float sleepTimer = 0.0f;
static float wakeUpTimer = 0.0f;

static bool isSleeping = false;
static bool isWakingUp = false;

static bool sleepAnimApplied = false;
static bool wakeAnimApplied = false;
static bool wakeSoundPlayed = false;

const float sleepIdleTime = 245.0f;
const float wakeDelayTime = 5.0f;
const float wakeUpTime = 3.2f;
const float wakeSoundTime = 2.35f;

static readonly Player.InputActionType[] wakeActions = new Player.InputActionType[]
{
    Player.InputActionType.PlayerJump,
    Player.InputActionType.PlayerCyloop,
    Player.InputActionType.PlayerAttack,
    Player.InputActionType.PlayerLightDash,
    Player.InputActionType.PlayerBoost,
    Player.InputActionType.PlayerLeftStep,
    Player.InputActionType.PlayerRightStep,
    Player.InputActionType.PlayerStomping,
    Player.InputActionType.PlayerSonicboom
};

static bool IsMovementDetected()
{
    var state = XInput.GetState();

    if (state == null)
        return true;

    Vector2 stick = XInput.GetAnalog(0, true);

    return Math.Abs(stick.X) >= 0.25f || Math.Abs(stick.Y) >= 0.25f;
}

static bool IsWakeInputPressed()
{
    for (int i = 0; i < wakeActions.Length; i++)
    {
        if (Player.Input.IsPressed(wakeActions[i]))
            return true;
    }

    return IsMovementDetected();
}

static string GetSleepStartAnim()
{
    return Player.Status.IsSideView() ? "SLEEP_START_SV" : "SLEEP_START";
}

static string GetSleepEndAnim()
{
    return Player.Status.IsSideView() ? "SLEEP_END_SV" : "SLEEP_END";
}

{
    CyberCorruption.Update();

    if (Player.GetPlayerType() != Player.PlayerType.Sonic || IS_WORLD_FLAG(IsBattle))
        return;

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool isCyberCorrupted = CyberCorruption.Level != 0;

    if (!isPaused &&
        currentState == Sonic.StateID.StateStandRoot &&
        !isSleeping &&
        !isCyberCorrupted &&
        !Player.Input.IsDown(Player.InputActionType.PlayerBoost))
    {
        idleSleepTimer += Time.GetDeltaTime();

        if (idleSleepTimer >= sleepIdleTime)
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSleep);

            isSleeping = true;
            isWakingUp = false;

            sleepTimer = 0.0f;
            wakeUpTimer = 0.0f;

            sleepAnimApplied = false;
            wakeAnimApplied = false;
            wakeSoundPlayed = false;

            idleSleepTimer = 0.0f;
        }
    }
    else if (currentState != Sonic.StateID.StateStandRoot && !isSleeping)
    {
        idleSleepTimer = 0.0f;
    }

    // Knocked out of the sleep state without waking up, so let the idle timer run again
    if (isSleeping && sleepAnimApplied && currentState != Sonic.StateID.StateSleep)
    {
        isSleeping = false;
        isWakingUp = false;
        sleepTimer = 0.0f;
        wakeUpTimer = 0.0f;
    }

    if (currentState == Sonic.StateID.StateSleep && isSleeping)
    {
        if (!sleepAnimApplied)
        {
            Player.Animation.SetAnimation(GetSleepStartAnim());
            sleepAnimApplied = true;
        }

        if (!isPaused)
        {
            sleepTimer += Time.GetDeltaTime();

            if (!isWakingUp && sleepTimer >= wakeDelayTime && IsWakeInputPressed())
            {
                isWakingUp = true;
                wakeUpTimer = 0.0f;
                wakeAnimApplied = false;
                wakeSoundPlayed = false;
            }

            if (isWakingUp)
            {
                wakeUpTimer += Time.GetDeltaTime();

                if (!wakeAnimApplied)
                {
                    Player.Animation.SetAnimation(GetSleepEndAnim());
                    wakeAnimApplied = true;
                }

                if (!wakeSoundPlayed && wakeUpTimer >= wakeSoundTime)
                {
                    Player.Sound.PlaySound("sn_jump");
                    Lua.Call("PlayVoice", "sa1003");
                    wakeSoundPlayed = true;
                }

                if (wakeUpTimer >= wakeUpTime)
                {
                    Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStandRoot);

                    isSleeping = false;
                    isWakingUp = false;

                    sleepTimer = 0.0f;
                    wakeUpTimer = 0.0f;
                }
            }
        }
    }
}

Code "Parry Tweaks" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"
#lib "Reflection"
#lib "Time"

const float parryDescentSpeed = 6.0f;

{
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    // Super Sonic always uses grounded values
    bool isAerial = !BlackboardStatus.IsSuper() && !Player.Status.IsGrounded();

    if (!isAerial)
    {
        if (SonicParametersInfo.pData != null)
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 15.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 2.5f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[0], 5.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[1], 3.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[2], 1.5f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[3], 0.5f);
        }

        if (TailsParametersInfo.pData != null)
        {
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 15.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 10.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 5.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 2.5f);
        }

        if (KnucklesParametersInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 15.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 10.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 5.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 2.5f);
        }

        if (AmyParametersInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 15.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 10.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 5.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 2.5f);
        }
    }
    else
    {
        if (SonicParametersInfo.pData != null)
        {
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 10.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 7.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 1.5f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 0.8f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[0], 3.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[1], 2.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[2], 1.0f);
            RFL_SET_PARAM(SonicParametersInfo, forwardView.modePackage.parry.justRecieveTimes[3], 0.3f);
        }

        if (TailsParametersInfo.pData != null)
        {
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 20.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 15.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 8.0f);
            RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 4.0f);
        }

        if (KnucklesParametersInfo.pData != null)
        {
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 10.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 7.0f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 1.5f);
            RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 0.8f);
        }

        if (AmyParametersInfo.pData != null)
        {
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[0], 10.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[1], 7.0f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[2], 1.5f);
            RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.parry.maxRecieveTimes[3], 0.8f);
        }
    }

    if (isAerial && Player.GetPlayerType() != Player.PlayerType.Tails &&
        Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateParry)
    {
        kinematics->Velocity.Y -= parryDescentSpeed * Time.GetDeltaTime();
    }
}

Code "Manual Sky Dive" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

static bool isManualDive = false;
static bool isConfigInitialized = false;
static int conSkyDiveAbility = 0;
static int conLegacySpinDash = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conSkyDiveAbility = INI.GetField<int>(ini, "Main", "SkyDiveAbility", conSkyDiveAbility);
            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            isConfigInitialized = true;
        }
    }

    if (conSkyDiveAbility != 1)
        return;

    bool isGrind = IS_STATE_FLAG(IsGrind);
    bool isDamage = IS_WORLD_FLAG(IsDamagedOrRepelled);
    bool isOutOfControl = IS_WORLD_FLAG(IsOutOfControl);
    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);

    if (isGrind || isDamage || isOutOfControl || isAutoRun || Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateCaught)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (Player.Status.IsSideView())
    {
        isManualDive = false;
    }
    else if (currentState == Sonic.StateID.StateDiving)
    {
        if (isManualDive)
        {
            if (Player.Input.IsPressed(Player.InputActionType.PlayerSonicboom) &&
                (conLegacySpinDash != 3 || IS_COMBAT_FLAG(IsSpinDash)))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);
                isManualDive = false;
            }
            else if (Player.Input.IsPressed(Player.InputActionType.PlayerStomping))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStompingDown);
                isManualDive = false;
            }
            else if (Player.Input.IsPressed(Player.InputActionType.PlayerRightStep) ||
                     Player.Input.IsPressed(Player.InputActionType.PlayerLeftStep))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateAvoid);
                isManualDive = false;
            }
        }
    }
    else if (!Player.Status.IsGrounded() && Player.Input.IsPressed(Player.InputActionType.CameraGaze))
    {
        if (!isManualDive)
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateDiving);
            isManualDive = true;
        }
    }
    else
    {
        isManualDive = false;
    }
}

Code "Slide Tweaks" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"

{
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    if (Player.State.GetCurrentStateID<Sonic.StateID>() != Sonic.StateID.StateSliding)
        return;

    bool isHoldingSlide = Player.Input.IsDown(Player.InputActionType.PlayerStomping);

    // Sonic
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.minSpeed, 25.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.endSpeed, 5.0f);
