            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.airboost.startHSpeedMax, 50.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.airboost.startVSpeed, 25.0f);
