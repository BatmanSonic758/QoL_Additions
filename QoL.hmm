Code "Generations-Style Wall Jump" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"

{
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    // Sonic
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.gravitySize, 10.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.minTime, 0.10f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.maxTime, 0.7f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.stopTime, 0.10f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.maxDownSpeed, 4.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.frontForce, 25.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.upForce, 13.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.walljump.impulseTime, 0.25f);
    }

    // Tails
    if (TailsParametersInfo.pData != null)
    {
