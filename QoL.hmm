Code "Fix Accelerator Gun Animation" by "Batman Sonic"
//

#lib "Player"
#lib "Time"
#lib "GameManager"

static bool inSelectorFlow = false;
static bool playedSelectorAnim = false;
static float launchHorizontal = 0.0f;
static float launchVertical = 0.0f;

static bool missLanding = false;
static bool inRecovery = false;
static bool recoveryAnimSet = false;
static float recoveryTimer = 0.0f;

const float fwdThreshold = 2.0f;
const float upThreshold = 5.0f;
const float recoveryTime = 2.0f;

{
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float verticalSpeed = Player.Kinematics.GetVerticalMagnitude();
    float horizontalSpeed = Player.Kinematics.GetHorizontalMagnitude();

    if (currentState == Sonic.StateID.StateHoldStand &&
        previousState != Sonic.StateID.StateHoldStand &&
        !inRecovery)
    {
        inSelectorFlow = false;
        playedSelectorAnim = false;
        launchHorizontal = 0.0f;
        launchVertical = 0.0f;
        missLanding = false;
    }

    if (previousState == Sonic.StateID.StateHoldStand &&
        currentState == Sonic.StateID.StateSpringJump)
    {
        inSelectorFlow = true;
        playedSelectorAnim = false;
        launchHorizontal = 0.0f;
        launchVertical = 0.0f;
    }

    if (inSelectorFlow && currentState == Sonic.StateID.StateSpringJump)
    {
        if (horizontalSpeed > launchHorizontal)
            launchHorizontal = horizontalSpeed;
        if (verticalSpeed > launchVertical)
            launchVertical = verticalSpeed;
    }

    if (inSelectorFlow &&
        previousState == Sonic.StateID.StateSpringJump &&
        currentState == Sonic.StateID.StateFall &&
        !playedSelectorAnim)
    {
        if (launchHorizontal >= fwdThreshold)
        {
            Player.Animation.SetAnimation("SELECTJUMP_F_END");
        }
        else if (launchVertical >= upThreshold)
        {
            Player.Animation.SetAnimation("SELECTJUMP_U_END");
        }
        else
        {
            Player.Animation.SetAnimation("SELECTJUMP_MISS_LOOP");
            missLanding = true;
        }

        playedSelectorAnim = true;
    }

    if (missLanding && Player.Status.IsGrounded())
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHoldStand);
        recoveryTimer = 0.0f;
        inRecovery = true;
        recoveryAnimSet = false;
        missLanding = false;
    }

    // Something else took over mid-recovery, so don't force StandRoot when the timer ends
    if (inRecovery && recoveryAnimSet && currentState != Sonic.StateID.StateHoldStand)
    {
        inRecovery = false;
        recoveryAnimSet = false;
    }

    if (inRecovery)
    {
        if (!recoveryAnimSet && currentState == Sonic.StateID.StateHoldStand)
        {
            Player.Animation.SetAnimation("SELECTJUMP_MISS_END");
            recoveryAnimSet = true;
        }

        if (recoveryTimer < recoveryTime)
        {
            bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                            GameManager.GetGameObject("MapMenu") != null ||
                            GameManager.GetGameObject("PhotoMode") != null;

            if (!isPaused)
            {
                recoveryTimer += Time.GetDeltaTime();
                if (recoveryTimer >= recoveryTime)
                {
                    Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStandRoot);
                    inRecovery = false;
                    recoveryAnimSet = false;
                }
            }
        }
    }

    if (currentState != Sonic.StateID.StateHoldStand &&
        currentState != Sonic.StateID.StateSpringJump &&
        currentState != Sonic.StateID.StateFall)
    {
        inSelectorFlow = false;
        playedSelectorAnim = false;
        launchHorizontal = 0.0f;
        launchVertical = 0.0f;
    }
}

