        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.walljump.frontForce, 25.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.walljump.upForce, 13.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.walljump.impulseTime, 0.25f);
