Code "Light Dash Tweaks" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Reflection"
#lib "SonicParameters"
#lib "Player"

{
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float lightDashBrake = (Player.Kinematics.GetHorizontalMagnitude() < 16.0f) ? 250.0f : 0.0f;

    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, lightDash.dashSpeed, 70.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, lightDash.dashSpeedMax, 70.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, lightDash.speed, 50.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, lightDash.speedMax, 50.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, lightDash.accel, 50.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, lightDash.brake, lightDashBrake);
    }
}

