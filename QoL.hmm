        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.spinAttack.deceleForce, 2.5f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.spinAttack.brakeForce, 0.5f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.spinAttack.limitSpeedMin, 4.0f);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.spinAttack.limitSpeedMax, 100.0f);
    }

    // Amy
    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.jumpForce, 12.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.jumpAddForce, 22.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.addTime, 0.5f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.acceleForce, 2.5f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.deceleForce, 2.5f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.brakeForce, 0.5f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.limitSpeedMin, 4.0f);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.spinAttack.limitSpeedMax, 100.0f);

        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.jumpForce, 12.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.jumpAddForce, 22.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.addTime, 0.5f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.acceleForce, 2.5f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.deceleForce, 2.5f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.brakeForce, 0.5f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.limitSpeedMin, 4.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.spinAttack.limitSpeedMax, 100.0f);
    }

    // Amy (3D Cyber Space)
    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.jumpForce, 12.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.jumpAddForce, 22.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.addTime, 0.5f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.acceleForce, 2.5f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.deceleForce, 2.5f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.brakeForce, 0.5f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.limitSpeedMin, 4.0f);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.spinAttack.limitSpeedMax, 100.0f);
    }

    // Knuckles' homing belongs to Knuckles Combat Rework and Amy's to Hammer Moves while her hammer attack is on
    bool canForceHoming = playerType != Player.PlayerType.Knuckles &&
                          !(playerType == Player.PlayerType.Amy && conHammerAttack == 1);

    // Homing Attack input handling
    if (canForceHoming && Player.Status.IsLockOnCursorVisible() && Player.Input.IsPressed(Player.InputActionType.PlayerAttack) && previousState == Sonic.StateID.StateSpinAttack)
    {
        if (playerType == Player.PlayerType.Amy)
        {
            if (Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.StateGrindDoubleJump)
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHomingAttack);
        }
        else
        {
            if (currentState == Sonic.StateID.StateSpinAttack || currentState == Sonic.StateID.StateBounceJump)
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHomingAttack);
        }
    }

    if (currentState == Sonic.StateID.StateSpinAttack)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
            spinAttackDelayTimer += Time.GetDeltaTime();

        if (!isSpinAttackRedirect && spinAttackDelayTimer >= 0.18f)
        {
            isSpinAttackRedirect = true;

            if (playerType == Player.PlayerType.Amy)
                Player.State.SetState<Amy.StateID>(Amy.StateID.StateGrindDoubleJump);
            else
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateBounceJump);
        }
    }
    else
    {
        spinAttackDelayTimer = 0.0f;
        isSpinAttackRedirect = false;
    }
}

Code "Dynamic Bounce Height" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "MathHelpers"
#lib "HMM"
#lib "INI"

static bool wasBouncing = false;
static bool bounceApplied = false;
static float fallSpeed = 0.0f;

const float minBounce = 25.0f;
const float maxBounce = 120.0f;
const float fixedBounce = 25.0f;

static bool isConfigInitialized = false;
static int conBounceAttackAbility = 0;
static int conHammerAttack = 0;
static int conTailSwipeAbility = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conBounceAttackAbility = INI.GetField<int>(ini, "Main", "BounceAttackAbility", conBounceAttackAbility);
            conHammerAttack = INI.GetField<int>(ini, "Main", "HammerAttack", conHammerAttack);
            conTailSwipeAbility = INI.GetField<int>(ini, "Main", "TailSwipeAbility", conTailSwipeAbility);
            isConfigInitialized = true;
        }
    }

    if (BlackboardStatus.IsSuper())
        return;

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    var playerType = Player.GetPlayerType();

    bool isBouncing = false;
    bool isStompBounce = false;
    bool isTailSwipeBounce = false;

    if (playerType == Player.PlayerType.Sonic)
    {
        var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
        var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

        isBouncing = previousState == Sonic.StateID.StateSpinAttack &&
                     (currentState == Sonic.StateID.StateBounceJump ||
                     currentState == Sonic.StateID.StateQuickStepDoubleJump ||
                     currentState == Sonic.StateID.StateSpinBoostCharge);

        if (conBounceAttackAbility == 1 && currentState == Sonic.StateID.StateStompingBounce)
        {
            isBouncing = true;
            isStompBounce = true;
        }
    }
    else if (playerType == Player.PlayerType.Tails)
    {
        var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
        var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

        isBouncing = previousState == Tails.StateID.StateSpinAttack &&
                     (currentState == Tails.StateID.StateBounceJump ||
                     currentState == Tails.StateID.StateQuickStepDoubleJump ||
                     currentState == Tails.StateID.StateSpinBoostCharge);

        if (conTailSwipeAbility == 1 &&
            currentState == Tails.StateID.StatePursuitKick)
        {
            isBouncing = true;
            isTailSwipeBounce = true;
        }
    }
    else if (playerType == Player.PlayerType.Knuckles)
    {
        var currentState = Player.State.GetCurrentStateID<Knuckles.StateID>();
        var previousState = Player.State.GetPreviousStateID<Knuckles.StateID>();

        isBouncing = previousState == Knuckles.StateID.StateSpinAttack &&
                     (currentState == Knuckles.StateID.StateAcceleCombo1 ||
                     currentState == Knuckles.StateID.StateBounceJump ||
                     currentState == Knuckles.StateID.StateQuickStepDoubleJump ||
                     currentState == Knuckles.StateID.StateSpinBoostCharge);
    }
    else if (playerType == Player.PlayerType.Amy)
    {
        var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
        var previousState = Player.State.GetPreviousStateID<Amy.StateID>();

        isBouncing = previousState == Amy.StateID.StateSpinAttack &&
                     (currentState == Amy.StateID.StateGrindDoubleJump ||
                     currentState == Amy.StateID.StateQuickStepDoubleJump ||
                     currentState == Amy.StateID.StateSpinBoostCharge);

        if (conHammerAttack == 1 &&
            currentState == Amy.StateID.StateAcceleCombo1)
        {
            isBouncing = true;
        }
    }

    if (!isBouncing)
    {
        if (kinematics->Velocity.Y < 0.0f)
            fallSpeed = -kinematics->Velocity.Y;
    }

    if (isBouncing && !wasBouncing && !bounceApplied)
    {
        float bounce = fixedBounce;

        if (!isTailSwipeBounce && !IS_WORLD_FLAG(IsCyberSpace) && !isStompBounce)
        {
            bounce = MathHelpers.Clamp(fallSpeed, minBounce, maxBounce);
        }

        kinematics->Velocity.Y = bounce;
        bounceApplied = true;
    }

    if (!isBouncing)
        bounceApplied = false;

    wasBouncing = isBouncing;
}

Code "Disable Bounce Height for Amy" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "AmyParameters"

static bool wasInDoubleJump = false;

{
    if (Player.GetPlayerType() != Player.PlayerType.Amy)
        return;

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
    float verticalSpeed = Player.Kinematics.GetVerticalMagnitude();

    Player.State.Redirect<Amy.StateID>(Amy.StateID.StateGrindDoubleJump, Amy.StateID.StateDoubleJump);

    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.doubleJump.initialSpeed, verticalSpeed);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.doubleJump.initialSpeed, verticalSpeed);
    }

    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.doubleJump.initialSpeed, verticalSpeed);
    }

    if (currentState == Amy.StateID.StateDoubleJump || currentState == Amy.StateID.StateRecoveryJump || currentState == Amy.StateID.StateAcceleCombo1)
    {
        if (!wasInDoubleJump)
        {
            kinematics->Velocity.Y = Player.Status.IsSideView() ? 12.0f : 22.5f;
            wasInDoubleJump = true;
        }
    }
    else
    {
        wasInDoubleJump = false;
    }
}

Code "Spin States Fixes" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Player"
#lib "Time"
#lib "GameManager"
#lib "SonicParameters"
#lib "TailsParameters"
#lib "KnucklesParameters"
#lib "AmyParameters"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"
#lib "Reflection"

#import "Plugins"

#load "System.Numerics.dll"
using System.Numerics;

static float chargeTime = 0.0f;
const float maxChargeTime = 10.0f;
static bool wasInSpinState = false;

static float spinAttackDelayTimer = 0.0f;
static bool isSpinAttackRedirect = false;

static float fallReturnTimer = 0.0f;

static bool isSpinSound = false;
static bool isSpinChargeSound = false;
static bool isBoostRunSound = false;

static int spinSoundHandle = 0;
static int spinChargeSoundHandle = 0;
static int boostRunSoundHandle = 0;

static Sonic.StateID originalSpinState = Sonic.StateID.StateSpin;

static bool wasChargingInAir = false;

static float spinBoostGraceTimer = 0.0f;
const float spinBoostGraceDuration = 0.5f;

static bool isConfigInitialized = false;
static int conLegacySpinDash = 0;
static int conHammerAttack = 0;

static List<Sonic.StateID> spinStates = new()
{
    Sonic.StateID.StateQuickStepDoubleJump,
    Sonic.StateID.StateSpinBoostCharge,
    Sonic.StateID.StateDriftDash,
    Sonic.StateID.StateDropDash,
    Sonic.StateID.StateSpin
};

static List<Sonic.StateID> spinSoundStates = new()
{
    Sonic.StateID.StateQuickStepDoubleJump,
    Sonic.StateID.StateDriftDash,
    Sonic.StateID.StateDropDash,
    Sonic.StateID.StateSpin
};

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            conHammerAttack = INI.GetField<int>(ini, "Main", "HammerAttack", conHammerAttack);

            // The classic dash rolls, so it counts as a spin state too
            if (conLegacySpinDash == 1 || conLegacySpinDash == 2)
            {
                spinStates.Add(Sonic.StateID.StateSpinBoost);
                spinSoundStates.Add(Sonic.StateID.StateSpinBoost);
            }

            isConfigInitialized = true;
        }
    }

    bool isLegacySpinDash = conLegacySpinDash == 1 || conLegacySpinDash == 2;

    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var TailsParametersInfo = Reflection.GetDataInfo<TailsParameters.Root>("tails_common");
    var KnucklesParametersInfo = Reflection.GetDataInfo<KnucklesParameters.Root>("knuckles_common");
    var AmyParametersInfo = Reflection.GetDataInfo<AmyParameters.Root>("amy_common");

    var TailsParametersCyberInfo = Reflection.GetDataInfo<TailsParameters.ModePackageTails>("tails_modepackage_cyber");
    var KnucklesParametersCyberInfo = Reflection.GetDataInfo<KnucklesParameters.ModePackageKnuckles>("knuckles_modepackage_cyber");
    var AmyParametersCyberInfo = Reflection.GetDataInfo<AmyParameters.ModePackageAmy>("amy_modepackage_cyber");

    var kinematics = Player.Kinematics.Get();

    var currentPlayerType = Player.GetPlayerType();
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();
    var isGrounded = Player.Status.IsGrounded();

    float verticalSpeed = Player.Kinematics.GetVerticalMagnitude();

    bool is2D = Player.Status.IsSideView();

    if (BlackboardStatus.IsSuper())
    {
        // Transforming mid-spin would otherwise leave the spin's damage sphere behind
        if (wasInSpinState)
        {
            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);
            wasInSpinState = false;
        }

        return;
    }

    if (kinematics == null)
        return;

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();
    bool hasBoostEnergy = boostPlugin != null && (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0;

    // Disable Bounce Height (also hotfixed in other codes)
    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.fall.thresholdVertSpeed, -150.0f);
    }

    if (TailsParametersInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(TailsParametersInfo, forwardView.modePackage.fall.thresholdVertSpeed, -150.0f);
        RFL_SET_PARAM(TailsParametersInfo, cyberspaceSV.modePackage.fall.thresholdVertSpeed, -150.0f);
    }

    if (KnucklesParametersInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(KnucklesParametersInfo, forwardView.modePackage.fall.thresholdVertSpeed, -150.0f);
        RFL_SET_PARAM(KnucklesParametersInfo, cyberspaceSV.modePackage.fall.thresholdVertSpeed, -150.0f);
    }

    if (AmyParametersInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(AmyParametersInfo, forwardView.modePackage.fall.thresholdVertSpeed, -150.0f);
        RFL_SET_PARAM(AmyParametersInfo, cyberspaceSV.modePackage.fall.thresholdVertSpeed, -150.0f);
    }

    if (TailsParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(TailsParametersCyberInfo, modePackage.fall.thresholdVertSpeed, -150.0f);
    }

    if (KnucklesParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(KnucklesParametersCyberInfo, modePackage.fall.thresholdVertSpeed, -150.0f);
    }

    if (AmyParametersCyberInfo.pData != null)
    {
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.doubleJump.bounceSpeed, verticalSpeed);
        RFL_SET_PARAM(AmyParametersCyberInfo, modePackage.fall.thresholdVertSpeed, -150.0f);
    }

    Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateQuickStepDoubleJump, Sonic.StateID.StateBounceJump);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateQuickStepDoubleJump, Tails.StateID.StateBounceJump);
    Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateQuickStepDoubleJump, Knuckles.StateID.StateBounceJump);
    Player.State.Redirect<Amy.StateID>(Amy.StateID.StateQuickStepDoubleJump, Amy.StateID.StateDoubleJump);

    // Self-redirect in 2D clears the 3D Drift Dash redirect
    if (is2D)
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateDropDash, Sonic.StateID.StateDropDash);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateDropDash, Tails.StateID.StateDropDash);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateDropDash, Knuckles.StateID.StateDropDash);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateDropDash, Amy.StateID.StateDropDash);
    }
    else
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateDropDash, Sonic.StateID.StateDriftDash);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateDropDash, Tails.StateID.StateDriftDash);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateDropDash, Knuckles.StateID.StateDriftDash);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateDropDash, Amy.StateID.StateDriftDash);
    }

    if (!isGrounded)
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge, Sonic.StateID.StateBounceJump);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateSpinBoostCharge, Tails.StateID.StateBounceJump);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateSpinBoostCharge, Knuckles.StateID.StateBounceJump);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateSpinBoostCharge, Amy.StateID.StateDoubleJump);
    }
    else
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge, Sonic.StateID.StateSpinBoostCharge);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateSpinBoostCharge, Tails.StateID.StateSpinBoostCharge);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateSpinBoostCharge, Knuckles.StateID.StateSpinBoostCharge);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateSpinBoostCharge, Amy.StateID.StateSpinBoostCharge);
    }

    // Spin State Sound
    if (spinSoundStates.Contains(currentState))
    {
        if (!isSpinSound && !spinSoundStates.Contains(previousState))
        {
            spinSoundHandle = Player.Sound.PlaySound("sn_spinboost");
            isSpinSound = true;
        }
    }
    else if (isSpinSound)
    {
        int handle = spinSoundHandle;
        Player.Sound.StopSound(&handle);
        isSpinSound = false;
    }

    // Aerial Spin Dash Charge Sound
    if (!isGrounded && currentState == Sonic.StateID.StateSpinBoostCharge)
    {
        if (!isSpinChargeSound && previousState != Sonic.StateID.StateSpinBoostCharge)
        {
            spinChargeSoundHandle = Player.Sound.PlaySound("sn_spinboost_charge");
            isSpinChargeSound = true;
        }
    }
    else if (isSpinChargeSound)
    {
        int handle = spinChargeSoundHandle;
        Player.Sound.StopSound(&handle);
        isSpinChargeSound = false;
    }

    // Boost Run Sound
    if (currentState == Sonic.StateID.StateRun && IS_STATE_FLAG(IsBoost))
    {
        if (!isBoostRunSound && spinStates.Contains(previousState))
        {
            boostRunSoundHandle = Player.Sound.PlaySound("sn_boost_run");
            isBoostRunSound = true;
        }
    }
    else if (isBoostRunSound)
    {
        int handle = boostRunSoundHandle;
        Player.Sound.StopSound(&handle);
        isBoostRunSound = false;
    }

    bool needsPauseCheck = currentState == Sonic.StateID.StateSpinBoost ||
                           currentState == Sonic.StateID.StateSpinBoostCharge ||
                           (!isGrounded && spinStates.Contains(currentState)) ||
                           (currentState == Sonic.StateID.StateSpinAttack && !isSpinAttackRedirect);

    bool isPaused = needsPauseCheck &&
                    (GameManager.GetGameObject("MainMenu") != null ||
                     GameManager.GetGameObject("MapMenu") != null ||
                     GameManager.GetGameObject("PhotoMode") != null);

    float deltaTime = isPaused ? 0.0f : Time.GetDeltaTime();

    // StateSpinAttack Delay
    if (currentState == Sonic.StateID.StateSpinAttack &&
        (previousState == Sonic.StateID.StateQuickStepDoubleJump ||
        (!isGrounded && previousState == Sonic.StateID.StateSpinBoostCharge)))
    {
        spinAttackDelayTimer += deltaTime;

        if (!isSpinAttackRedirect && spinAttackDelayTimer >= 0.1f)
        {
            isSpinAttackRedirect = true;
            Player.State.SetState<Sonic.StateID>(previousState);
        }
    }
    else if (currentState != Sonic.StateID.StateSpinAttack)
    {
        spinAttackDelayTimer = 0.0f;
        isSpinAttackRedirect = false;
    }

    // Roll backwards on slopes, uncurl on flat ground at low speed
    if (currentState == Sonic.StateID.StateSpinBoost)
        spinBoostGraceTimer += deltaTime;
    else
        spinBoostGraceTimer = 0.0f;

    bool canApplySlopeHandling = currentState != Sonic.StateID.StateSpinBoostCharge &&
                                 currentState != Sonic.StateID.StateQuickStepDoubleJump &&
                                 (currentState != Sonic.StateID.StateSpinBoost || spinBoostGraceTimer >= spinBoostGraceDuration);

    if (isGrounded && spinStates.Contains(currentState) && canApplySlopeHandling)
    {
        float slopeY = Vector3.Transform(Vector3.UnitY, kinematics->Rotation).Y;

        float slopeThreshold = is2D ? 0.95f : 0.92f;
        float speedLimit = is2D ? 0.5f : 0.2f;
        bool isOnSlope = slopeY < slopeThreshold;

        if (Player.Kinematics.GetMagnitude() < speedLimit)
        {
            if (isOnSlope)
            {
                // Turn around and let gravity roll back
                kinematics->Rotation = kinematics->Rotation * new Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
            }
            else
            {
                // Flat ground with no momentum left, so stand back up
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpringJumpHeadLand);
            }
        }
    }

    // Aerial Rolling
    if (!isGrounded && spinStates.Contains(currentState) && currentState != Sonic.StateID.StateSpinBoostCharge)
    {
        float timerThreshold = (currentState == Sonic.StateID.StateSpinBoost && isLegacySpinDash) ? 0.3f : 0.1f;

        fallReturnTimer += deltaTime;

        if (fallReturnTimer <= timerThreshold && currentState != Sonic.StateID.StateQuickStepDoubleJump)
        {
            originalSpinState = currentState;
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateQuickStepDoubleJump);
        }
    }
    else
    {
        fallReturnTimer = 0.0f;
    }

    // Aerial Roll Descent
    if (!isGrounded && currentState == Sonic.StateID.StateQuickStepDoubleJump)
    {
        float descentAccel = 18.0f;
        kinematics->Velocity.Y -= descentAccel * deltaTime;
    }

    // Spin Dash entry from a spin state
    bool canChargeSpinDash = conLegacySpinDash != 3 || (hasBoostEnergy && IS_COMBAT_FLAG(IsSpinDash));

    if (canChargeSpinDash && isGrounded &&
        currentState != Sonic.StateID.StateSpinBoostCharge && spinStates.Contains(currentState) &&
        Player.Input.IsDown(Player.InputActionType.PlayerSonicboom) && Player.Input.IsDown(Player.InputActionType.PlayerStomping))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);
    }

    // Drop Dash-style charge, landing an aerial charge straight into SpinBoost
    if (currentState == Sonic.StateID.StateSpinBoostCharge)
    {
        if (!isGrounded)
        {
            wasChargingInAir = true;

            if (!Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateFall);
                wasChargingInAir = false;
            }
        }
        else if (wasChargingInAir)
        {
            if (Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpinBoost);

            wasChargingInAir = false;
        }
    }
    else if (wasChargingInAir)
    {
        if (isGrounded && previousState == Sonic.StateID.StateSpinBoostCharge &&
            Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpinBoost);
        }

        wasChargingInAir = false;
    }

    // Restore the previous spin state on landing
    if (isGrounded && currentState != Sonic.StateID.StateQuickStepDoubleJump && previousState == Sonic.StateID.StateQuickStepDoubleJump)
    {
        if (originalSpinState == Sonic.StateID.StateSpinBoost ||
            originalSpinState == Sonic.StateID.StateDropDash ||
            originalSpinState == Sonic.StateID.StateDriftDash ||
            originalSpinState == Sonic.StateID.StateSpin)
        {
            Player.State.SetState<Sonic.StateID>(originalSpinState);
        }

        originalSpinState = Sonic.StateID.StateSpin;
    }

    // Knuckles' homing belongs to Knuckles Combat Rework and Amy's to Hammer Moves while her hammer attack is on
    bool canForceHoming = currentPlayerType != Player.PlayerType.Knuckles &&
                          !(currentPlayerType == Player.PlayerType.Amy && conHammerAttack == 1);

    // Allow Homing Attack out of the aerial roll
    if (canForceHoming && !isGrounded && currentState == Sonic.StateID.StateQuickStepDoubleJump && Player.Status.IsLockOnCursorVisible() &&
        Player.Input.IsPressed(Player.InputActionType.PlayerAttack))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateHomingAttack);
    }

    // SpinBoost / DropDash transitions
    if (currentPlayerType == Player.PlayerType.Sonic ||
        currentPlayerType == Player.PlayerType.Tails ||
        currentPlayerType == Player.PlayerType.Knuckles ||
        currentPlayerType == Player.PlayerType.Amy)
    {
        // Frontiers Spin Dash transitions
        if (conLegacySpinDash == 3 && currentState == Sonic.StateID.StateSpinBoost)
        {
            if (!isGrounded)
            {
                if (hasBoostEnergy && Player.Input.IsPressed(Player.InputActionType.PlayerBoost))
                {
                    Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateAirBoost);
                    SET_STATE_FLAG(IsBoost, true);
                }
            }
            else
            {
                if (hasBoostEnergy && Player.Input.IsDown(Player.InputActionType.PlayerBoost))
                {
                    Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRun);
                    SET_STATE_FLAG(IsBoost, true);
                }
                else if (Player.Input.IsPressed(Player.InputActionType.PlayerStomping))
                {
                    Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpringJumpHeadLand);
                }
            }
        }

        // Classic Spin Dash transitions
        if (isGrounded &&
            (currentState == Sonic.StateID.StateDropDash || (isLegacySpinDash && currentState == Sonic.StateID.StateSpinBoost)))
        {
            if (hasBoostEnergy && Player.Input.IsDown(Player.InputActionType.PlayerBoost))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRun);
                SET_STATE_FLAG(IsBoost, true);
            }
            else if (Player.Input.IsPressed(Player.InputActionType.PlayerCyloop))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpringJumpHeadLand);
            }
        }

        // Aerial spin transitions
        if (!isGrounded && currentState == Sonic.StateID.StateQuickStepDoubleJump)
        {
            if (Player.Input.IsPressed(Player.InputActionType.PlayerStomping))
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStompingDown);
            else if (Player.Input.IsPressed(Player.InputActionType.PlayerBoost))
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateAirBoost);
            else if (Player.Input.IsPressed(Player.InputActionType.PlayerCyloop))
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateBumpJump);
        }
    }

    // Spin Dash Charge timer
    if (currentState == Sonic.StateID.StateSpinBoostCharge)
    {
        chargeTime += deltaTime;

        if (Player.Input.IsPressed(Player.InputActionType.PlayerSonicboom))
            chargeTime = 0.0f;

        if (chargeTime >= maxChargeTime)
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSquat);
            Player.Animation.SetAnimation("IDLE_BATTLE_LOOP");
            Player.Effect.StopAnimationEffects();
            chargeTime = 0.0f;
        }
    }
    else
    {
        chargeTime = 0.0f;
    }

    // Collision
    if (spinStates.Contains(currentState) ||
        (currentState == Sonic.StateID.StateJump && spinStates.Contains(previousState)))
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 2.0f);
        Player.Collision.SetEntityCollision(false);
        wasInSpinState = true;
    }
    else if (wasInSpinState)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        wasInSpinState = false;
    }
}

Code "Spin Physics Tweaks" by "Batman Sonic"
//

#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "SonicParameters"

#load "System.Numerics.dll"

using System.Numerics;

{
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float verticalSpeed = Player.Kinematics.GetVerticalMagnitude();
    float slopeY = Vector3.Transform(Vector3.UnitY, kinematics->Rotation).Y;

    bool isOnSlope = slopeY < 0.98f;
    bool isMovingUphill = verticalSpeed > 0.5f && isOnSlope;
    bool isMovingDownhill = !isMovingUphill && isOnSlope;

    // Drop Dash brakes like the 2D games on slopes, Drift Dash keeps a gentler 3D feel
    float dropDashBrake = isMovingDownhill ? -3.5f : isMovingUphill ? 6.5f : 0.85f;
    float driftDashBrake = isMovingDownhill ? -1.2f : isMovingUphill ? 3.5f : -0.1f;

    if (SonicParametersInfo.pData != null)
    {
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.maxChargeTime, 0.2f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.minDashSpeed, 8.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.minDashSpeedMax, 12.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.maxDashSpeed, 120.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.maxDashSpeedMax, 120.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.tumbleDashSpeed, 25.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.maxSpeed, 120.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.brake, dropDashBrake);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.steeringSpeed1, 550.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.steeringSpeed2, 400.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.checkDashSpeed, 9999.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, dropDash.checkDashTime, 9999.0f);

        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.maxSpeed, 120.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.brake, driftDashBrake);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.steeringSpeed1, 400.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.steeringSpeed2, 200.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.startSteeringSpeed, 0.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.endSteeringSpeed, 150.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.outOfControlSpeed, 9999.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.checkDashSpeed, 9999.0f);
        RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, driftDash.checkDashTime, 9999.0f);
    }
}

Code "Roll over Slide" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

static bool isConfigInitialized = false;
static int conRollAbility = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conRollAbility = INI.GetField<int>(ini, "Main", "RollAbility", conRollAbility);
            isConfigInitialized = true;
        }
    }

    if (conRollAbility != 1 || IS_WORLD_FLAG(IsAutoRun))
        return;

    var currentPlayerType = Player.GetPlayerType();
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (currentPlayerType == Player.PlayerType.Sonic)
    {
        if (currentState == Sonic.StateID.StateSliding)
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateDropDash);
        }
    }

    // Allow Tails, Knuckles and Amy to enter the Drop Dash state
    if (currentPlayerType == Player.PlayerType.Tails ||
        currentPlayerType == Player.PlayerType.Knuckles ||
        currentPlayerType == Player.PlayerType.Amy)
    {
        var currentFriendState = Player.State.GetCurrentStateID<Tails.StateID>();

        if ((currentFriendState == Tails.StateID.StateRun && Player.Input.IsPressed(Player.InputActionType.PlayerStomping)) ||
            currentFriendState == Tails.StateID.StateQuickStepJump)
        {
            Player.State.SetState<Tails.StateID>(Tails.StateID.StateDropDash);
        }
    }
}

Code "Classic Spin Dash" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Time"
#lib "INI"
#lib "HMM"
#lib "GameManager"

#load "System.Numerics.dll"

using System.Numerics;

static bool wasAerialCharge = false;

static float chargeCount = 0.0f;

static bool isConfigInitialized = false;
static int conLegacySpinDash = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            isConfigInitialized = true;
        }
    }

    if (conLegacySpinDash != 1 && conLegacySpinDash != 2)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool isGrounded = Player.Status.IsGrounded();
    bool isSideView = Player.Status.IsSideView();

    float deltaTime = Time.GetDeltaTime();
    float speed = Player.Kinematics.GetHorizontalMagnitude();

    bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                    GameManager.GetGameObject("MapMenu") != null ||
                    GameManager.GetGameObject("PhotoMode") != null;

    float maxCharge = 10.0f;
    float maxChargeDropDash;
    float maxChargeDropDashOpenZone;
    float chargeSpeedMultiplier;
    float releaseSpeedCap;
    float groundReleaseSpeedCap;

    if (isSideView)
    {
        maxChargeDropDash = 2.5f;
        maxChargeDropDashOpenZone = 3.0f;
        chargeSpeedMultiplier = 16.0f;
        releaseSpeedCap = IS_WORLD_FLAG(IsCyberSpace) ? 35.0f : 40.0f;
        groundReleaseSpeedCap = IS_WORLD_FLAG(IsCyberSpace) ? 44.0f : 50.0f;
    }
    else
    {
        maxChargeDropDash = 4.0f;
        maxChargeDropDashOpenZone = 5.0f;
        chargeSpeedMultiplier = 15.0f;
        releaseSpeedCap = IS_WORLD_FLAG(IsCyberSpace) ? 40.0f : 45.0f;
        groundReleaseSpeedCap = IS_WORLD_FLAG(IsCyberSpace) ? 55.0f : 62.0f;
    }

    float chargeRate = maxCharge / 2.0f;

    if (isSideView)
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateSpinBoost, Sonic.StateID.StateDropDash);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateSpinBoost, Tails.StateID.StateDropDash);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateSpinBoost, Knuckles.StateID.StateDropDash);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateSpinBoost, Amy.StateID.StateDropDash);
    }
    else
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StateSpinBoost, Sonic.StateID.StateDriftDash);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateSpinBoost, Tails.StateID.StateDriftDash);
        Player.State.Redirect<Knuckles.StateID>(Knuckles.StateID.StateSpinBoost, Knuckles.StateID.StateDriftDash);
        Player.State.Redirect<Amy.StateID>(Amy.StateID.StateSpinBoost, Amy.StateID.StateDriftDash);
    }

    if (currentState == Sonic.StateID.StateSpinBoostCharge)
    {
        if (!isGrounded)
        {
            wasAerialCharge = true;

            if (!Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateFall);
                chargeCount = 0.0f;
                wasAerialCharge = false;
            }
            else
            {
                chargeCount = IS_WORLD_FLAG(IsCyberSpace) ? maxChargeDropDash : maxChargeDropDashOpenZone;
            }
        }
        else
        {
            wasAerialCharge = false;

            if (conLegacySpinDash == 1)
            {
                if (Player.Input.IsPressed(Player.InputActionType.PlayerSonicboom))
                {
                    chargeCount = Math.Min(chargeCount + 0.75f, maxCharge);
                }
            }
            else if (conLegacySpinDash == 2)
            {
                if (!isPaused)
                {
                    chargeCount += deltaTime * chargeRate;
                    chargeCount = Math.Min(chargeCount, maxCharge);
                }
            }
        }
    }

    bool justReleasedCharge = (previousState == Sonic.StateID.StateSpinBoostCharge &&
                              currentState == Sonic.StateID.StateSpinBoost) ||
                              (currentState == Sonic.StateID.StateSpinBoost &&
                              previousState != Sonic.StateID.StateSpinBoostCharge && wasAerialCharge);

    if (justReleasedCharge)
    {
        var kinematics = Player.Kinematics.Get();

        if (kinematics != null)
        {
            float speedMultiplier = isSideView ? 0.75f : 1.0f;

            float activeCap = wasAerialCharge ? releaseSpeedCap : groundReleaseSpeedCap;

            float addedSpeed = chargeCount * chargeSpeedMultiplier * speedMultiplier;
            addedSpeed = Math.Min(addedSpeed, activeCap);

            kinematics->Velocity += Player.Kinematics.GetForward() * addedSpeed;

            // Final Spin Dash / Drop Dash speed cap
            float finalSpeedCap;

            if (isSideView)
            {
                if (IS_WORLD_FLAG(IsCyberSpace))
                {
                    finalSpeedCap = wasAerialCharge ? 58.0f : 64.0f;
                }
                else
                {
                    finalSpeedCap = wasAerialCharge ? 60.0f : 70.0f;
                }
            }
            else
            {
                if (IS_WORLD_FLAG(IsCyberSpace))
                {
                    finalSpeedCap = wasAerialCharge ? 70.0f : 90.0f;
                }
                else
                {
                    finalSpeedCap = wasAerialCharge ? 80.0f : 120.0f;
                }
            }

            Vector3 horizontalVelocity = new Vector3(kinematics->Velocity.X, 0.0f, kinematics->Velocity.Z);

            float finalSpeed = horizontalVelocity.Length();

            if (finalSpeed > finalSpeedCap)
            {
                float scale = finalSpeedCap / finalSpeed;

                kinematics->Velocity.X *= scale;
                kinematics->Velocity.Z *= scale;
            }
        }

        chargeCount = 0.0f;
        wasAerialCharge = false;
    }

    if (currentState == Sonic.StateID.StateSquat &&
        Player.Input.IsPressed(Player.InputActionType.PlayerSonicboom))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);
    }

    if (previousState == Sonic.StateID.StateSpinBoost &&
        currentState != Sonic.StateID.StateSpinBoost)
    {
        wasAerialCharge = false;
    }

    if (isSideView && speed > 170.0f)
    {
        var kinematics = Player.Kinematics.Get();

        // 0.94 per frame at 60 FPS, scaled so the cap holds at any frame rate
        if (kinematics != null)
            kinematics->Velocity *= (float)Math.Pow(0.94f, deltaTime * 60.0f);
    }
}

Code "Spin Dash on Walls" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "INI"
#lib "HMM"
#lib "BlackboardStatus"

static bool isConfigInitialized = false;

static int conWallDashAbility = 0;
static int conLegacySpinDash = 0;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conWallDashAbility = INI.GetField<int>(ini, "Main", "WallDashAbility", conWallDashAbility);
            conLegacySpinDash = INI.GetField<int>(ini, "Main", "LegacySpinDash", conLegacySpinDash);
            isConfigInitialized = true;
        }
    }

    if (conWallDashAbility != 1 || conLegacySpinDash == 3)
        return;

    var currentPlayerType = Player.GetPlayerType();

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    float speed = Player.Kinematics.GetHorizontalMagnitude();

    var currentKnuxState = Player.State.GetCurrentStateID<Knuckles.StateID>();

    // Sonic
    if (currentPlayerType == Player.PlayerType.Sonic)
    {
        if (IS_STATE_FLAG(IsWallClimbIdle) &&
            Player.Input.IsDown(Player.InputActionType.PlayerStomping) &&
            Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
        {
            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSpinBoostCharge);
        }
    }

    // Knuckles
    if (currentPlayerType == Player.PlayerType.Knuckles)
    {
        if (speed < 1.0f &&
            currentKnuxState == Knuckles.StateID.KnucklesStateWallMove &&
            Player.Input.IsDown(Player.InputActionType.PlayerStomping) &&
            Player.Input.IsDown(Player.InputActionType.PlayerSonicboom))
        {
            Player.State.SetState<Knuckles.StateID>(Knuckles.StateID.StateSpinBoostCharge);
        }
    }
}

Code "Sweepkick" by "Batman Sonic"
//

#include "BlackboardStatus" noemit
#include "Reflection" noemit

#lib "Player"
#lib "Reflection"
#lib "BlackboardStatus"
#lib "Time"
#lib "GameManager"
#lib "HMM"
#lib "INI"
#lib "SonicParameters"
#lib "Lua"

static bool isSweepKickActive = false;
static bool isSweepKickEffectPlayed = false;
static bool isSweepKickVoicePlayed = false;

static float sweepKickTimer = 0.0f;
static float cooldownTimer = 0.0f;
static float effectTimer = 0.0f;
static float sweepKickDuration = 0.0f;

static bool isFirstTap = false;
static float doubleTapTimer = 0.0f;
static bool lastFramePressed = false;

static bool wasStartedFromSquat = false;
static bool isPursuitKickRedirected = false;
static bool hasSweepDamage = false;
static float squatHoldTimer = 0.0f;

const float squatHoldDuration = 1.0f;
const float sweepDurationDefault = 1.0f;
const float sweepDurationFromSquat = 1.2f;
const float cooldownDelay = 0.5f;
const float effectDuration = 0.4f;
const float doubleTapWindow = 0.3f;

static bool isConfigInitialized = false;
static int conSweepkickAbility = 0;
static bool conSweepkickSound = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conSweepkickAbility = INI.GetField<int>(ini, "Main", "SweepkickAbility", conSweepkickAbility);
            conSweepkickSound = INI.GetField<bool>(ini, "Main", "SweepkickSound", conSweepkickSound);
            isConfigInitialized = true;
        }
    }

    if (conSweepkickAbility == 0)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();
    var kinematics = Player.Kinematics.Get();
    var SonicParametersInfo = Reflection.GetDataInfo<SonicParameters.Root>("player_common");

    if (kinematics == null)
        return;

    float speed = Player.Kinematics.GetHorizontalMagnitude();
    float deltaTime = Time.GetDeltaTime();

    bool isDiving = IS_STATE_FLAG(IsDiving);
    bool isGrinding = IS_STATE_FLAG(IsGrind);
    bool isDamaged = IS_WORLD_FLAG(IsDamagedOrRepelled);
    bool isOutOfControl = IS_WORLD_FLAG(IsOutOfControl);
    bool isDivingBoost = IS_STATE_FLAG(IsDivingBoost);
    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);

    bool isInBlockingState = currentState == Sonic.StateID.StateJumpBoardLaunch ||
                             currentState == Sonic.StateID.StateHomingAttack ||
                             currentState == Sonic.StateID.StateStompingDown ||
                             currentState == Sonic.StateID.StateSpinBoostCharge ||
                             currentState == Sonic.StateID.StateStorm ||
                             currentState == Sonic.StateID.StateCaught ||
                             currentState == Sonic.StateID.StateHangPole ||
                             currentState == Sonic.StateID.StateAvoid ||
                             currentState == Sonic.StateID.StateParry ||
                             currentState == Sonic.StateID.StateParryStand ||
                             currentState == Sonic.StateID.StateAirBoost ||
                             currentState == Sonic.StateID.StateHomingFinished ||
                             currentState == Sonic.StateID.StateSpringJump;

    // Cancel sweepkick
    if ((isDamaged || isInBlockingState ||
        (previousState == Sonic.StateID.StatePursuitKick && currentState != Sonic.StateID.StatePursuitKick)) &&
        isSweepKickActive)
    {
        isSweepKickActive = false;
        Player.Effect.StopEffect("SweepkickEffect");
        isSweepKickEffectPlayed = false;
        wasStartedFromSquat = false;
        squatHoldTimer = 0.0f;
    }

    if (previousState == Sonic.StateID.StatePursuitKick &&
        currentState == Sonic.StateID.StateRun &&
        Player.Input.IsDown(Player.InputActionType.PlayerStomping))
    {
        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSliding);
    }

    bool isStompingPressed = Player.Input.IsPressed(Player.InputActionType.PlayerStomping);
    bool isStompingJustPressed = isStompingPressed && !lastFramePressed;

    bool isTimerActive = doubleTapTimer > 0.0f || cooldownTimer > 0.0f || isSweepKickActive || isSweepKickEffectPlayed;

    if (isTimerActive)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            if (doubleTapTimer > 0.0f)
                doubleTapTimer -= deltaTime;

            if (cooldownTimer > 0.0f)
                cooldownTimer -= deltaTime;

            if (isSweepKickActive)
                sweepKickTimer += deltaTime;

            if (isSweepKickEffectPlayed)
                effectTimer += deltaTime;

            if (isSweepKickActive && wasStartedFromSquat && Player.Input.IsDown(Player.InputActionType.PlayerStomping))
            {
                squatHoldTimer += deltaTime;
            }
        }
    }

    bool isDoubleTap = false;

    if (isStompingJustPressed && cooldownTimer <= 0.0f && !isSweepKickActive &&
        !isDiving && !isGrinding && !isDamaged && !isOutOfControl && !isDivingBoost &&
        !isAutoRun && !isInBlockingState &&
        (currentState == Sonic.StateID.StateSquat || currentState == Sonic.StateID.StateSliding || currentState == Sonic.StateID.StateRun))
    {
        if (!isFirstTap)
        {
            isFirstTap = true;
            doubleTapTimer = doubleTapWindow;
        }
        else if (doubleTapTimer > 0.0f)
        {
            isDoubleTap = true;
            isFirstTap = false;
            doubleTapTimer = 0.0f;
        }
    }

    if (isFirstTap && doubleTapTimer <= 0.0f)
        isFirstTap = false;

    if (isDoubleTap)
    {
        wasStartedFromSquat = currentState == Sonic.StateID.StateSquat;

        if (currentState == Sonic.StateID.StateSquat || speed < 7.0f)
            sweepKickDuration = sweepDurationFromSquat;
        else
            sweepKickDuration = sweepDurationDefault;

        isSweepKickActive = true;
        sweepKickTimer = 0.0f;
        cooldownTimer = cooldownDelay;
        squatHoldTimer = 0.0f;

        Player.State.SetState<Sonic.StateID>(Sonic.StateID.StatePursuitKick);
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StatePursuitKick, (currentState == Sonic.StateID.StateSquat) ? Sonic.StateID.StateSleep : Sonic.StateID.StateSliding);
        isPursuitKickRedirected = true;

        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 2.0f);
        Player.Collision.SetEntityCollision(false);
        hasSweepDamage = true;

        if (!isSweepKickEffectPlayed)
        {
            Player.Effect.PlayEffect("SweepkickEffect", "ef_so_cyloop_slash_hit01");
            isSweepKickEffectPlayed = true;
            effectTimer = 0.0f;
        }

        if (conSweepkickSound)
            Player.Sound.PlaySound("sn_tornade");
        else
            Player.Sound.PlaySound("sn_finish_attack1");

        Player.Animation.SetAnimation("SQUAT_KICK");
    }

    if (isSweepKickActive && currentState == Sonic.StateID.StatePursuitKick && !isSweepKickVoicePlayed)
    {
        Lua.Call("PlayVoice", "sa1014_2");
        isSweepKickVoicePlayed = true;
    }
    else if (!isSweepKickActive)
    {
        isSweepKickVoicePlayed = false;
    }

    if (isSweepKickActive)
    {
        if (wasStartedFromSquat &&
            squatHoldTimer >= squatHoldDuration)
        {
            isSweepKickActive = false;
            wasStartedFromSquat = false;
            squatHoldTimer = 0.0f;

            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSquat);
            Player.Effect.StopEffect("SweepkickEffect");
            isSweepKickEffectPlayed = false;
        }
        else if (Player.Input.IsDown(Player.InputActionType.PlayerJump))
        {
            isSweepKickActive = false;
            wasStartedFromSquat = false;
            squatHoldTimer = 0.0f;

            Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateStandRoot);
            Player.Effect.StopEffect("SweepkickEffect");
            isSweepKickEffectPlayed = false;
        }
        else if (sweepKickTimer >= sweepKickDuration)
        {
            if (!wasStartedFromSquat &&
                Player.Input.IsDown(Player.InputActionType.PlayerStomping))
            {
                isSweepKickActive = false;
                wasStartedFromSquat = false;
                squatHoldTimer = 0.0f;

                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateRun);
                Player.Effect.StopEffect("SweepkickEffect");
                isSweepKickEffectPlayed = false;
            }
            else
            {
                Player.State.SetState<Sonic.StateID>(Sonic.StateID.StateSlidingToStand);
                isSweepKickActive = false;
                wasStartedFromSquat = false;
                squatHoldTimer = 0.0f;
            }
        }
    }

    if (isSweepKickEffectPlayed && effectTimer >= effectDuration)
    {
        Player.Effect.StopEffect("SweepkickEffect");
        isSweepKickEffectPlayed = false;
    }

    lastFramePressed = isStompingPressed;

    // Other mods use StatePursuitKick too, so hand it back its own behaviour once the sweepkick is over
    if (isPursuitKickRedirected && !isSweepKickActive && currentState != Sonic.StateID.StatePursuitKick)
    {
        Player.State.Redirect<Sonic.StateID>(Sonic.StateID.StatePursuitKick, Sonic.StateID.StatePursuitKick);
        isPursuitKickRedirected = false;
    }

    if (hasSweepDamage && !isSweepKickActive)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        hasSweepDamage = false;
    }

    bool isSweeping = currentState == Sonic.StateID.StatePursuitKick && isSweepKickActive;

    if (SonicParametersInfo.pData != null)
    {
        if (isSweeping)
        {
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.minSpeed, 5.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.endSpeed, 0.5f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.minContinueTime, 0.75f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.baseRotateForce, 1000.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.baseRotateForceSpeed, 1000.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.gravitySize, 0.0f);
        }
        else if (currentState != Sonic.StateID.StateSliding)
        {
            // Same values as Slide Tweaks, so the next slide starts on them instead of the vanilla ones
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.minSpeed, 25.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.endSpeed, 5.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.minContinueTime, 0.2f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.baseRotateForce, 250.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.baseRotateForceSpeed, 15.0f);
            RFL_SET_CONTEXTUAL_PLAYER_PARAM(SonicParametersInfo, modePackage.sliding.gravitySize, 60.0f);
        }
    }
}

Code "Disable Wrench Attack Skill [EXPERIMENTAL]" by "Batman Sonic"
//

#include "SaveData" noemit

#lib "Player"
#lib "INI"
#lib "HMM"

static bool isConfigInitialized = false;
static bool conTailsSpannerStop = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conTailsSpannerStop = INI.GetField<bool>(ini, "Main", "TailsSpannerStop", conTailsSpannerStop);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    SAVE_SET_PARAM(extraCharacters.characters[2].skillLevel[5], (byte)(conTailsSpannerStop ? 0 : 1));
}

Code "Tail Swipe" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "BlackboardStatus"
#lib "Time"
#lib "GameManager"
#lib "HMM"
#lib "INI"
#lib "Lua"
#lib "TailsSwipeShared"

// Ground swipe state
static bool isTailSwipeActive = false;
static bool animationSet = false;
static bool effectPlayed = false;
static bool singleSwipe = false;

static float tailSwipeTimer = 0.0f;
static float cooldownTimer = 0.0f;
static float effectTimer = 0.0f;
static float rhythmAnimTimer = 0.0f;
static float holdTimer = 0.0f;

// Aerial swipe state
static bool isAerialSwipeActive = false;
static bool aerialEffectPlayed = false;
static bool isInLoopKickRecovery = false;
static bool loopKickSpringAnimPlayed = false;

static float aerialCooldownTimer = 0.0f;
static float aerialEffectTimer = 0.0f;
static float aerialAttackTimer = 0.0f;
static float loopKickRecoveryTimer = 0.0f;

static float spinAttackDelayTimer = 0.0f;
static bool spinAttackRedirect = false;

static bool hasEnteredSwipeState = false;

static List<Tails.StateID> tailSwipeStates = new()
{
    Tails.StateID.StateAcceleCombo1,
    Tails.StateID.StateAcceleCombo2,
    Tails.StateID.StateSpinAttack,
    Tails.StateID.StatePursuitKick
};

const float swipeDuration = 0.35f;
const float cooldownDelay = 0.5f;
const float aerialCooldownDelay = 0.5f;
const float aerialAttackDuration = 0.3f;
const float effectDuration = 1.0f;
const float holdDurationForRhythm = 0.35f;
const float loopKickSpringDuration = 0.5f;

static bool isConfigInitialized = false;
static int conTailSwipeAbility = 0;
static int conTailsHoming = 0;

static List<string> tailSwipeVoices = new List<string> { "sa1002", "sa1005", "sa1007", "sa1009", "sa1024", "sa1033", "sa1038" };
static Random random = new Random();

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conTailSwipeAbility = INI.GetField<int>(ini, "Main", "TailSwipeAbility", conTailSwipeAbility);
            conTailsHoming = INI.GetField<int>(ini, "Main", "TailsHoming", conTailsHoming);
            isConfigInitialized = true;
        }
    }

    if (conTailSwipeAbility == 2)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    var previousState = Player.State.GetPreviousStateID<Tails.StateID>();
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null)
        return;

    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateAcceleCombo1, Tails.StateID.StateBounceJump);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StateAcceleCombo2, Tails.StateID.StateRun);
    Player.State.Redirect<Tails.StateID>(Tails.StateID.StatePursuitKick, Tails.StateID.StateBounceJump);

    bool isIdle = IS_STATE_FLAG(IsIdle);
    bool isDiving = IS_STATE_FLAG(IsDiving);
    bool isGrind = IS_STATE_FLAG(IsGrind);
    bool isDamage = IS_WORLD_FLAG(IsDamagedOrRepelled);
    bool isOutOfControl = IS_WORLD_FLAG(IsOutOfControl);
    bool isDivingBoost = IS_STATE_FLAG(IsDivingBoost);
    bool isAutoRun = IS_WORLD_FLAG(IsAutoRun);

    if (currentState == Tails.StateID.StateSpinAttack && previousState == Tails.StateID.StateAcceleCombo1)
    {
        bool isSpinAttackPaused = GameManager.GetGameObject("MainMenu") != null ||
                                  GameManager.GetGameObject("MapMenu") != null ||
                                  GameManager.GetGameObject("PhotoMode") != null;

        if (!isSpinAttackPaused)
            spinAttackDelayTimer += Time.GetDeltaTime();

        if (!spinAttackRedirect && spinAttackDelayTimer >= 0.1f)
        {
            spinAttackRedirect = true;
            Player.State.SetState<Tails.StateID>(Tails.StateID.StatePursuitKick);
        }
    }
    else if (currentState != Tails.StateID.StateSpinAttack)
    {
        spinAttackDelayTimer = 0.0f;
        spinAttackRedirect = false;
    }

    bool isInBlockingState = currentState == Tails.StateID.StateJumpBoardLaunch ||
                             currentState == Tails.StateID.StateHomingAttack ||
                             currentState == Tails.StateID.TailsStateStompingDown ||
                             currentState == Tails.StateID.StateSpinBoostCharge ||
                             currentState == Tails.StateID.StateStorm ||
                             currentState == Tails.StateID.StateCaught ||
                             currentState == Tails.StateID.StateHangPole ||
                             currentState == Tails.StateID.StateAvoid ||
                             currentState == Tails.StateID.StateParry ||
                             currentState == Tails.StateID.StateParryStand ||
                             currentState == Tails.StateID.StateAirBoost ||
                             currentState == Tails.StateID.StateHomingFinished ||
                             (conTailsHoming == 1 && Player.Status.IsLockOnCursorVisible());

    bool isSwipeActive = isTailSwipeActive || isAerialSwipeActive;
    bool isInSwipeState = tailSwipeStates.Contains(currentState);

    if (!isSwipeActive)
        hasEnteredSwipeState = false;
    else if (isInSwipeState)
        hasEnteredSwipeState = true;

    // Only counted once Tails has reached a swipe state, otherwise the frame before SetState lands would cancel the swipe it just started
    bool hasLeftSwipeState = hasEnteredSwipeState && !isInSwipeState;

    if (isSwipeActive && (isDamage || isInBlockingState || hasLeftSwipeState))
    {
        isTailSwipeActive = false;
        isAerialSwipeActive = false;
        hasEnteredSwipeState = false;
        animationSet = false;
        tailSwipeTimer = 0.0f;
        aerialAttackTimer = 0.0f;
        holdTimer = 0.0f;
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);

        for (int i = 0; i < 5; i++)
            Player.Effect.StopEffect("TailSwipeEffect");

        effectPlayed = false;
        aerialEffectPlayed = false;
    }

    bool needsPauseCheck = isTailSwipeActive || isAerialSwipeActive || isInLoopKickRecovery ||
                           cooldownTimer > 0.0f || aerialCooldownTimer > 0.0f || effectPlayed || aerialEffectPlayed;

    if (needsPauseCheck)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
        {
            if (isTailSwipeActive)
            {
                tailSwipeTimer += Time.GetDeltaTime();
                rhythmAnimTimer -= Time.GetDeltaTime();
                if (singleSwipe && !isIdle && Player.Input.IsDown(Player.InputActionType.PlayerAttack))
                    holdTimer += Time.GetDeltaTime();
            }

            if (isAerialSwipeActive)
            {
                aerialAttackTimer += Time.GetDeltaTime();
            }

            if (isInLoopKickRecovery)
                loopKickRecoveryTimer += Time.GetDeltaTime();

            if (cooldownTimer > 0.0f)
                cooldownTimer -= Time.GetDeltaTime();

            if (aerialCooldownTimer > 0.0f)
                aerialCooldownTimer -= Time.GetDeltaTime();

            if (effectPlayed && !isTailSwipeActive)
            {
                effectTimer += Time.GetDeltaTime();
                if (effectTimer >= effectDuration)
                {
                    for (int i = 0; i < 5; i++)
                        Player.Effect.StopEffect("TailSwipeEffect");
                    effectPlayed = false;
                    effectTimer = 0.0f;
                }
            }

            if (aerialEffectPlayed && !isAerialSwipeActive)
            {
                aerialEffectTimer += Time.GetDeltaTime();
                if (aerialEffectTimer >= effectDuration)
                {
                    for (int i = 0; i < 5; i++)
                        Player.Effect.StopEffect("TailSwipeEffect");
                    aerialEffectPlayed = false;
                    aerialEffectTimer = 0.0f;
                }
            }
        }
    }

    if (Player.Input.IsPressed(Player.InputActionType.PlayerAttack) &&
        cooldownTimer <= 0.0f && Player.Status.IsGrounded() &&
        !isTailSwipeActive && !isAerialSwipeActive && !isDiving &&
        !isGrind && !isDamage && !isOutOfControl &&
        !isDivingBoost && !isAutoRun && !isInBlockingState)
    {
        isTailSwipeActive = true;
        singleSwipe = true;
        tailSwipeTimer = 0.0f;
        holdTimer = 0.0f;
        cooldownTimer = cooldownDelay;
        animationSet = false;
        effectPlayed = false;
        effectTimer = 0.0f;
        rhythmAnimTimer = 0.5f;

        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 2.0f);
        Player.Collision.SetEntityCollision(false);
        Player.Sound.PlaySound("sn_skateboard_trick");
        Lua.Call("PlayVoice", "sa1038");

        Player.State.SetState<Tails.StateID>(Tails.StateID.StateAcceleCombo1);
        Player.State.Redirect<Tails.StateID>(Tails.StateID.StateAcceleCombo1, isIdle ? Tails.StateID.StateSleep : Tails.StateID.StateRun);
    }

    // Aerial Tail Swipe
    if (Player.Input.IsPressed(Player.InputActionType.PlayerAttack) &&
        aerialCooldownTimer <= 0.0f &&
        !Player.Status.IsGrounded() &&
        !isTailSwipeActive &&
        !isAerialSwipeActive &&
        !isGrind &&
        !isDiving &&
        !isDamage &&
        !isOutOfControl &&
        !isDivingBoost &&
        !isAutoRun &&
        !isInBlockingState)
    {
        isAerialSwipeActive = true;
        aerialCooldownTimer = aerialCooldownDelay;
        aerialAttackTimer = 0.0f;
        aerialEffectPlayed = false;
        aerialEffectTimer = 0.0f;
        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 2.0f);
        Player.Collision.SetEntityCollision(false);
        Player.Sound.PlaySound("sn_skateboard_trick");
        Lua.Call("PlayVoice", tailSwipeVoices[random.Next(tailSwipeVoices.Count)]);
        Player.State.SetState<Tails.StateID>(Tails.StateID.StateAcceleCombo1);
    }

    // Ground Tail Swipe
    if (isTailSwipeActive)
    {
        bool isHolding = Player.Input.IsDown(Player.InputActionType.PlayerAttack);
        bool canEnterRhythm = !isIdle;

        if (holdTimer >= holdDurationForRhythm && singleSwipe && Player.Status.IsGrounded() && canEnterRhythm)
        {
            singleSwipe = false;
            Player.State.SetState<Tails.StateID>(Tails.StateID.StateAcceleCombo2);
            animationSet = false;
            rhythmAnimTimer = swipeDuration;
        }

        if (rhythmAnimTimer <= 0.0f && !singleSwipe)
        {
            Player.Animation.SetAnimation("ATK_TAIL_ROLL_SPIN");
            Player.Sound.PlaySound("sn_skateboard_trick");
            effectPlayed = false;
            animationSet = true;
            rhythmAnimTimer = swipeDuration;
        }

        if (!animationSet)
        {
            Player.Animation.SetAnimation(singleSwipe ? "ATK_TAIL_ROLL" : "ATK_TAIL_ROLL_SPIN");
            animationSet = true;
        }

        if (!effectPlayed)
        {
            for (int i = 0; i < 5; i++)
                Player.Effect.PlayEffect("TailSwipeEffect", "ec_so_skill_airtrick01_pose01_spiral01");
            effectPlayed = true;
        }

        // End the swipe, or restart it if the button is still held while moving
        if (tailSwipeTimer >= swipeDuration)
        {
            if (isHolding && Player.Status.IsGrounded() && canEnterRhythm)
            {
                tailSwipeTimer = 0.0f;
                animationSet = false;
                effectPlayed = false;
                rhythmAnimTimer = swipeDuration;
            }
            else
            {
                isTailSwipeActive = false;
                animationSet = false;
                Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
                Player.Collision.SetEntityCollision(true);
                Player.State.SetState<Tails.StateID>(Tails.StateID.StateSlidingToStand);
            }
        }
    }

    if (isAerialSwipeActive)
    {
        if (!Player.Status.IsGrounded())
        {
            Player.Animation.SetAnimation("ATK_TAIL_ROLL_AIR");
            Player.Effect.StopAnimationEffects();
        }

        if (!aerialEffectPlayed)
        {
            for (int i = 0; i < 5; i++)
                Player.Effect.PlayEffect("TailSwipeEffect", "ec_so_skill_airtrick01_pose01_spiral01");
            aerialEffectPlayed = true;
        }

        if (aerialAttackTimer >= aerialAttackDuration || Player.Status.IsGrounded())
        {
            isAerialSwipeActive = false;
            aerialAttackTimer = 0.0f;
            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);
        }
    }

    // The swipe redirects into StateRun, so run/boost animation codes would otherwise stomp on it
    TailsSwipeShared.IsGroundSwipeActive = isTailSwipeActive;

    // Tail Swipe Recovery
    if (currentState == Tails.StateID.StatePursuitKick)
    {
        if (!isInLoopKickRecovery)
        {
            Player.Effect.StopAnimationEffects();
            isInLoopKickRecovery = true;
            loopKickSpringAnimPlayed = false;
            Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
            Player.Collision.SetEntityCollision(true);

            if (isAerialSwipeActive)
            {
                isAerialSwipeActive = false;
                aerialAttackTimer = 0.0f;
            }
        }

        if (loopKickRecoveryTimer < loopKickSpringDuration)
        {
            if (!loopKickSpringAnimPlayed)
            {
                Player.Animation.SetAnimation("JUMP_START_LOOP");
                Player.Effect.StopAnimationEffects();
                loopKickSpringAnimPlayed = true;
            }
        }
        else
        {
            Player.Animation.SetAnimation("FALL");
            Player.Effect.StopAnimationEffects();
        }
    }
    else if (isInLoopKickRecovery)
    {
        loopKickRecoveryTimer = 0.0f;
        isInLoopKickRecovery = false;
        loopKickSpringAnimPlayed = false;
    }
}

Code "Cyber Corruption Additions" by "Batman Sonic, AggroNova"
//

#include "BlackboardStatus" noemit

#lib "BlackboardStatus"
#lib "Player"
#lib "Time"
#lib "GameManager"
#lib "HMM"
#lib "CyberCorruption"

static bool hasCheckedDisableCorruptionAnimations = false;
static bool isDisableCorruptionAnimationsEnabled = false;

static bool isCorruptedRun = false;
static float idleTimer = 0.0f;

{
    if (!hasCheckedDisableCorruptionAnimations)
    {
        var codes = HMM.GetCodes();
        isDisableCorruptionAnimationsEnabled = codes.Contains("Animation/Sonic/Disable Corruption Animations");
        hasCheckedDisableCorruptionAnimations = true;
    }

    CyberCorruption.Update();

    if (Player.GetPlayerType() != Player.PlayerType.Sonic || BlackboardStatus.IsSuper())
        return;

    int corruptionLevel = CyberCorruption.Level;

    if (corruptionLevel == 0 || IS_WORLD_FLAG(IsAutoRun) || isDisableCorruptionAnimationsEnabled)
    {
        isCorruptedRun = false;
        idleTimer = 0.0f;
        return;
    }

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    string runAnim = corruptionLevel == 2 ? "RUNNING_CORRUPTION_STRONG" : "RUNNING_CORRUPTION_WEAK";
    string idleAnim = corruptionLevel == 2 ? "IDLE_ACT_CORRUPTION_STRONG" : "IDLE_ACT_CORRUPTION_WEAK";

    if (currentState == Sonic.StateID.StateRun)
    {
        if (!isCorruptedRun)
        {
            Player.Animation.SetAnimation(runAnim);
            isCorruptedRun = true;
        }
    }
    else
    {
        isCorruptedRun = false;
    }

    if (currentState == Sonic.StateID.StateStandRoot)
    {
        bool isPaused = GameManager.GetGameObject("MainMenu") != null ||
                        GameManager.GetGameObject("MapMenu") != null ||
                        GameManager.GetGameObject("PhotoMode") != null;

        if (!isPaused)
            idleTimer += Time.GetDeltaTime();

        if (idleTimer >= 10.06f)
        {
            Player.Animation.SetAnimation(idleAnim);

            // Starting below zero waits out the idle act before the next one can begin
            idleTimer = corruptionLevel == 2 ? -11.02f : -12.02f;
        }
    }
    else
    {
        idleTimer = 0.0f;
    }
}

Code "Rocket Boost Animation" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "HMM"
#lib "INI"
#lib "BlackboardStatus"
#lib "CyberCorruption"

static bool isBoostAnimation = false;
static bool hasDamageSphere = false;
static string currentAnim = "";

static bool isConfigInitialized = false;
static int conCyberSpaceRun = 3;

const float topSpeedThreshold = 80.0f;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conCyberSpaceRun = INI.GetField<int>(ini, "Main", "CyberSpaceRun", conCyberSpaceRun);
            isConfigInitialized = true;
        }
    }

    CyberCorruption.Update();

    var kinematics = Player.Kinematics.Get();

    if (kinematics == null || Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    float speed = Player.Kinematics.GetHorizontalMagnitude();

    bool inCyberSpace = IS_WORLD_FLAG(IsCyberSpace);
    bool isBattle = IS_WORLD_FLAG(IsBattle);
    bool isNitroBoost = IS_WORLD_FLAG(IsNitroBoost);

    bool topSpeed = speed >= topSpeedThreshold && !inCyberSpace;
    bool isCyberCorrupted = CyberCorruption.Level != 0;

    bool shouldPlayTopSpeedAnimation = topSpeed && conCyberSpaceRun == 3 && !isCyberCorrupted;

    void SetAnim(string animName)
    {
        if (animName != currentAnim)
        {
            Player.Animation.SetAnimation(animName);
            currentAnim = animName;
        }
    }

    if (currentState == Sonic.StateID.StateRun)
    {
        if (isNitroBoost || shouldPlayTopSpeedAnimation)
        {
            SetAnim("NITRO_BOOST");
            isBoostAnimation = true;
        }
        else if (isBoostAnimation)
        {
            if (isBattle && conCyberSpaceRun == 3)
            {
                SetAnim("RUNNING_BATTLE");
            }
            else if (!isBattle)
            {
                SetAnim("RUNNING");
            }

            isBoostAnimation = false;
        }
    }
    else
    {
        isBoostAnimation = false;
        currentAnim = "";
    }

    // The sphere is independent from the animation, and while boosting Boost Damage Collision is the one handing it back
    if (currentState == Sonic.StateID.StateRun && topSpeed)
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Damage, 1.0f);
        Player.Collision.SetEntityCollision(false);
        hasDamageSphere = true;
    }
    else if (hasDamageSphere && !IS_STATE_FLAG(IsBoost))
    {
        Player.Collision.SetCollisionSphere(Player.CollisionType.Default, 1.0f);
        Player.Collision.SetEntityCollision(true);
        hasDamageSphere = false;
    }
}

Code "Tails Boost at Top Speed" by "Batman Sonic"
//

#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "Memory"
#lib "TailsSwipeShared"

#import "GOComponents"

#load "System.Numerics.dll"
using System;
using System.Numerics;

static Quaternion previousBoostRotation = Quaternion.Identity;
static bool hasPrevBoostRotation = false;
static float currentLeanAngle = 0.0f;

const float leanSpeed = 180.0f;
const float maxLeanAngle = 120.0f;
const float leanThreshold = 90.0f;

{
    var kinematics = Player.Kinematics.Get();

    if (kinematics == null || Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    if (IS_WORLD_FLAG(IsCyberSpace))
        return;

    if (!Memory.TryGetPointer<GOCPlayerKinematicParams>(kinematics, out var out_pKinematics))
        return;

    float deltaTime = Time.GetDeltaTime();
    float speed = Player.Kinematics.GetHorizontalMagnitude();

    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    bool isUnderwater = Player.Status.IsUnderwater();

    var currentRotation = out_pKinematics->Rotation;

    if (!hasPrevBoostRotation)
    {
        previousBoostRotation = currentRotation;
        hasPrevBoostRotation = true;
    }

    var deltaRot = Quaternion.Concatenate(Quaternion.Inverse(previousBoostRotation), currentRotation);

    float yawDelta = 2.0f * (float)Math.Atan2(deltaRot.Y, deltaRot.W);
    float yawSpeedDeg = (yawDelta / Math.Max(deltaTime, 0.0001f)) * (180.0f / (float)Math.PI);

    float targetLean = Math.Max(-maxLeanAngle, Math.Min(yawSpeedDeg, maxLeanAngle));
    float leanStep = leanSpeed * deltaTime;

    if (currentLeanAngle < targetLean)
        currentLeanAngle = Math.Min(currentLeanAngle + leanStep, targetLean);
    else
        currentLeanAngle = Math.Max(currentLeanAngle - leanStep, targetLean);

    previousBoostRotation = currentRotation;

    // Lean tracking above keeps running so there's no lean spike once the swipe ends
    if (TailsSwipeShared.IsGroundSwipeActive)
        return;

    string TurnVariant(string baseName)
    {
        if (currentLeanAngle > leanThreshold)
            return baseName + "_L";

        if (currentLeanAngle < -leanThreshold)
            return baseName + "_R";

        return baseName;
    }

    if (isUnderwater && currentState == Tails.StateID.StateRun)
    {
        Player.Animation.SetAnimation(TurnVariant("TAILS_BOOST_SWIM"));
    }

    if (!isUnderwater && currentState == Tails.StateID.StateRun)
    {
        if (speed >= 42.0f)
        {
            Player.Animation.SetAnimation("TAILS_BOOST");
        }
        else
        {
            Player.Animation.SetAnimation(IS_WORLD_FLAG(IsBattle) ? "TAILS_RUN_BATTLE" : "TAILS_RUN");
        }
    }
}

Code "Flying Sound in Running" by "Batman Sonic"
//

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Tails"
#lib "INI"
#lib "HMM"

#import "States"

#load "System.Numerics.dll"
using System.Numerics;

static bool isTailSpin = false;
static int soundHandle = 0;
static bool isConfigInitialized = false;
static bool conTailsSpinRunStop = false;

{
    if (!isConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");

        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conTailsSpinRunStop = INI.GetField<bool>(ini, "Main", "TailsSpinRunStop", conTailsSpinRunStop);
            isConfigInitialized = true;
        }
    }

    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    float speed = Player.Kinematics.GetHorizontalMagnitude();
    bool isUnderwater = Player.Status.IsUnderwater();

    bool shouldPlaySound = !conTailsSpinRunStop && currentState == Tails.StateID.StateRun && speed >= 14.0f && !isUnderwater;

    if (shouldPlaySound)
    {
        if (!isTailSpin)
        {
            soundHandle = Player.Sound.PlaySound("ta_fly_loop");
            isTailSpin = true;
        }
    }
    else if (isTailSpin)
    {
        fixed (int* pSoundHandle = &soundHandle)
        {
            Player.Sound.StopSound(pSoundHandle);
        }

        soundHandle = 0;
        isTailSpin = false;
    }
}

