Code "Fix Knuckles and Amy Power Boost Fall State" by "Batman Sonic"
//

#lib "Player"

{
    bool isPowerBoostAir = Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.KnucklesStateDrillBoostAir ||
                           Player.State.GetCurrentStateID<Amy.StateID>() == Amy.StateID.AmyStateTarotBoostAir;

