Code "Shark Sandski Blow Grunt" by "Batman Sonic & SuperNova124"
//

#lib "Player"

// Static voice lists per character
static List<string> sonicSandskiBlow = new List<string> { "sa1027", "sa1049", "sa1050" };
static List<string> tailsSandskiBlow = new List<string> { "sa1026", "sa1027", "sa1028" };
static List<string> knucklesSandskiBlow = new List<string> { "sa1025", "sa1026", "sa1029" };
static List<string> amySandskiBlow = new List<string> { "sa1027", "sa1035" };

static Random random = new Random();

static bool isSandskiBlow = false;
static bool hasPlayedCollision = false;

{
    // Cache current state check
    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    // Sandski Blow state
    if (currentState == Sonic.StateID.StateSandSkiBlow)
    {
        // Play voice once per state entry
        if (!isSandskiBlow)
        {
            // Get voice list based on player type
            List<string> sandskiblow = null;
            switch (Player.GetPlayerType())
            {
                case Player.PlayerType.Sonic:
                    sandskiblow = sonicSandskiBlow;
                    break;
                case Player.PlayerType.Tails:
                    sandskiblow = tailsSandskiBlow;
                    break;
                case Player.PlayerType.Knuckles:
                    sandskiblow = knucklesSandskiBlow;
                    break;
                case Player.PlayerType.Amy:
                    sandskiblow = amySandskiBlow;
                    break;
                default:
                    sandskiblow = sonicSandskiBlow; // fallback to Sonic
                    break;
            }

            Lua.Call("PlayVoice", sandskiblow[random.Next(sandskiblow.Count)]);
            isSandskiBlow = true;
            hasPlayedCollision = false; // reset collision flag
        }

        // Play collision sound once when grounded
        if (Player.Status.IsGrounded() && !hasPlayedCollision)
        {
            Player.Sound.PlaySound("sn_collision");
            hasPlayedCollision = true;
        }
    }
    else
    {
        isSandskiBlow = false;
        hasPlayedCollision = false;
    }
}

Code "Forces-like Jump Ball Sound" by "Batman Sonic & SuperNova124"
//Makes the spin sound play when each character curls into a ball, like in Sonic Forces.

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "Knuckles"
#lib "Amy"
#lib "Time"
#lib "Lua"
#lib "HMM"
#lib "INI"
	
#load "System.Numerics.dll"

using System.Numerics;
using System.Collections.Generic;

static bool isJumpSpinBounceAttack = false;
static bool isSpinDashJump = false;
static bool isBoostWallJump = false;
static bool isAmyGrindDoubleJump = false;
static bool isSpinState = false;
static int spinDashJumpSoundHandle = -1;

static bool IsConfigInitialized = false;
static int conJumpSpinSound = 0;
static int conLegacySpinDash = 0;

// Spin States
static List<Sonic.StateID> _jumpSpinSoundStates = new()
{
    Sonic.StateID.StateQuickStepDoubleJump,
    Sonic.StateID.StateDriftDash,
    Sonic.StateID.StateDropDash,
    Sonic.StateID.StateSpin
};

if (!IsConfigInitialized)
{
    var modsQuery = HMM.FindModsByName("Quality of Life Additions");
	
    if (modsQuery.Count == 1)
    {
        string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
        var ini = INI.Read(modConfigIniPath);

        conJumpSpinSound = INI.Parse<int>(ini["Main"]["JumpSpinSound"], conJumpSpinSound);
        conLegacySpinDash = INI.Parse<int>(ini["Main"]["LegacySpinDash"], conLegacySpinDash);

        // StateSpinBoost is an extra addition for conJumpSpinSound == 2,
        // only when Legacy Spin Dash isn't set to 3.
        if (conLegacySpinDash != 3 && !_jumpSpinSoundStates.Contains(Sonic.StateID.StateSpinBoost))
        {
            _jumpSpinSoundStates.Add(Sonic.StateID.StateSpinBoost);
        }

        IsConfigInitialized = true;
    }
}

// Check if the spin sound should be enabled
if (conJumpSpinSound == 1 || conJumpSpinSound == 2)
{
    var currentPlayerType = Player.GetPlayerType();

    // Sonic, Tails and Knuckles
    if (currentPlayerType == Player.PlayerType.Sonic || 
        currentPlayerType == Player.PlayerType.Tails || 
        currentPlayerType == Player.PlayerType.Knuckles)
    {
        var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
        var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

        // StateBounceJump
        if (currentState == Sonic.StateID.StateBounceJump && previousState != Sonic.StateID.StateBounceJump)
        {
            if (!isJumpSpinBounceAttack)
            {
                Player.Sound.PlaySound("sn_spin");
                isJumpSpinBounceAttack = true;
            }
        }
        else if (currentState != Sonic.StateID.StateBounceJump)
        {
            isJumpSpinBounceAttack = false;
        }

        // StateJump transition from spin states
        if (currentState == Sonic.StateID.StateJump &&
            (previousState == Sonic.StateID.StateSpinBoost ||
             previousState == Sonic.StateID.StateSpinBoostCharge ||
             previousState == Sonic.StateID.StateDriftDash ||
             previousState == Sonic.StateID.StateDropDash ||
             previousState == Sonic.StateID.StateSpin))
        {
            if (!isSpinDashJump)
            {
                spinDashJumpSoundHandle = Player.Sound.PlaySound("sn_spin");
                isSpinDashJump = true;
            }
        }
        else if (currentState != Sonic.StateID.StateJump)
        {
            if (isSpinDashJump)
            {
                int soundHandleSpinDash = Player.Sound.PlaySound("sn_spin");
                Player.Sound.StopSound(&soundHandleSpinDash);
            }

            isSpinDashJump = false;
        }

        // Stop sound when leaving StateBounceJump
        if (currentState != Sonic.StateID.StateBounceJump && previousState == Sonic.StateID.StateBounceJump)
        {
            int soundSpinJumpSonic = Player.Sound.PlaySound("sn_spin");
            Player.Sound.StopSound(&soundSpinJumpSonic);
        }
    }

    // Amy
    if (currentPlayerType == Player.PlayerType.Amy)
    {
        var currentAmyState = Player.State.GetCurrentStateID<Amy.StateID>();
        var previousAmyState = Player.State.GetPreviousStateID<Amy.StateID>();

        // Handle StateGrindDoubleJump
        if (currentAmyState == Amy.StateID.StateGrindDoubleJump && previousAmyState != Amy.StateID.StateGrindDoubleJump)
        {
            if (!isAmyGrindDoubleJump)
            {
                Player.Sound.PlaySound("sn_spin");
                isAmyGrindDoubleJump = true;
            }
        }
        else if (currentAmyState != Amy.StateID.StateGrindDoubleJump)
        {
            isAmyGrindDoubleJump = false;
        }

        // Handle StateJump transition from spin states (Amy)
        if (currentAmyState == Amy.StateID.StateJump &&
            (previousAmyState == Amy.StateID.StateSpinBoost ||
             previousAmyState == Amy.StateID.StateSpinBoostCharge ||
             previousAmyState == Amy.StateID.StateDriftDash ||
             previousAmyState == Amy.StateID.StateDropDash ||
             previousAmyState == Amy.StateID.StateSpin))
        {
            if (!isSpinDashJump)
            {
                spinDashJumpSoundHandle = Player.Sound.PlaySound("sn_spin");
                isSpinDashJump = true;
            }
        }
        else if (currentAmyState != Amy.StateID.StateJump)
        {
            if (isSpinDashJump)
            {
                int soundHandleSpinDash = Player.Sound.PlaySound("sn_spin");
                Player.Sound.StopSound(&soundHandleSpinDash);
            }

            isSpinDashJump = false;
        }

        // Stop sounds when leaving states
        if (currentAmyState != Amy.StateID.StateGrindDoubleJump && previousAmyState == Amy.StateID.StateGrindDoubleJump)
        {
            int soundGrindDoubleJump = Player.Sound.PlaySound("sn_spin");
            Player.Sound.StopSound(&soundGrindDoubleJump);
        }
    }

    // Sonic & Knuckles (pun intended) Wall Jump
    if (currentPlayerType == Player.PlayerType.Sonic || currentPlayerType == Player.PlayerType.Knuckles)
    {
        if ((Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateBaseJump ||
             Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.StateBaseJump) &&
            (Player.State.GetPreviousStateID<Sonic.StateID>() != Sonic.StateID.StateBaseJump &&
             Player.State.GetPreviousStateID<Knuckles.StateID>() != Knuckles.StateID.StateBaseJump))
        {
            if (!isBoostWallJump)
            {
                Player.Sound.PlaySound("sn_spin");
                Player.Sound.PlaySound("sn_jump");
                Player.Sound.PlaySound("sn_windmill_kick");
                Lua.Call("PlayVoice", "sa1007"); 
                isBoostWallJump = true;
            }
        }
        else if ((Player.State.GetCurrentStateID<Sonic.StateID>() != Sonic.StateID.StateBaseJump &&
                  Player.State.GetCurrentStateID<Knuckles.StateID>() != Knuckles.StateID.StateBaseJump))
        {
            isBoostWallJump = false;
        }

        if ((Player.State.GetCurrentStateID<Sonic.StateID>() != Sonic.StateID.StateBaseJump &&
             Player.State.GetPreviousStateID<Sonic.StateID>() == Sonic.StateID.StateBaseJump) ||
            (Player.State.GetCurrentStateID<Knuckles.StateID>() != Knuckles.StateID.StateBaseJump &&
             Player.State.GetPreviousStateID<Knuckles.StateID>() == Knuckles.StateID.StateBaseJump))
        {
            int soundBoostWallJump = Player.Sound.PlaySound("sn_spin");
            Player.Sound.StopSound(&soundBoostWallJump);
        }
    }
}

// Spin States
if (conJumpSpinSound == 2)
{
    var currentPlayerType = Player.GetPlayerType();

    if (currentPlayerType == Player.PlayerType.Sonic || currentPlayerType == Player.PlayerType.Knuckles)
    {
        var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();
        var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

        if (_jumpSpinSoundStates.Contains(currentState) && !_jumpSpinSoundStates.Contains(previousState))
        {
            if (!isSpinState)
            {
                Player.Sound.PlaySound("sn_spin");
                isSpinState = true;
            }
        }
        else if (!_jumpSpinSoundStates.Contains(currentState))
        {
            isSpinState = false;
        }

        if (!_jumpSpinSoundStates.Contains(currentState) && _jumpSpinSoundStates.Contains(previousState))
        {
            bool handOffToJumpBallSound =
                currentState == Sonic.StateID.StateBounceJump ||
                (currentState == Sonic.StateID.StateJump &&
                 (previousState == Sonic.StateID.StateSpinBoost ||
                  previousState == Sonic.StateID.StateDriftDash ||
                  previousState == Sonic.StateID.StateDropDash ||
                  previousState == Sonic.StateID.StateSpin));

            if (!handOffToJumpBallSound)
            {
                int soundSpinState = Player.Sound.PlaySound("sn_spin");
                Player.Sound.StopSound(&soundSpinState);
            }
        }
    }
}

// Disable sn_spin
else if (conJumpSpinSound == 3)
{
    if (Player.GetPlayerType() == Player.PlayerType.Sonic || Player.GetPlayerType() == Player.PlayerType.Knuckles)
    {
        if ((Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateBaseJump ||
             Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.StateBaseJump) &&
            (Player.State.GetPreviousStateID<Sonic.StateID>() != Sonic.StateID.StateBaseJump &&
             Player.State.GetPreviousStateID<Knuckles.StateID>() != Knuckles.StateID.StateBaseJump))
        {
            if (!isBoostWallJump)
            {
                Player.Sound.PlaySound("sn_jump");
                Player.Sound.PlaySound("sn_windmill_kick");
                Lua.Call("PlayVoice", "sa1007"); 
                isBoostWallJump = true;
            }
        }
        else
        {
            isBoostWallJump = false;
        }
    }
}

Code "Flying Sound in Stomping - OPTIMIZED" by "Batman Sonic & SuperNova124"
// Plays Tails' flying sound during stomping animation

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Tails"

#import "States"

#load "System.Numerics.dll"

using System.Numerics;

// State tracking
static bool isTailSpin = false;
static int soundHandle = 0;

{
    // Early exit if not Tails
    if (Player.GetPlayerType() != Player.PlayerType.Tails)
        return;

    // Cache state checks
    var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
    var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

    // Entering stomping state
    if (currentState == Tails.StateID.TailsStateStompingDown &&
        previousState != Tails.StateID.TailsStateStompingDown)
    {
        if (!isTailSpin)
        {
            soundHandle = Player.Sound.PlaySound("ta_fly_loop");
            isTailSpin = true;
        }
    }
    // Exiting stomping state
    else if (currentState != Tails.StateID.TailsStateStompingDown &&
             previousState == Tails.StateID.TailsStateStompingDown)
    {
        if (isTailSpin)
        {
            fixed (int* pSoundHandle = &soundHandle)
            {
                Player.Sound.StopSound(pSoundHandle);
            }
            soundHandle = 0;
            isTailSpin = false;
        }
    }
}

Code "Boost Sound Fixes (Tails & Amy) - UNIFIED OPTIMIZED" by "Batman Sonic & SuperNova124"
// Fixes Tails and Amy's boost sounds being missing during:
// 1. Spin Dash Boost
// 2. Max Ring Grind Boost

#include "Reflection" noemit

#lib "Player"
#lib "Tails"
#lib "Amy"
#lib "BlackboardItem"

#load "System.Numerics.dll"

using System.Numerics;

// Separate flags for each fix
static bool isSpinBoostFixTails = false;
static bool isSpinBoostFixAmy = false;
static bool isGrindBoostFixTails = false;
static bool isGrindBoostFixAmy = false;

{
    // Cache boost flag once
    bool isBoost = IS_STATE_FLAG(IsBoost);
    
    // Cache player type once
    var playerType = Player.GetPlayerType();

    // Handle Tails fixes
    if (playerType == Player.PlayerType.Tails)
    {
        // Cache state checks
        var currentState = Player.State.GetCurrentStateID<Tails.StateID>();
        var previousState = Player.State.GetPreviousStateID<Tails.StateID>();

        // ===== FIX 1: SPIN DASH BOOST SOUND =====
        
        // Entering spin boost with boost active
        if (currentState == Tails.StateID.StateSpinBoost &&
            previousState != Tails.StateID.StateSpinBoost &&
            isBoost)
        {
            if (!isSpinBoostFixTails)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isSpinBoostFixTails = true;
            }
        }
        else
        {
            isSpinBoostFixTails = false;
        }

        // Exiting spin boost
        if (currentState != Tails.StateID.StateSpinBoost &&
            previousState == Tails.StateID.StateSpinBoost &&
            !isBoost)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            Player.Sound.StopSound(&soundBoostFix);
        }

        // ===== FIX 2: MAX RING GRIND BOOST SOUND =====
        
        var pBlackboardItem = BlackboardItem.Get();
        if (pBlackboardItem != null)
        {
            int maxrings = pBlackboardItem->RingCapacity;
            int rings = pBlackboardItem->RingCount;

            // Entering grind with max rings and boost active
            if (currentState == Tails.StateID.StateGrind &&
                previousState != Tails.StateID.StateGrind &&
                isBoost && rings == maxrings)
            {
                if (!isGrindBoostFixTails)
                {
                    Player.Sound.PlaySound("sn_boost_run");
                    isGrindBoostFixTails = true;
                }
            }
            else
            {
                isGrindBoostFixTails = false;
            }

            // Exiting grind with max rings
            if (currentState != Tails.StateID.StateGrind &&
                previousState == Tails.StateID.StateGrind &&
                !isBoost && rings == maxrings)
            {
                int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
    // Handle Amy fixes
    else if (playerType == Player.PlayerType.Amy)
    {
        // Cache state checks
        var currentState = Player.State.GetCurrentStateID<Amy.StateID>();
        var previousState = Player.State.GetPreviousStateID<Amy.StateID>();

        // ===== FIX 1: SPIN DASH BOOST SOUND =====
        
        // Entering spin boost with boost active
        if (currentState == Amy.StateID.StateSpinBoost &&
            previousState != Amy.StateID.StateSpinBoost &&
            isBoost)
        {
            if (!isSpinBoostFixAmy)
            {
                Player.Sound.PlaySound("sn_boost_run");
                isSpinBoostFixAmy = true;
            }
        }
        else
        {
            isSpinBoostFixAmy = false;
        }

        // Exiting spin boost
        if (currentState != Amy.StateID.StateSpinBoost &&
            previousState == Amy.StateID.StateSpinBoost &&
            !isBoost)
        {
            int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
            Player.Sound.StopSound(&soundBoostFix);
        }

        // ===== FIX 2: MAX RING GRIND BOOST SOUND =====
        
        var pBlackboardItem = BlackboardItem.Get();
        if (pBlackboardItem != null)
        {
            int maxrings = pBlackboardItem->RingCapacity;
            int rings = pBlackboardItem->RingCount;

            // Entering grind with max rings and boost active
            if (currentState == Amy.StateID.StateGrind &&
                previousState != Amy.StateID.StateGrind &&
                isBoost && rings == maxrings)
            {
                if (!isGrindBoostFixAmy)
                {
                    Player.Sound.PlaySound("sn_boost_run");
                    isGrindBoostFixAmy = true;
                }
            }
            else
            {
                isGrindBoostFixAmy = false;
            }

            // Exiting grind with max rings
            if (currentState != Amy.StateID.StateGrind &&
                previousState == Amy.StateID.StateGrind &&
                !isBoost && rings == maxrings)
            {
                int soundBoostFix = Player.Sound.PlaySound("sn_boost_run");
                Player.Sound.StopSound(&soundBoostFix);
            }
        }
    }
}

Code "Super Sonic Wait Grunt - OPTIMIZED" by "Batman Sonic & SuperNova124"
// Adds a grunt to Super Sonic when he waits after taking damage

#lib "Player"
#lib "Lua"

