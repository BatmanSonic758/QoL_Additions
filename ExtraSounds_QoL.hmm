        isHangPole = false;

    // Sliding
    if (currentState == Knuckles.StateID.StateSliding)
    {
        if (!isSliding)
        {
            Lua.Call("PlayVoice", slidingVoices[random.Next(slidingVoices.Count)]);
            isSliding = true;
        }
    }
    else
        isSliding = false;

    // Quick Step
    if (QuickStepStates.Contains(currentState))
    {
        if (!isQuickStep)
        {
            Lua.Call("PlayVoice", quickstepVoices[random.Next(quickstepVoices.Count)]);
            isQuickStep = true;
        }
    }
    else
        isQuickStep = false;

    // Guard Block
    if (currentState == Knuckles.StateID.StateGuardedFlipBack)
    {
        if (!isGaurdBlock)
        {
            Lua.Call("PlayVoice", guardedflipVoices[random.Next(guardedflipVoices.Count)]);
            isGaurdBlock = true;
        }
    }
    else
        isGaurdBlock = false;

    // Aura Train
    if (currentState == Knuckles.StateID.StateAuraTrain)
    {
        if (!isAuraTrain)
        {
            Lua.Call("PlayVoice", auratrainVoices[random.Next(auratrainVoices.Count)]);
            isAuraTrain = true;
        }
    }
    else
        isAuraTrain = false;
}

