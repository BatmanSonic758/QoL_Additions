Code "Somersault when hitting wall terrain - OPTIMIZED" by "Batman Sonic & SuperNova124"
// Plays a somersault sound when hitting terrain as Sonic or Knuckles

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"
#lib "Knuckles"

#load "System.Numerics.dll"

using System.Numerics;

// State tracking
static bool SomersaultWall = false;

{
    // Early exit if not Sonic or Knuckles
    var playerType = Player.GetPlayerType();
    if (playerType != Player.PlayerType.Sonic && playerType != Player.PlayerType.Knuckles)
        return;

    // Check wall leave state
    bool isWallLeave = false;
    if (playerType == Player.PlayerType.Sonic)
        isWallLeave = Player.State.GetCurrentStateID<Sonic.StateID>() == Sonic.StateID.StateWallLeave;
    else
        isWallLeave = Player.State.GetCurrentStateID<Knuckles.StateID>() == Knuckles.StateID.StateWallLeave;

    if (isWallLeave)
    {
        if (!SomersaultWall)
        {
            Player.Sound.PlaySound("sn_windmill_kick");
            Player.Sound.PlaySound("sa1001");
            SomersaultWall = true;
        }
    }
    else
    {
        SomersaultWall = false;
    }
}

Code "Boost Sound for Sonic's Drift - OPTIMIZED" by "Batman Sonic & SuperNova124"
// Adds a boost sound when pressing the Boost input during a Drift

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"

static bool driftBoostActive = false;
static bool boostWasHeldLastFrame = false;
static int driftBoostHandle = -1;

{
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var currentState  = Player.State.GetCurrentStateID<Sonic.StateID>();
    var previousState = Player.State.GetPreviousStateID<Sonic.StateID>();

    bool isDrift     = currentState == Sonic.StateID.StateDrift;
    bool isBoostDown = Player.Input.IsDown(Player.InputActionType.PlayerBoost);

    // Detect entering drift
    bool justEnteredDrift =
        currentState == Sonic.StateID.StateDrift &&
        previousState != Sonic.StateID.StateDrift;

    // If we entered drift while boost was already held,
    // block sound until boost is released once
    if (justEnteredDrift && boostWasHeldLastFrame)
    {
        driftBoostActive = true; // Prevent playback
    }

    // Play only on fresh press during drift
    if (isDrift && isBoostDown && !boostWasHeldLastFrame && !driftBoostActive)
    {
        driftBoostHandle = Player.Sound.PlaySound("sn_boost_run");
        driftBoostActive = true;
    }

    // Stop when releasing boost or leaving drift
    if (driftBoostActive && (!isDrift || !isBoostDown))
    {
        int driftBoostHandle = Player.Sound.PlaySound("sn_boost_run");
		Player.Sound.StopSound(&driftBoostHandle);
        driftBoostActive = false;
    }

    // Update input memory
    boostWasHeldLastFrame = isBoostDown;
}

Code "Boost Sound for Skateboard" by "Batman Sonic & SuperNova124"
//

#include "Reflection" noemit

#lib "Player"
#lib "Sonic"

#import "Plugins"

static bool boardingBoostActive = false;
static int boardingBoostHandle = 0;

{
    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    var boostPlugin = Player.State.GetStatePlugin<StatePluginBoost>();

    if (boostPlugin == null)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    bool hasBoostEnergy = (boostPlugin->Flags & StatePluginBoost.BoostFlags.IsGaugeEmpty) == 0 &&
                          boostPlugin->BoostAmount > 0.01f;

    bool isBoostBoarding = currentState == Sonic.StateID.StateBoarding && Player.Input.IsDown(Player.InputActionType.PlayerBoost) && hasBoostEnergy && !IS_WORLD_FLAG(IsDamagedOrRepelled);

    if (isBoostBoarding)
    {
        if (!boardingBoostActive)
        {
            boardingBoostHandle = Player.Sound.PlaySound("sn_boost_run");
            boardingBoostActive = true;
        }
    }
    else if (boardingBoostActive)
    {
        if (boardingBoostHandle != 0)
        {
            int soundHandle = boardingBoostHandle;
            Player.Sound.StopSound(&soundHandle);
            boardingBoostHandle = 0;
        }

        boardingBoostActive = false;
    }
}

Code "Consistent Spin Slash Sound" by "Batman Sonic & SuperNova124"
//Spin Slash sound depends on your current Spin Dash sound preset

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Time"
#lib "HMM"

#import "States"

// 0 = idle, 1 = playing charge, 3 = done
static int spinSlashSoundPhase = 0;
static float spinSlashSoundTimer = 0.0f;

static int spinSlashChargeHandle = 0;

// Check if Sound Overhaul Pack is active (static, checked once)
static bool? sopCheckCache = null;

{
    // Check SOP mod once
    if (sopCheckCache == null)
    {
        sopCheckCache = HMM.GetModByID("frontiers.sound-overhaul-pack") != null;
    }

    // Exit early if SOP is active
    if (sopCheckCache == true)
        return;

    var currentState = Player.State.GetCurrentStateID<Sonic.StateID>();

    if (currentState == Sonic.StateID.StateSpinSlash)
    {
        bool isSuper = BlackboardStatus.IsSuper();
        float duration = isSuper ? 0.45f : 1.0f;

        spinSlashSoundTimer += Time.GetDeltaTime();

        if (spinSlashSoundPhase == 0)
        {
            spinSlashChargeHandle = Player.Sound.PlaySound("sn_spinboost_charge");
            spinSlashSoundPhase   = 1;
        }
        else if (spinSlashSoundPhase == 1 && spinSlashSoundTimer >= duration)
        {
            int chargeHandle = spinSlashChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            spinSlashChargeHandle = 0;

            spinSlashSoundPhase = 3;
        }
    }
    else
    {
        if (spinSlashSoundPhase == 1)
        {
            int chargeHandle = spinSlashChargeHandle;
            Player.Sound.StopSound(&chargeHandle);
            spinSlashChargeHandle = 0;
        }

        spinSlashSoundPhase = 0;
        spinSlashSoundTimer = 0.0f;
    }
}