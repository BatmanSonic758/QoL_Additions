Code "Spin Dash Skill" by "Batman Sonic"
//

#include "Reflection" noemit
#include "BlackboardStatus" noemit

#lib "Player"
#lib "Sonic"
#lib "Reflection"
#lib "GameSkillParameter"

static int conLegacySpinDash = 0;
static bool IsConfigInitialized = false;
{
    if (!IsConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");
		
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conLegacySpinDash = INI.Parse<int>(ini["Main"]["LegacySpinDash"], conLegacySpinDash);

            IsConfigInitialized = true;
        }
    }
	
	var GameSkillParameterInfo = Reflection.GetDataInfo<GameSkillParameter.Root>("skill");

    if (GameSkillParameterInfo.pData == null)
        return;

    RFL_SET_PARAM(GameSkillParameterInfo, skillParams[14].unlockPoint, 40);

    if (conLegacySpinDash == 1 || conLegacySpinDash == 2)
        return;

    if (Player.GetPlayerType() != Player.PlayerType.Sonic)
        return;

    SET_COMBAT_FLAG(IsSpinDash, IS_COMBAT_FLAG(IsAutoCombo));
}

Patch "Spin Dash Skill Text" by "Batman Sonic"
//

#lib "Converse"

static int conDrift = 0;
static int conDriftInput = 0;
static bool IsConfigInitialized = false;
{
    if (!IsConfigInitialized)
    {
        var modsQuery = HMM.FindModsByName("Quality of Life Additions");
        if (modsQuery.Count == 1)
        {
            string modConfigIniPath = System.IO.Path.Combine(modsQuery[0].Path, "mod.ini");
            var ini = INI.Read(modConfigIniPath);

            conDrift = INI.Parse<int>(ini["Main"]["Drift"], conDrift);
			conDriftInput = INI.Parse<int>(ini["Main"]["DriftInput"], conDriftInput);

            IsConfigInitialized = true;
        }
    }
	
    Converse.Redirect("tu1000dlc_160", "Congratulation!");
    Converse.Redirect("tu1000dlc_165", "You achieved an S rank in every Action Chain Challenge.\nYour skill, speed, and precision are unmatched!");
    Converse.Redirect("tu1000dlc_166", "Congratulation\nYou achieved an S rank in every Action Chain Challenge.\nYour skill, speed, and precision are unmatched!");
	
    Converse.Redirect("skill_15_name", "Spin Dash");
    Converse.Redirect("skill_15_command", "Hold <image name=\"button_right\" /> → <image name=\"button_left_trigger\" /> → Release <image name=\"button_right\" />");

    if (conDriftInput == 4)
    {
        // Drift on LT, Sonic can't Spin Dash while running
        Converse.Redirect("skill_15_explain", "Press <image name=\"button_left_trigger\" /> while in midair to roll into a ball form and run over enemies to deal damage.");
    }
    else
    {
        // Default Spin Dash text
        Converse.Redirect("skill_15_explain", "Press <image name=\"button_left_trigger\" /> while running or in midair to roll into a ball form and run over enemies to deal damage.");
    }
}